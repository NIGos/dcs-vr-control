+// Deferred mode: creates frame generation for application swapchains that this frame submits to the
+// runtime. Runs at the same point and under the same locks as apply_embedded_control.
+void materialize_submitted_generation(
+    const std::shared_ptr<SessionState>& state,
+    const XrFrameEndInfo* end_info) {
+    if (!state->defer_generation_until_submitted || end_info == nullptr ||
+        end_info->type != XR_TYPE_FRAME_END_INFO || end_info->layers == nullptr ||
+        state->graphics_binding != SessionGraphicsBinding::d3d11) {
+        return;
+    }
+    for (std::uint32_t layer_index = 0; layer_index < end_info->layerCount; ++layer_index) {
+        const auto* header = end_info->layers[layer_index];
+        if (header == nullptr || header->type != XR_TYPE_COMPOSITION_LAYER_PROJECTION) continue;
+        const auto* projection = reinterpret_cast<const XrCompositionLayerProjection*>(header);
+        for (std::uint32_t view = 0; projection->views != nullptr && view < projection->viewCount; ++view) {
+            const auto chain = find_swapchain(projection->views[view].subImage.swapchain);
+            if (!chain) continue;
+            {
+                std::scoped_lock mark_lock(chain->mutex);
+                chain->submitted_to_runtime = true;
+            }
+            // Framegen off or manually stopped: remember the submission, create nothing. Enabling
+            // framegen later creates generation for submitted swapchains only.
+            if (!state->menu_enabled || state->manual_control.stop_requested()) continue;
+            std::scoped_lock call_lock(chain->call_mutex);
+            std::scoped_lock gpu_lock(state->gpu_mutex);
+            std::unique_lock lock(chain->mutex);
+            if (chain->frame_generation || chain->generation_materialization_attempted ||
+                chain->enumerated_d3d11_images.empty()) {
+                continue;
+            }
+            chain->generation_materialization_attempted = true;
+            std::vector<ID3D11Texture2D*> sources;
+            for (const auto& image : chain->enumerated_d3d11_images) sources.push_back(image.Get());
+            lock.unlock();
+            SwapchainEligibilityReason reason{SwapchainEligibilityReason::ready};
+            std::uint64_t detail{};
+            auto candidate = create_d3d11_frame_generation_swapchains(chain, sources, &reason, &detail);
+            lock.lock();
+            const bool ready = static_cast<bool>(candidate);
+            if (candidate && !chain->frame_generation) chain->frame_generation = std::move(candidate);
+            lock.unlock();
+            log_swapchain_eligibility(
+                chain,
+                ready ? SwapchainEligibilityReason::ready : reason,
+                ready ? sources.size() : detail,
+                (static_cast<std::uint64_t>(sources.size()) << 32) | chain->create_info.arraySize);
+        }
+    }
+}
