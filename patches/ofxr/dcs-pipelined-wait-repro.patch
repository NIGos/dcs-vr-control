@@ -0,0 +1,952 @@
+// Offline reproduction of the DCS World hang (no game, no headset, no runtime).
+//
+// DCS calls xrWaitFrame on one thread and xrBeginFrame/xrEndFrame (plus the
+// swapchain acquire/wait/release calls) on its render thread. Its wait thread
+// issues the wait for frame N+1 as soon as frame N has begun, so the runtime
+// regularly holds a waited-but-not-yet-begun frame while the render thread is
+// inside xrEndFrame for frame N.
+//
+// The fake runtime below enforces the OpenXR rule real compositors (Pimax,
+// SteamVR, ...) implement: "a subsequent xrWaitFrame call must block until the
+// previous frame has been begun with xrBeginFrame". It also paces xrWaitFrame to
+// a 90 Hz display. A runtime would block forever; this one gives up after
+// kDeadlockTimeout, records a deadlock and fails the call so that the test
+// always terminates. A watchdog additionally kills the process if the
+// application threads still do not finish.
+//
+// usage: xrfg_layer_dcs_pipelined_wait <layer-dll> <work-dir> [options]
+//   direct     run the application against the fake runtime without the layer
+//   defer      write [ofxr] defer_until_submitted=1 into the layer ini
+//   log        enable the OFXR flight recorder (ofxr-bridge-flight-*.log in work-dir)
+//   steamvr    report a SteamVR runtime name
+//   bridge     the runtime also offers XR_KHR_D3D12_enable (lets the djules75 fork
+//              engage its D3D11 bridge: runtime session on the layer's D3D12 device)
+//   qvf-turbo  emulate Quad-Views-Foveated turbo_mode=1 above the layer: xrWaitFrame
+//              returns a made-up time, xrBeginFrame is deferred into xrEndFrame and the
+//              next downstream xrWaitFrame runs on a std::async thread after each end
+//   frames=N   application frames to run (default 120)
+//   serial=N   initial frames rendered with a serial wait->begin->end loop (default 12)
+
+#include <windows.h>
+#include <d3d11_4.h>
+#include <d3d12.h>
+#include <dxgi1_6.h>
+#include <wrl/client.h>
+
+#include <openxr/openxr.h>
+#include <openxr/openxr_loader_negotiation.h>
+#include <openxr/openxr_platform.h>
+
+#include <array>
+#include <atomic>
+#include <chrono>
+#include <cmath>
+#include <condition_variable>
+#include <cstdint>
+#include <cstdlib>
+#include <cstring>
+#include <deque>
+#include <filesystem>
+#include <future>
+#include <fstream>
+#include <iostream>
+#include <map>
+#include <mutex>
+#include <optional>
+#include <set>
+#include <string>
+#include <thread>
+#include <vector>
+
+namespace {
+
+using Microsoft::WRL::ComPtr;
+
+constexpr char kLayerName[] = "XR_APILAYER_XRFrameBridge_diagnostic";
+constexpr XrDuration kDisplayPeriod = 11'111'111;  // 90 Hz
+constexpr auto kDeadlockTimeout = std::chrono::milliseconds(2'000);
+constexpr std::uint32_t kEyeWidth = 256;
+constexpr std::uint32_t kEyeHeight = 256;
+
+XrInstance g_instance = reinterpret_cast<XrInstance>(static_cast<std::uintptr_t>(0x101));
+XrSession g_session = reinterpret_cast<XrSession>(static_cast<std::uintptr_t>(0x202));
+XrSpace g_space = reinterpret_cast<XrSpace>(static_cast<std::uintptr_t>(0x404));
+bool g_steamvr_name = false;
+bool g_offer_d3d12 = false;
+ComPtr<ID3D12Device> g_runtime_d3d12_device;  // Set when the session binding is D3D12.
+std::atomic<bool> g_session_d3d12{false};
+
+ComPtr<ID3D11Device> g_device;
+ComPtr<ID3D11DeviceContext> g_context;
+
+// ---------------------------------------------------------------- fake runtime
+
+std::mutex g_frame_mutex;
+std::condition_variable g_frame_condition;
+bool g_waited_not_begun = false;  // A wait returned and its xrBeginFrame has not happened yet.
+bool g_frame_begun = false;       // xrBeginFrame happened and xrEndFrame has not.
+std::int64_t g_last_slot = -1;
+std::chrono::steady_clock::time_point g_epoch = std::chrono::steady_clock::now();
+std::deque<XrTime> g_waited_times;
+
+std::atomic<std::uint32_t> g_runtime_waits{0};
+std::atomic<std::uint32_t> g_runtime_begins{0};
+std::atomic<std::uint32_t> g_runtime_ends{0};
+std::atomic<std::uint32_t> g_deadlocks{0};
+std::atomic<std::uint32_t> g_order_errors{0};
+std::atomic<std::uint32_t> g_private_submissions{0};
+std::atomic<std::uint32_t> g_application_submissions{0};
+std::atomic<DWORD> g_deadlocked_thread{0};
+
+struct FakeSwapchain {
+    std::vector<ComPtr<ID3D11Texture2D>> images;
+    std::vector<ComPtr<ID3D12Resource>> d3d12_images;
+    std::uint32_t next_image{};
+    bool application_owned{};
+};
+std::mutex g_swapchain_mutex;
+std::map<XrSwapchain, FakeSwapchain> g_swapchains;
+std::uintptr_t g_next_swapchain = 0x1000;
+std::atomic<bool> g_application_creating_swapchains{false};
+std::atomic<std::uint32_t> g_swapchains_created{0};
+std::atomic<std::uint32_t> g_swapchains_peak{0};
+
+XrTime slot_time(std::int64_t slot) noexcept {
+    return 1'000'000'000 + slot * kDisplayPeriod;
+}
+
+XRAPI_ATTR XrResult XRAPI_CALL fake_wait_frame(XrSession, const XrFrameWaitInfo*, XrFrameState* frame_state) {
+    if (frame_state == nullptr) return XR_ERROR_VALIDATION_FAILURE;
+    g_runtime_waits.fetch_add(1);
+    std::unique_lock lock(g_frame_mutex);
+    // OpenXR: a subsequent xrWaitFrame must block until the previous frame has
+    // been begun. A real runtime blocks here indefinitely.
+    if (!g_frame_condition.wait_for(lock, kDeadlockTimeout, [] { return !g_waited_not_begun; })) {
+        g_deadlocks.fetch_add(1);
+        g_deadlocked_thread.store(GetCurrentThreadId());
+        std::cerr << "[fake-runtime] DEADLOCK: xrWaitFrame on thread " << GetCurrentThreadId()
+                  << " blocked " << kDeadlockTimeout.count()
+                  << " ms behind a waited frame whose xrBeginFrame never came\n";
+        return XR_ERROR_RUNTIME_FAILURE;
+    }
+    g_waited_not_begun = true;  // Claim before releasing the lock for pacing.
+    const auto now = std::chrono::steady_clock::now();
+    const auto elapsed = std::chrono::duration_cast<std::chrono::nanoseconds>(now - g_epoch).count();
+    std::int64_t slot = elapsed / kDisplayPeriod + 1;
+    if (slot <= g_last_slot) slot = g_last_slot + 1;
+    g_last_slot = slot;
+    const auto wake = g_epoch + std::chrono::nanoseconds(slot * kDisplayPeriod);
+    lock.unlock();
+    std::this_thread::sleep_until(wake);  // Compositor frame pacing.
+    lock.lock();
+    frame_state->predictedDisplayTime = slot_time(slot + 1);
+    frame_state->predictedDisplayPeriod = kDisplayPeriod;
+    frame_state->shouldRender = XR_TRUE;
+    g_waited_times.push_back(frame_state->predictedDisplayTime);
+    return XR_SUCCESS;
+}
+
+XRAPI_ATTR XrResult XRAPI_CALL fake_begin_frame(XrSession, const XrFrameBeginInfo*) {
+    g_runtime_begins.fetch_add(1);
+    std::scoped_lock lock(g_frame_mutex);
+    if (!g_waited_not_begun) {
+        g_order_errors.fetch_add(1);
+        std::cerr << "[fake-runtime] xrBeginFrame without a waited frame\n";
+        return XR_ERROR_CALL_ORDER_INVALID;
+    }
+    g_waited_not_begun = false;
+    const bool discarded = g_frame_begun;
+    g_frame_begun = true;
+    g_frame_condition.notify_all();
+    if (discarded) {
+        g_order_errors.fetch_add(1);
+        std::cerr << "[fake-runtime] xrBeginFrame discarded an unended frame\n";
+        return XR_FRAME_DISCARDED;
+    }
+    return XR_SUCCESS;
+}
+
+XRAPI_ATTR XrResult XRAPI_CALL fake_end_frame(XrSession, const XrFrameEndInfo* end_info) {
+    g_runtime_ends.fetch_add(1);
+    {
+        std::scoped_lock lock(g_frame_mutex);
+        if (!g_frame_begun || end_info == nullptr) {
+            g_order_errors.fetch_add(1);
+            std::cerr << "[fake-runtime] xrEndFrame without a begun frame\n";
+            return XR_ERROR_CALL_ORDER_INVALID;
+        }
+        g_frame_begun = false;
+    }
+    bool private_submission = false;
+    bool application_submission = false;
+    for (std::uint32_t index = 0; end_info->layers != nullptr && index < end_info->layerCount; ++index) {
+        const auto* layer = end_info->layers[index];
+        if (layer == nullptr || layer->type != XR_TYPE_COMPOSITION_LAYER_PROJECTION) continue;
+        const auto* projection = reinterpret_cast<const XrCompositionLayerProjection*>(layer);
+        for (std::uint32_t view = 0; view < projection->viewCount; ++view) {
+            std::scoped_lock lock(g_swapchain_mutex);
+            const auto found = g_swapchains.find(projection->views[view].subImage.swapchain);
+            if (found == g_swapchains.end()) {
+                g_order_errors.fetch_add(1);
+                return XR_ERROR_HANDLE_INVALID;
+            }
+            (found->second.application_owned ? application_submission : private_submission) = true;
+        }
+    }
+    if (private_submission) g_private_submissions.fetch_add(1);
+    if (application_submission) g_application_submissions.fetch_add(1);
+    return XR_SUCCESS;
+}
+
+XRAPI_ATTR XrResult XRAPI_CALL fake_destroy_instance(XrInstance) { return XR_SUCCESS; }
+
+XRAPI_ATTR XrResult XRAPI_CALL fake_get_instance_properties(XrInstance, XrInstanceProperties* properties) {
+    if (properties == nullptr || properties->type != XR_TYPE_INSTANCE_PROPERTIES) {
+        return XR_ERROR_VALIDATION_FAILURE;
+    }
+    properties->runtimeVersion = XR_MAKE_VERSION(1, 0, 0);
+    strcpy_s(properties->runtimeName,
+             g_steamvr_name ? "SteamVR/OpenXR : XRFG blocking fake" : "XRFG blocking fake runtime");
+    return XR_SUCCESS;
+}
+
+XRAPI_ATTR XrResult XRAPI_CALL fake_create_session(XrInstance, const XrSessionCreateInfo* info, XrSession* session) {
+    for (auto* next = info ? static_cast<const XrBaseInStructure*>(info->next) : nullptr; next != nullptr;
+         next = next->next) {
+        if (next->type == XR_TYPE_GRAPHICS_BINDING_D3D12_KHR) {
+            g_runtime_d3d12_device = reinterpret_cast<const XrGraphicsBindingD3D12KHR*>(next)->device;
+            g_session_d3d12.store(true);
+        }
+    }
+    *session = g_session;
+    return XR_SUCCESS;
+}
+XRAPI_ATTR XrResult XRAPI_CALL fake_destroy_session(XrSession) { return XR_SUCCESS; }
+
+XRAPI_ATTR XrResult XRAPI_CALL fake_enumerate_instance_extensions(const char*, std::uint32_t capacity,
+                                                                  std::uint32_t* count, XrExtensionProperties* props) {
+    std::vector<const char*> names{"XR_KHR_D3D11_enable"};
+    if (g_offer_d3d12) names.push_back("XR_KHR_D3D12_enable");
+    if (count == nullptr) return XR_ERROR_VALIDATION_FAILURE;
+    *count = static_cast<std::uint32_t>(names.size());
+    if (capacity == 0) return XR_SUCCESS;
+    if (capacity < names.size() || props == nullptr) return XR_ERROR_SIZE_INSUFFICIENT;
+    for (std::size_t index = 0; index < names.size(); ++index) {
+        strcpy_s(props[index].extensionName, names[index]);
+        props[index].extensionVersion = 1;
+    }
+    return XR_SUCCESS;
+}
+
+LUID adapter_luid() {
+    LUID luid{};
+    ComPtr<IDXGIDevice> dxgi;
+    ComPtr<IDXGIAdapter> adapter;
+    DXGI_ADAPTER_DESC description{};
+    if (SUCCEEDED(g_device.As(&dxgi)) && SUCCEEDED(dxgi->GetAdapter(adapter.GetAddressOf())) &&
+        SUCCEEDED(adapter->GetDesc(&description))) {
+        luid = description.AdapterLuid;
+    }
+    return luid;
+}
+
+XRAPI_ATTR XrResult XRAPI_CALL fake_get_d3d12_requirements(XrInstance, XrSystemId,
+                                                           XrGraphicsRequirementsD3D12KHR* requirements) {
+    if (requirements == nullptr) return XR_ERROR_VALIDATION_FAILURE;
+    requirements->adapterLuid = adapter_luid();
+    requirements->minFeatureLevel = D3D_FEATURE_LEVEL_11_0;
+    return XR_SUCCESS;
+}
+
+XRAPI_ATTR XrResult XRAPI_CALL fake_get_d3d11_requirements(XrInstance, XrSystemId,
+                                                           XrGraphicsRequirementsD3D11KHR* requirements) {
+    if (requirements == nullptr) return XR_ERROR_VALIDATION_FAILURE;
+    requirements->adapterLuid = adapter_luid();
+    requirements->minFeatureLevel = D3D_FEATURE_LEVEL_11_0;
+    return XR_SUCCESS;
+}
+XRAPI_ATTR XrResult XRAPI_CALL fake_begin_session(XrSession, const XrSessionBeginInfo*) { return XR_SUCCESS; }
+XRAPI_ATTR XrResult XRAPI_CALL fake_end_session(XrSession) { return XR_SUCCESS; }
+XRAPI_ATTR XrResult XRAPI_CALL fake_destroy_space(XrSpace) { return XR_SUCCESS; }
+
+XrView view_for_time(XrTime time, std::uint32_t eye) {
+    const float t = static_cast<float>(static_cast<double>(time - 1'000'000'000) / 1e9);
+    XrView view{XR_TYPE_VIEW};
+    const float half_yaw = 0.05F * std::sin(t * 2.0F);
+    view.pose.orientation.y = std::sin(half_yaw);
+    view.pose.orientation.w = std::cos(half_yaw);
+    view.pose.position = {eye == 0 ? -0.032F : 0.032F, 1.6F, 0.0F};
+    view.fov = {-0.8F, 0.8F, 0.75F, -0.75F};
+    return view;
+}
+
+XRAPI_ATTR XrResult XRAPI_CALL fake_locate_views(XrSession, const XrViewLocateInfo* info, XrViewState* state,
+                                                 std::uint32_t capacity, std::uint32_t* count, XrView* views) {
+    if (info == nullptr || state == nullptr || count == nullptr) return XR_ERROR_VALIDATION_FAILURE;
+    *count = 2;
+    state->viewStateFlags = XR_VIEW_STATE_ORIENTATION_VALID_BIT | XR_VIEW_STATE_POSITION_VALID_BIT;
+    if (capacity >= 2 && views != nullptr) {
+        for (std::uint32_t eye = 0; eye < 2; ++eye) {
+            const XrView sample = view_for_time(info->displayTime, eye);
+            views[eye].pose = sample.pose;
+            views[eye].fov = sample.fov;
+        }
+    }
+    return XR_SUCCESS;
+}
+
+DXGI_FORMAT runtime_texture_format(std::int64_t format) {
+    switch (format) {
+        case DXGI_FORMAT_R8G8B8A8_UNORM:
+        case DXGI_FORMAT_R8G8B8A8_UNORM_SRGB:
+            return DXGI_FORMAT_R8G8B8A8_TYPELESS;  // Like real runtimes.
+        default:
+            return static_cast<DXGI_FORMAT>(format);
+    }
+}
+
+XRAPI_ATTR XrResult XRAPI_CALL fake_create_swapchain(XrSession, const XrSwapchainCreateInfo* info, XrSwapchain* out) {
+    if (info == nullptr || out == nullptr) return XR_ERROR_VALIDATION_FAILURE;
+    FakeSwapchain chain;
+    chain.application_owned = g_application_creating_swapchains.load();
+    D3D11_TEXTURE2D_DESC description{};
+    description.Width = info->width;
+    description.Height = info->height;
+    description.MipLevels = info->mipCount == 0 ? 1 : info->mipCount;
+    description.ArraySize = info->arraySize == 0 ? 1 : info->arraySize;
+    description.Format = runtime_texture_format(info->format);
+    description.SampleDesc.Count = 1;
+    description.Usage = D3D11_USAGE_DEFAULT;
+    description.BindFlags = D3D11_BIND_RENDER_TARGET | D3D11_BIND_SHADER_RESOURCE;
+    if (g_session_d3d12.load()) {
+        D3D12_HEAP_PROPERTIES heap{D3D12_HEAP_TYPE_DEFAULT};
+        D3D12_RESOURCE_DESC resource{};
+        resource.Dimension = D3D12_RESOURCE_DIMENSION_TEXTURE2D;
+        resource.Width = info->width;
+        resource.Height = info->height;
+        resource.DepthOrArraySize = static_cast<UINT16>(description.ArraySize);
+        resource.MipLevels = static_cast<UINT16>(description.MipLevels);
+        resource.Format = description.Format;
+        resource.SampleDesc.Count = 1;
+        resource.Flags = D3D12_RESOURCE_FLAG_ALLOW_RENDER_TARGET;
+        for (int image = 0; image < 3; ++image) {
+            ComPtr<ID3D12Resource> texture;
+            if (FAILED(g_runtime_d3d12_device->CreateCommittedResource(
+                    &heap, D3D12_HEAP_FLAG_NONE, &resource, D3D12_RESOURCE_STATE_RENDER_TARGET, nullptr,
+                    IID_PPV_ARGS(texture.GetAddressOf())))) {
+                return XR_ERROR_RUNTIME_FAILURE;
+            }
+            chain.d3d12_images.push_back(texture);
+        }
+    }
+    for (int image = 0; !g_session_d3d12.load() && image < 3; ++image) {
+        ComPtr<ID3D11Texture2D> texture;
+        if (FAILED(g_device->CreateTexture2D(&description, nullptr, texture.GetAddressOf()))) {
+            return XR_ERROR_RUNTIME_FAILURE;
+        }
+        chain.images.push_back(texture);
+    }
+    std::scoped_lock lock(g_swapchain_mutex);
+    const auto handle = reinterpret_cast<XrSwapchain>(g_next_swapchain++);
+    g_swapchains.emplace(handle, std::move(chain));
+    g_swapchains_created.fetch_add(1);
+    if (g_swapchains.size() > g_swapchains_peak.load()) g_swapchains_peak.store(static_cast<std::uint32_t>(g_swapchains.size()));
+    *out = handle;
+    return XR_SUCCESS;
+}
+
+XRAPI_ATTR XrResult XRAPI_CALL fake_destroy_swapchain(XrSwapchain swapchain) {
+    std::scoped_lock lock(g_swapchain_mutex);
+    return g_swapchains.erase(swapchain) == 1 ? XR_SUCCESS : XR_ERROR_HANDLE_INVALID;
+}
+
+XRAPI_ATTR XrResult XRAPI_CALL fake_enumerate_swapchain_images(XrSwapchain swapchain, std::uint32_t capacity,
+                                                               std::uint32_t* count,
+                                                               XrSwapchainImageBaseHeader* images) {
+    std::scoped_lock lock(g_swapchain_mutex);
+    const auto found = g_swapchains.find(swapchain);
+    if (found == g_swapchains.end() || count == nullptr) return XR_ERROR_HANDLE_INVALID;
+    const bool d3d12 = !found->second.d3d12_images.empty();
+    *count = static_cast<std::uint32_t>(d3d12 ? found->second.d3d12_images.size() : found->second.images.size());
+    if (capacity == 0 || images == nullptr) return XR_SUCCESS;
+    if (capacity < *count) return XR_ERROR_SIZE_INSUFFICIENT;
+    if (d3d12) {
+        auto* d3d12_images = reinterpret_cast<XrSwapchainImageD3D12KHR*>(images);
+        for (std::uint32_t index = 0; index < *count; ++index) {
+            if (d3d12_images[index].type != XR_TYPE_SWAPCHAIN_IMAGE_D3D12_KHR) return XR_ERROR_VALIDATION_FAILURE;
+            d3d12_images[index].texture = found->second.d3d12_images[index].Get();
+        }
+        return XR_SUCCESS;
+    }
+    auto* d3d11_images = reinterpret_cast<XrSwapchainImageD3D11KHR*>(images);
+    for (std::uint32_t index = 0; index < *count; ++index) {
+        if (d3d11_images[index].type != XR_TYPE_SWAPCHAIN_IMAGE_D3D11_KHR) return XR_ERROR_VALIDATION_FAILURE;
+        d3d11_images[index].texture = found->second.images[index].Get();
+    }
+    return XR_SUCCESS;
+}
+
+XRAPI_ATTR XrResult XRAPI_CALL fake_acquire_swapchain_image(XrSwapchain swapchain,
+                                                            const XrSwapchainImageAcquireInfo*,
+                                                            std::uint32_t* index) {
+    std::scoped_lock lock(g_swapchain_mutex);
+    const auto found = g_swapchains.find(swapchain);
+    if (found == g_swapchains.end() || index == nullptr) return XR_ERROR_HANDLE_INVALID;
+    *index = found->second.next_image;
+    const std::size_t image_count =
+        found->second.d3d12_images.empty() ? found->second.images.size() : found->second.d3d12_images.size();
+    found->second.next_image = static_cast<std::uint32_t>((found->second.next_image + 1) % image_count);
+    return XR_SUCCESS;
+}
