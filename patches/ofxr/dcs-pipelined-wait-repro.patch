+XRAPI_ATTR XrResult XRAPI_CALL fake_get_instance_proc_addr(XrInstance, const char* name, PFN_xrVoidFunction* function) {
+    *function = nullptr;
+#define XRFG_FAKE(openxr_name, implementation)                                  \
+    if (std::strcmp(name, openxr_name) == 0) {                                  \
+        *function = reinterpret_cast<PFN_xrVoidFunction>(implementation);       \
+        return XR_SUCCESS;                                                       \
+    }
+    XRFG_FAKE("xrDestroyInstance", fake_destroy_instance)
+    XRFG_FAKE("xrGetInstanceProperties", fake_get_instance_properties)
+    XRFG_FAKE("xrCreateSession", fake_create_session)
+    XRFG_FAKE("xrDestroySession", fake_destroy_session)
+    XRFG_FAKE("xrBeginSession", fake_begin_session)
+    XRFG_FAKE("xrEndSession", fake_end_session)
+    XRFG_FAKE("xrWaitFrame", fake_wait_frame)
+    XRFG_FAKE("xrBeginFrame", fake_begin_frame)
+    XRFG_FAKE("xrEndFrame", fake_end_frame)
+    XRFG_FAKE("xrLocateViews", fake_locate_views)
+    XRFG_FAKE("xrCreateSwapchain", fake_create_swapchain)
+    XRFG_FAKE("xrDestroySwapchain", fake_destroy_swapchain)
+    XRFG_FAKE("xrDestroySpace", fake_destroy_space)
+    XRFG_FAKE("xrEnumerateSwapchainImages", fake_enumerate_swapchain_images)
+    XRFG_FAKE("xrAcquireSwapchainImage", fake_acquire_swapchain_image)
+    XRFG_FAKE("xrWaitSwapchainImage", fake_wait_swapchain_image)
+    XRFG_FAKE("xrReleaseSwapchainImage", fake_release_swapchain_image)
+    XRFG_FAKE("xrEnumerateInstanceExtensionProperties", fake_enumerate_instance_extensions)
+    XRFG_FAKE("xrGetD3D11GraphicsRequirementsKHR", fake_get_d3d11_requirements)
+    if (g_offer_d3d12) {
+        XRFG_FAKE("xrGetD3D12GraphicsRequirementsKHR", fake_get_d3d12_requirements)
+    }
+#undef XRFG_FAKE
+    return XR_ERROR_FUNCTION_UNSUPPORTED;
+}
+
+XRAPI_ATTR XrResult XRAPI_CALL fake_create_api_layer_instance(const XrInstanceCreateInfo*,
+                                                              const XrApiLayerCreateInfo*, XrInstance* instance) {
+    *instance = g_instance;
+    return XR_SUCCESS;
+}
+
+// ---------------------------------------------------------------- application
+
+struct Api {
+    PFN_xrCreateSession create_session{};
+    PFN_xrDestroySession destroy_session{};
+    PFN_xrBeginSession begin_session{};
+    PFN_xrEndSession end_session{};
+    PFN_xrWaitFrame wait_frame{};
+    PFN_xrBeginFrame begin_frame{};
+    PFN_xrEndFrame end_frame{};
+    PFN_xrCreateSwapchain create_swapchain{};
+    PFN_xrDestroySwapchain destroy_swapchain{};
+    PFN_xrEnumerateSwapchainImages enumerate_images{};
+    PFN_xrAcquireSwapchainImage acquire_image{};
+    PFN_xrWaitSwapchainImage wait_image{};
+    PFN_xrReleaseSwapchainImage release_image{};
+    PFN_xrDestroyInstance destroy_instance{};
+};
+
+template <typename Function>
+bool load(PFN_xrGetInstanceProcAddr get, const char* name, Function* output) {
+    PFN_xrVoidFunction function = nullptr;
+    if (XR_FAILED(get(g_instance, name, &function)) || function == nullptr) {
+        std::cerr << "missing " << name << '\n';
+        return false;
+    }
+    *output = reinterpret_cast<Function>(function);
+    return true;
+}
+
+bool load_api(PFN_xrGetInstanceProcAddr get, Api* api) {
+    return load(get, "xrCreateSession", &api->create_session) &&
+           load(get, "xrDestroySession", &api->destroy_session) &&
+           load(get, "xrBeginSession", &api->begin_session) &&
+           load(get, "xrEndSession", &api->end_session) &&
+           load(get, "xrWaitFrame", &api->wait_frame) &&
+           load(get, "xrBeginFrame", &api->begin_frame) &&
+           load(get, "xrEndFrame", &api->end_frame) &&
+           load(get, "xrCreateSwapchain", &api->create_swapchain) &&
+           load(get, "xrDestroySwapchain", &api->destroy_swapchain) &&
+           load(get, "xrEnumerateSwapchainImages", &api->enumerate_images) &&
+           load(get, "xrAcquireSwapchainImage", &api->acquire_image) &&
+           load(get, "xrWaitSwapchainImage", &api->wait_image) &&
+           load(get, "xrReleaseSwapchainImage", &api->release_image) &&
+           load(get, "xrDestroyInstance", &api->destroy_instance);
+}
+
+struct AppSwapchain {
+    XrSwapchain handle{XR_NULL_HANDLE};
+    std::vector<ComPtr<ID3D11RenderTargetView>> targets;
+};
+
+bool create_app_swapchain(const Api& api, XrSession session, AppSwapchain* output) {
+    XrSwapchainCreateInfo info{XR_TYPE_SWAPCHAIN_CREATE_INFO};
+    info.usageFlags = XR_SWAPCHAIN_USAGE_COLOR_ATTACHMENT_BIT | XR_SWAPCHAIN_USAGE_SAMPLED_BIT;
+    info.format = DXGI_FORMAT_R8G8B8A8_UNORM_SRGB;  // What Quad-Views-Foveated hands the next layer.
+    info.sampleCount = 1;
+    info.width = kEyeWidth;
+    info.height = kEyeHeight;
+    info.faceCount = 1;
+    info.arraySize = 1;
+    info.mipCount = 1;
+    g_application_creating_swapchains.store(true);
+    const XrResult result = api.create_swapchain(session, &info, &output->handle);
+    g_application_creating_swapchains.store(false);
+    if (XR_FAILED(result)) return false;
+    std::uint32_t count = 0;
+    if (XR_FAILED(api.enumerate_images(output->handle, 0, &count, nullptr)) || count == 0) return false;
+    std::vector<XrSwapchainImageD3D11KHR> images(count, {XR_TYPE_SWAPCHAIN_IMAGE_D3D11_KHR});
+    if (XR_FAILED(api.enumerate_images(output->handle, count, &count,
+                                       reinterpret_cast<XrSwapchainImageBaseHeader*>(images.data())))) {
+        return false;
+    }
+    for (const auto& image : images) {
+        D3D11_RENDER_TARGET_VIEW_DESC rtv{};
+        rtv.Format = DXGI_FORMAT_R8G8B8A8_UNORM_SRGB;
+        rtv.ViewDimension = D3D11_RTV_DIMENSION_TEXTURE2D;
+        ComPtr<ID3D11RenderTargetView> target;
+        if (FAILED(g_device->CreateRenderTargetView(image.texture, &rtv, target.GetAddressOf()))) return false;
+        output->targets.push_back(target);
+    }
+    return true;
+}
+
+struct WaitedFrame {
+    XrFrameState state{XR_TYPE_FRAME_STATE};
+    bool valid{};
+};
+
+// Mirrors Quad-Views-Foveated's turbo mode (openxr-api-layer/layer.cpp,
+// xrWaitFrame/xrBeginFrame/xrEndFrame with m_asyncWaitPromise): the layer
+// below sees its xrWaitFrame from an async thread right after each end, and
+// begin+end back to back on the render thread.
+struct TurboShim {
+    const Api* api{};
+    XrSession session{};
+    bool enabled{};
+    std::mutex mutex;
+    std::future<void> async_wait;
+    bool polled{};
+    bool completed{};
+    XrTime last_time{};
+    XrDuration last_period{};
+    XrBool32 last_should_render{XR_TRUE};
+    std::chrono::steady_clock::time_point last_wait_stamp{};
+    std::atomic<std::uint32_t> timeouts{0};
+
+    XrResult wait(XrFrameState* state) {
+        std::unique_lock lock(mutex);
+        const auto previous_stamp = last_wait_stamp;
+        last_wait_stamp = std::chrono::steady_clock::now();
+        if (enabled && async_wait.valid()) {
+            if (polled) {
+                lock.unlock();
+                async_wait.wait();
+                lock.lock();
+            }
+            polled = true;
+            state->predictedDisplayTime = completed
+                ? last_time
+                : last_time + std::chrono::duration_cast<std::chrono::nanoseconds>(last_wait_stamp - previous_stamp).count();
+            state->predictedDisplayPeriod = last_period;
+            state->shouldRender = last_should_render;
+            return XR_SUCCESS;
+        }
+        lock.unlock();
+        XrFrameWaitInfo info{XR_TYPE_FRAME_WAIT_INFO};
+        const XrResult result = api->wait_frame(session, &info, state);
+        lock.lock();
+        if (XR_SUCCEEDED(result)) {
+            last_time = state->predictedDisplayTime;
+            last_period = state->predictedDisplayPeriod;
+            last_should_render = state->shouldRender;
+        }
+        return result;
+    }
+
+    XrResult begin() {
+        {
+            std::scoped_lock lock(mutex);
+            if (enabled && async_wait.valid()) return XR_SUCCESS;
+        }
+        XrFrameBeginInfo info{XR_TYPE_FRAME_BEGIN_INFO};
+        return api->begin_frame(session, &info);
+    }
+
+    XrResult end(const XrFrameEndInfo* end_info) {
+        std::unique_lock lock(mutex);
+        XrResult result = XR_SUCCESS;
+        if (async_wait.valid()) {
+            lock.unlock();
+            const bool ready = async_wait.wait_for(std::chrono::seconds(1)) == std::future_status::ready;
+            lock.lock();
+            if (ready) {
+                async_wait = {};
+            } else {
+                timeouts.fetch_add(1);
+            }
+            result = api->begin_frame(session, nullptr);
+        }
+        if (XR_SUCCEEDED(result)) result = api->end_frame(session, end_info);
+        if (XR_SUCCEEDED(result) && enabled && !async_wait.valid()) {
+            polled = false;
+            completed = false;
+            async_wait = std::async(std::launch::async, [this] {
+                XrFrameState state{XR_TYPE_FRAME_STATE};
+                const XrResult wait_result = api->wait_frame(session, nullptr, &state);
+                std::scoped_lock inner(mutex);
+                if (XR_SUCCEEDED(wait_result)) {
+                    last_time = state.predictedDisplayTime;
+                    last_period = state.predictedDisplayPeriod;
+                    last_should_render = state.shouldRender;
+                }
+                completed = true;
+            });
+        }
+        return result;
+    }
+};
+
+int run(int argc, char** argv) {
+    if (argc < 3) {
+        std::cerr << "usage: xrfg_layer_dcs_pipelined_wait <layer-dll> <work-dir> "
+                     "[direct] [defer] [steamvr] [frames=N] [serial=N]\n";
+        return EXIT_FAILURE;
+    }
+    bool direct = false;
+    bool defer = false;
+    bool log = false;
+    bool turbo_option = false;
+    std::uint32_t frame_count = 120;
+    std::uint32_t serial_frames = 12;
+    for (int index = 3; index < argc; ++index) {
+        const std::string option = argv[index];
+        if (option == "direct") direct = true;
+        else if (option == "defer") defer = true;
+        else if (option == "log") log = true;
+        else if (option == "steamvr") g_steamvr_name = true;
+        else if (option == "bridge") g_offer_d3d12 = true;
+        else if (option == "qvf-turbo") turbo_option = true;
+        else if (option.rfind("frames=", 0) == 0) frame_count = static_cast<std::uint32_t>(std::stoul(option.substr(7)));
+        else if (option.rfind("serial=", 0) == 0) serial_frames = static_cast<std::uint32_t>(std::stoul(option.substr(7)));
+        else {
+            std::cerr << "unknown option " << option << '\n';
+            return EXIT_FAILURE;
+        }
+    }
+
+    D3D_FEATURE_LEVEL level{};
+    if (FAILED(D3D11CreateDevice(nullptr, D3D_DRIVER_TYPE_HARDWARE, nullptr, D3D11_CREATE_DEVICE_BGRA_SUPPORT,
+                                 nullptr, 0, D3D11_SDK_VERSION, g_device.GetAddressOf(), &level,
+                                 g_context.GetAddressOf()))) {
+        std::cerr << "failed to create the D3D11 hardware device\n";
+        return EXIT_FAILURE;
+    }
+
+    PFN_xrGetInstanceProcAddr get_proc = fake_get_instance_proc_addr;
+    HMODULE module = nullptr;
+    if (!direct) {
+        // Load a private copy so the layer reads this test's ofxr_bridge.ini.
+        const std::filesystem::path work = argv[2];
+        std::error_code error;
+        std::filesystem::remove_all(work, error);
+        std::filesystem::create_directories(work);
+        const std::filesystem::path source = argv[1];
+        const auto dll = work / source.filename();
+        std::filesystem::copy_file(source, dll, std::filesystem::copy_options::overwrite_existing);
+        {
+            std::ofstream ini(work / "ofxr_bridge.ini", std::ios::trunc);
+            ini << "[ofxr]\nenabled=1\nframe_generation=ofxr\nmotion_vectors=off\nbackend=fidelityfx\n"
+                << "defer_until_submitted=" << (defer ? 1 : 0) << "\n\n"
+                << "[diagnostics]\nlogging_enabled=" << (log ? 1 : 0) << "\nmax_file_mb=64\nflush_each_event=0\n";
+        }
+        module = LoadLibraryW(dll.c_str());
+        if (module == nullptr) {
+            std::cerr << "LoadLibrary failed: " << GetLastError() << '\n';
+            return EXIT_FAILURE;
+        }
+        const auto negotiate = reinterpret_cast<PFN_xrNegotiateLoaderApiLayerInterface>(
+            GetProcAddress(module, "xrNegotiateLoaderApiLayerInterface"));
+        XrNegotiateLoaderInfo loader_info{};
+        loader_info.structType = XR_LOADER_INTERFACE_STRUCT_LOADER_INFO;
+        loader_info.structVersion = XR_LOADER_INFO_STRUCT_VERSION;
+        loader_info.structSize = sizeof(loader_info);
+        loader_info.minInterfaceVersion = 1;
+        loader_info.maxInterfaceVersion = XR_CURRENT_LOADER_API_LAYER_VERSION;
+        loader_info.minApiVersion = XR_MAKE_VERSION(1, 0, 0);
+        loader_info.maxApiVersion = XR_CURRENT_API_VERSION;
+        XrNegotiateApiLayerRequest request{};
+        request.structType = XR_LOADER_INTERFACE_STRUCT_API_LAYER_REQUEST;
+        request.structVersion = XR_API_LAYER_INFO_STRUCT_VERSION;
+        request.structSize = sizeof(request);
+        if (negotiate == nullptr || XR_FAILED(negotiate(&loader_info, kLayerName, &request))) {
+            std::cerr << "layer negotiation failed\n";
+            return EXIT_FAILURE;
+        }
+        XrApiLayerNextInfo next_info{};
+        next_info.structType = XR_LOADER_INTERFACE_STRUCT_API_LAYER_NEXT_INFO;
+        next_info.structVersion = XR_API_LAYER_NEXT_INFO_STRUCT_VERSION;
+        next_info.structSize = sizeof(next_info);
+        strcpy_s(next_info.layerName, kLayerName);
+        next_info.nextGetInstanceProcAddr = fake_get_instance_proc_addr;
+        next_info.nextCreateApiLayerInstance = fake_create_api_layer_instance;
+        XrApiLayerCreateInfo layer_info{};
+        layer_info.structType = XR_LOADER_INTERFACE_STRUCT_API_LAYER_CREATE_INFO;
+        layer_info.structVersion = XR_API_LAYER_CREATE_INFO_STRUCT_VERSION;
+        layer_info.structSize = sizeof(layer_info);
+        layer_info.nextInfo = &next_info;
+        XrInstanceCreateInfo instance_info{XR_TYPE_INSTANCE_CREATE_INFO};
+        strcpy_s(instance_info.applicationInfo.applicationName, "DCS");
+        strcpy_s(instance_info.applicationInfo.engineName, "XRFG DCS pipelined-wait test");
+        instance_info.applicationInfo.apiVersion = XR_MAKE_VERSION(1, 0, 0);
+        const char* extensions[] = {"XR_KHR_D3D11_enable"};
+        instance_info.enabledExtensionCount = 1;  // DCS enables the D3D11 graphics extension.
+        instance_info.enabledExtensionNames = extensions;
+        XrInstance instance = XR_NULL_HANDLE;
+        if (XR_FAILED(request.createApiLayerInstance(&instance_info, &layer_info, &instance))) {
+            std::cerr << "layer instance creation failed\n";
+            return EXIT_FAILURE;
+        }
+        get_proc = request.getInstanceProcAddr;
+    }
+
+    Api api{};
+    if (!load_api(get_proc, &api)) return EXIT_FAILURE;
+
+    XrGraphicsBindingD3D11KHR binding{XR_TYPE_GRAPHICS_BINDING_D3D11_KHR};
+    binding.device = g_device.Get();
+    XrSessionCreateInfo session_info{XR_TYPE_SESSION_CREATE_INFO};
+    session_info.next = &binding;
+    session_info.systemId = 1;
+    XrSession session = XR_NULL_HANDLE;
+    if (XR_FAILED(api.create_session(g_instance, &session_info, &session))) {
+        std::cerr << "session creation failed\n";
+        return EXIT_FAILURE;
+    }
+
+    // Quad-Views-Foveated creates the four DCS quad-view swapchains (never
+    // submitted downstream) and then its own stereo pair that it submits.
+    std::vector<AppSwapchain> quad_views(4);
+    for (auto& chain : quad_views) {
+        if (!create_app_swapchain(api, session, &chain)) {
+            std::cerr << "quad-view swapchain creation failed\n";
+            return EXIT_FAILURE;
+        }
+    }
+    std::vector<AppSwapchain> eyes(2);
+    for (auto& chain : eyes) {
+        if (!create_app_swapchain(api, session, &chain)) {
+            std::cerr << "stereo swapchain creation failed\n";
+            return EXIT_FAILURE;
+        }
+    }
+
+    XrSessionBeginInfo begin_info{XR_TYPE_SESSION_BEGIN_INFO};
+    begin_info.primaryViewConfigurationType = XR_VIEW_CONFIGURATION_TYPE_PRIMARY_STEREO;
+    if (XR_FAILED(api.begin_session(session, &begin_info))) return EXIT_FAILURE;
+
+    TurboShim turbo;
+    turbo.api = &api;
+    turbo.session = session;
+    turbo.enabled = turbo_option;
+    std::mutex queue_mutex;
+    std::condition_variable queue_condition;
+    std::deque<WaitedFrame> waited;
+    std::uint32_t frames_ended = 0;
+    std::atomic<std::uint32_t> app_end_failures{0};
+    std::atomic<std::uint32_t> app_wait_failures{0};
+    std::atomic<std::uint32_t> app_begin_failures{0};
+    std::atomic<bool> wait_thread_done{false};
+    std::atomic<bool> render_thread_done{false};
+
+    // DCS's frame-timing thread.
+    std::thread wait_thread([&] {
+        for (std::uint32_t frame = 0; frame < frame_count; ++frame) {
+            if (frame < serial_frames) {
+                // Start-up: the render thread finishes each frame before the next wait.
+                std::unique_lock lock(queue_mutex);
+                queue_condition.wait(lock, [&] { return frames_ended == frame; });
+            }
+            WaitedFrame item{};
+            const XrResult result = turbo.wait(&item.state);
+            item.valid = XR_SUCCEEDED(result);
+            if (!item.valid) app_wait_failures.fetch_add(1);
+            {
+                std::scoped_lock lock(queue_mutex);
+                waited.push_back(item);
+            }
+            queue_condition.notify_all();
+        }
+        wait_thread_done.store(true);
+    });
+
+    // DCS's render thread.
+    std::thread render_thread([&] {
+        XrSwapchainImageAcquireInfo acquire_info{XR_TYPE_SWAPCHAIN_IMAGE_ACQUIRE_INFO};
+        XrSwapchainImageWaitInfo image_wait{XR_TYPE_SWAPCHAIN_IMAGE_WAIT_INFO};
+        image_wait.timeout = XR_INFINITE_DURATION;
+        XrSwapchainImageReleaseInfo release_info{XR_TYPE_SWAPCHAIN_IMAGE_RELEASE_INFO};
+        for (std::uint32_t frame = 0; frame < frame_count; ++frame) {
+            WaitedFrame item;
+            {
+                std::unique_lock lock(queue_mutex);
+                queue_condition.wait(lock, [&] { return !waited.empty(); });
+                item = waited.front();
+                waited.pop_front();
+            }
+            auto finish = [&] {
+                {
+                    std::scoped_lock lock(queue_mutex);
+                    ++frames_ended;
+                }
+                queue_condition.notify_all();
+            };
+            if (!item.valid) {
+                finish();
+                continue;
+            }
+            const XrResult begin_result = turbo.begin();
+            if (XR_FAILED(begin_result)) {
+                app_begin_failures.fetch_add(1);
+                finish();
+                continue;
+            }
+            // Quad views rendered by DCS, then the stereo composition by the upper layer.
+            const float shade = static_cast<float>(frame % 64) / 64.0F;
+            for (auto* group : {&quad_views, &eyes}) {
+                for (auto& chain : *group) {
+                    std::uint32_t index = 0;
+                    if (XR_FAILED(api.acquire_image(chain.handle, &acquire_info, &index)) ||
+                        XR_FAILED(api.wait_image(chain.handle, &image_wait))) {
+                        app_end_failures.fetch_add(1);
+                        continue;
+                    }
+                    const float color[4] = {shade, 0.25F, 1.0F - shade, 1.0F};
+                    g_context->ClearRenderTargetView(chain.targets[index].Get(), color);
+                    static_cast<void>(api.release_image(chain.handle, &release_info));
+                }
+            }
+            std::this_thread::sleep_for(std::chrono::milliseconds(4));  // CPU-side frame work.
+            std::array<XrCompositionLayerProjectionView, 2> views{};
+            for (std::uint32_t eye = 0; eye < 2; ++eye) {
+                const XrView sample = view_for_time(item.state.predictedDisplayTime, eye);
+                views[eye] = {XR_TYPE_COMPOSITION_LAYER_PROJECTION_VIEW};
+                views[eye].pose = sample.pose;
+                views[eye].fov = sample.fov;
+                views[eye].subImage.swapchain = eyes[eye].handle;
+                views[eye].subImage.imageRect = {{0, 0}, {static_cast<std::int32_t>(kEyeWidth),
+                                                          static_cast<std::int32_t>(kEyeHeight)}};
+            }
+            XrCompositionLayerProjection projection{XR_TYPE_COMPOSITION_LAYER_PROJECTION};
+            projection.space = g_space;
+            projection.viewCount = 2;
+            projection.views = views.data();
+            const XrCompositionLayerBaseHeader* layers[] = {
+                reinterpret_cast<const XrCompositionLayerBaseHeader*>(&projection)};
+            XrFrameEndInfo end_info{XR_TYPE_FRAME_END_INFO};
+            end_info.displayTime = item.state.predictedDisplayTime;
+            end_info.environmentBlendMode = XR_ENVIRONMENT_BLEND_MODE_OPAQUE;
+            end_info.layerCount = 1;
+            end_info.layers = layers;
+            if (XR_FAILED(turbo.end(&end_info))) app_end_failures.fetch_add(1);
+            finish();
+        }
+        render_thread_done.store(true);
+    });
+
+    // Watchdog: never hang the test. A stall is no application frame ending for
+    // kStallTimeout; the fake runtime's own deadlock timeout is shorter, so a
+    // runtime-visible deadlock is reported by it first.
+    constexpr auto kStallTimeout = std::chrono::seconds(10);
+    const auto started = std::chrono::steady_clock::now();
+    std::uint32_t last_progress = 0;
+    auto last_progress_time = started;
+    while (!(wait_thread_done.load() && render_thread_done.load())) {
+        std::uint32_t ended = 0;
+        {
+            std::scoped_lock lock(queue_mutex);
+            ended = frames_ended;
+        }
+        const auto now = std::chrono::steady_clock::now();
+        if (ended != last_progress) {
+            last_progress = ended;
+            last_progress_time = now;
+        } else if (now - last_progress_time > kStallTimeout) {
+            std::cerr << "WATCHDOG: no application frame ended for " << kStallTimeout.count()
+                      << " s (wait_done=" << wait_thread_done.load() << " render_done=" << render_thread_done.load()
+                      << " frames_ended=" << ended << " runtime_waits=" << g_runtime_waits.load()
+                      << " deadlocks=" << g_deadlocks.load() << ")\nFAIL: hang\n";
+            std::cerr.flush();
+            TerminateProcess(GetCurrentProcess(), 3);
+        }
+        std::this_thread::sleep_for(std::chrono::milliseconds(20));
+    }
+    const double seconds = std::chrono::duration<double>(std::chrono::steady_clock::now() - started).count();
+    wait_thread.join();
+    render_thread.join();
+    if (turbo.async_wait.valid()) turbo.async_wait.wait_for(std::chrono::seconds(3));
+
+    static_cast<void>(api.end_session(session));
+    for (auto* group : {&quad_views, &eyes}) {
+        for (auto& chain : *group) static_cast<void>(api.destroy_swapchain(chain.handle));
+    }
+    static_cast<void>(api.destroy_session(session));
+    static_cast<void>(api.destroy_instance(g_instance));
+
+    std::cout << "mode=" << (direct ? "direct" : "layer") << " defer=" << defer << " steamvr=" << g_steamvr_name
+              << " qvf_turbo=" << turbo_option << " turbo_1s_timeouts=" << turbo.timeouts.load()
+              << " bridge_offered=" << g_offer_d3d12 << " runtime_session_d3d12=" << g_session_d3d12.load()
+              << " frames=" << frame_count << " serial=" << serial_frames
+              << " app_fps=" << frame_count / seconds << " runtime_fps=" << g_runtime_ends.load() / seconds << '\n'
+              << "runtime waits=" << g_runtime_waits.load() << " begins=" << g_runtime_begins.load()
+              << " ends=" << g_runtime_ends.load() << " private_submissions=" << g_private_submissions.load()
+              << " application_submissions=" << g_application_submissions.load()
+              << " runtime_swapchains_created=" << g_swapchains_created.load()
+              << " runtime_swapchains_peak=" << g_swapchains_peak.load() << '\n'
+              << "deadlocks=" << g_deadlocks.load() << " order_errors=" << g_order_errors.load()
+              << " app_wait_failures=" << app_wait_failures.load()
+              << " app_begin_failures=" << app_begin_failures.load()
+              << " app_end_failures=" << app_end_failures.load() << '\n';
+    bool ok = turbo.timeouts.load() == 0 && g_deadlocks.load() == 0 && g_order_errors.load() == 0 && app_wait_failures.load() == 0 &&
+              app_begin_failures.load() == 0 && app_end_failures.load() == 0;
+    if (!direct && g_private_submissions.load() == 0) {
+        std::cout << "frame generation never submitted a private swapchain\n";
+        ok = false;
+    }
+    if (g_deadlocks.load() != 0) {
+        std::cout << "FAIL: runtime xrWaitFrame deadlocked behind an un-begun application wait (thread "
+                  << g_deadlocked_thread.load() << ")\n";
+    }
+    std::cout << (ok ? "PASS" : "FAIL") << '\n';
+    // The layer DLL stays loaded: its worker threads may still reference it.
+    return ok ? EXIT_SUCCESS : EXIT_FAILURE;
+}
+
+}  // namespace
+
+int main(int argc, char** argv) {
+    try {
+        return run(argc, argv);
+    } catch (const std::exception& error) {
+        std::cerr << "exception: " << error.what() << '\n';
+        return EXIT_FAILURE;
+    }
+}
