+// DCS Control (0015): what the pupil shift layer's PupilShift_Status() export
+// reports (XR_APILAYER_DCSVR_pupil_shift.dll). Bit 0 running, bit 1
+// correction on, bit 2 a gaze was applied in the last second, bit 3 the gaze
+// is simulated, bit 4 runtime poses were put back, bits 8-15 the largest pupil
+// shift in 0.1 mm. known is false when the layer is not loaded.
+struct PupilStatus {
+    bool known{};
+    std::uint64_t bits{};
+};
+inline constexpr std::uint64_t kPupilRunning = 1ULL << 0;
+inline constexpr std::uint64_t kPupilOn = 1ULL << 1;
+inline constexpr std::uint64_t kPupilGaze = 1ULL << 2;
+inline constexpr std::uint64_t kPupilSimulated = 1ULL << 3;
+inline constexpr std::uint64_t kPupilRestored = 1ULL << 4;
