+std::string format_pupil_line(const DiagnosticInputs& in, DiagnosticColor& color) {
+    const auto& p = in.pupil;
+    if (!p.known) return {};
+    if (!(p.bits & kPupilRunning)) { color = DiagnosticColor::grey; return "Pupil shift: starting"; }
+    if (!(p.bits & kPupilOn)) {
+        color = DiagnosticColor::grey;
+        const auto key = diagnostic_hotkey_label(in.pupil_hotkey);
+        return key.empty() ? std::string("Pupil shift: OFF") : "Pupil shift: OFF (" + key + ")";
+    }
+    if (!(p.bits & kPupilGaze)) { color = DiagnosticColor::amber; return "Pupil shift: no gaze"; }
+    if (p.bits & kPupilSimulated) { color = DiagnosticColor::amber; return "Pupil shift: ON, simulated gaze"; }
+    if (!(p.bits & kPupilRestored)) { color = DiagnosticColor::amber; return "Pupil shift: ON, poses not restored"; }
+    const auto tenths = static_cast<unsigned>((p.bits >> 8) & 0xFFU);
+    color = DiagnosticColor::green;
+    return "Pupil shift: ON, " + std::to_string(tenths / 10) + "." + std::to_string(tenths % 10) + " mm";
+}
