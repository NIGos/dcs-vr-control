+[[nodiscard]] xrfg::latency::Nanoseconds steady_nanoseconds(
+    std::chrono::steady_clock::time_point at) noexcept {
+    return std::chrono::duration_cast<std::chrono::nanoseconds>(
+        at.time_since_epoch()).count();
+}
+
+// DCS VR Control: when each application frame's first synthetic was actually
+// written, for adaptive 2X/3X. The layer has the fence that says so (the one
+// the presenter polls), but nothing waits on it: the presenter only looks at
+// the moment it hands a frame over. This thread waits on it, frame by frame,
+// and reports the application's work - from its release by the once-per-pair
+// hold to that moment, so its CPU time, its GPU time and the synthesis behind
+// it - to the adaptive controller. One event, one wait at a time; a frame
+// whose fence does not complete within a second is dropped, and a device
+// removed ends nothing but that frame's sample.
+struct ReadinessProbe {
+    struct Item {
+        std::vector<Microsoft::WRL::ComPtr<ID3D12Fence>> fences;
+        std::vector<std::uint64_t> values;
+        std::chrono::steady_clock::time_point released_at{};
+    };
+
+    ReadinessProbe(
+        std::mutex& sink_mutex,
+        xrfg::latency::AdaptiveFrameGenController& sink)
+        : sink_mutex_(&sink_mutex), sink_(&sink) {
+        event_ = CreateEventW(nullptr, FALSE, FALSE, nullptr);
+        if (event_ != nullptr) {
+            try {
+                thread_ = std::thread([this] { run(); });
+            } catch (...) {
+            }
+        }
+    }
+    ReadinessProbe(const ReadinessProbe&) = delete;
+    ReadinessProbe& operator=(const ReadinessProbe&) = delete;
+
+    ~ReadinessProbe() {
+        {
+            std::scoped_lock lock(mutex_);
+            stop_ = true;
+        }
+        condition_.notify_all();
+        if (event_ != nullptr) {
+            SetEvent(event_);
+        }
+        if (thread_.joinable()) {
+            thread_.join();
+        }
+        if (event_ != nullptr) {
+            CloseHandle(event_);
+        }
+    }
+
+    void submit(Item item) noexcept {
+        try {
+            if (!thread_.joinable() || item.fences.empty()) {
+                return;
+            }
+            {
+                std::scoped_lock lock(mutex_);
+                // Never a backlog: a probe that falls behind reports late.
+                constexpr std::size_t kMaximumItems = 8;
+                while (items_.size() >= kMaximumItems) {
+                    items_.pop_front();
+                }
+                items_.push_back(std::move(item));
+            }
+            condition_.notify_one();
+        } catch (...) {
+        }
+    }
+
+private:
+    void run() noexcept {
+        try {
+            for (;;) {
+                Item item;
+                {
+                    std::unique_lock lock(mutex_);
+                    condition_.wait(
+                        lock, [&] { return stop_ || !items_.empty(); });
+                    if (stop_) {
+                        return;
+                    }
+                    item = std::move(items_.front());
+                    items_.pop_front();
+                }
+                bool complete = true;
+                for (std::size_t index = 0;
+                     complete && index < item.fences.size(); ++index) {
+                    ID3D12Fence* fence = item.fences[index].Get();
+                    const std::uint64_t value = item.values[index];
+                    for (;;) {
+                        const std::uint64_t completed = fence->GetCompletedValue();
+                        if (completed == std::numeric_limits<std::uint64_t>::max()) {
+                            complete = false;
+                            break;
+                        }
+                        if (completed >= value) {
+                            break;
+                        }
+                        if (FAILED(fence->SetEventOnCompletion(value, event_))) {
+                            complete = false;
+                            break;
+                        }
+                        const DWORD waited = WaitForSingleObject(event_, 1'000);
+                        {
+                            std::scoped_lock lock(mutex_);
+                            if (stop_) {
+                                return;
+                            }
+                        }
+                        if (waited != WAIT_OBJECT_0) {
+                            complete = false;
+                            break;
+                        }
+                    }
+                }
+                if (!complete) {
+                    continue;
+                }
+                const auto ready = std::chrono::steady_clock::now();
+                const auto work = std::chrono::duration_cast<
+                    std::chrono::nanoseconds>(ready - item.released_at).count();
+                std::scoped_lock lock(*sink_mutex_);
+                sink_->add_work(steady_nanoseconds(ready), work);
+            }
+        } catch (...) {
+        }
+    }
+
+    std::mutex* sink_mutex_{};
+    xrfg::latency::AdaptiveFrameGenController* sink_{};
+    HANDLE event_{};
+    std::thread thread_;
+    std::mutex mutex_;
+    std::condition_variable condition_;
+    std::deque<Item> items_;
+    bool stop_{};
+};
