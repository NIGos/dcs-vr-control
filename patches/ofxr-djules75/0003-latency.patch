diff --git a/include/xrfg/latency_control.hpp b/include/xrfg/latency_control.hpp
new file mode 100644
index 0000000..38cdf48
--- /dev/null
+++ b/include/xrfg/latency_control.hpp
@@ -0,0 +1,236 @@
+#pragma once
+// DCS VR Control: the decisions behind the layer's latency controls, kept free
+// of Windows, D3D and OpenXR so they can be unit tested on their own. The
+// layer feeds them what it measures and acts on what they return.
+//
+//   TripleReleaseTuner         how long 3X keeps the application after its
+//                              frame is handed over (the release delay)
+//   DisplayTimeCorrector       how far the display time the application is
+//                              told must move to name the scanout its real
+//                              frame actually lands on
+//   AdaptiveFrameGenController when to run 2X and when 3X
+//
+// All times are nanoseconds on one monotonic timeline the caller chooses.
+
+#include <array>
+#include <cstddef>
+#include <cstdint>
+
+namespace xrfg::latency {
+
+using Nanoseconds = std::int64_t;
+
+inline constexpr Nanoseconds kMillisecond = 1'000'000;
+inline constexpr Nanoseconds kSecond = 1'000'000'000;
+
+// ---------------------------------------------------------------------------
+// 3X release delay.
+//
+// One observation per application frame: whether that frame's first synthetic
+// was late by the test the caller applies. Judged a window of kWindowFrames at
+// a time. A window with none late raises the delay by kRaiseStep up to the
+// ceiling, and once at the ceiling and past the hold, probes kRaiseStep above
+// it. One with two or more late puts the ceiling kBackoffStep under the delay
+// that failed and holds it there for `backoff` windows; each further failure
+// doubles that hold, up to kMaxHoldWindows, and a clean window at or above the
+// delay that last failed (the room has grown) brings it back to
+// kBaseHoldWindows. Late frames with no
+// delay applied move nothing: they are the application's own, and a start-up
+// burst once put the ceiling at zero for forty seconds. The ceiling never goes
+// below zero and a zero ceiling still probes, so a tuner that was pushed all
+// the way down comes back up once its frames are on time again.
+struct TripleReleaseTuner {
+    static constexpr std::uint32_t kWindowFrames = 30;
+    static constexpr std::uint32_t kBaseHoldWindows = 10;
+    static constexpr std::uint32_t kMaxHoldWindows = 80;
+    static constexpr Nanoseconds kRaiseStep = 2 * kMillisecond;
+    static constexpr Nanoseconds kBackoffStep = 3 * kMillisecond;
+
+    Nanoseconds delay{0};
+    // Negative until the first window sets it to two periods: the
+    // application needs the third to render in.
+    Nanoseconds ceiling{-1};
+    std::uint32_t hold{};
+    std::uint32_t backoff{kBaseHoldWindows};
+    // The delay of the last window that failed; negative when none has, or
+    // since a clean window reached it again.
+    Nanoseconds last_failure{-1};
+    std::uint32_t window_frames{};
+    std::uint32_t window_late{};
+    // First synthetics handed to the runtime before their output was written,
+    // this window. Recorded for the log whatever the test in force.
+    std::uint32_t window_unwritten{};
+
+    void reset() noexcept { *this = TripleReleaseTuner{}; }
+};
+
+struct TripleReleaseWindow {
+    bool closed{};
+    Nanoseconds delay{};
+    Nanoseconds ceiling{};
+    std::uint32_t late{};
+    std::uint32_t unwritten{};
+    std::uint32_t hold{};
+};
+
+// One frame's observation. A non-positive period is ignored.
+TripleReleaseWindow observe_triple_release(
+    TripleReleaseTuner& tuner, Nanoseconds period, bool late) noexcept;
+
+// ---------------------------------------------------------------------------
+// Display time correction.
+//
+// The application is told a display time on the layer's virtual timeline: the
+// presenter's prediction plus one virtual period. Its real frame lands later
+// than that, by however deep the presenter's queue is in front of it and by
+// however far the application itself pipelines its frames (DCS World waits for
+// the next frame before it ends the current one). Measured, not computed: one
+// residual per real frame, the runtime display time it was submitted for minus
+// the display time the application ended it with. A window of kWindowSamples
+// whose spread is under half a period and whose median rounds to a non-zero
+// number of periods, twice in a row with the same step, moves the correction
+// by that many periods, within [0, kMaxPeriods]. The correction is added to
+// what the application is told, so the residual it leaves behind is zero.
+struct DisplayTimeCorrector {
+    static constexpr std::size_t kWindowSamples = 30;
+    static constexpr Nanoseconds kMaxPeriods = 8;
+    // Real frames ignored after a correction moves or the mode changes: they
+    // were told under the old value and are still in the queue.
+    static constexpr std::uint32_t kSettleSamples = 6;
+    // Mode keys: what was learned in each shape is kept for when the session
+    // comes back to it.
+    static constexpr std::size_t kModes = 3;
+
+    Nanoseconds correction{0};
+    std::array<Nanoseconds, kWindowSamples> window{};
+    std::size_t count{};
+    std::uint32_t skip{};
+    Nanoseconds pending_step{};
+    std::array<Nanoseconds, kModes> learned{-1, -1, -1};
+    std::size_t mode{};
+
+    void reset() noexcept { *this = DisplayTimeCorrector{}; }
+};
+
+// 0: 2X shallow, 1: 2X with the deeper pipeline, 2: 3X.
+[[nodiscard]] std::size_t display_time_mode(
+    std::uint32_t frames_per_application_frame, bool deep_pipeline) noexcept;
+
+struct DisplayTimeStep {
+    bool window_closed{};
+    bool changed{};
+    Nanoseconds median{};
+    Nanoseconds spread{};
+    Nanoseconds before{};
+    Nanoseconds after{};
+};
+
+DisplayTimeStep observe_presented(
+    DisplayTimeCorrector& corrector,
+    Nanoseconds residual,
+    Nanoseconds period) noexcept;
+
+// The pipeline changed shape. Starts from what was learned in the new shape
+// if anything was, otherwise from the old correction scaled by the virtual
+// periods (rounded to whole periods). Returns the correction now in force.
+Nanoseconds rebase_display_time_correction(
+    DisplayTimeCorrector& corrector,
+    std::size_t new_mode,
+    Nanoseconds old_virtual_period,
+    Nanoseconds new_virtual_period,
+    Nanoseconds period) noexcept;
+
+// ---------------------------------------------------------------------------
+// Adaptive 2X / 3X.
+//
+// Fed the application's work per frame - from its release to the moment its
+// frame's first synthetic exists, so CPU and GPU both - and every frame that
+// missed its slot. Decides from that, not from the application's paced
+// interval: an application paced to a third of the refresh in 3X may well be
+// able to hold half of it.
+//
+//   3X -> 2X  p90 work <= downshift_fraction of two periods over the last
+//             downshift_window (3 s, doubled after each flap, up to
+//             max_downshift_window), with no missed slot in it (the layer
+//             reports missed slots in 2X only: in 3X they are the release
+//             delay probing).
+//   2X -> 3X  p90 work > two periods, or upshift_late_events missed slots,
+//             over the last upshift_window (0.75 s).
+//
+// Never within min_dwell of the previous switch, and samples within settle of
+// a switch are not counted: the pipeline re-phases once on a switch.
+struct AdaptiveConfig {
+    double downshift_fraction{0.85};
+    Nanoseconds downshift_window{3 * kSecond};
+    Nanoseconds max_downshift_window{48 * kSecond};
+    Nanoseconds upshift_window{750 * kMillisecond};
+    Nanoseconds min_dwell{5 * kSecond};
+    Nanoseconds settle{1 * kSecond};
+    // An upshift this soon after a downshift is a flap.
+    Nanoseconds flap_window{20 * kSecond};
+    std::uint32_t upshift_late_events{2};
+    std::uint32_t min_samples_down{20};
+    std::uint32_t min_samples_up{6};
+};
+
+enum class AdaptiveReason : std::uint32_t {
+    none = 0,
+    headroom = 1,     // 3X -> 2X
+    slow = 2,         // 2X -> 3X, p90 work over budget
+    late = 3,         // 2X -> 3X, missed slots
+    manual = 4,       // the ini's triple_frame_gen changed (caller's record)
+    enabled = 5,      // adaptive turned on or off (caller's record)
+};
+
+struct AdaptiveStats {
+    Nanoseconds p90{-1};
+    std::uint32_t samples{};
+    std::uint32_t late{};
+};
+
+struct AdaptiveDecision {
+    std::uint32_t target{};     // 0: stay
+    AdaptiveReason reason{AdaptiveReason::none};
+    AdaptiveStats stats;
+    Nanoseconds threshold{};
+};
+
+class AdaptiveFrameGenController {
+public:
+    explicit AdaptiveFrameGenController(AdaptiveConfig config = {}) noexcept;
+
+    // Starts (or restarts) in `mode` at `now`; the dwell counts from here.
+    void start(std::uint32_t mode, Nanoseconds now) noexcept;
+    void add_work(Nanoseconds at, Nanoseconds work) noexcept;
+    void add_late(Nanoseconds at, std::uint32_t count = 1) noexcept;
+    [[nodiscard]] AdaptiveDecision evaluate(
+        Nanoseconds now, Nanoseconds period) const noexcept;
+    // The caller applied a switch.
+    void switched(std::uint32_t to, Nanoseconds now) noexcept;
+
+    [[nodiscard]] std::uint32_t mode() const noexcept { return mode_; }
+    [[nodiscard]] Nanoseconds downshift_window() const noexcept {
+        return downshift_window_;
+    }
+    // Over (now - span, now], ignoring what fell within settle of a switch.
+    [[nodiscard]] AdaptiveStats stats(
+        Nanoseconds now, Nanoseconds span) const noexcept;
+
+private:
+    static constexpr std::size_t kWorkSamples = 512;
+    static constexpr std::size_t kLateEvents = 128;
+    AdaptiveConfig config_;
+    std::uint32_t mode_{3};
+    Nanoseconds last_switch_{};
+    Nanoseconds last_downshift_{-1};
+    Nanoseconds downshift_window_{};
+    std::array<Nanoseconds, kWorkSamples> work_at_{};
+    std::array<Nanoseconds, kWorkSamples> work_{};
+    std::size_t work_count_{};
+    std::size_t work_next_{};
+    std::array<Nanoseconds, kLateEvents> late_at_{};
+    std::size_t late_count_{};
+    std::size_t late_next_{};
+};
+
+} // namespace xrfg::latency
