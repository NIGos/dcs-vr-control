diff --git a/tests/latency_control_tests.cpp b/tests/latency_control_tests.cpp
new file mode 100644
index 0000000..1bddd30
--- /dev/null
+++ b/tests/latency_control_tests.cpp
@@ -0,0 +1,421 @@
+// DCS VR Control latency controls: the 3X release delay, the display time the
+// application is told, and adaptive 2X/3X.
+#include "xrfg/latency_control.hpp"
+
+#include <cstdint>
+#include <deque>
+#include <iostream>
+#include <stdexcept>
+#include <string>
+
+namespace {
+
+using namespace xrfg::latency;
+
+void require(bool pass, const std::string& message) {
+    if (!pass) {
+        throw std::runtime_error(message);
+    }
+}
+
+constexpr Nanoseconds kPeriod = 11'111'111; // 90 Hz
+
+// ---------------------------------------------------------------------------
+// 3X release delay.
+
+// A Pimax-like session judged at the first synthetic's own hand-over: the
+// application finishes in time while the delay stays at or under `room`.
+struct TunerRun {
+    std::uint32_t late_frames{};
+    std::uint32_t failed_windows{};
+    Nanoseconds final_delay{};
+    Nanoseconds max_delay{};
+};
+
+TunerRun run_tuner(TripleReleaseTuner& tuner, Nanoseconds room, std::uint32_t frames) {
+    TunerRun run{};
+    for (std::uint32_t frame = 0; frame < frames; ++frame) {
+        const bool late = tuner.delay > room;
+        run.late_frames += late ? 1U : 0U;
+        const auto window = observe_triple_release(tuner, kPeriod, late);
+        if (window.closed && window.late >= 2) {
+            ++run.failed_windows;
+        }
+        run.max_delay = std::max(run.max_delay, tuner.delay);
+    }
+    run.final_delay = tuner.delay;
+    return run;
+}
+
+void triple_release_tests() {
+    {
+        // No delay yet and frames on time: the first window sets the ceiling
+        // to two periods and steps up.
+        TripleReleaseTuner tuner;
+        TripleReleaseWindow window{};
+        for (std::uint32_t i = 0; i < TripleReleaseTuner::kWindowFrames; ++i) {
+            window = observe_triple_release(tuner, kPeriod, false);
+        }
+        require(window.closed, "window closes after thirty frames");
+        require(window.ceiling == 2 * kPeriod, "first ceiling is two periods");
+        require(window.delay == TripleReleaseTuner::kRaiseStep, "first clean window raises 2 ms");
+    }
+    {
+        // Late frames with no delay applied move nothing.
+        TripleReleaseTuner tuner;
+        for (std::uint32_t i = 0; i < 10 * TripleReleaseTuner::kWindowFrames; ++i) {
+            observe_triple_release(tuner, kPeriod, true);
+        }
+        require(tuner.delay == 0 && tuner.ceiling == 2 * kPeriod,
+            "lateness without a delay must not set the ceiling");
+    }
+    {
+        // The log that motivated this: Pimax, 90 Hz, room for ~9.5 ms. The
+        // tuner settles near the room without late frames in steady state.
+        TripleReleaseTuner tuner;
+        const Nanoseconds room = 9'500'000;
+        const auto first = run_tuner(tuner, room, 90 * 30); // 90 s at 30 fps
+        require(first.final_delay <= room, "settled delay is on time");
+        require(first.final_delay >= room - TripleReleaseTuner::kBackoffStep - TripleReleaseTuner::kRaiseStep,
+            "settled delay is within a step of the room: " + std::to_string(first.final_delay));
+        // Each failed probe costs a window; backoff keeps them rare: at most
+        // one per hold, and holds double.
+        require(first.failed_windows <= 6, "probes above the room are backed off: " +
+            std::to_string(first.failed_windows));
+        require(first.late_frames <= first.failed_windows * TripleReleaseTuner::kWindowFrames,
+            "late frames only in probing windows");
+        // Steady state afterwards: a further minute has fewer failures still.
+        const auto second = run_tuner(tuner, room, 60 * 30);
+        require(second.failed_windows <= 2, "backoff keeps steady-state probes rare: " +
+            std::to_string(second.failed_windows));
+        require(tuner.backoff > TripleReleaseTuner::kBaseHoldWindows || second.failed_windows == 0,
+            "repeated failures lengthen the hold");
+    }
+    {
+        // A ceiling pushed to zero comes back: the old tuner stayed at
+        // "delay 0, ceiling 0, all late" for a whole flight.
+        TripleReleaseTuner tuner;
+        run_tuner(tuner, 9'000'000, 30 * 30);
+        require(tuner.delay > 0, "delay found first");
+        // The scene gets heavy: no room at all for a while.
+        run_tuner(tuner, -1, 60 * 30);
+        require(tuner.delay == 0 && tuner.ceiling == 0, "pushed down to zero");
+        // Light again: it must probe up from zero, after its hold.
+        const auto recovered = run_tuner(tuner, 9'000'000, 120 * 30);
+        require(recovered.final_delay >= 4'000'000,
+            "a zero ceiling probes again: " + std::to_string(recovered.final_delay));
+    }
+    {
+        // Backoff doubles on consecutive failures and is capped.
+        TripleReleaseTuner tuner;
+        tuner.ceiling = 2 * kPeriod;
+        std::uint32_t previous_hold = 0;
+        for (int round = 0; round < 8; ++round) {
+            tuner.delay = 10'000'000;
+            tuner.hold = 0;
+            for (std::uint32_t i = 0; i < TripleReleaseTuner::kWindowFrames; ++i) {
+                observe_triple_release(tuner, kPeriod, i < 2);
+            }
+            require(tuner.hold >= previous_hold, "hold never shrinks on a failure");
+            require(tuner.hold <= TripleReleaseTuner::kMaxHoldWindows, "hold capped");
+            previous_hold = tuner.hold;
+        }
+        require(previous_hold == TripleReleaseTuner::kMaxHoldWindows, "hold reaches its cap");
+        require(tuner.ceiling == 10'000'000 - TripleReleaseTuner::kBackoffStep, "ceiling 3 ms under the failure");
+    }
+    {
+        // Unwritten counts are reported per window.
+        TripleReleaseTuner tuner;
+        tuner.window_unwritten = 3;
+        TripleReleaseWindow window{};
+        for (std::uint32_t i = 0; i < TripleReleaseTuner::kWindowFrames; ++i) {
+            window = observe_triple_release(tuner, kPeriod, false);
+        }
+        require(window.unwritten == 3 && tuner.window_unwritten == 0, "unwritten reported and reset");
+        require(observe_triple_release(tuner, 0, true).closed == false && tuner.window_late == 0,
+            "no period, no observation");
+    }
+}
+
+// ---------------------------------------------------------------------------
+// Display time. A presenter on a grid of kPeriod; the application is told the
+// presenter's prediction plus one virtual period plus the correction, and its
+// real frame lands a fixed number of periods after the uncorrected time, set
+// by the pipeline's shape. The residual of a frame is known only once it has
+// been presented, `depth` application frames after it was told.
+
+struct Pipeline {
+    std::uint32_t frames{3};
+    bool deep{};
+    Nanoseconds offset_periods{5};
+};
+
+struct TellSimulation {
+    DisplayTimeCorrector corrector;
+    std::deque<std::pair<Nanoseconds, Nanoseconds>> in_flight; // told, real
+    Nanoseconds now{1'000'000'000'000};
+    std::size_t depth{2};
+    Nanoseconds jitter{};
+    std::uint64_t frame{};
+
+    // Runs `count` application frames; returns how many of the last `tail`
+    // were told exactly the time their real frame was presented for.
+    std::size_t run(const Pipeline& pipeline, std::size_t count, std::size_t tail) {
+        std::size_t exact = 0;
+        const Nanoseconds virtual_period = kPeriod * pipeline.frames;
+        for (std::size_t i = 0; i < count; ++i) {
+            const Nanoseconds uncorrected = now + virtual_period;
+            const Nanoseconds told = uncorrected + corrector.correction;
+            const Nanoseconds noise = jitter == 0 ? 0
+                : static_cast<Nanoseconds>((frame * 7919U) % 3U) * jitter - jitter;
+            const Nanoseconds real = uncorrected + pipeline.offset_periods * kPeriod + noise;
+            in_flight.emplace_back(told, real);
+            if (in_flight.size() > depth) {
+                const auto [presented_told, presented_real] = in_flight.front();
+                in_flight.pop_front();
+                observe_presented(corrector, presented_real - presented_told, kPeriod);
+            }
+            if (i + tail >= count && told == real) {
+                ++exact;
+            }
+            now += virtual_period;
+            ++frame;
+        }
+        return exact;
+    }
+
+    void switch_to(const Pipeline& from, const Pipeline& to) {
+        rebase_display_time_correction(
+            corrector, display_time_mode(to.frames, to.deep),
+            kPeriod * from.frames, kPeriod * to.frames, kPeriod);
+    }
+};
+
+void display_time_tests() {
+    require(display_time_mode(3, true) == 2 && display_time_mode(3, false) == 2 &&
+            display_time_mode(2, true) == 1 && display_time_mode(2, false) == 0,
+        "mode keys");
+    const Pipeline triple{3, false, 5};      // measured on DCS/Pimax: +55.56 ms at 90 Hz
+    const Pipeline deep_pair{2, true, 3};    // +33.3 ms
+    const Pipeline shallow_pair{2, false, 2};
+    {
+        // Each shape on its own: told == real presentation time once settled.
+        for (const Pipeline& pipeline : {triple, deep_pair, shallow_pair}) {
+            TellSimulation sim;
+            const std::size_t exact = sim.run(pipeline, 300, 100);
+            require(exact == 100, "told time is the real presentation time in mode " +
+                std::to_string(pipeline.frames) + (pipeline.deep ? " deep" : "") +
+                " (" + std::to_string(exact) + "/100, correction " +
+                std::to_string(sim.corrector.correction) + ")");
+            require(sim.corrector.correction == pipeline.offset_periods * kPeriod,
+                "correction equals the measured offset");
+        }
+    }
+    {
+        // Settles within a few seconds and never overshoots, although every
+        // residual arrives two frames late.
+        TellSimulation sim;
+        Nanoseconds peak = 0;
+        for (int i = 0; i < 200; ++i) {
+            sim.run(triple, 1, 0);
+            peak = std::max(peak, sim.corrector.correction);
+        }
+        require(sim.corrector.correction == 5 * kPeriod, "3X settles at five periods");
+        require(peak == 5 * kPeriod, "no overshoot");
+    }
+    {
+        // Switching shapes keeps it right: scaled the first time, learned after.
+        TellSimulation sim;
+        sim.run(triple, 300, 0);
+        sim.switch_to(triple, deep_pair);
+        require(sim.corrector.correction == 3 * kPeriod,
+            "3X -> deep 2X rebases by the virtual periods: " + std::to_string(sim.corrector.correction));
+        require(sim.run(deep_pair, 200, 150) == 150, "deep 2X exact after the switch");
+        sim.switch_to(deep_pair, triple);
+        require(sim.corrector.correction == 5 * kPeriod, "back to 3X uses what was learned there");
+        require(sim.run(triple, 100, 90) == 90, "3X exact after switching back");
+        sim.switch_to(triple, shallow_pair);
+        require(sim.run(shallow_pair, 300, 100) == 100, "shallow 2X learned by measurement");
+        require(sim.corrector.correction == 2 * kPeriod, "shallow 2X at two periods");
+    }
+    {
+        // Small jitter (well under half a period) still converges to the grid.
+        TellSimulation sim;
+        sim.jitter = 300'000;
+        sim.run(triple, 300, 0);
+        require(sim.corrector.correction == 5 * kPeriod, "jitter tolerated");
+    }
+    {
+        // Frames that disagree about where they land teach nothing.
+        DisplayTimeCorrector corrector;
+        for (int i = 0; i < 300; ++i) {
+            observe_presented(corrector, (i % 2) ? 5 * kPeriod : 0, kPeriod);
+        }
+        require(corrector.correction == 0, "a spread window does not move the correction");
+    }
+    {
+        // Never earlier than the presenter's own anchor, never beyond the cap.
+        DisplayTimeCorrector corrector;
+        for (int i = 0; i < 300; ++i) {
+            observe_presented(corrector, -3 * kPeriod, kPeriod);
+        }
+        require(corrector.correction == 0, "correction is not negative");
+        for (int i = 0; i < 3000; ++i) {
+            observe_presented(corrector, 40 * kPeriod, kPeriod);
+        }
+        require(corrector.correction == DisplayTimeCorrector::kMaxPeriods * kPeriod, "correction capped");
+        require(observe_presented(corrector, 0, 0).window_closed == false, "no period, no observation");
+    }
+    {
+        // One stray window is not enough to move it.
+        DisplayTimeCorrector corrector;
+        for (std::size_t i = 0; i < DisplayTimeCorrector::kWindowSamples; ++i) {
+            observe_presented(corrector, 2 * kPeriod, kPeriod);
+        }
+        require(corrector.correction == 0 && corrector.pending_step == 2, "first window only proposes");
+        for (std::size_t i = 0; i < DisplayTimeCorrector::kWindowSamples; ++i) {
+            observe_presented(corrector, 0, kPeriod);
+        }
+        require(corrector.correction == 0 && corrector.pending_step == 0, "a settled window cancels it");
+    }
+}
+
+// ---------------------------------------------------------------------------
+// Adaptive 2X/3X. Samples at the application's paced rate.
+
+struct AdaptiveRun {
+    Nanoseconds switched_at{-1};
+    std::uint32_t target{};
+    AdaptiveDecision decision;
+};
+
+// Feeds `seconds` of frames with a constant work time and asks for a decision
+// each frame; stops at the first switch, which it applies.
+AdaptiveRun drive(AdaptiveFrameGenController& controller, Nanoseconds& now, Nanoseconds seconds,
+    Nanoseconds work, std::uint32_t late_every = 0) {
+    AdaptiveRun run{};
+    const Nanoseconds frame = kPeriod * controller.mode();
+    const Nanoseconds end = now + seconds;
+    std::uint32_t index = 0;
+    while (now < end) {
+        now += frame;
+        controller.add_work(now, work);
+        if (late_every != 0 && ++index % late_every == 0) {
+            controller.add_late(now);
+        }
+        const auto decision = controller.evaluate(now, kPeriod);
+        if (decision.target != 0) {
+            run.switched_at = now;
+            run.target = decision.target;
+            run.decision = decision;
+            controller.switched(decision.target, now);
+            return run;
+        }
+    }
+    return run;
+}
+
+void adaptive_tests() {
+    const Nanoseconds start = 50 * kSecond;
+    {
+        // DCS in 3X, paced to 30 but needing 15 ms: room for 45 with margin.
+        AdaptiveFrameGenController controller;
+        controller.start(3, start);
+        Nanoseconds now = start;
+        const auto run = drive(controller, now, 20 * kSecond, 15 * kMillisecond);
+        require(run.target == 2 && run.decision.reason == AdaptiveReason::headroom, "3X -> 2X on headroom");
+        require(run.switched_at - start >= 5 * kSecond, "not within the minimum dwell");
+        require(run.switched_at - start <= 5 * kSecond + 2 * kPeriod * 3, "as soon as dwell and window allow");
+        require(run.decision.stats.p90 == 15 * kMillisecond && run.decision.stats.samples >= 20, "stats reported");
+        require(controller.mode() == 2, "controller follows the switch");
+    }
+    {
+        // 20 ms is over 85% of two periods (18.9 ms): stays in 3X.
+        AdaptiveFrameGenController controller;
+        controller.start(3, start);
+        Nanoseconds now = start;
+        require(drive(controller, now, 60 * kSecond, 20 * kMillisecond).target == 0, "no downshift without margin");
+    }
+    {
+        // Headroom, but its first synthetics are late now and then: stays.
+        AdaptiveFrameGenController controller;
+        controller.start(3, start);
+        Nanoseconds now = start;
+        require(drive(controller, now, 60 * kSecond, 12 * kMillisecond, 60).target == 0,
+            "missed slots block a downshift");
+    }
+    {
+        // A p90 is a p90: one slow frame in ten does not block it.
+        AdaptiveFrameGenController controller;
+        controller.start(3, start);
+        for (int i = 0; i < 9; ++i) controller.add_work(start + 2 * kSecond + i, 10 * kMillisecond);
+        controller.add_work(start + 2 * kSecond + 9, 30 * kMillisecond);
+        const auto stats = controller.stats(start + 3 * kSecond, 3 * kSecond);
+        require(stats.samples == 10 && stats.p90 == 10 * kMillisecond, "nearest-rank p90");
+        // Samples inside the settle after a start are not counted.
+        controller.add_work(start + kSecond / 2, 50 * kMillisecond);
+        require(controller.stats(start + 3 * kSecond, 3 * kSecond).samples == 10, "settle ignored");
+    }
+    {
+        // In 2X: slow frames send it back to 3X quickly, but never within
+        // the dwell of the downshift.
+        AdaptiveFrameGenController controller;
+        controller.start(3, start);
+        Nanoseconds now = start;
+        const auto down = drive(controller, now, 20 * kSecond, 15 * kMillisecond);
+        require(down.target == 2, "downshift first");
+        const auto up = drive(controller, now, 20 * kSecond, 26 * kMillisecond);
+        require(up.target == 3 && up.decision.reason == AdaptiveReason::slow, "2X -> 3X when p90 > two periods");
+        require(up.switched_at - down.switched_at >= 5 * kSecond, "upshift respects the dwell");
+        require(up.switched_at - down.switched_at <= 5 * kSecond + kSecond, "and is quick after it");
+        // That was a flap: the next downshift needs twice the evidence.
+        require(controller.downshift_window() == 6 * kSecond, "flap doubles the downshift window");
+        const auto again = drive(controller, now, 30 * kSecond, 15 * kMillisecond);
+        require(again.target == 2 && again.switched_at - up.switched_at >= 7 * kSecond,
+            "second downshift waits for the longer window");
+    }
+    {
+        // In 2X: missed slots send it back even when the work looks fine.
+        AdaptiveFrameGenController controller;
+        controller.start(2, start);
+        Nanoseconds now = start;
+        const auto up = drive(controller, now, 20 * kSecond, 10 * kMillisecond, 10);
+        require(up.target == 3 && up.decision.reason == AdaptiveReason::late, "2X -> 3X on missed slots");
+        require(up.switched_at - start >= 5 * kSecond && up.switched_at - start < 6 * kSecond, "after the dwell");
+    }
+    {
+        // A downshift that holds for longer than the flap window resets the
+        // evidence needed for the next one.
+        AdaptiveFrameGenController controller;
+        controller.start(3, start);
+        Nanoseconds now = start;
+        drive(controller, now, 20 * kSecond, 15 * kMillisecond);
+        drive(controller, now, 30 * kSecond, 15 * kMillisecond); // stays in 2X
+        const auto up = drive(controller, now, 10 * kSecond, 30 * kMillisecond);
+        require(up.target == 3, "upshift");
+        require(controller.downshift_window() == 3 * kSecond, "no flap, base window");
+    }
+    {
+        // Steady 2X with margin stays there.
+        AdaptiveFrameGenController controller;
+        controller.start(2, start);
+        Nanoseconds now = start;
+        require(drive(controller, now, 60 * kSecond, 16 * kMillisecond).target == 0, "2X holds");
+        require(controller.evaluate(now, 0).target == 0, "no period, no decision");
+    }
+}
+
+} // namespace
+
+int main() {
+    try {
+        triple_release_tests();
+        display_time_tests();
+        adaptive_tests();
+        std::cout << "Latency control tests passed\n";
+        return 0;
+    } catch (const std::exception& error) {
+        std::cerr << error.what() << '\n';
+        return 1;
+    }
+}
diff --git a/tests/layer_adaptive_frame_gen.cmake b/tests/layer_adaptive_frame_gen.cmake
new file mode 100644
index 0000000..61189fb
--- /dev/null
+++ b/tests/layer_adaptive_frame_gen.cmake
@@ -0,0 +1,65 @@
+# DCS VR Control: runs the dcs-adaptive call-chain scenario with
+# `adaptive_frame_gen=1` (ADAPTIVE_INI beside the layer DLL) and checks, from
+# the flight log, that adaptive control took the session 3X -> 2X on headroom
+# and 2X -> 3X when the application turned heavy, through the live switch,
+# with the status and display time records a flight log is read by.
+foreach(required_variable IN ITEMS LAYER_DLL CALL_CHAIN ADAPTIVE_INI WORK_DIR)
+    if(NOT DEFINED ${required_variable})
+        message(FATAL_ERROR "${required_variable} was not provided")
+    endif()
+endforeach()
+
+file(REMOVE_RECURSE "${WORK_DIR}")
+file(MAKE_DIRECTORY "${WORK_DIR}")
+file(COPY "${LAYER_DLL}" DESTINATION "${WORK_DIR}")
+file(COPY "${ADAPTIVE_INI}" DESTINATION "${WORK_DIR}")
+get_filename_component(adaptive_ini_name "${ADAPTIVE_INI}" NAME)
+file(RENAME "${WORK_DIR}/${adaptive_ini_name}" "${WORK_DIR}/ofxr_bridge.ini")
+
+get_filename_component(layer_name "${LAYER_DLL}" NAME)
+execute_process(
+    COMMAND "${CALL_CHAIN}"
+        "${WORK_DIR}/${layer_name}"
