diff --git a/src/core/latency_control.cpp b/src/core/latency_control.cpp
new file mode 100644
index 0000000..94ad824
--- /dev/null
+++ b/src/core/latency_control.cpp
@@ -0,0 +1,285 @@
+#include "xrfg/latency_control.hpp"
+
+#include <algorithm>
+#include <cmath>
+
+namespace xrfg::latency {
+namespace {
+
+// Rounds to the nearest whole number of periods, halves away from zero.
+[[nodiscard]] Nanoseconds round_periods(Nanoseconds value, Nanoseconds period) noexcept {
+    if (period <= 0) {
+        return 0;
+    }
+    const Nanoseconds half = period / 2;
+    return value >= 0 ? (value + half) / period : -((-value + half) / period);
+}
+
+} // namespace
+
+TripleReleaseWindow observe_triple_release(
+    TripleReleaseTuner& tuner, Nanoseconds period, bool late) noexcept {
+    TripleReleaseWindow report{};
+    if (period <= 0) {
+        return report;
+    }
+    if (late) {
+        ++tuner.window_late;
+    }
+    if (++tuner.window_frames < TripleReleaseTuner::kWindowFrames) {
+        return report;
+    }
+    const std::uint32_t late_count = tuner.window_late;
+    const std::uint32_t unwritten = tuner.window_unwritten;
+    tuner.window_frames = 0;
+    tuner.window_late = 0;
+    tuner.window_unwritten = 0;
+    auto& delay = tuner.delay;
+    auto& ceiling = tuner.ceiling;
+    if (ceiling < 0) {
+        ceiling = period * 2;
+    }
+    if (late_count >= 2) {
+        // Only a delay can be blamed. Frames that are late with none applied
+        // are the title's own and say nothing about where the ceiling goes.
+        if (delay > 0) {
+            tuner.last_failure = delay;
+            ceiling = std::max<Nanoseconds>(0, delay - TripleReleaseTuner::kBackoffStep);
+            delay = ceiling;
+            tuner.hold = tuner.backoff;
+            tuner.backoff = std::min(
+                tuner.backoff * 2, TripleReleaseTuner::kMaxHoldWindows);
+        }
+    } else if (late_count == 0) {
+        if (tuner.last_failure >= 0 && delay >= tuner.last_failure) {
+            // On time where it failed before: the room has grown.
+            tuner.backoff = TripleReleaseTuner::kBaseHoldWindows;
+            tuner.last_failure = -1;
+        }
+        if (delay < ceiling) {
+            delay = std::min(ceiling, delay + TripleReleaseTuner::kRaiseStep);
+        } else if (tuner.hold > 0) {
+            --tuner.hold;
+        } else {
+            // Also from a zero ceiling: being pushed all the way down once
+            // must not cost the rest of the session.
+            ceiling = std::min(period * 2, ceiling + TripleReleaseTuner::kRaiseStep);
+            delay = ceiling;
+        }
+    }
+    report.closed = true;
+    report.delay = delay;
+    report.ceiling = ceiling;
+    report.late = late_count;
+    report.unwritten = unwritten;
+    report.hold = tuner.hold;
+    return report;
+}
+
+std::size_t display_time_mode(
+    std::uint32_t frames_per_application_frame, bool deep_pipeline) noexcept {
+    if (frames_per_application_frame > 2) {
+        return 2;
+    }
+    return deep_pipeline ? 1 : 0;
+}
+
+DisplayTimeStep observe_presented(
+    DisplayTimeCorrector& corrector,
+    Nanoseconds residual,
+    Nanoseconds period) noexcept {
+    DisplayTimeStep step{};
+    step.before = corrector.correction;
+    step.after = corrector.correction;
+    if (period <= 0) {
+        return step;
+    }
+    if (corrector.skip > 0) {
+        --corrector.skip;
+        return step;
+    }
+    corrector.window[corrector.count++] = residual;
+    if (corrector.count < corrector.window.size()) {
+        return step;
+    }
+    auto sorted = corrector.window;
+    std::sort(sorted.begin(), sorted.end());
+    corrector.count = 0;
+    const std::size_t n = sorted.size();
+    step.window_closed = true;
+    step.median = sorted[n / 2];
+    step.spread = sorted[(n * 9) / 10] - sorted[n / 10];
+    if (step.spread > period / 2) {
+        // The frames do not agree on where they land: a stall, a menu, a
+        // switch. Nothing to learn from this window.
+        corrector.pending_step = 0;
+        return step;
+    }
+    const Nanoseconds periods = round_periods(step.median, period);
+    if (periods == 0) {
+        corrector.pending_step = 0;
+        corrector.learned[corrector.mode] = corrector.correction;
+        return step;
+    }
+    if (corrector.pending_step != periods) {
+        // Once is not enough: the next window has to ask for the same step.
+        corrector.pending_step = periods;
+        return step;
+    }
+    corrector.pending_step = 0;
+    const Nanoseconds moved = std::clamp(
+        corrector.correction + periods * period,
+        Nanoseconds{0},
+        DisplayTimeCorrector::kMaxPeriods * period);
+    if (moved != corrector.correction) {
+        corrector.correction = moved;
+        corrector.skip = DisplayTimeCorrector::kSettleSamples;
+        step.changed = true;
+    }
+    step.after = corrector.correction;
+    return step;
+}
+
+Nanoseconds rebase_display_time_correction(
+    DisplayTimeCorrector& corrector,
+    std::size_t new_mode,
+    Nanoseconds old_virtual_period,
+    Nanoseconds new_virtual_period,
+    Nanoseconds period) noexcept {
+    new_mode = std::min(new_mode, DisplayTimeCorrector::kModes - 1);
+    if (corrector.learned[new_mode] >= 0) {
+        corrector.correction = corrector.learned[new_mode];
+    } else if (old_virtual_period > 0 && new_virtual_period > 0 && period > 0) {
+        // Whatever the application adds by pipelining its own frames scales
+        // with its period; whole periods either way.
+        const long double scaled =
+            static_cast<long double>(corrector.correction) *
+            static_cast<long double>(new_virtual_period) /
+            static_cast<long double>(old_virtual_period);
+        const Nanoseconds periods = static_cast<Nanoseconds>(
+            std::llround(scaled / static_cast<long double>(period)));
+        corrector.correction = std::clamp(
+            periods * period, Nanoseconds{0},
+            DisplayTimeCorrector::kMaxPeriods * period);
+    }
+    corrector.mode = new_mode;
+    corrector.count = 0;
+    corrector.pending_step = 0;
+    corrector.skip = DisplayTimeCorrector::kSettleSamples;
+    return corrector.correction;
+}
+
+AdaptiveFrameGenController::AdaptiveFrameGenController(AdaptiveConfig config) noexcept
+    : config_(config), downshift_window_(config.downshift_window) {}
+
+void AdaptiveFrameGenController::start(std::uint32_t mode, Nanoseconds now) noexcept {
+    mode_ = mode > 2 ? 3U : 2U;
+    last_switch_ = now;
+    last_downshift_ = -1;
+    downshift_window_ = config_.downshift_window;
+    work_count_ = 0;
+    work_next_ = 0;
+    late_count_ = 0;
+    late_next_ = 0;
+}
+
+void AdaptiveFrameGenController::add_work(Nanoseconds at, Nanoseconds work) noexcept {
+    if (work < 0) {
+        return;
+    }
+    work_at_[work_next_] = at;
+    work_[work_next_] = work;
+    work_next_ = (work_next_ + 1) % kWorkSamples;
+    work_count_ = std::min(work_count_ + 1, kWorkSamples);
+}
+
+void AdaptiveFrameGenController::add_late(Nanoseconds at, std::uint32_t count) noexcept {
+    for (std::uint32_t index = 0; index < count; ++index) {
+        late_at_[late_next_] = at;
+        late_next_ = (late_next_ + 1) % kLateEvents;
+        late_count_ = std::min(late_count_ + 1, kLateEvents);
+    }
+}
+
+AdaptiveStats AdaptiveFrameGenController::stats(
+    Nanoseconds now, Nanoseconds span) const noexcept {
+    AdaptiveStats result{};
+    const Nanoseconds from = std::max(now - span, last_switch_ + config_.settle);
+    std::array<Nanoseconds, kWorkSamples> values{};
+    std::size_t n = 0;
+    for (std::size_t index = 0; index < work_count_; ++index) {
+        if (work_at_[index] > from && work_at_[index] <= now) {
+            values[n++] = work_[index];
+        }
+    }
+    for (std::size_t index = 0; index < late_count_; ++index) {
+        if (late_at_[index] > from && late_at_[index] <= now) {
+            ++result.late;
+        }
+    }
+    result.samples = static_cast<std::uint32_t>(n);
+    if (n > 0) {
+        std::sort(values.begin(), values.begin() + static_cast<std::ptrdiff_t>(n));
+        // Nearest rank.
+        const std::size_t rank = (n * 9 + 9) / 10; // ceil(0.9 n)
+        result.p90 = values[std::max<std::size_t>(rank, 1) - 1];
+    }
+    return result;
+}
+
+AdaptiveDecision AdaptiveFrameGenController::evaluate(
+    Nanoseconds now, Nanoseconds period) const noexcept {
+    AdaptiveDecision decision{};
+    if (period <= 0) {
+        return decision;
+    }
+    const Nanoseconds two_periods = period * 2;
+    if (mode_ > 2) {
+        decision.threshold = static_cast<Nanoseconds>(
+            config_.downshift_fraction * static_cast<double>(two_periods));
+        decision.stats = stats(now, downshift_window_);
+        if (now - last_switch_ < config_.min_dwell ||
+            now - (last_switch_ + config_.settle) < downshift_window_) {
+            return decision;
+        }
+        if (decision.stats.samples >= config_.min_samples_down &&
+            decision.stats.late == 0 &&
+            decision.stats.p90 <= decision.threshold) {
+            decision.target = 2;
+            decision.reason = AdaptiveReason::headroom;
+        }
+        return decision;
+    }
+    decision.threshold = two_periods;
+    decision.stats = stats(now, config_.upshift_window);
+    if (now - last_switch_ < config_.min_dwell) {
+        return decision;
+    }
+    if (decision.stats.late >= config_.upshift_late_events) {
+        decision.target = 3;
+        decision.reason = AdaptiveReason::late;
+    } else if (decision.stats.samples >= config_.min_samples_up &&
+               decision.stats.p90 > two_periods) {
+        decision.target = 3;
+        decision.reason = AdaptiveReason::slow;
+    }
+    return decision;
+}
+
+void AdaptiveFrameGenController::switched(std::uint32_t to, Nanoseconds now) noexcept {
+    to = to > 2 ? 3U : 2U;
+    if (to == 2 && mode_ > 2) {
+        last_downshift_ = now;
+    } else if (to == 3 && mode_ == 2) {
+        if (last_downshift_ >= 0 && now - last_downshift_ < config_.flap_window) {
+            downshift_window_ = std::min(
+                downshift_window_ * 2, config_.max_downshift_window);
+        } else {
+            downshift_window_ = config_.downshift_window;
+        }
+    }
+    mode_ = to;
+    last_switch_ = now;
+}
