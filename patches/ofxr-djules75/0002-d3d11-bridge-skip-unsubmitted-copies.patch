+// A bridged D3D11 session: tells every bridged swapchain whether this frame
+// names it, before anything of the frame goes downstream. A swapchain that
+// had stopped copying and is named again gets its last released image copied
+// here, on the session's queue; the release mark that follows puts that copy
+// ahead of the binding queue's join for this frame, as a copy at release
+// would have been. Called before app_end_frame_release_value is taken.
+void note_bridged_submissions(
+    const std::shared_ptr<SessionState>& state,
+    const XrFrameEndInfo* end_info) noexcept {
+    try {
+        if (!state->d3d11_bridge) {
+            return;
+        }
+        std::vector<XrSwapchain> named;
+        const bool complete = collect_named_swapchains(end_info, &named);
+        bool caught_up = false;
+        bool restart_continuity = false;
+        for (const auto& swapchain_state : find_swapchains(state)) {
+            std::shared_ptr<xrfg::D3D11BridgeSwapchain> bridge;
+            {
+                std::scoped_lock lock(swapchain_state->mutex);
+                bridge = swapchain_state->bridge;
+            }
+            if (!bridge) {
+                continue;
+            }
+            const bool submitted = !complete ||
+                std::find(named.begin(), named.end(), swapchain_state->handle) != named.end();
+            const bool copied_before = bridge->copies_on_release();
+            const HRESULT result = bridge->frame_ended(submitted);
+            const bool copies_now = bridge->copies_on_release();
+            if (copies_now && !copied_before) {
+                // Back after skipping: its releases were not captured, so a
+                // generator that ran on it holds history from before the gap.
+                // Start over, as after any break in the sequence: this frame
+                // passes through (no capture) or primes, the next pairs.
+                std::scoped_lock lock(swapchain_state->mutex);
+                restart_continuity = restart_continuity ||
+                    swapchain_state->frame_generation != nullptr;
+            }
+            if (copies_now != copied_before) {
+                // 5: the swapchain's release copies stopped (c = 0) or
+                // resumed (c = 1).
+                xrfg::bridge_flight_logger().event(
+                    xrfg::BridgeFlightOperation::d3d11_bridge,
+                    5,
+                    handle_value(swapchain_state->handle),
+                    0,
+                    copies_now ? 1U : 0U);
+            }
+            if (result == S_FALSE) {
+                caught_up = true;
+            } else if (FAILED(result)) {
+                xrfg::bridge_flight_logger().event(
+                    xrfg::BridgeFlightOperation::d3d11_bridge,
+                    4,
+                    handle_value(swapchain_state->handle),
+                    0,
+                    static_cast<std::uint64_t>(static_cast<std::uint32_t>(result)));
+            }
+        }
+        if (caught_up) {
+            mark_application_release(state.get());
+        }
+        if (restart_continuity) {
+            clear_generation_continuity(state);
+        }
+    } catch (...) {
+    }
+}
