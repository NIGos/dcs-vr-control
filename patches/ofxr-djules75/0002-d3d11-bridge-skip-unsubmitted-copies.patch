+// Copies into the runtime's images for a swapchain no frame names: DCS
+// through Quad Views releases four quad-view swapchains every frame that
+// only the layer above reads. The bridge stops copying them after
+// kUnsubmittedFramesBeforeSkip frames, and a frame that names one again gets
+// the image released last copied before it goes down, after which the
+// swapchain copies for good.
+struct UnsubmittedFixture {
+    std::array<ComPtr<ID3D12Resource>, 3> runtime;
+    xrfg::D3D11BridgeSwapchain bridge;
+};
+
+[[nodiscard]] bool create_unsubmitted_fixture(
+    const Devices& devices, UnsubmittedFixture* fixture, const char* name) {
+    std::vector<ID3D12Resource*> images;
+    for (auto& image : fixture->runtime) {
+        image = create_runtime_image(devices.d3d12.Get(), DXGI_FORMAT_R8G8B8A8_UNORM, false, 1);
+        if (!image) {
+            expect(false, name);
+            return false;
+        }
+        images.push_back(image.Get());
+    }
+    xrfg::D3D11BridgeSwapchainDescription requested{};
+    requested.requested_format = DXGI_FORMAT_R8G8B8A8_UNORM;
+    requested.requested_sample_count = 1;
+    std::uint32_t stage = 0;
+    const HRESULT init = fixture->bridge.initialize(
+        devices.d3d11.Get(), devices.context.Get(), devices.d3d12.Get(),
+        devices.queue.Get(), images, requested, &stage);
+    expect(SUCCEEDED(init), name);
+    return SUCCEEDED(init);
+}
