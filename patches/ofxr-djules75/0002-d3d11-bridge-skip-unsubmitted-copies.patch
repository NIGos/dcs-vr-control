+// The swapchains an application's frame names, for the D3D11 bridge's
+// release copies (D3D11BridgeSwapchain::release). Returns false when the
+// frame carries anything this layer cannot see every swapchain of - a layer
+// type or chained structure it does not know - and the caller then treats
+// every swapchain as named, which keeps every copy.
+[[nodiscard]] bool collect_named_swapchains(
+    const XrFrameEndInfo* end_info,
+    std::vector<XrSwapchain>* named) {
+    if (end_info == nullptr || end_info->type != XR_TYPE_FRAME_END_INFO ||
+        end_info->next != nullptr ||
+        (end_info->layerCount != 0 && end_info->layers == nullptr)) {
+        return false;
+    }
+    for (std::uint32_t layer_index = 0; layer_index < end_info->layerCount; ++layer_index) {
+        const XrCompositionLayerBaseHeader* const layer = end_info->layers[layer_index];
+        if (layer == nullptr) {
+            continue;
+        }
+        if (layer->next != nullptr) {
+            return false;
+        }
+        switch (layer->type) {
+            case XR_TYPE_COMPOSITION_LAYER_PROJECTION: {
+                const auto* projection =
+                    reinterpret_cast<const XrCompositionLayerProjection*>(layer);
+                if (projection->viewCount != 0 && projection->views == nullptr) {
+                    return false;
+                }
+                for (std::uint32_t view_index = 0; view_index < projection->viewCount;
+                     ++view_index) {
+                    const XrCompositionLayerProjectionView& view =
+                        projection->views[view_index];
+                    named->push_back(view.subImage.swapchain);
+                    for (const auto* next = static_cast<const XrBaseInStructure*>(view.next);
+                         next != nullptr; next = next->next) {
+                        if (next->type != XR_TYPE_COMPOSITION_LAYER_DEPTH_INFO_KHR) {
+                            return false;
+                        }
+                        named->push_back(
+                            reinterpret_cast<const XrCompositionLayerDepthInfoKHR*>(next)
+                                ->subImage.swapchain);
+                    }
+                }
+                break;
+            }
+            case XR_TYPE_COMPOSITION_LAYER_QUAD:
+                named->push_back(
+                    reinterpret_cast<const XrCompositionLayerQuad*>(layer)->subImage.swapchain);
+                break;
+            case XR_TYPE_COMPOSITION_LAYER_CYLINDER_KHR:
+                named->push_back(reinterpret_cast<const XrCompositionLayerCylinderKHR*>(layer)
+                                     ->subImage.swapchain);
+                break;
+            case XR_TYPE_COMPOSITION_LAYER_EQUIRECT_KHR:
+                named->push_back(reinterpret_cast<const XrCompositionLayerEquirectKHR*>(layer)
+                                     ->subImage.swapchain);
+                break;
+            case XR_TYPE_COMPOSITION_LAYER_EQUIRECT2_KHR:
+                named->push_back(reinterpret_cast<const XrCompositionLayerEquirect2KHR*>(layer)
+                                     ->subImage.swapchain);
+                break;
+            case XR_TYPE_COMPOSITION_LAYER_CUBE_KHR:
+                named->push_back(
+                    reinterpret_cast<const XrCompositionLayerCubeKHR*>(layer)->swapchain);
+                break;
+            default:
+                return false;
+        }
+    }
+    return true;
