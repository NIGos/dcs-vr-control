+void test_unsubmitted_skip(const Devices& devices) {
+    UnsubmittedFixture fixture;
+    if (!create_unsubmitted_fixture(devices, &fixture, "unsubmitted: bridge initialised")) {
+        return;
+    }
+    xrfg::D3D11BridgeSwapchain& bridge = fixture.bridge;
+    constexpr std::uint32_t threshold = xrfg::D3D11BridgeSwapchain::kUnsubmittedFramesBeforeSkip;
+    // Frames that release nothing never count towards skipping.
+    for (std::uint32_t frame = 0; frame < threshold * 2; ++frame) {
+        expect(SUCCEEDED(bridge.frame_ended(false)), "unsubmitted: idle frame_ended");
+    }
+    expect(bridge.copies_on_release(), "unsubmitted: frames without releases do not count");
+
+    std::uint32_t frame = 0;
+    std::uint32_t index = 0;
+    std::uint8_t red = 0;
+    // Up to the threshold every release still copies.
+    bool copied_every_frame = true;
+    for (; frame < threshold; ++frame) {
+        index = frame % 3;
+        red = static_cast<std::uint8_t>(10 + frame);
+        expect(bridge.copies_on_release(), "unsubmitted: copies before the threshold");
+        HRESULT released = E_FAIL;
+        expect(render_and_release(devices, bridge, index, red, &released), "unsubmitted: release");
+        expect(released == S_OK, "unsubmitted: a copying release returns S_OK");
+        expect(SUCCEEDED(bridge.wait_for_idle()), "unsubmitted: idle");
+        copied_every_frame = copied_every_frame &&
+            runtime_red(devices, fixture.runtime[index].Get()) == red;
+        expect(SUCCEEDED(bridge.frame_ended(false)), "unsubmitted: frame_ended");
+    }
+    expect(copied_every_frame, "unsubmitted: every release before the threshold reached the runtime");
+    expect(!bridge.copies_on_release(), "unsubmitted: copies stop at the threshold");
+
+    // Skipping: the runtime's image keeps its old content.
+    for (std::uint32_t skipped = 0; skipped < 4; ++skipped, ++frame) {
+        index = frame % 3;
+        red = static_cast<std::uint8_t>(10 + frame);
+        // S_FALSE tells the layer to queue no read of the shared texture
+        // (no history capture) after it.
+        HRESULT released = E_FAIL;
+        expect(render_and_release(devices, bridge, index, red, &released),
+            "unsubmitted: skipped release");
+        expect(released == S_FALSE, "unsubmitted: a skipped release returns S_FALSE");
+        expect(SUCCEEDED(bridge.frame_ended(false)), "unsubmitted: skipped frame_ended");
+    }
+    expect(SUCCEEDED(bridge.wait_for_idle()), "unsubmitted: idle after skipping");
+    expect(runtime_red(devices, fixture.runtime[index].Get()) != red,
+        "unsubmitted: a skipped release leaves the runtime's image alone");
+
+    // Named again: the last released image is caught up before the frame
+    // goes down, and from then on every release copies.
+    expect(bridge.frame_ended(true) == S_FALSE, "unsubmitted: catch-up copy queued");
+    expect(SUCCEEDED(bridge.wait_for_idle()), "unsubmitted: idle after catch-up");
+    expect(runtime_red(devices, fixture.runtime[index].Get()) == red,
+        "unsubmitted: the catch-up copy holds the last released image");
+    expect(bridge.copies_on_release(), "unsubmitted: copies resume once named");
+    copied_every_frame = true;
+    for (std::uint32_t pinned = 0; pinned < threshold * 2; ++pinned, ++frame) {
+        index = frame % 3;
+        red = static_cast<std::uint8_t>(10 + frame);
+        HRESULT released = E_FAIL;
+        expect(render_and_release(devices, bridge, index, red, &released), "unsubmitted: pinned release");
+        expect(released == S_OK, "unsubmitted: a pinned release copies");
+        expect(SUCCEEDED(bridge.wait_for_idle()), "unsubmitted: pinned idle");
+        copied_every_frame = copied_every_frame &&
+            runtime_red(devices, fixture.runtime[index].Get()) == red;
+        expect(bridge.frame_ended(false) == S_OK, "unsubmitted: pinned frame_ended");
+    }
+    expect(copied_every_frame && bridge.copies_on_release(),
+        "unsubmitted: a swapchain named after skipping copies for good");
+}
