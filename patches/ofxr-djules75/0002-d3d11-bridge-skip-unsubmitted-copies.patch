+// Paints image `index` with `red` and releases it, as an application frame.
+// `release_result` receives what the release returned (S_FALSE: skipped).
+[[nodiscard]] bool render_and_release(
+    const Devices& devices, xrfg::D3D11BridgeSwapchain& bridge,
+    std::uint32_t index, std::uint8_t red, HRESULT* release_result = nullptr) {
+    std::vector<std::uint8_t> pixels(8 * 8 * 4, 0);
+    for (std::size_t offset = 0; offset < pixels.size(); offset += 4) {
+        pixels[offset] = red;
+        pixels[offset + 3] = 255;
+    }
+    if (FAILED(bridge.before_write(index))) return false;
+    devices.context->UpdateSubresource(
+        bridge.d3d11_images()[index], 0, nullptr, pixels.data(), 8 * 4, 0);
+    const HRESULT released = bridge.release(index);
+    if (release_result != nullptr) *release_result = released;
+    return SUCCEEDED(released) && SUCCEEDED(bridge.mark_read(index));
+}
+
+[[nodiscard]] int runtime_red(const Devices& devices, ID3D12Resource* image) {
+    std::vector<std::uint8_t> bytes;
+    UINT pitch = 0;
+    if (!read_back(devices, image, false, &bytes, &pitch) || bytes.empty()) {
+        return -1;
+    }
+    return bytes[0];
+}
