+void SubmissionTally::add(
+    SubmissionKind kind, Nanoseconds wait_to_submit, Nanoseconds threshold) noexcept {
+    const auto index = static_cast<std::size_t>(kind);
+    if (index >= kSubmissionKinds) {
+        return;
+    }
+    ++frames[index];
+    if (submission_late(wait_to_submit, threshold)) {
+        ++late[index];
+    }
+    worst = std::max(worst, wait_to_submit);
+    if (kind == SubmissionKind::gen1) {
+        worst_gen1 = std::max(worst_gen1, wait_to_submit);
+    }
+}
+
+Nanoseconds lead_slack_with_lateness(
+    Nanoseconds written_slack,
+    Nanoseconds wait_to_submit,
+    Nanoseconds threshold) noexcept {
+    if (!submission_late(wait_to_submit, threshold)) {
+        return written_slack;
+    }
+    return std::min(written_slack, threshold - wait_to_submit);
+}
+
+LateFrameSkipController::LateFrameSkipController(LateSkipConfig config) noexcept
+    : config_(config), dwell_(config.min_dwell) {
+    if (config_.window_frames == 0) {
+        config_.window_frames = 1;
+    }
+}
+
+void LateFrameSkipController::reset() noexcept {
+    active_ = false;
+    window_frames_ = 0;
+    window_late_ = 0;
+    window_ready_ = 0;
+    good_windows_ = 0;
+    entered_at_ = 0;
+    left_at_ = -1;
+    dwell_ = config_.min_dwell;
+}
+
+LateSkipStep LateFrameSkipController::observe_leader(
+    Nanoseconds now, bool late) noexcept {
+    if (active_) {
+        // A first synthetic made while the skip is on (a frame prepared just
+        // before it engaged) says nothing about the skip.
+        return {};
+    }
+    window_late_ += late ? 1U : 0U;
+    if (++window_frames_ < config_.window_frames) {
+        return {};
+    }
+    return close_window(now);
+}
+
+LateSkipStep LateFrameSkipController::observe_skipped(
+    Nanoseconds now, bool would_be_ready) noexcept {
+    if (!active_) {
+        return {};
+    }
+    window_ready_ += would_be_ready ? 1U : 0U;
+    if (++window_frames_ < config_.window_frames) {
+        return {};
+    }
+    return close_window(now);
+}
+
+LateSkipStep LateFrameSkipController::close_window(Nanoseconds now) noexcept {
+    LateSkipStep step{};
+    step.window_closed = true;
+    step.window_late = window_late_;
+    step.window_ready = window_ready_;
+    window_frames_ = 0;
+    window_late_ = 0;
+    window_ready_ = 0;
+    if (!active_) {
+        if (step.window_late >= config_.enter_late) {
+            // Back within the flap window of leaving: the room it left on
+            // did not last, so it stays longer this time.
+            if (left_at_ >= 0 && now - left_at_ < config_.flap_window) {
+                dwell_ = std::min(dwell_ * 2, config_.max_dwell);
+            } else {
+                dwell_ = config_.min_dwell;
+            }
+            active_ = true;
+            entered_at_ = now;
+            good_windows_ = 0;
+            step.transition = LateSkipTransition::entered;
+        }
+    } else {
+        good_windows_ = step.window_ready >= config_.exit_ready
+            ? good_windows_ + 1
+            : 0;
+        if (good_windows_ >= config_.exit_windows &&
+            now - entered_at_ >= dwell_) {
+            active_ = false;
+            left_at_ = now;
+            good_windows_ = 0;
+            step.transition = LateSkipTransition::left;
+        }
+    }
+    step.dwell = dwell_;
+    return step;
+}
+
+SynthesisGpuSplit split_synthesis_gpu_time(
+    std::uint64_t pack_microseconds,
+    std::uint64_t eye0_microseconds,
+    std::uint64_t eye1_microseconds,
+    std::uint64_t composition_microseconds,
+    std::uint64_t total_microseconds) noexcept {
+    SynthesisGpuSplit split{};
+    const std::uint64_t staged = pack_microseconds + composition_microseconds;
+    const std::uint64_t waits = eye0_microseconds + eye1_microseconds;
+    if (staged == 0 && waits == 0) {
+        split.shader = static_cast<Nanoseconds>(total_microseconds) * 1000;
+        return split;
+    }
+    split.shader = static_cast<Nanoseconds>(staged) * 1000;
+    split.optical_flow_wait = static_cast<Nanoseconds>(waits) * 1000;
+    return split;
+}
