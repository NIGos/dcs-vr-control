+    endif()
+endforeach()
+string(REGEX MATCHALL "op=d3d11_bridge result=7 dur_us=0 a=${named_handle} b=0 c=1" deferrals "${contents}")
+list(LENGTH deferrals deferral_count)
+if(deferral_count LESS 2)
+    message(FATAL_ERROR "Release copies were deferred ${deferral_count} times, expected again after the fall-back")
+endif()
+message(STATUS "Lazy history and deferred bridge copies verified")
