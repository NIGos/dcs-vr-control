+// ---------------------------------------------------------------------------
+// DCS VR Control (0006): late submissions, the late-frame skip, and the
+// synthesis GPU split.
+
+void late_submission_tests() {
+    {
+        // The threshold is exclusive and configurable.
+        require(!submission_late(0), "an immediate submission is on time");
+        require(!submission_late(kLateSubmissionThreshold), "exactly the threshold is on time");
+        require(submission_late(kLateSubmissionThreshold + 1), "past the threshold is late");
+        require(!submission_late(3 * kMillisecond, 5 * kMillisecond), "a wider threshold holds");
+        require(submission_late(6 * kMillisecond, 5 * kMillisecond), "and is still a threshold");
+    }
+    {
+        // The live flight's shape: real and second synthetics on time, the
+        // first synthetic late most of the time; counted per kind.
+        SubmissionTally tally;
+        for (int frame = 0; frame < 30; ++frame) {
+            tally.add(SubmissionKind::real, 600'000);
+            tally.add(SubmissionKind::gen1, frame % 3 == 0 ? 900'000 : 8'500'000);
+            tally.add(SubmissionKind::gen2, 700'000);
+        }
+        tally.add(SubmissionKind::repeat, 300'000);
+        require(tally.frames[0] == 30 && tally.frames[1] == 30 && tally.frames[2] == 30 &&
+                tally.frames[3] == 1, "frames are counted by kind");
+        require(tally.late[0] == 0 && tally.late[1] == 20 && tally.late[2] == 0 &&
+                tally.late[3] == 0, "late are counted by kind: " + std::to_string(tally.late[1]));
+        require(tally.worst_gen1 == 8'500'000 && tally.worst == 8'500'000, "worst is kept");
+        tally.reset();
+        require(tally.frames[1] == 0 && tally.worst == 0, "a reset starts over");
+    }
+    {
+        // Slack: written early but handed over late is late by the excess.
+        require(lead_slack_with_lateness(4 * kMillisecond, 1 * kMillisecond) == 4 * kMillisecond,
+            "on time, the written slack stands");
+        require(lead_slack_with_lateness(4 * kMillisecond, 7 * kMillisecond) == -5 * kMillisecond,
+            "handed over 5 ms past the threshold is 5 ms short");
+        require(lead_slack_with_lateness(-9 * kMillisecond, 7 * kMillisecond) == -9 * kMillisecond,
+            "written later still keeps the larger shortfall");
+    }
+    {
+        // Fed to the slack tuner, late hand-overs back a delay off even when
+        // the first synthetic was written in time.
+        TripleReleaseTuner tuner;
+        tuner.delay = 8 * kMillisecond;
+        tuner.ceiling = 2 * kPeriod;
+        TripleReleaseWindow window{};
+        for (std::uint32_t i = 0; i < TripleReleaseTuner::kWindowFrames; ++i) {
+            const Nanoseconds lateness = i % 2 == 0 ? 6 * kMillisecond : 500'000;
+            window = observe_triple_slack(
+                tuner, kPeriod, lead_slack_with_lateness(5 * kMillisecond, lateness));
+        }
+        require(window.closed && window.late == 15, "half the window late");
+        require(tuner.delay < 8 * kMillisecond, "the delay backed off: " + std::to_string(tuner.delay));
+    }
+    {
+        // Adaptive: late first synthetics are counted and shown, never acted on.
+        AdaptiveFrameGenController controller;
+        const Nanoseconds start = 100 * kSecond;
+        controller.start(3, start);
+        Nanoseconds now = start + 2 * kSecond;
+        for (int i = 0; i < 60; ++i) {
+            now += 3 * kPeriod;
+            controller.add_frame(now, 10 * kMillisecond, 12 * kMillisecond);
+            controller.add_late_leaders(now, 1);
+        }
+        const auto stats = controller.stats(now, kSecond);
+        require(stats.late_leaders >= 29 && stats.late_leaders <= 31,
+            "late first synthetics over a second: " + std::to_string(stats.late_leaders));
+        require(stats.late == 0, "they are not missed-slot episodes");
+        controller.add_late_leaders(now, 0);
+        require(controller.stats(now, kSecond).late_leaders == stats.late_leaders,
+            "a zero count adds nothing");
+    }
+}
+
+void late_skip_tests() {
+    const Nanoseconds start = 1000 * kSecond;
+    // One application frame every three periods.
+    const Nanoseconds frame = 3 * kPeriod;
+    {
+        // Steady, a few late first synthetics a second: never engages.
+        LateFrameSkipController skip;
+        Nanoseconds now = start;
+        for (int i = 0; i < 30 * 60; ++i) {
+            now += frame;
+            const auto step = skip.observe_leader(now, i % 10 == 0); // 3 a window
+            require(step.transition == LateSkipTransition::none, "3 of 30 late does not engage");
+        }
+        require(!skip.active(), "stays off");
+    }
+    {
+        // The live flight: two in three late. Engages on the first window.
+        LateFrameSkipController skip;
+        Nanoseconds now = start;
+        LateSkipStep step{};
+        int frames = 0;
+        while (!skip.active() && frames < 200) {
+            now += frame;
+            step = skip.observe_leader(now, frames % 3 != 0);
+            ++frames;
+        }
+        require(skip.active() && frames == 30, "engages on the first window: " + std::to_string(frames));
+        require(step.transition == LateSkipTransition::entered && step.window_late == 20,
+            "and says why");
+        // While on, a frame that was prepared before it engaged is not judged.
+        require(skip.observe_leader(now, true).transition == LateSkipTransition::none,
+            "first synthetics while on are ignored");
+        // Ready every time: leaves after two good windows, not before the dwell.
+        const Nanoseconds entered = now;
+        int ready_frames = 0;
+        while (skip.active() && ready_frames < 2000) {
+            now += frame;
+            step = skip.observe_skipped(now, true);
+            ++ready_frames;
+        }
+        require(!skip.active() && step.transition == LateSkipTransition::left, "leaves once there is room");
+        require(now - entered >= LateSkipConfig{}.min_dwell, "not before the dwell");
+        require(ready_frames >= 60, "two good windows at least: " + std::to_string(ready_frames));
+        require(ready_frames <= 120, "and soon after the dwell: " + std::to_string(ready_frames));
+    }
+    {
+        // Hysteresis: a window with too few ready resets the run of good ones.
+        LateSkipConfig config;
+        config.min_dwell = 0;
+        LateFrameSkipController skip(config);
+        Nanoseconds now = start;
+        for (int i = 0; i < 30; ++i) {
+            now += frame;
+            skip.observe_leader(now, true);
+        }
+        require(skip.active(), "engaged");
+        auto window = [&](std::uint32_t ready) {
+            LateSkipStep last{};
+            for (std::uint32_t i = 0; i < 30; ++i) {
+                now += frame;
+                last = skip.observe_skipped(now, i < ready);
+            }
+            return last;
+        };
+        require(window(30).transition == LateSkipTransition::none, "one good window is not enough");
+        require(window(20).transition == LateSkipTransition::none && skip.active(), "a bad one resets");
+        require(window(28).transition == LateSkipTransition::none, "good again: one");
+        require(window(29).transition == LateSkipTransition::left && !skip.active(), "two in a row: leaves");
+    }
+    {
+        // Flapping: back within the flap window doubles the dwell, up to the
+        // maximum; a long stretch off resets it.
+        LateFrameSkipController skip;
+        Nanoseconds now = start;
+        auto engage = [&] {
+            for (int i = 0; i < 30; ++i) {
+                now += frame;
+                skip.observe_leader(now, true);
+            }
+        };
+        auto leave = [&] {
+            int guard = 0;
+            while (skip.active() && guard++ < 100000) {
+                now += frame;
+                skip.observe_skipped(now, true);
+            }
+        };
+        engage();
+        require(skip.active() && skip.dwell() == 3 * kSecond, "first dwell is the minimum");
+        leave();
+        engage();
+        require(skip.active() && skip.dwell() == 6 * kSecond, "a flap doubles it");
+        leave();
+        engage();
+        leave();
+        engage();
+        require(skip.dwell() == 24 * kSecond, "up to the maximum: " + std::to_string(skip.dwell()));
+        leave();
+        engage();
+        require(skip.dwell() == 24 * kSecond, "and no further");
+        leave();
+        // Off for longer than the flap window: back to the minimum.
+        for (int i = 0; i < 30 * 20; ++i) {
+            now += frame;
+            skip.observe_leader(now, false);
+        }
+        engage();
+        require(skip.dwell() == 3 * kSecond, "a long stretch off resets the dwell");
+        skip.reset();
+        require(!skip.active() && skip.dwell() == 3 * kSecond, "reset is off");
+    }
+}
