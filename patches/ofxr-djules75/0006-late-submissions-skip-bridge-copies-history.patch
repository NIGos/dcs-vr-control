+        require(split.shader == 4'200'000 && split.optical_flow_wait == 0, "span is shader");
+    }
+    {
+        // A single eye.
+        const auto split = split_synthesis_gpu_time(400, 2500, 0, 500, 3500);
+        require(split.shader == 900'000 && split.optical_flow_wait == 2'500'000, "one eye");
+    }
+}
