+        "deferred: an ordinary release copies");
+    expect(SUCCEEDED(bridge.wait_for_idle()), "deferred: idle");
+    expect(runtime_red(devices, fixture.runtime[0].Get()) == 50, "deferred: copied at release");
+    expect(bridge.catch_up() == S_OK, "deferred: nothing to catch up after a copy");
+
+    bridge.set_defer_copies(true);
+    expect(bridge.defers_copies(), "deferred: on");
+    std::uint32_t index = 0;
+    std::uint8_t red = 0;
+    bool untouched = true;
+    for (std::uint32_t frame = 1; frame <= 4; ++frame) {
+        index = frame % 3;
+        red = static_cast<std::uint8_t>(50 + frame);
+        expect(render_and_release(devices, bridge, index, red, &released),
+            "deferred: release");
+        // S_OK, not S_FALSE: the shared texture was handed over, so the layer
+        // may read it (the history capture) after the release.
+        expect(released == S_OK, "deferred: a deferred release returns S_OK");
+        expect(SUCCEEDED(bridge.wait_for_idle()), "deferred: idle");
+        untouched = untouched && runtime_red(devices, fixture.runtime[index].Get()) != red;
+    }
+    expect(untouched, "deferred: the runtime's image is left alone");
+    expect(bridge.copies_on_release(), "deferred: not the unsubmitted skip");
+
+    // Named directly: the last release, and only it, is copied now.
+    const std::uint32_t older = 3 % 3;
+    expect(bridge.catch_up() == S_FALSE, "deferred: catch-up copy queued");
+    expect(SUCCEEDED(bridge.wait_for_idle()), "deferred: idle after catch-up");
+    expect(runtime_red(devices, fixture.runtime[index].Get()) == red,
