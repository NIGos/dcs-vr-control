+// DCS VR Control (0006): after a frame has gone to the runtime, the bridged
+// swapchains its releases need not copy for. When the frame went down
+// rewritten onto the private swapchains (`output`, what the runtime was
+// given), that is every bridged swapchain nothing in it names directly: the
+// projection views it was generated from, and the depth the generated frames
+// do not carry. When it went down as the application's own (`output` null),
+// none. Logged (d3d11_bridge result=7) when a swapchain changes.
+void update_bridged_copy_deferral(
+    const std::shared_ptr<SessionState>& state,
+    const XrFrameEndInfo* output) noexcept {
+    try {
+        if (!state->d3d11_bridge) {
+            return;
+        }
+        std::vector<XrSwapchain> named;
+        const bool output_known = output != nullptr &&
+            collect_named_swapchains(output, &named);
+        for (const auto& swapchain_state : find_swapchains(state)) {
+            std::shared_ptr<xrfg::D3D11BridgeSwapchain> bridge;
+            {
+                std::scoped_lock lock(swapchain_state->mutex);
+                bridge = swapchain_state->bridge;
+            }
+            if (!bridge) {
+                continue;
+            }
+            // Nothing reaches the runtime's images of a private depth
+            // swapchain in any case.
+            if (bridge->path() == xrfg::D3D11BridgePath::depth_private) {
+                continue;
