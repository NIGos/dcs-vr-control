+// DCS VR Control (0006): while generation rewrites a bridged swapchain's
+// frames onto the layer's private swapchains, its releases do not copy into
+// the runtime's images (D3D11BridgeSwapchain::set_defer_copies). Before any
+// submission that may name such a swapchain directly goes downstream - a
+// frame passed through for whatever reason, or a generated frame whose other
+// layers name it - the image it released last is copied here, on the
+// session's queue, and the release mark is moved past that copy, as 0002's
+// catch-up does for a skipped swapchain. `frame` null: every bridged
+// swapchain, named or not. `stop_deferring`: and their releases copy again
+// from now on. The decision to defer is only ever made after a frame has
+// gone to the runtime rewritten (update_bridged_copy_deferral), so a release
+// that turns out to belong to a pass-through frame is always caught up here
+// before that frame goes down.
+void catch_up_bridged_copies(
+    const std::shared_ptr<SessionState>& state,
+    const XrFrameEndInfo* frame,
+    bool stop_deferring) noexcept {
+    try {
+        if (!state->d3d11_bridge) {
+            return;
+        }
+        std::vector<XrSwapchain> named;
+        const bool every = frame == nullptr ||
+            !collect_named_swapchains(frame, &named);
+        bool copied = false;
+        for (const auto& swapchain_state : find_swapchains(state)) {
+            std::shared_ptr<xrfg::D3D11BridgeSwapchain> bridge;
+            {
+                std::scoped_lock lock(swapchain_state->mutex);
+                bridge = swapchain_state->bridge;
+            }
+            if (!bridge) {
+                continue;
+            }
+            if (stop_deferring && bridge->defers_copies()) {
+                bridge->set_defer_copies(false);
+                // See update_bridged_copy_deferral.
+                xrfg::bridge_flight_logger().event(
+                    xrfg::BridgeFlightOperation::d3d11_bridge,
+                    7,
+                    handle_value(swapchain_state->handle),
+                    0,
+                    0);
+            }
+            if (!every &&
+                std::find(named.begin(), named.end(), swapchain_state->handle) ==
+                    named.end()) {
+                continue;
+            }
+            const HRESULT result = bridge->catch_up();
+            if (result == S_FALSE) {
+                copied = true;
+            } else if (FAILED(result)) {
+                xrfg::bridge_flight_logger().event(
+                    xrfg::BridgeFlightOperation::d3d11_bridge,
+                    4,
+                    handle_value(swapchain_state->handle),
+                    1,
+                    static_cast<std::uint64_t>(static_cast<std::uint32_t>(result)));
+            }
+        }
