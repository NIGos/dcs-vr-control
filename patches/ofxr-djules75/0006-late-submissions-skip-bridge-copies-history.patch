diff --git a/tests/layer_late_skip.cmake b/tests/layer_late_skip.cmake
new file mode 100644
index 0000000..966dd08
--- /dev/null
+++ b/tests/layer_late_skip.cmake
@@ -0,0 +1,91 @@
+# DCS VR Control (0006): runs the dcs-late-skip call-chain scenario in 3X off
+# SteamVR with SKIP_INI beside the layer DLL, and checks from the flight log
+# that submissions were timed and tallied by kind every second, and that the
+# late-frame skip turned on while the application was heavy and off once it
+# was light again - or, with EXPECT_SKIP=OFF (the ini says late_frame_skip=0),
+# that it never turned on.
+foreach(required_variable IN ITEMS LAYER_DLL CALL_CHAIN SKIP_INI WORK_DIR EXPECT_SKIP)
+    if(NOT DEFINED ${required_variable})
+        message(FATAL_ERROR "${required_variable} was not provided")
+    endif()
+endforeach()
+
+file(REMOVE_RECURSE "${WORK_DIR}")
+file(MAKE_DIRECTORY "${WORK_DIR}")
+file(COPY "${LAYER_DLL}" DESTINATION "${WORK_DIR}")
+file(COPY "${SKIP_INI}" DESTINATION "${WORK_DIR}")
+get_filename_component(skip_ini_name "${SKIP_INI}" NAME)
+file(RENAME "${WORK_DIR}/${skip_ini_name}" "${WORK_DIR}/ofxr_bridge.ini")
+
+get_filename_component(layer_name "${LAYER_DLL}" NAME)
+execute_process(
+    COMMAND "${CALL_CHAIN}"
+        "${WORK_DIR}/${layer_name}"
+        "${WORK_DIR}/fake-runtime.log"
+        dcs-late-skip
+    RESULT_VARIABLE call_chain_result
+    OUTPUT_VARIABLE call_chain_output
+    ERROR_VARIABLE call_chain_error)
+if(NOT call_chain_result EQUAL 0)
+    message(FATAL_ERROR
+        "Call chain 'dcs-late-skip' failed (${call_chain_result}):\n"
+        "${call_chain_output}\n${call_chain_error}")
+endif()
+
+file(GLOB flight_logs "${WORK_DIR}/ofxr-bridge-flight-*.log")
+list(LENGTH flight_logs flight_log_count)
+if(NOT flight_log_count EQUAL 1)
+    message(FATAL_ERROR "Expected one OFXR flight log, found ${flight_log_count}")
+endif()
+list(GET flight_logs 0 flight_log)
+file(READ "${flight_log}" contents)
+
+# Once a second: submissions and late ones by kind, and in 3X the skip
+# (which with late_frame_skip=0 is not recorded at all).
+string(REGEX MATCH "op=submission_timing result=1 dur_us=0 a=[1-9][0-9]* b=[0-9]+ c=[0-9]+" tally "${contents}")
+if(tally STREQUAL "")
+    message(FATAL_ERROR "No per-second submission_timing record")
+endif()
+string(REGEX MATCH "op=submission_timing result=2 dur_us=0 a=[01] b=[0-9]+ c=[0-9]+" status "${contents}")
+if(EXPECT_SKIP AND status STREQUAL "")
+    message(FATAL_ERROR "No per-second late-frame skip record")
+endif()
+if(NOT EXPECT_SKIP AND NOT status STREQUAL "")
+    message(FATAL_ERROR "A late-frame skip record with late_frame_skip=0")
+endif()
+# Late first synthetics while heavy: the gen1 field (bits 16-31) of b.
+string(REGEX MATCHALL "op=submission_timing result=1 dur_us=0 a=[0-9]+ b=[0-9]+" tallies "${contents}")
+set(late_gen1_seconds 0)
+foreach(record IN LISTS tallies)
+    string(REGEX REPLACE ".* b=([0-9]+)$" "\\1" late "${record}")
+    math(EXPR late_gen1 "(${late} >> 16) & 65535")
+    if(late_gen1 GREATER 0)
+        math(EXPR late_gen1_seconds "${late_gen1_seconds} + 1")
+    endif()
+endforeach()
+if(late_gen1_seconds LESS 1)
+    message(FATAL_ERROR "No second with a late first synthetic was tallied")
+endif()
+
+string(FIND "${contents}" "op=submission_timing result=3 dur_us=0 a=1 " entered)
+string(FIND "${contents}" "op=submission_timing result=3 dur_us=0 a=2 " left)
+if(EXPECT_SKIP)
+    if(entered EQUAL -1)
+        message(FATAL_ERROR "The late-frame skip never turned on")
+    endif()
+    if(left EQUAL -1)
+        message(FATAL_ERROR "The late-frame skip never turned off")
+    endif()
+    if(left LESS entered)
+        message(FATAL_ERROR "The late-frame skip turned off before it turned on")
+    endif()
+    string(REGEX MATCH "op=submission_timing result=2 dur_us=0 a=1 b=[1-9][0-9]*" skipping "${contents}")
+    if(skipping STREQUAL "")
+        message(FATAL_ERROR "No second in which the skip re-presented a slot")
+    endif()
+else()
+    if(NOT entered EQUAL -1)
+        message(FATAL_ERROR "The late-frame skip turned on with late_frame_skip=0")
+    endif()
+endif()
+message(STATUS "Late-frame skip verified (expected: ${EXPECT_SKIP})")
