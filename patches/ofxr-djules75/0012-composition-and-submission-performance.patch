+    std::cout << "triple bench " << width << "x" << height << " x2 eyes: composition median one pass "
+              << median(pipelines[0].composition) << " us, two passes " << median(pipelines[1].composition)
+              << " us (" << pipelines[0].composition.size() << " pairs); whole pair median one pass "
+              << median(pipelines[0].total) << " us, two passes " << median(pipelines[1].total) << " us" << std::endl;
+}
