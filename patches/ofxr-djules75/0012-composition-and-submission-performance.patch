 // The ratio the flow input was packed at, relative to the source image.
@@ -1112,3 +1086,52 @@ float4 SynthesizeNvidiaFastBidirectionalMidpointPS(
     FullscreenVertex input) : SV_Target {
     return synthesize_midpoint(input, 1.0 / 32.0, true, true, true, false, true);
 }
+
+// DCS VR Control (0011): 3X in one pass. Both synthetics of a pair are
+// composed by the same pixel - the second at the instant the NVIDIA path
+// carries in GameMotionPadding's low 16 bits (the game-motion branch is the
+// only one that reads that field otherwise) - into two render targets, so
+// the fallback sample, the mapping, the flow, the cost and the masks are
+// fetched once per pixel with the second composition hitting the cache, and
+// the full-screen draw, its rasterization and the mask run once.
+struct TripleOutputs {
+    float4 first : SV_Target0;
+    float4 second : SV_Target1;
+};
+
+float second_synthesis_fraction() {
+    uint packed = GameMotionPadding & 0xffffu;
+    return packed == 0u ? 0.5 : float(packed) / 65535.0;
+}
+
+TripleOutputs SynthesizeNvidiaTripleMidpointPS(FullscreenVertex input) {
+    TripleOutputs output;
+    output.first = synthesize_midpoint(input, 1.0 / 32.0, true, false, false, false, true);
+    g_synthesis_fraction = second_synthesis_fraction();
+    output.second = synthesize_midpoint(input, 1.0 / 32.0, true, false, false, false, true);
+    return output;
+}
+
+TripleOutputs SynthesizeNvidiaTripleBidirectionalMidpointPS(FullscreenVertex input) {
+    TripleOutputs output;
+    output.first = synthesize_midpoint(input, 1.0 / 32.0, true, true, false, false, true);
+    g_synthesis_fraction = second_synthesis_fraction();
+    output.second = synthesize_midpoint(input, 1.0 / 32.0, true, true, false, false, true);
+    return output;
+}
+
+TripleOutputs SynthesizeNvidiaTripleFastMidpointPS(FullscreenVertex input) {
+    TripleOutputs output;
+    output.first = synthesize_midpoint(input, 1.0 / 32.0, true, false, true, false, true);
