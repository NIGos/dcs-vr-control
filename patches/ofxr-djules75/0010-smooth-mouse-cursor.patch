+    // matched.
+    std::vector<D3D12CursorTemplate> templates;
+    // The detection runs only while the Windows cursor moved within this
+    // long; otherwise nothing of the feature runs at all.
+    std::uint32_t active_milliseconds{5000};
+};
+
+// Running totals since set_smooth_cursor. The GPU counts are as of the latest
+// completed work slot, so they trail the submissions by a frame or two.
+struct D3D12SmoothCursorStats {
+    std::uint64_t pairs{};          // pairs the gate judged
+    std::uint64_t drawn{};          // ... and accepted: the cursor was redrawn
+    std::uint64_t not_found{};      // a frame or view without a match
+    std::uint64_t low_score{};      // a match below the acceptance score
+    std::uint64_t ambiguous{};      // a look-alike too close in score
+    std::uint64_t stereo{};         // the two views disagree
+    std::uint64_t jump{};           // an impossible move
+    std::uint64_t busy{};           // too much moved to search the frame
+    std::uint64_t acquired{};       // frame-views searched where motion was
+    std::uint64_t tracked{};        // frame-views searched around the last find
+    std::uint64_t idle_pairs{};     // pairs with the mouse idle (nothing ran)
+    std::uint64_t timed_pairs{};    // pairs whose detection was GPU-timed
+    std::uint64_t detection_microseconds{}; // their summed GPU time
+    std::uint32_t templates{};      // templates uploaded
+    std::uint32_t matchable_templates{};
 };
 
