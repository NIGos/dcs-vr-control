new file mode 100644
index 0000000..ddd6bad
--- /dev/null
+++ b/src/d3d12/smooth_cursor.hlsl
@@ -0,0 +1,906 @@
+// DCS VR Control (0010): smooth mouse cursor - detection.
+//
+// DCS draws its VR mouse cursor after DLSS as a small view-locked sprite that
+// follows the absolute Windows cursor. Optical flow cannot carry it: every
+// generated pixel samples the flow at its own position, and a sprite that
+// moves further than its own size between two real frames has no flow vector
+// that lands on it, so a generated frame shows it faded at both places. The
+// synthesis fixes that per pixel (see frame_synthesis.hlsl, cursor_*): it
+// removes the cursor from whichever real frame a sample came from and draws
+// it again at its position for the generated frame's instant. These passes
+// find it, in both real frames of a pair, per view, and decide whether that
+// is safe:
+//
+//   CursorBeginCS   one thread: clears this frame's entry and picks its mode -
+//                   tracking (a window around the other frame's position,
+//                   moved by the mouse; its tiles are listed for the search)
+//                   or acquisition
+//   CursorMotionCS  acquisition only (an indirect dispatch Begin sizes): lists
+//                   the tiles where the pose-compensated frame difference says
+//                   something moved
+//   CursorArgumentsCS one thread: sizes the search's indirect dispatch
+//   CursorSearchCS  one group per listed 32x32 tile of candidate positions and
+//                   template: zero-mean normalised correlation of the
+//                   template's opaque pixels only (so the background never
+//                   takes part), coarse positions, the tracked scale or all
+//                   eight
+//   CursorVerifyCS  one group per view: refines the best candidate with every
+//                   sample and measures the best look-alike elsewhere in a
+//                   window around it (the margin)
+//   CursorGateCS    one thread: accepts the pair only when both frames found
+//                   it confidently, unambiguously, consistently between the
+//                   eyes and without an impossible jump; otherwise the
+//                   generated frames are drawn exactly as without the feature
+//
+// Nothing is read back on the CPU in the frame: the gate writes the record the
+// synthesis reads, and the running counters are copied to a readback buffer
+// that is read when the work slot is reused.
+
+Texture2DArray<float4> PreviousFrame : register(t0);
+Texture2DArray<float4> CurrentFrame : register(t1);
+StructuredBuffer<uint> CursorTemplates : register(t2);
+RWStructuredBuffer<uint> CursorState : register(u0);
+RWStructuredBuffer<uint> CursorCandidates : register(u1);
+// Two dispatches' arguments: the motion pass's, then the search's.
+RWStructuredBuffer<uint> CursorArguments : register(u2);
+
+struct CameraMapping {
+    float4 TargetToSourceRotation;
+    float4 SourceTangents;
+    float4 TargetTangents;
+    float4 SourceRect;
+    float4 TargetRect;
+};
+
+cbuffer CursorParameters : register(b0) {
+    uint Width;
+    uint Height;
+    // Bit 0: the frames are read through an sRGB view (linear values), so
+    // the templates' bytes are linearised to match. Bit 1: this pass detects
+    // in the previous frame. Bit 2: the mouse delta is known.
+    uint Flags;
+    uint TemplateCount;
+    uint EntryIndex;
+    // The ring entry of the other frame: tracked from by Begin, the previous
+    // frame's result in Gate. 2 or more: none.
+    uint TrackIndex;
+    uint TilesX;
+    uint TilesY;
+    // The Windows cursor's movement from the other frame to this one, in
+    // screen pixels (Gate: from the previous frame to the current).
+    float2 MouseDelta;
+    // The views (bits 0-7) and each one's array slice (bits 8-15, 16-23).
+    uint ViewInfo;
+    uint Padding;
+    // Target: the current frame's camera. Source: the previous frame's.
+    CameraMapping Mappings[2];
+};
+
+// Shared layout; d3d12_frame_synthesizer.cpp and frame_synthesis.hlsl
+// mirror these values.
+static const uint kTemplateSize = 32;
+static const uint kTemplateTexels = 1024;
+static const uint kMaxTemplates = 16;
+static const uint kSamplesPerTemplate = 64;
+static const uint kCoarseSamples = 32;
+static const uint kSampleBase = kMaxTemplates * kTemplateTexels;
+static const uint kInfoBase = kSampleBase + kMaxTemplates * kSamplesPerTemplate;
+
+static const uint kEntryStride = 32;
+static const uint kEntryStatus = 0;
+static const uint kEntryX = 1;
+static const uint kEntryY = 2;
+static const uint kEntryTemplate = 3;
+static const uint kEntryScale = 4;
+static const uint kEntryScore = 5;
+static const uint kEntrySecond = 6;
+static const uint kEntryKey = 7;
+static const uint kEntryHot = 8;
+static const uint kEntryMode = 9;
+static const uint kEntryWindowX0 = 10;
+static const uint kEntryWindowY0 = 11;
+static const uint kEntryWindowX1 = 12;
+static const uint kEntryWindowY1 = 13;
+static const uint kEntryOverflow = 14;
+
+static const uint kStatusNone = 0;
+static const uint kStatusFound = 1;
+static const uint kStatusBusy = 2;
+static const uint kStatusNotSearched = 3;
+
+static const uint kModeOff = 0;
+static const uint kModeTrack = 1;
+static const uint kModeAcquire = 2;
+
+static const uint kLearnBase = 128;     // per view: gain x, gain y, known
+static const uint kStereoBase = 144;    // learned vertical offset, known
+static const uint kCompositeBase = 160; // per view, 16
+static const uint kStatsBase = 192;
+static const uint kStatPairs = 0;
+static const uint kStatDrawn = 1;
+static const uint kStatNotFound = 2;
+static const uint kStatScore = 3;
+static const uint kStatMargin = 4;
+static const uint kStatStereo = 5;
+static const uint kStatJump = 6;
+static const uint kStatBusy = 7;
+static const uint kStatAcquired = 8;
+static const uint kStatTracked = 9;
+// The tiles the search visits: (view << 16) | tile.
+static const uint kListCount = 256;
+static const uint kListEntries = 260;
+static const uint kMaxListEntries = 400;
+
+// The sprite's size in the eye image against the 32x32 cursor image: DCS has
+// no size option, but the size in pixels follows the headset's resolution.
+static const uint kScaleCount = 8;
+static const float kScales[8] = {0.4, 0.5, 0.63, 0.794, 1.0, 1.26, 1.587, 2.0};
+
+static const uint kMaxHotTiles = 24;
+static const float kHotDifference = 0.08;
+static const uint kHotSamples = 3;
+// A detection the gate accepts, and how far ahead of the next best
+// look-alike near it. The research emulation matched the true cursor at
+// 0.9+ under blur, noise and 0.85-1.25x scale; an identical arrow 30 px away
+// matched as well as the cursor itself, which only the margin rejects.
+static const float kAcceptScore = 0.72;
+static const float kAcceptMargin = 0.15;
+static const float kTrackScore = 0.6;
+static const float kCandidateScore = 0.3;
+
+#define ViewCount (ViewInfo & 0xffu)
+
+uint view_slice(uint view) {
+    return (ViewInfo >> (view == 0u ? 8 : 16)) & 0xffu;
+}
+
+uint entry_base(uint ring, uint view) {
+    return (ring * 2u + view) * kEntryStride;
+}
+
+bool detecting_previous() {
+    return (Flags & 2u) != 0u;
+}
+
+float4 view_rect(uint view) {
+    return detecting_previous() ? Mappings[view].SourceRect : Mappings[view].TargetRect;
+}
+
+float3 rotate_by_quaternion(float4 quaternion, float3 input_vector) {
+    return input_vector + 2.0 * cross(
+        quaternion.xyz,
+        cross(quaternion.xyz, input_vector) + quaternion.w * input_vector);
+}
+
+// As frame_synthesis.hlsl's map_target_to_source / map_source_to_target,
+// nearest pixel and without the validity bookkeeping it does not need here.
+float2 target_to_source(float2 target, CameraMapping mapping, out bool valid) {
+    float2 uv = (target - mapping.TargetRect.xy + 0.5) / mapping.TargetRect.zw;
+    float3 ray = float3(
+        lerp(mapping.TargetTangents.x, mapping.TargetTangents.y, uv.x),
+        lerp(mapping.TargetTangents.z, mapping.TargetTangents.w, uv.y),
+        -1.0);
+    float3 source_ray = rotate_by_quaternion(mapping.TargetToSourceRotation, ray);
+    valid = source_ray.z < -1.0e-5;
+    float2 tangent = source_ray.xy / max(-source_ray.z, 1.0e-5);
+    float2 source_uv = float2(
+        (tangent.x - mapping.SourceTangents.x) /
+            max(mapping.SourceTangents.y - mapping.SourceTangents.x, 1.0e-7),
+        (tangent.y - mapping.SourceTangents.z) /
+            (mapping.SourceTangents.w - mapping.SourceTangents.z));
+    return mapping.SourceRect.xy + source_uv * mapping.SourceRect.zw - 0.5;
+}
+
+float2 source_to_target(float2 source, CameraMapping mapping, out bool valid) {
+    float2 uv = (source - mapping.SourceRect.xy + 0.5) / mapping.SourceRect.zw;
+    float3 ray = float3(
+        lerp(mapping.SourceTangents.x, mapping.SourceTangents.y, uv.x),
+        lerp(mapping.SourceTangents.z, mapping.SourceTangents.w, uv.y),
+        -1.0);
+    float4 inverse = float4(-mapping.TargetToSourceRotation.xyz, mapping.TargetToSourceRotation.w);
+    float3 target_ray = rotate_by_quaternion(inverse, ray);
+    valid = target_ray.z < -1.0e-5;
+    float2 tangent = target_ray.xy / max(-target_ray.z, 1.0e-5);
+    float2 target_uv = float2(
+        (tangent.x - mapping.TargetTangents.x) /
+            max(mapping.TargetTangents.y - mapping.TargetTangents.x, 1.0e-7),
+        (tangent.y - mapping.TargetTangents.z) /
+            (mapping.TargetTangents.w - mapping.TargetTangents.z));
+    return mapping.TargetRect.xy + target_uv * mapping.TargetRect.zw - 0.5;
+}
+
+float luma(float3 colour) {
+    return dot(colour, float3(0.2126, 0.7152, 0.0722));
+}
+
+float frame_luma(int2 pixel, uint slice) {
+    int2 bounded = clamp(pixel, int2(0, 0), int2(int(Width) - 1, int(Height) - 1));
+    float4 colour = detecting_previous()
+        ? PreviousFrame.Load(int4(bounded, int(slice), 0))
+        : CurrentFrame.Load(int4(bounded, int(slice), 0));
+    return luma(colour.rgb);
+}
+
+// The frame this pass searches against the other one brought into its
+// camera (so head rotation does not count as motion; the view-locked cursor
+// does, since rotation moves the world past it).
+float temporal_difference(int2 pixel, uint view) {
+    uint slice = view_slice(view);
+    bool valid = false;
+    float other = 0.0;
+    if (detecting_previous()) {
+        float2 target = source_to_target(float2(pixel), Mappings[view], valid);
+        int2 at = int2(round(target));
+        valid = valid && all(at >= int2(0, 0)) && at.x < int(Width) && at.y < int(Height);
+        if (valid) {
+            other = luma(CurrentFrame.Load(int4(at, int(slice), 0)).rgb);
+        }
+    } else {
+        float2 source = target_to_source(float2(pixel), Mappings[view], valid);
+        int2 at = int2(round(source));
+        valid = valid && all(at >= int2(0, 0)) && at.x < int(Width) && at.y < int(Height);
+        if (valid) {
+            other = luma(PreviousFrame.Load(int4(at, int(slice), 0)).rgb);
+        }
+    }
+    return valid ? abs(frame_luma(pixel, slice) - other) : 0.0;
+}
+
+float srgb_to_linear(float value) {
+    return value <= 0.04045 ? value / 12.92 : pow((value + 0.055) / 1.055, 2.4);
+}
+
+float template_luma(uint template_index, uint2 texel) {
+    uint rgba = CursorTemplates[template_index * kTemplateTexels + texel.y * kTemplateSize + texel.x];
+    float3 colour = float3(
+        float(rgba & 0xffu),
+        float((rgba >> 8) & 0xffu),
+        float((rgba >> 16) & 0xffu)) / 255.0;
+    if ((Flags & 1u) != 0u) {
+        colour = float3(srgb_to_linear(colour.r), srgb_to_linear(colour.g), srgb_to_linear(colour.b));
+    }
+    return luma(colour);
+}
+
+// A template is matched one of two ways (the info word's bit 16). One with
+// inner contrast - DCS's white arrow with its dark outline - on its own
+// opaque pixels' brightness, so the background never takes part. One of a
+// single colour - DCS's green and yellow control markers, the outlined set -
+// has no inner contrast to match: it is matched on its shape, its opaque
+// pixels (weight 255) against a ring of the transparent ones around them
+// (weight 0), either way round (a bright marker on a dark panel or a dark
+// one on the sky), and its colour is checked in the verification.
+uint template_sample_count(uint template_index) {
+    return min(CursorTemplates[kInfoBase + template_index] & 0xffffu, kSamplesPerTemplate);
+}
+
+bool template_is_shape(uint template_index) {
+    return (CursorTemplates[kInfoBase + template_index] & 0x10000u) != 0u;
+}
+
+// x, y and the sample's weight (a shape template's mask value).
+uint3 template_sample(uint template_index, uint sample_index) {
+    uint packed = CursorTemplates[kSampleBase + template_index * kSamplesPerTemplate + sample_index];
+    return uint3(packed & 0xffu, (packed >> 8) & 0xffu, (packed >> 16) & 0xffu);
+}
+
+int2 sample_offset(uint2 texel, float scale) {
+    return int2(floor((float2(texel) + 0.5) * scale));
+}
+
+groupshared float gs_luma[64];
+groupshared uint gs_texel[64];
+groupshared float gs_score[1024];
+groupshared uint gs_position[1024];
+groupshared uint gs_meta[1024];
+groupshared uint gs_flag;
+groupshared uint gs_shape;
+groupshared uint gs_mode;
+groupshared uint gs_view;
+groupshared int2 gs_origin;
+groupshared int4 gs_window;
+groupshared uint gs_scale;
+
+// Loads one template's samples for the whole group and returns how many
+// there are. Every thread must call it.
+uint load_template(uint template_index, uint thread_index) {
+    GroupMemoryBarrierWithGroupSync();
+    uint count = template_sample_count(template_index);
+    bool shape = template_is_shape(template_index);
+    if (thread_index == 0u) {
+        gs_shape = shape ? 1u : 0u;
+    }
+    if (thread_index < count) {
+        uint3 texel = template_sample(template_index, thread_index);
+        gs_texel[thread_index] = texel.x | (texel.y << 8);
+        gs_luma[thread_index] = shape ? float(texel.z) / 255.0 : template_luma(template_index, texel.xy);
+    }
+    GroupMemoryBarrierWithGroupSync();
+    return count;
+}
+
+// Zero-mean normalised correlation of the first `count` loaded template
+// samples (the first half is the coarse set) against the image at
+// `position` (the template box's top-left) and `scale`. A flat image patch
+// scores 0.
+float correlation(int2 position, float scale, uint slice, uint count,
+    float template_mean, float template_spread) {
+    float sum = 0.0;
+    float sum_squares = 0.0;
+    float cross_sum = 0.0;
+    for (uint i = 0; i < count; ++i) {
+        uint packed = gs_texel[i];
+        uint2 texel = uint2(packed & 0xffu, packed >> 8);
+        float value = frame_luma(position + sample_offset(texel, scale), slice);
+        sum += value;
+        sum_squares += value * value;
+        cross_sum += value * gs_luma[i];
+    }
+    float n = float(max(count, 1u));
+    float mean = sum / n;
+    float spread = sum_squares - n * mean * mean;
+    bool structured = spread >= n * 1.0e-4 && template_spread > 0.0;
+    float score = structured
+        ? (cross_sum - n * mean * template_mean) * rsqrt(max(spread * template_spread, 1.0e-12))
+        : 0.0;
+    return gs_shape != 0u ? abs(score) : score;
+}
+
+// A shape template's colour against the image's under its opaque samples, as
+// chromaticity (so brightness does not count): 1 the same, falling to 0 at a
+// clearly different hue. Inner-contrast templates are not checked.
+float shape_colour_match(uint template_index, int2 position, float scale, uint slice, uint count) {
+    float3 image = float3(0.0, 0.0, 0.0);
+    float3 sprite = float3(0.0, 0.0, 0.0);
+    for (uint i = 0; i < count; ++i) {
+        if (gs_luma[i] > 0.5) {
+            uint packed = gs_texel[i];
+            uint2 texel = uint2(packed & 0xffu, packed >> 8);
+            int2 pixel = clamp(position + sample_offset(texel, scale), int2(0, 0),
+                int2(int(Width) - 1, int(Height) - 1));
+            float4 colour = detecting_previous()
+                ? PreviousFrame.Load(int4(pixel, int(slice), 0))
+                : CurrentFrame.Load(int4(pixel, int(slice), 0));
+            image += colour.rgb;
+            uint rgba = CursorTemplates[template_index * kTemplateTexels + texel.y * kTemplateSize + texel.x];
+            float3 own = float3(float(rgba & 0xffu), float((rgba >> 8) & 0xffu),
+                float((rgba >> 16) & 0xffu)) / 255.0;
+            if ((Flags & 1u) != 0u) {
+                own = float3(srgb_to_linear(own.r), srgb_to_linear(own.g), srgb_to_linear(own.b));
+            }
+            sprite += own;
+        }
+    }
+    float3 image_chroma = image / max(image.r + image.g + image.b, 1.0e-4);
+    float3 sprite_chroma = sprite / max(sprite.r + sprite.g + sprite.b, 1.0e-4);
+    float distance = abs(image_chroma.r - sprite_chroma.r) + abs(image_chroma.g - sprite_chroma.g) +
+        abs(image_chroma.b - sprite_chroma.b);
+    return template_is_shape(template_index) ? saturate(1.0 - distance * 4.0) : 1.0;
+}
+
+void template_statistics(uint count, out float mean, out float spread) {
+    float sum = 0.0;
+    float sum_squares = 0.0;
+    for (uint i = 0; i < count; ++i) {
+        sum += gs_luma[i];
+        sum_squares += gs_luma[i] * gs_luma[i];
+    }
+    float n = float(max(count, 1u));
+    mean = sum / n;
+    spread = count >= 8u ? sum_squares - n * mean * mean : 0.0;
+    // Too little structure to match on its own: a plain dot.
+    if (spread < n * 4.0e-3) {
+        spread = 0.0;
+    }
+}
+
+void append_tile(uint view, uint tile) {
+    uint index = kMaxListEntries;
+    InterlockedAdd(CursorState[kListCount], 1u, index);
+    if (index < kMaxListEntries) {
+        CursorState[kListEntries + index] = (view << 16) | (tile & 0xffffu);
+    }
+}
+
+[numthreads(1, 1, 1)]
+void CursorBeginCS() {
+    CursorState[kListCount] = 0u;
+    bool acquiring = false;
+    for (uint view = 0; view < ViewCount; ++view) {
+        uint entry = entry_base(EntryIndex, view);
+        CursorState[entry + kEntryStatus] = kStatusNotSearched;
+        CursorState[entry + kEntryKey] = 0u;
+        CursorState[entry + kEntryHot] = 0u;
+        CursorState[entry + kEntryOverflow] = 0u;
+        CursorState[entry + kEntryScore] = asuint(0.0);
+        CursorState[entry + kEntrySecond] = asuint(0.0);
+        uint mode = kModeAcquire;
+        float4 rect = view_rect(view);
+        int2 rect_min = int2(rect.xy);
+        int2 window_min = rect_min;
+        int2 window_max = int2(rect.xy + rect.zw);
+        if (TrackIndex < 2u) {
+            uint other = entry_base(TrackIndex, view);
+            if (CursorState[other + kEntryStatus] == kStatusFound &&
+                asfloat(CursorState[other + kEntryScore]) >= kTrackScore) {
+                mode = kModeTrack;
+                float2 centre = float2(
+                    float(asint(CursorState[other + kEntryX])),
+                    float(asint(CursorState[other + kEntryY])));
+                // Only the frames' own image rectangles differ between the
+                // two (double-wide views); the cursor is view-locked.
+                float4 other_rect = detecting_previous()
+                    ? Mappings[view].TargetRect
+                    : Mappings[view].SourceRect;
+                centre += rect.xy - other_rect.xy;
+                float radius = 72.0;
+                uint learn = kLearnBase + view * 8u;
+                if ((Flags & 4u) != 0u && CursorState[learn + 2u] != 0u) {
+                    float2 predicted = MouseDelta * float2(
+                        asfloat(CursorState[learn]), asfloat(CursorState[learn + 1u]));
+                    centre += predicted;
+                    radius = 24.0 + 0.35 * length(predicted);
+                }
+                radius = min(radius, 192.0);
+                window_min = max(window_min, int2(floor(centre - radius)));
+                window_max = min(window_max, int2(ceil(centre + radius)) + 1);
+                CursorState[entry + kEntryScale] = CursorState[other + kEntryScale];
+                // The tiles of candidate positions the window touches.
+                if (all(window_max > window_min)) {
+                    uint2 first = uint2(window_min - rect_min) / 32u;
+                    uint2 last = uint2(window_max - 1 - rect_min) / 32u;
+                    for (uint ty = first.y; ty <= last.y; ++ty) {
+                        for (uint tx = first.x; tx <= last.x; ++tx) {
+                            append_tile(view, ty * TilesX + tx);
+                        }
+                    }
+                }
+            }
+        }
+        acquiring = acquiring || mode == kModeAcquire;
+        CursorState[entry + kEntryMode] = mode;
+        CursorState[entry + kEntryWindowX0] = asuint(window_min.x);
+        CursorState[entry + kEntryWindowY0] = asuint(window_min.y);
+        CursorState[entry + kEntryWindowX1] = asuint(window_max.x);
+        CursorState[entry + kEntryWindowY1] = asuint(window_max.y);
+        CursorState[kStatsBase + (mode == kModeTrack ? kStatTracked : kStatAcquired)] += 1u;
+    }
+    // The motion pass runs only when a view acquires.
+    CursorArguments[0] = acquiring ? TilesX : 0u;
+    CursorArguments[1] = acquiring ? TilesY : 1u;
+    CursorArguments[2] = acquiring ? ViewCount : 1u;
+}
+
+// Acquisition: one group per 32x32 tile of candidate positions per view,
+// listed for the search where the pose-compensated frame difference says
+// something moved against the scene (the tile and the template's reach
+// beyond it, every fourth pixel). At most kMaxHotTiles per view: past that
+// the frame is too busy to search and the view says so.
+[numthreads(64, 1, 1)]
+void CursorMotionCS(uint3 group_id : SV_GroupID, uint thread_index : SV_GroupIndex) {
+    uint view = min(group_id.z, 1u);
+    uint entry = entry_base(EntryIndex, view);
+    float4 rect = view_rect(view);
+    int2 rect_max = int2(rect.xy + rect.zw);
+    int2 tile_origin = int2(rect.xy) + int2(group_id.xy) * 32;
+    if (thread_index == 0u) {
+        bool wanted = group_id.z < ViewCount && all(tile_origin < rect_max) &&
+            CursorState[entry + kEntryMode] == kModeAcquire;
+        gs_mode = wanted ? kModeAcquire : kModeOff;
+        gs_flag = 0u;
+    }
+    GroupMemoryBarrierWithGroupSync();
+    if (gs_mode == kModeOff) {
+        return;
+    }
+    uint local = 0u;
+    for (uint i = 0; i < 4u; ++i) {
+        uint s = thread_index * 4u + i;
+        int2 p = tile_origin + int2(int(s % 16u), int(s / 16u)) * 4;
+        if (all(p < rect_max) && temporal_difference(p, view) > kHotDifference) {
+            ++local;
+        }
+    }
+    InterlockedAdd(gs_flag, local);
+    GroupMemoryBarrierWithGroupSync();
+    if (thread_index == 0u && gs_flag >= kHotSamples) {
+        uint order = kMaxHotTiles;
+        InterlockedAdd(CursorState[entry + kEntryHot], 1u, order);
+        if (order < kMaxHotTiles) {
+            append_tile(view, group_id.y * TilesX + group_id.x);
+        } else {
+            CursorState[entry + kEntryOverflow] = 1u;
+        }
+    }
+}
+
+[numthreads(1, 1, 1)]
+void CursorArgumentsCS() {
+    uint count = min(CursorState[kListCount], kMaxListEntries);
+    CursorArguments[3] = count;
+    CursorArguments[4] = count != 0u ? max(TemplateCount, 1u) : 1u;
+    CursorArguments[5] = 1u;
+}
+
+// One group per listed tile and template: every coarse candidate position
+// of the tile (every second pixel, one per thread), at the tracked scale or
+// all eight, against the template's coarse samples.
+[numthreads(256, 1, 1)]
+void CursorSearchCS(uint3 group_id : SV_GroupID, uint thread_index : SV_GroupIndex) {
+    uint list_index = group_id.x;
+    uint template_index = group_id.y;
+    if (thread_index == 0u) {
+        uint packed = CursorState[kListEntries + min(list_index, kMaxListEntries - 1u)];
+        uint view = min(packed >> 16, 1u);
+        uint tile = packed & 0xffffu;
+        uint entry = entry_base(EntryIndex, view);
+        float4 rect = view_rect(view);
+        gs_view = view;
+        gs_origin = int2(rect.xy) + int2(int(tile % max(TilesX, 1u)), int(tile / max(TilesX, 1u))) * 32;
+        gs_mode = CursorState[entry + kEntryMode];
+        gs_window = int4(
+            asint(CursorState[entry + kEntryWindowX0]),
+            asint(CursorState[entry + kEntryWindowY0]),
+            asint(CursorState[entry + kEntryWindowX1]),
+            asint(CursorState[entry + kEntryWindowY1]));
+        gs_scale = min(CursorState[entry + kEntryScale], kScaleCount - 1u);
+    }
+    GroupMemoryBarrierWithGroupSync();
+    uint view = gs_view;
+    uint mode = gs_mode;
+    int2 tile_origin = gs_origin;
+    int2 window_min = gs_window.xy;
+    int2 window_max = gs_window.zw;
+    uint scale_first = mode == kModeTrack ? gs_scale : 0u;
+    uint scale_last = mode == kModeTrack ? gs_scale : kScaleCount - 1u;
+    uint slice = view_slice(view);
+    float4 rect = view_rect(view);
+    int2 rect_min = int2(rect.xy);
+    int2 rect_max = int2(rect.xy + rect.zw);
+
+    uint count = min(load_template(template_index, thread_index), kCoarseSamples);
+    float template_mean = 0.0;
+    float template_spread = 0.0;
+    template_statistics(count, template_mean, template_spread);
+    float best = -2.0;
+    uint best_position = 0u;
+    int2 position = tile_origin + int2(int(thread_index % 16u), int(thread_index / 16u)) * 2;
+    bool inside = mode != kModeOff && template_index < TemplateCount && template_spread > 0.0 &&
+        all(position >= window_min) && all(position < window_max) && all(position >= rect_min);
+    uint best_scale = scale_first;
+    if (inside) {
+        for (uint scale_index = scale_first; scale_index <= scale_last; ++scale_index) {
+            float scale = kScales[scale_index];
+            int extent = int(ceil(float(kTemplateSize) * scale));
+            if (all(position + extent <= rect_max)) {
+                float score = correlation(position, scale, slice, count, template_mean, template_spread);
+                if (score > best) {
+                    best = score;
+                    best_scale = scale_index;
+                }
+            }
+        }
+        best_position = uint(position.x) | (uint(position.y) << 16);
+    }
+    gs_score[thread_index] = best;
+    gs_position[thread_index] = best_position;
+    gs_meta[thread_index] = template_index | (best_scale << 8);
+    GroupMemoryBarrierWithGroupSync();
+    for (uint stride = 128u; stride > 0u; stride >>= 1) {
+        if (thread_index < stride && gs_score[thread_index + stride] > gs_score[thread_index]) {
+            gs_score[thread_index] = gs_score[thread_index + stride];
+            gs_position[thread_index] = gs_position[thread_index + stride];
+            gs_meta[thread_index] = gs_meta[thread_index + stride];
+        }
+        GroupMemoryBarrierWithGroupSync();
+    }
+    if (thread_index == 0u && gs_score[0] > kCandidateScore) {
+        uint slot = list_index * kMaxTemplates + min(template_index, kMaxTemplates - 1u);
+        CursorCandidates[slot * 2u] = gs_position[0];
+        CursorCandidates[slot * 2u + 1u] = gs_meta[0];
+        uint quantised = uint(saturate(gs_score[0]) * 65535.0);
+        InterlockedMax(CursorState[entry_base(EntryIndex, view) + kEntryKey],
+            (quantised << 16) | (slot & 0xffffu));
+    }
+}
+
+// One group per view: the best candidate refined to the pixel with every
+// sample, and the best look-alike within 48 px that is not the cursor itself
+// (more than a quarter of the template box away on either axis) - every
+// second position on the coarse samples, its best refined with all of them,
+// so an identical sprite is found at its full score.
+[numthreads(1024, 1, 1)]
+void CursorVerifyCS(uint3 group_id : SV_GroupID, uint thread_index : SV_GroupIndex) {
+    uint view = min(group_id.z, 1u);
+    uint entry = entry_base(EntryIndex, view);
+    uint mode = group_id.z < ViewCount ? CursorState[entry + kEntryMode] : kModeOff;
+    uint key = CursorState[entry + kEntryKey];
+    uint slice = view_slice(view);
+    float4 rect = view_rect(view);
+    int2 rect_min = int2(rect.xy);
+    int2 rect_max = int2(rect.xy + rect.zw);
+    bool found = mode != kModeOff && key != 0u;
+    uint slot = min(key & 0xffffu, kMaxListEntries * kMaxTemplates - 1u);
+    uint packed = found ? CursorCandidates[slot * 2u] : 0u;
+    uint meta = found ? CursorCandidates[slot * 2u + 1u] : 0u;
+    int2 position = int2(int(packed & 0xffffu), int(packed >> 16));
+    uint template_index = min(meta & 0xffu, max(TemplateCount, 1u) - 1u);
+    uint scale_index = min((meta >> 8) & 0xffu, kScaleCount - 1u);
+    float scale = kScales[scale_index];
+    int extent = int(ceil(float(kTemplateSize) * scale));
+
+    uint count = load_template(template_index, thread_index);
+    uint coarse = min(count, kCoarseSamples);
+    float template_mean = 0.0;
+    float template_spread = 0.0;
+    template_statistics(count, template_mean, template_spread);
+    float coarse_mean = 0.0;
+    float coarse_spread = 0.0;
+    template_statistics(coarse, coarse_mean, coarse_spread);
+
+    float score = -2.0;
+    int2 refined = position;
+    if (found && thread_index < 25u) {
+        int2 candidate = position + int2(int(thread_index % 5u) - 2, int(thread_index / 5u) - 2);
+        if (all(candidate >= rect_min) && all(candidate + extent <= rect_max)) {
+            score = correlation(candidate, scale, slice, count, template_mean, template_spread);
+            refined = candidate;
+        }
+    }
+    // A shape template must also be the sprite's colour.
+    if (found && thread_index < 25u && score > 0.0) {
+        score *= shape_colour_match(template_index, refined, scale, slice, count);
+    }
+    gs_score[thread_index] = score;
+    gs_position[thread_index] = uint(refined.x) | (uint(refined.y) << 16);
+    GroupMemoryBarrierWithGroupSync();
+    for (uint stride = 512u; stride > 0u; stride >>= 1) {
+        if (thread_index < stride && gs_score[thread_index + stride] > gs_score[thread_index]) {
+            gs_score[thread_index] = gs_score[thread_index + stride];
+            gs_position[thread_index] = gs_position[thread_index + stride];
+        }
+        GroupMemoryBarrierWithGroupSync();
+    }
+    float best = gs_score[0];
+    uint best_packed = gs_position[0];
+    int2 best_position = int2(int(best_packed & 0xffffu), int(best_packed >> 16));
+    GroupMemoryBarrierWithGroupSync();
+
+    int exclusion = max(4, int(ceil(8.0 * scale)));
+    float second = 0.0;
+    int2 second_position = best_position;
+    if (found) {
+        for (uint i = thread_index; i < 49u * 49u; i += 1024u) {
+            int2 offset = int2(int(i % 49u) * 2 - 48, int(i / 49u) * 2 - 48);
+            if (max(abs(offset.x), abs(offset.y)) > exclusion) {
+                int2 candidate = best_position + offset;
+                if (all(candidate >= rect_min) && all(candidate + extent <= rect_max)) {
+                    float value = correlation(candidate, scale, slice, coarse, coarse_mean, coarse_spread);
+                    if (value > second) {
+                        second = value;
+                        second_position = candidate;
+                    }
+                }
+            }
+        }
+    }
+    gs_score[thread_index] = second;
+    gs_position[thread_index] = uint(second_position.x) | (uint(second_position.y) << 16);
+    GroupMemoryBarrierWithGroupSync();
+    for (uint stride2 = 512u; stride2 > 0u; stride2 >>= 1) {
+        if (thread_index < stride2 && gs_score[thread_index + stride2] > gs_score[thread_index]) {
+            gs_score[thread_index] = gs_score[thread_index + stride2];
+            gs_position[thread_index] = gs_position[thread_index + stride2];
+        }
+        GroupMemoryBarrierWithGroupSync();
+    }
+    float coarse_second = gs_score[0];
+    uint coarse_packed = gs_position[0];
+    int2 coarse_position = int2(int(coarse_packed & 0xffffu), int(coarse_packed >> 16));
+    GroupMemoryBarrierWithGroupSync();
+    float refined_second = 0.0;
+    if (found && coarse_second > 0.0 && thread_index < 9u) {
+        int2 candidate = coarse_position + int2(int(thread_index % 3u) - 1, int(thread_index / 3u) - 1);
+        int2 apart = abs(candidate - best_position);
+        if (max(apart.x, apart.y) > exclusion &&
+            all(candidate >= rect_min) && all(candidate + extent <= rect_max)) {
+            refined_second = correlation(candidate, scale, slice, count, template_mean, template_spread);
+        }
+    }
+    gs_score[thread_index] = refined_second;
+    GroupMemoryBarrierWithGroupSync();
+    for (uint stride3 = 512u; stride3 > 0u; stride3 >>= 1) {
+        if (thread_index < stride3) {
+            gs_score[thread_index] = max(gs_score[thread_index], gs_score[thread_index + stride3]);
+        }
+        GroupMemoryBarrierWithGroupSync();
+    }
+
+    if (thread_index == 0u && mode != kModeOff) {
+        uint status = kStatusNone;
+        if (found && best > kCandidateScore) {
+            status = kStatusFound;
+        } else if (CursorState[entry + kEntryOverflow] != 0u) {
+            status = kStatusBusy;
+        }
+        CursorState[entry + kEntryStatus] = status;
+        CursorState[entry + kEntryX] = asuint(best_position.x);
+        CursorState[entry + kEntryY] = asuint(best_position.y);
+        CursorState[entry + kEntryTemplate] = template_index;
+        CursorState[entry + kEntryScale] = scale_index;
+        CursorState[entry + kEntryScore] = asuint(found ? best : 0.0);
+        // The coarse score alone stands where the refinement found nothing
+        // better (it is never above the refined one at the same place).
+        CursorState[entry + kEntrySecond] = asuint(max(gs_score[0], coarse_second));
+    }
+}
+
+// Why a pair was not drawn, in the order the gate tests.
+static const uint kReasonNone = 0;
+static const uint kReasonBusy = 1;
+static const uint kReasonNotFound = 2;
+static const uint kReasonScore = 3;
+static const uint kReasonMargin = 4;
+static const uint kReasonStereo = 5;
+static const uint kReasonJump = 6;
+
+struct Detection {
+    uint status;
+    float2 position;
+    uint template_index;
+    uint scale_index;
+    float score;
+    float second;
+};
+
+Detection load_detection(uint ring, uint view) {
+    uint entry = entry_base(ring, view);
+    Detection output;
+    output.status = CursorState[entry + kEntryStatus];
+    output.position = float2(
+        float(asint(CursorState[entry + kEntryX])),
+        float(asint(CursorState[entry + kEntryY])));
+    output.template_index = CursorState[entry + kEntryTemplate];
+    output.scale_index = min(CursorState[entry + kEntryScale], kScaleCount - 1u);
+    output.score = asfloat(CursorState[entry + kEntryScore]);
+    output.second = asfloat(CursorState[entry + kEntrySecond]);
+    return output;
+}
+
+uint judge_detection(Detection detection) {
+    uint reason = kReasonNone;
+    if (detection.status == kStatusBusy) {
+        reason = kReasonBusy;
+    } else if (detection.status != kStatusFound) {
+        reason = kReasonNotFound;
+    } else if (detection.score < kAcceptScore) {
+        reason = kReasonScore;
+    } else if (detection.score - detection.second < kAcceptMargin) {
+        reason = kReasonMargin;
+    }
+    return reason;
+}
+
+// EntryIndex: the current frame's entry; TrackIndex: the previous frame's.
+[numthreads(1, 1, 1)]
+void CursorGateCS() {
+    uint reason = kReasonNone;
+    Detection previous[2];
+    Detection current[2];
+    float2 moved[2];
+    uint views = min(ViewCount, 2u);
+    [unroll] for (uint v = 0; v < 2u; ++v) {
+        previous[v] = load_detection(min(TrackIndex, 1u), v);
+        current[v] = load_detection(EntryIndex, v);
+        // The previous position in the current frame's image rectangle
+        // (they differ only for double-wide views).
+        moved[v] = current[v].position -
+            (previous[v].position - Mappings[v].SourceRect.xy + Mappings[v].TargetRect.xy);
+    }
+    for (uint view = 0; view < views && reason == kReasonNone; ++view) {
+        uint a = judge_detection(previous[view]);
+        uint b = judge_detection(current[view]);
+        reason = a != kReasonNone ? a : b;
+    }
+    if (TrackIndex >= 2u) {
+        reason = kReasonNotFound;
+    }
+    float limit = 0.3 * float(Width);
+    if (reason == kReasonNone) {
+        for (uint view2 = 0; view2 < views; ++view2) {
+            float distance = length(moved[view2]);
+            // View-locked: it moves only with the mouse. Still mouse, moving
+            // match: not the cursor.
+            bool still_mouse = (Flags & 4u) != 0u && all(MouseDelta == float2(0.0, 0.0));
+            if (distance > limit || (still_mouse && distance > 4.0)) {
+                reason = kReasonJump;
+            }
+        }
+    }
+    if (reason == kReasonNone && views == 2u) {
+        // Both eyes see the same sprite: the same template at about the same
+        // size, at a plausible offset, moving by the same amount.
+        float dy = current[1].position.y - Mappings[1].TargetRect.y -
+            (current[0].position.y - Mappings[0].TargetRect.y);
+        float dx = current[1].position.x - Mappings[1].TargetRect.x -
+            (current[0].position.x - Mappings[0].TargetRect.x);
+        float scale_ratio = kScales[current[1].scale_index] / kScales[current[0].scale_index];
+        bool stereo_known = CursorState[kStereoBase + 1u] != 0u;
+        float vertical_tolerance = stereo_known
+            ? 4.0 + 0.01 * float(Height)
+            : 0.06 * float(Height);
+        float expected_dy = stereo_known ? asfloat(CursorState[kStereoBase]) : 0.0;
+        if (current[0].template_index != current[1].template_index ||
+            previous[0].template_index != previous[1].template_index ||
+            scale_ratio < 0.75 || scale_ratio > 1.34 ||
+            abs(dy - expected_dy) > vertical_tolerance ||
+            abs(dx) > 0.3 * float(Width)) {
+            reason = kReasonStereo;
+        } else {
+            float disagreement = length(moved[1] - moved[0]);
+            if (disagreement > 3.0 + 0.15 * max(length(moved[0]), length(moved[1]))) {
+                reason = kReasonJump;
+            }
+        }
+    }
+
+    CursorState[kStatsBase + kStatPairs] += 1u;
+    for (uint view3 = 0; view3 < 2u; ++view3) {
+        uint record = kCompositeBase + view3 * 16u;
+        bool draw = reason == kReasonNone && view3 < views;
+        CursorState[record + 0u] = draw ? 1u : 0u;
+        CursorState[record + 1u] = asuint(previous[view3].position.x);
+        CursorState[record + 2u] = asuint(previous[view3].position.y);
+        CursorState[record + 3u] = asuint(current[view3].position.x);
+        CursorState[record + 4u] = asuint(current[view3].position.y);
+        CursorState[record + 5u] = min(previous[view3].template_index, kMaxTemplates - 1u);
+        CursorState[record + 6u] = min(current[view3].template_index, kMaxTemplates - 1u);
+        CursorState[record + 7u] = asuint(kScales[previous[view3].scale_index]);
+        CursorState[record + 8u] = asuint(kScales[current[view3].scale_index]);
+    }
+    if (reason == kReasonNone) {
+        CursorState[kStatsBase + kStatDrawn] += 1u;
+        // Learn the mouse-to-image gain (for the next tracking window) and
+        // the eyes' vertical offset (for the stereo test).
+        for (uint view4 = 0; view4 < views; ++view4) {
+            uint learn = kLearnBase + view4 * 8u;
+            bool known = CursorState[learn + 2u] != 0u;
+            float2 gain = float2(asfloat(CursorState[learn]), asfloat(CursorState[learn + 1u]));
+            if ((Flags & 4u) != 0u) {
+                [unroll] for (uint axis = 0; axis < 2u; ++axis) {
+                    float mouse = MouseDelta[axis];
+                    float image = moved[view4][axis];
+                    if (abs(mouse) >= 3.0 && abs(image) >= 2.0 && sign(mouse) == sign(image)) {
+                        float sample_gain = clamp(image / mouse, 0.05, 20.0);
+                        gain[axis] = known && gain[axis] > 0.0 ? lerp(gain[axis], sample_gain, 0.3) : sample_gain;
+                        CursorState[learn + 2u] = 1u;
+                    }
+                }
+            }
+            CursorState[learn] = asuint(gain.x);
+            CursorState[learn + 1u] = asuint(gain.y);
+        }
+        if (views == 2u) {
+            float dy = current[1].position.y - Mappings[1].TargetRect.y -
+                (current[0].position.y - Mappings[0].TargetRect.y);
+            bool stereo_known = CursorState[kStereoBase + 1u] != 0u;
+            float learned = stereo_known ? lerp(asfloat(CursorState[kStereoBase]), dy, 0.2) : dy;
+            CursorState[kStereoBase] = asuint(learned);
+            CursorState[kStereoBase + 1u] = 1u;
+        }
+    } else {
+        uint counter = kStatNotFound;
+        if (reason == kReasonBusy) {
+            counter = kStatBusy;
+        } else if (reason == kReasonScore) {
+            counter = kStatScore;
+        } else if (reason == kReasonMargin) {
+            counter = kStatMargin;
+        } else if (reason == kReasonStereo) {
+            counter = kStatStereo;
+        } else if (reason == kReasonJump) {
+            counter = kStatJump;
+        }
+        CursorState[kStatsBase + counter] += 1u;
+    }
+}
diff --git a/src/d3d12/smooth_cursor_templates.cpp b/src/d3d12/smooth_cursor_templates.cpp
new file mode 100644
index 0000000..f15ae66
--- /dev/null
+++ b/src/d3d12/smooth_cursor_templates.cpp
@@ -0,0 +1,249 @@
+#include "xrfg/smooth_cursor_templates.hpp"
+
+#include <windows.h>
+
+#include <array>
+#include <cstring>
+
+namespace xrfg {
+namespace {
+
+constexpr std::array<std::uint16_t, 16> kCockpitCursorIds{
+    116, 132, 145, 146, 147, 148, 149, 151,
+    301, 302, 303, 306, 307, 308, 309, 310,
+};
+
+[[nodiscard]] std::uint32_t read_u32(std::span<const std::uint8_t> bytes, std::size_t at) noexcept {
+    return static_cast<std::uint32_t>(bytes[at]) |
+        (static_cast<std::uint32_t>(bytes[at + 1]) << 8U) |
+        (static_cast<std::uint32_t>(bytes[at + 2]) << 16U) |
+        (static_cast<std::uint32_t>(bytes[at + 3]) << 24U);
+}
+
+[[nodiscard]] std::uint16_t read_u16(std::span<const std::uint8_t> bytes, std::size_t at) noexcept {
+    return static_cast<std::uint16_t>(
+        bytes[at] | (static_cast<std::uint16_t>(bytes[at + 1]) << 8U));
+}
+
+[[nodiscard]] std::span<const std::uint8_t> resource_bytes(
+    HMODULE module, LPCWSTR name, LPCWSTR type) noexcept {
+    HRSRC found = FindResourceW(module, name, type);
+    if (found == nullptr) {
+        return {};
+    }
+    HGLOBAL loaded = LoadResource(module, found);
+    const DWORD size = SizeofResource(module, found);
+    const void* data = loaded == nullptr ? nullptr : LockResource(loaded);
+    if (data == nullptr || size == 0) {
+        return {};
+    }
+    return {static_cast<const std::uint8_t*>(data), size};
+}
+
+// One cursor group's 32x32 image, decoded.
+[[nodiscard]] bool load_group(HMODULE module, std::uint16_t id, D3D12CursorTemplate* output) noexcept {
+    const auto group = resource_bytes(
+        module, MAKEINTRESOURCEW(id), MAKEINTRESOURCEW(12) /* RT_GROUP_CURSOR */);
+    if (group.size() < 6U || read_u16(group, 2) != 2U) {
+        return false;
+    }
+    const std::uint16_t count = read_u16(group, 4);
+    for (std::uint16_t entry = 0; entry < count; ++entry) {
+        const std::size_t at = 6U + static_cast<std::size_t>(entry) * 14U;
+        if (at + 14U > group.size()) {
+            break;
+        }
+        // CURSORDIR: width, height (doubled), planes, bit count, bytes, id.
+        if (read_u16(group, at) != kD3D12CursorTemplateSize) {
+            continue;
+        }
+        const std::uint16_t image = read_u16(group, at + 12U);
+        const auto bits = resource_bytes(
+            module, MAKEINTRESOURCEW(image), MAKEINTRESOURCEW(1) /* RT_CURSOR */);
+        if (decode_cursor_resource(bits, output)) {
+            output->source_id = id;
+            return true;
+        }
+    }
+    return false;
+}
+
+[[nodiscard]] std::vector<D3D12CursorTemplate> load_module(HMODULE module) noexcept {
+    std::vector<D3D12CursorTemplate> templates;
+    try {
+        for (const std::uint16_t id : kCockpitCursorIds) {
+            D3D12CursorTemplate decoded{};
+            if (load_group(module, id, &decoded)) {
+                templates.push_back(decoded);
+            }
+        }
+    } catch (...) {
+        templates.clear();
+    }
+    return templates;
+}
+
+}  // namespace
+
+std::span<const std::uint16_t> dcs_cockpit_cursor_ids() noexcept {
+    return kCockpitCursorIds;
+}
+
+bool decode_cursor_resource(
+    std::span<const std::uint8_t> bits,
+    D3D12CursorTemplate* output) noexcept {
+    if (output == nullptr || bits.size() < 4U + 40U) {
+        return false;
+    }
+    // A hotspot (two words), then BITMAPINFOHEADER with the height doubled
+    // (XOR image above the AND mask). A PNG cursor is not decoded.
+    const auto dib = bits.subspan(4U);
+    const std::uint32_t header_size = read_u32(dib, 0);
+    const auto width = static_cast<std::int32_t>(read_u32(dib, 4));
+    const auto doubled_height = static_cast<std::int32_t>(read_u32(dib, 8));
+    const std::uint16_t bit_count = read_u16(dib, 14);
+    const std::uint32_t compression = read_u32(dib, 16);
+    std::uint32_t colours_used = read_u32(dib, 32);
+    constexpr auto kSize = static_cast<std::int32_t>(kD3D12CursorTemplateSize);
+    if (header_size < 40U || width != kSize || doubled_height != 2 * kSize ||
+        compression != 0U /* BI_RGB */ ||
+        (bit_count != 1U && bit_count != 4U && bit_count != 8U &&
+         bit_count != 24U && bit_count != 32U)) {
+        return false;
+    }
+    if (colours_used == 0U && bit_count <= 8U) {
+        colours_used = 1U << bit_count;
+    }
+    const std::size_t palette_at = header_size;
+    const std::size_t pixels_at = palette_at + static_cast<std::size_t>(colours_used) * 4U;
+    const std::size_t stride = ((static_cast<std::size_t>(kSize) * bit_count + 31U) / 32U) * 4U;
+    const std::size_t mask_at = pixels_at + stride * kSize;
+    const std::size_t mask_stride = ((static_cast<std::size_t>(kSize) + 31U) / 32U) * 4U;
+    if (dib.size() < mask_at + mask_stride * kSize) {
+        return false;
+    }
+    bool any_alpha = false;
+    std::array<std::uint32_t, kD3D12CursorTemplateSize * kD3D12CursorTemplateSize> rgba{};
+    std::array<bool, kD3D12CursorTemplateSize * kD3D12CursorTemplateSize> masked{};
+    for (std::int32_t y = 0; y < kSize; ++y) {
+        // Bottom-up rows.
+        const std::size_t row = pixels_at + stride * static_cast<std::size_t>(kSize - 1 - y);
+        const std::size_t mask_row = mask_at + mask_stride * static_cast<std::size_t>(kSize - 1 - y);
+        for (std::int32_t x = 0; x < kSize; ++x) {
+            std::uint32_t r = 0;
+            std::uint32_t g = 0;
+            std::uint32_t b = 0;
+            std::uint32_t a = 255;
+            if (bit_count == 32U) {
+                const std::size_t at = row + static_cast<std::size_t>(x) * 4U;
+                b = dib[at];
+                g = dib[at + 1];
+                r = dib[at + 2];
+                a = dib[at + 3];
+                any_alpha = any_alpha || a != 0U;
+            } else if (bit_count == 24U) {
+                const std::size_t at = row + static_cast<std::size_t>(x) * 3U;
+                b = dib[at];
+                g = dib[at + 1];
+                r = dib[at + 2];
+            } else {
+                const std::size_t bit = static_cast<std::size_t>(x) * bit_count;
+                const std::uint8_t byte = dib[row + bit / 8U];
+                const std::uint32_t index = (byte >> (8U - bit_count - (bit % 8U))) &
+                    ((1U << bit_count) - 1U);
+                if (index >= colours_used) {
+                    return false;
+                }
+                const std::size_t at = palette_at + static_cast<std::size_t>(index) * 4U;
+                b = dib[at];
+                g = dib[at + 1];
+                r = dib[at + 2];
+            }
+            const std::size_t texel = static_cast<std::size_t>(y) * kSize + static_cast<std::size_t>(x);
+            masked[texel] = ((dib[mask_row + static_cast<std::size_t>(x) / 8U] >>
+                                 (7U - static_cast<std::uint32_t>(x) % 8U)) & 1U) != 0U;
+            rgba[texel] = r | (g << 8U) | (b << 16U) | (a << 24U);
+        }
+    }
+    for (std::size_t texel = 0; texel < rgba.size(); ++texel) {
+        // Without alpha the AND mask says what is transparent. (An inverting
+        // pixel - mask set, colour non-zero - is left out: DCS has none.)
+        if (!any_alpha || bit_count != 32U) {
+            const std::uint32_t alpha = masked[texel] ? 0U : 255U;
+            rgba[texel] = (rgba[texel] & 0x00ffffffU) | (alpha << 24U);
+        }
+    }
+    output->rgba = rgba;
+    return true;
+}
+
+D3D12CursorTemplate built_in_arrow_template() noexcept {
+    // The arrow's body: rows 0-15 widen one texel per row; the tail runs
+    // down from the notch. Outlined by one dark texel.
+    constexpr auto kSize = static_cast<int>(kD3D12CursorTemplateSize);
+    std::array<bool, kD3D12CursorTemplateSize * kD3D12CursorTemplateSize> body{};
+    const auto inside = [](int x, int y) {
+        const bool head = y >= 1 && y <= 16 && x >= 1 && x <= 1 + (y - 1) * 6 / 10;
+        const bool tail = y >= 12 && y <= 19 && x >= 4 + (y - 12) / 2 && x <= 6 + (y - 12) / 2;
+        return head || tail;
+    };
+    for (int y = 0; y < kSize; ++y) {
+        for (int x = 0; x < kSize; ++x) {
+            body[static_cast<std::size_t>(y * kSize + x)] = inside(x, y);
+        }
+    }
+    D3D12CursorTemplate output{};
+    for (int y = 0; y < kSize; ++y) {
+        for (int x = 0; x < kSize; ++x) {
+            const std::size_t texel = static_cast<std::size_t>(y * kSize + x);
+            bool outline = false;
+            for (int dy = -1; dy <= 1 && !body[texel]; ++dy) {
+                for (int dx = -1; dx <= 1; ++dx) {
+                    const int nx = x + dx;
+                    const int ny = y + dy;
+                    if (nx >= 0 && ny >= 0 && nx < kSize && ny < kSize &&
+                        body[static_cast<std::size_t>(ny * kSize + nx)]) {
+                        outline = true;
+                    }
+                }
+            }
+            output.rgba[texel] = body[texel] ? 0xffffffffU : (outline ? 0xff141414U : 0U);
+        }
+    }
+    output.source_id = 0;
+    return output;
+}
+
+CursorTemplateSet load_dcs_cursor_templates(const std::filesystem::path& directory) noexcept {
+    CursorTemplateSet output{};
+    if (HMODULE in_process = GetModuleHandleW(L"Visualizer.dll"); in_process != nullptr) {
+        output.templates = load_module(in_process);
+        if (!output.templates.empty()) {
+            output.source = CursorTemplateSource::dcs_process;
+            return output;
+        }
+    }
+    try {
+        if (!directory.empty()) {
+            const std::filesystem::path file = directory / L"Visualizer.dll";
+            HMODULE data = LoadLibraryExW(file.c_str(), nullptr,
+                LOAD_LIBRARY_AS_DATAFILE | LOAD_LIBRARY_AS_IMAGE_RESOURCE);
+            if (data != nullptr) {
+                output.templates = load_module(data);
+                FreeLibrary(data);
+                if (!output.templates.empty()) {
+                    output.source = CursorTemplateSource::dcs_file;
+                    return output;
+                }
+            }
+        }
+        output.templates.assign(1, built_in_arrow_template());
+        output.source = CursorTemplateSource::built_in;
+    } catch (...) {
+        output.templates.clear();
+        output.source = CursorTemplateSource::none;
+    }
+    return output;
+}
+
+}  // namespace xrfg
