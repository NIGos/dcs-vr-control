diff --git a/include/xrfg/smooth_cursor_templates.hpp b/include/xrfg/smooth_cursor_templates.hpp
new file mode 100644
index 0000000..e0e939e
--- /dev/null
+++ b/include/xrfg/smooth_cursor_templates.hpp
@@ -0,0 +1,56 @@
+#pragma once
+
+// DCS VR Control (0010): the cursor images the smooth cursor matches. They are
+// not shipped: DCS keeps its cursors as Windows cursor resources in its own
+// bin\Visualizer.dll (32x32, 32-bit with alpha), and they are read from the
+// copy the running game has loaded, or from the file in a directory the ini
+// names, at the moment the synthesis is set up. A built-in arrow stands in
+// where neither is found.
+
+#include "xrfg/d3d12_frame_synthesizer.hpp"
+
+#include <cstdint>
+#include <filesystem>
+#include <span>
+#include <vector>
+
+namespace xrfg {
+
+enum class CursorTemplateSource : std::uint32_t {
+    none = 0,
+    // Visualizer.dll as loaded in this process (the game itself).
+    dcs_process = 1,
+    // Visualizer.dll in the directory `[ofxr] cursor_templates` names.
+    dcs_file = 2,
+    built_in = 3,
+};
+
+struct CursorTemplateSet {
+    std::vector<D3D12CursorTemplate> templates;
+    CursorTemplateSource source{CursorTemplateSource::none};
+};
+
+// The cursor resources DCS shows in a cockpit (by resource id in
+// Visualizer.dll): the arrows (116 white, 132 red), the clickable-control
+// markers (145-151) and the newer outlined set (301-310), at most
+// kD3D12MaxCursorTemplates of them.
+[[nodiscard]] std::span<const std::uint16_t> dcs_cockpit_cursor_ids() noexcept;
+
+// Decodes the bits of one RT_CURSOR resource (a hotspot, then a DIB with its
+// AND mask) into a 32x32 template. 32-bit images keep their alpha; 1, 4, 8
+// and 24-bit ones take it from the AND mask. False for any other size or
+// format, or a malformed resource.
+[[nodiscard]] bool decode_cursor_resource(
+    std::span<const std::uint8_t> bits,
+    D3D12CursorTemplate* output) noexcept;
+
+// A plain arrow, white with a dark outline, about 12x19 texels, in the
+// manner of every desktop pointer.
+[[nodiscard]] D3D12CursorTemplate built_in_arrow_template() noexcept;
+
+// The game's own module first, then `directory`\Visualizer.dll when one is
+// given, then the built-in arrow.
+[[nodiscard]] CursorTemplateSet load_dcs_cursor_templates(
+    const std::filesystem::path& directory) noexcept;
+
+}  // namespace xrfg
