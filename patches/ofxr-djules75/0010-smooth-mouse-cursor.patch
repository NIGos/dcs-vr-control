+    void note_cursor_position(
+        std::int32_t x, std::int32_t y, std::uint64_t milliseconds) noexcept {
+        cursor_now_milliseconds = milliseconds;
+        if (cursor_position_known && (x != cursor_x || y != cursor_y)) {
+            cursor_moved_milliseconds = milliseconds;
+        }
+        cursor_x = x;
+        cursor_y = y;
+        cursor_position_known = true;
+    }
+
+    // What this pair does about the cursor: nothing unless the feature is on
+    // and the mouse moved within the active window. A frame whose detection
+    // the ring still holds (the previous pair's current frame) is not
+    // searched again.
+    void plan_cursor(std::uint64_t previous_serial, UINT view_count) noexcept {
+        cursor_plan = {};
+        if (!cursor_enabled || view_count == 0 || view_count > kMaxReprojectionViews) {
+            return;
+        }
+        const bool active = cursor_position_known && cursor_moved_milliseconds != 0 &&
+            cursor_now_milliseconds >= cursor_moved_milliseconds &&
+            cursor_now_milliseconds - cursor_moved_milliseconds <= cursor_active_milliseconds;
+        if (!active) {
+            ++cursor_stats.idle_pairs;
+            return;
+        }
+        cursor_plan.run = true;
+        cursor_plan.detect_previous = true;
+        cursor_plan.previous_entry = 0;
+        for (UINT entry = 0; entry < 2U; ++entry) {
+            if (previous_serial != 0 && cursor_entry_serial[entry] == previous_serial) {
+                cursor_plan.previous_entry = entry;
+                cursor_plan.detect_previous = false;
+            }
+        }
+        cursor_plan.current_entry = 1U - cursor_plan.previous_entry;
+        cursor_plan.mouse_known =
+            previous_serial != 0 && cursor_pointer_serial == previous_serial;
+        if (cursor_plan.mouse_known) {
+            cursor_plan.mouse_delta = {
+                static_cast<float>(cursor_x - cursor_pointer_x),
+                static_cast<float>(cursor_y - cursor_pointer_y)};
+        }
+    }
+
+    // After a submission: which frames the ring now holds, and the pointer
+    // this frame was submitted with.
+    void finish_cursor_pair(
+        WorkSlot& slot,
+        std::uint64_t previous_serial,
+        std::uint64_t current_serial,
+        bool submitted) noexcept {
+        if (cursor_plan.run) {
+            if (submitted && slot.cursor_recorded) {
+                cursor_entry_serial[cursor_plan.previous_entry] = previous_serial;
+                cursor_entry_serial[cursor_plan.current_entry] = current_serial;
+                slot.cursor_order = cursor_next_order++;
+            } else {
+                cursor_entry_serial = {};
+            }
+        }
+        if (cursor_position_known) {
+            cursor_pointer_serial = current_serial;
+            cursor_pointer_x = cursor_x;
+            cursor_pointer_y = cursor_y;
+        }
+        cursor_plan = {};
+    }
+
+    // Finds the cursor in this pair's frames and writes the gate's record
+    // (smooth_cursor.hlsl). Both frames must be in a shader-read state, with
+    // their views in the slot's first descriptor block. Leaves the state
+    // readable by the composition that follows in the same list (a later
+    // list finds it decayed to COMMON, from which a read promotes it).
+    void record_cursor_detection(
+        ID3D12GraphicsCommandList* list,
+        WorkSlot& slot,
+        const RollingSource& previous_source,
+        std::span<const D3D12ReprojectionView> target_views) noexcept {
+        const UINT slot_index = static_cast<UINT>(&slot - work_slots.data());
+        ID3D12DescriptorHeap* heaps[] = {slot.descriptor_heap.Get()};
+        list->SetDescriptorHeaps(1, heaps);
+        list->SetComputeRootSignature(cursor_root_signature.Get());
+        list->SetComputeRootDescriptorTable(
+            0, slot.descriptor_heap->GetGPUDescriptorHandleForHeapStart());
+        list->SetComputeRootShaderResourceView(1, cursor_templates->GetGPUVirtualAddress());
+        list->SetComputeRootUnorderedAccessView(2, cursor_state->GetGPUVirtualAddress());
+        list->SetComputeRootUnorderedAccessView(3, cursor_candidates->GetGPUVirtualAddress());
+        list->SetComputeRootUnorderedAccessView(4, cursor_arguments->GetGPUVirtualAddress());
+        slot.cursor_timed = nvidia_gpu_timing_enabled && nvidia_timestamp_heap != nullptr;
+        if (slot.cursor_timed) {
+            list->EndQuery(nvidia_timestamp_heap.Get(), D3D12_QUERY_TYPE_TIMESTAMP,
+                slot.timing_query_base + kCursorBegin);
+        }
+        CursorParameters parameters{};
+        parameters.width = static_cast<UINT>(image_description.Width);
+        parameters.height = image_description.Height;
+        parameters.template_count = cursor_template_count;
+        parameters.tiles_x = cursor_tiles_x;
+        parameters.tiles_y = cursor_tiles_y;
+        const UINT view_count = static_cast<UINT>(
+            std::min<std::size_t>(target_views.size(), kMaxReprojectionViews));
+        parameters.view_info = view_count;
+        for (UINT view = 0; view < view_count; ++view) {
+            const UINT slice = resolved_array_slice(
+                target_views[view], view, target_views.size(),
+                image_description.DepthOrArraySize);
+            parameters.view_info |= (slice & 0xffU) << (8U + 8U * view);
+            parameters.mappings[view] = make_camera_mapping(
+                previous_source.views[view], target_views[view],
+                static_cast<UINT>(image_description.Width), image_description.Height);
+        }
+        const UINT base_flags = (srgb_view_format(view_format) ? kCursorFlagLinear : 0U) |
+            (cursor_plan.mouse_known ? kCursorFlagMouseKnown : 0U);
+        const std::array<D3D12_RESOURCE_BARRIER, 2> uav{
+            uav_barrier(cursor_state.Get()), uav_barrier(cursor_candidates.Get())};
+        // The dispatch sizes go from written (UAV) to read as arguments and
+        // back, with the state's and candidates' writes made visible too.
+        const std::array<D3D12_RESOURCE_BARRIER, 3> to_arguments{
+            uav_barrier(cursor_state.Get()), uav_barrier(cursor_candidates.Get()),
+            transition_barrier(cursor_arguments.Get(),
+                D3D12_RESOURCE_STATE_UNORDERED_ACCESS,
+                D3D12_RESOURCE_STATE_INDIRECT_ARGUMENT)};
+        const std::array<D3D12_RESOURCE_BARRIER, 3> from_arguments{
+            uav_barrier(cursor_state.Get()), uav_barrier(cursor_candidates.Get()),
+            transition_barrier(cursor_arguments.Get(),
+                D3D12_RESOURCE_STATE_INDIRECT_ARGUMENT,
+                D3D12_RESOURCE_STATE_UNORDERED_ACCESS)};
+        const auto detect = [&](UINT entry, UINT track, bool previous,
+                                std::array<float, 2> mouse) {
+            parameters.entry_index = entry;
+            parameters.track_index = track;
+            parameters.flags = base_flags | (previous ? kCursorFlagPrevious : 0U);
+            parameters.mouse_delta = mouse;
+            list->SetComputeRoot32BitConstants(5, kCursorConstantCount, &parameters, 0);
+            list->SetPipelineState(cursor_begin_pipeline.Get());
+            list->Dispatch(1, 1, 1);
+            list->ResourceBarrier(static_cast<UINT>(to_arguments.size()), to_arguments.data());
+            list->SetPipelineState(cursor_motion_pipeline.Get());
+            list->ExecuteIndirect(cursor_dispatch_signature.Get(), 1,
+                cursor_arguments.Get(), 0, nullptr, 0);
+            list->ResourceBarrier(static_cast<UINT>(from_arguments.size()), from_arguments.data());
+            list->SetPipelineState(cursor_arguments_pipeline.Get());
+            list->Dispatch(1, 1, 1);
+            list->ResourceBarrier(static_cast<UINT>(to_arguments.size()), to_arguments.data());
+            list->SetPipelineState(cursor_search_pipeline.Get());
+            list->ExecuteIndirect(cursor_dispatch_signature.Get(), 1,
+                cursor_arguments.Get(), sizeof(D3D12_DISPATCH_ARGUMENTS), nullptr, 0);
+            list->ResourceBarrier(static_cast<UINT>(from_arguments.size()), from_arguments.data());
+            list->SetPipelineState(cursor_verify_pipeline.Get());
+            list->Dispatch(1, 1, view_count);
+            list->ResourceBarrier(static_cast<UINT>(uav.size()), uav.data());
+        };
+        dred_marker(list, "OFXR smooth cursor detection");
+        if (cursor_plan.detect_previous) {
+            detect(cursor_plan.previous_entry, kCursorNoEntry, true,
+                {-cursor_plan.mouse_delta[0], -cursor_plan.mouse_delta[1]});
+        }
+        detect(cursor_plan.current_entry, cursor_plan.previous_entry, false,
+            cursor_plan.mouse_delta);
+        parameters.entry_index = cursor_plan.current_entry;
+        parameters.track_index = cursor_plan.previous_entry;
+        parameters.flags = base_flags;
+        parameters.mouse_delta = cursor_plan.mouse_delta;
+        list->SetComputeRoot32BitConstants(5, kCursorConstantCount, &parameters, 0);
+        list->SetPipelineState(cursor_gate_pipeline.Get());
+        list->Dispatch(1, 1, 1);
+        // The counters go to this slot's readback region, read when the slot
+        // is next taken.
+        const D3D12_RESOURCE_BARRIER to_copy = transition_barrier(
+            cursor_state.Get(), D3D12_RESOURCE_STATE_UNORDERED_ACCESS,
+            D3D12_RESOURCE_STATE_COPY_SOURCE);
+        list->ResourceBarrier(1, &to_copy);
+        list->CopyBufferRegion(
+            cursor_stats_readback.Get(), static_cast<UINT64>(slot_index) * 64U,
+            cursor_state.Get(), static_cast<UINT64>(kCursorStatsBase) * sizeof(std::uint32_t),
+            static_cast<UINT64>(kCursorStatsWords) * sizeof(std::uint32_t));
+        // The composition reads the record through a shader resource view.
+        const D3D12_RESOURCE_BARRIER to_read = transition_barrier(
+            cursor_state.Get(), D3D12_RESOURCE_STATE_COPY_SOURCE, kShaderReadState);
+        list->ResourceBarrier(1, &to_read);
+        if (slot.cursor_timed) {
+            list->EndQuery(nvidia_timestamp_heap.Get(), D3D12_QUERY_TYPE_TIMESTAMP,
+                slot.timing_query_base + kCursorEnd);
+        }
+        slot.cursor_recorded = true;
+    }
+
+    // Every mark a resolve reads has to have been written: a pair without the
+    // detection writes the two cursor marks as an empty interval.
+    void write_unused_cursor_marks(ID3D12GraphicsCommandList* list, WorkSlot& slot) noexcept {
+        if (!slot.cursor_timed && nvidia_timestamp_heap != nullptr) {
+            list->EndQuery(nvidia_timestamp_heap.Get(), D3D12_QUERY_TYPE_TIMESTAMP,
+                slot.timing_query_base + kCursorBegin);
+            list->EndQuery(nvidia_timestamp_heap.Get(), D3D12_QUERY_TYPE_TIMESTAMP,
+                slot.timing_query_base + kCursorEnd);
+        }
+    }
+
+    void harvest_cursor_stats(WorkSlot& slot) noexcept {
+        if (slot.cursor_order == 0 || cursor_stats_readback == nullptr ||
+            fence_status(fence.Get(), slot.fence_value) != S_OK) {
+            return;
+        }
+        const UINT slot_index = static_cast<UINT>(&slot - work_slots.data());
+        const SIZE_T begin = static_cast<SIZE_T>(slot_index) * 64U;
+        const D3D12_RANGE read_range{begin, begin + kCursorStatsWords * sizeof(std::uint32_t)};
+        void* mapped = nullptr;
+        if (SUCCEEDED(cursor_stats_readback->Map(0, &read_range, &mapped)) && mapped != nullptr) {
+            std::array<std::uint32_t, kCursorStatsWords> values{};
+            std::memcpy(values.data(), static_cast<const std::byte*>(mapped) + begin,
+                sizeof(values));
+            const D3D12_RANGE no_write{0, 0};
+            cursor_stats_readback->Unmap(0, &no_write);
+            if (slot.cursor_order > cursor_stats_order) {
+                cursor_stats_order = slot.cursor_order;
+                cursor_stats.pairs = values[0];
+                cursor_stats.drawn = values[1];
+                cursor_stats.not_found = values[2];
+                cursor_stats.low_score = values[3];
+                cursor_stats.ambiguous = values[4];
+                cursor_stats.stereo = values[5];
+                cursor_stats.jump = values[6];
+                cursor_stats.busy = values[7];
+                cursor_stats.acquired = values[8];
+                cursor_stats.tracked = values[9];
+            }
+        }
+        slot.cursor_order = 0;
+    }
+
+    void harvest_all_cursor_stats() noexcept {
+        for (WorkSlot& slot : work_slots) {
+            harvest_cursor_stats(slot);
+        }
+    }
+
+    // Once a second while the feature is on, into the flight log
+    // (BridgeFlightOperation::smooth_cursor).
+    void log_smooth_cursor() noexcept {
+        if (!cursor_enabled || !bridge_flight_logger().enabled()) {
+            return;
+        }
+        const std::uint64_t now = GetTickCount64();
+        if (cursor_log_milliseconds == 0) {
+            cursor_log_milliseconds = now;
+            return;
+        }
+        if (now - cursor_log_milliseconds < 1000U) {
+            return;
+        }
+        cursor_log_milliseconds = now;
+        harvest_all_cursor_stats();
+        const D3D12SmoothCursorStats& c = cursor_stats;
+        const D3D12SmoothCursorStats& l = cursor_logged;
+        const auto field = [](std::uint64_t now_value, std::uint64_t then_value) {
+            const std::uint64_t delta = now_value >= then_value ? now_value - then_value : 0U;
+            return std::min<std::uint64_t>(delta, 0xffffU);
+        };
+        const std::uint64_t timed = c.timed_pairs >= l.timed_pairs ? c.timed_pairs - l.timed_pairs : 0U;
+        const std::uint64_t mean_us = timed == 0 ? 0U
+            : std::min<std::uint64_t>(
+                  (c.detection_microseconds - l.detection_microseconds) / timed, 0xffffU);
+        const std::uint64_t a = field(c.pairs, l.pairs) | (field(c.drawn, l.drawn) << 16U) |
+            (field(c.acquired, l.acquired) << 32U) | (field(c.tracked, l.tracked) << 48U);
+        const std::uint64_t b = field(c.not_found, l.not_found) |
+            (field(c.low_score, l.low_score) << 16U) |
+            (field(c.ambiguous, l.ambiguous) << 32U) | (field(c.stereo, l.stereo) << 48U);
+        const std::uint64_t d = field(c.jump, l.jump) | (field(c.busy, l.busy) << 16U) |
+            (field(c.idle_pairs, l.idle_pairs) << 32U) | (mean_us << 48U);
+        if (a != 0U || b != 0U || d != 0U) {
+            bridge_flight_logger().event(BridgeFlightOperation::smooth_cursor, 1, a, b, d);
+        }
+        cursor_logged = cursor_stats;
+    }
