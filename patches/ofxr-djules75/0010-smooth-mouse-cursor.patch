+[[nodiscard]] CursorRun run_cursor_scenario(
+    D3D12WarpFixture& fixture,
+    xrfg::D3D12OpticalFlowBackend backend,
+    xrfg::D3D12NvidiaOpticalFlowOptions nvidia_options,
+    const CursorScenario& scenario) {
+    const Sprite sprite = make_sprite(
+        scenario.marker ? marker_template() : xrfg::built_in_arrow_template(), scenario.scale);
+    CursorRun run;
+    const ReprojectionViews previous_views = make_reprojection_views();
+    const ReprojectionViews current_views = make_reprojection_views(scenario.yaw);
+    run.previous_frame = scenario.yaw == 0.0F
+        ? cursor_background()
+        : ray_direction_pattern(kCursorWidth, kCursorHeight, previous_views);
+    run.current_frame = scenario.yaw == 0.0F
+        ? run.previous_frame
+        : ray_direction_pattern(kCursorWidth, kCursorHeight, current_views);
+    run.background = run.current_frame;
+    for (UINT eye = 0; eye < kEyeCount; ++eye) {
+        const CursorPosition from = scenario.previous[eye];
+        const CursorPosition to{from[0] + scenario.motion[0], from[1] + scenario.motion[1]};
+        if (scenario.distractor) {
+            const CursorPosition still{from[0] + (*scenario.distractor)[0], from[1] + (*scenario.distractor)[1]};
+            draw_cursor(&run.previous_frame, eye, still, sprite);
+            draw_cursor(&run.current_frame, eye, still, sprite);
+        }
+        if (scenario.draw) {
+            draw_cursor(&run.previous_frame, eye, from, sprite);
+            draw_cursor(&run.current_frame, eye, to, sprite);
+        }
+    }
+    std::array<ComPtr<ID3D12Resource>, 2> sources{
+        create_source_texture(fixture, kCursorWidth, kCursorHeight),
+        create_source_texture(fixture, kCursorWidth, kCursorHeight)};
+    std::array<ComPtr<ID3D12Resource>, 2> currents{
+        create_source_texture(fixture, kCursorWidth, kCursorHeight),
+        create_source_texture(fixture, kCursorWidth, kCursorHeight)};
+    std::array<ComPtr<ID3D12Resource>, 2> synthetics{
+        create_source_texture(fixture, kCursorWidth, kCursorHeight),
+        create_source_texture(fixture, kCursorWidth, kCursorHeight)};
+    upload_pattern(fixture, sources[0].Get(), run.previous_frame);
+    upload_pattern(fixture, sources[1].Get(), run.current_frame);
+    std::array<ID3D12Resource*, 2> source_pointers{sources[0].Get(), sources[1].Get()};
+    std::array<ID3D12Resource*, 2> current_pointers{currents[0].Get(), currents[1].Get()};
+    std::array<ID3D12Resource*, 2> synthetic_pointers{synthetics[0].Get(), synthetics[1].Get()};
+    auto history = std::make_shared<xrfg::D3D12SwapchainHistory>();
+    require(operation_succeeded(history->initialize(
+                fixture.device(), fixture.queue(),
+                std::span<ID3D12Resource* const>(source_pointers.data(), source_pointers.size()),
+                D3D12_RESOURCE_STATE_RENDER_TARGET)),
+        "cursor: history initialization");
+    xrfg::D3D12FrameSynthesizer synthesizer;
+    require(operation_succeeded(synthesizer.initialize(
+                fixture.device(), fixture.queue(), history,
+                std::span<ID3D12Resource* const>(current_pointers.data(), current_pointers.size()),
+                std::span<ID3D12Resource* const>(synthetic_pointers.data(), synthetic_pointers.size()),
+                kFormat, D3D12_RESOURCE_STATE_RENDER_TARGET, backend, nvidia_options)),
+        "cursor: synthesizer initialization");
+    if (scenario.feature) {
+        xrfg::D3D12SmoothCursorOptions options{};
+        options.enabled = true;
+        options.templates.push_back(xrfg::built_in_arrow_template());
+        options.templates.push_back(marker_template());
+        require(synthesizer.set_smooth_cursor(options) == S_OK, "cursor: set_smooth_cursor");
+    }
+    synthesizer.note_cursor_position(1200, 700, 100'000);
+    xrfg::D3D12HistoryCaptureTicket capture{};
+    xrfg::D3D12FrameSynthesisTicket ticket{};
+    require(operation_succeeded(history->capture(0, &capture)) &&
+                operation_succeeded(history->commit(capture)) &&
+                operation_succeeded(synthesizer.submit_prime(capture, previous_views, 0, &ticket)),
+        "cursor: prime");
+    if (scenario.feature) {
+        xrfg::D3D12SmoothCursorOptions again{};
+        again.enabled = true;
+        again.templates.push_back(xrfg::built_in_arrow_template());
+        require(synthesizer.set_smooth_cursor(again) == E_ILLEGAL_METHOD_CALL,
+            "cursor: the templates were replaced after a submission");
+    }
+    require_frame_start_gate(synthesizer, "cursor: frame-start gate");
+    synthesizer.note_cursor_position(
+        scenario.mouse_moves ? 1200 + scenario.motion[0] : 1200,
+        scenario.mouse_moves ? 700 + scenario.motion[1] : 700,
