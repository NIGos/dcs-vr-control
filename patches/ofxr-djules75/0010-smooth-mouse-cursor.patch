 }
 
+bool read_smooth_cursor(const std::filesystem::path& module_directory) noexcept {
+    return read_ofxr_switch(module_directory, L"smooth_cursor", false);
+}
+
+std::filesystem::path read_cursor_templates(
+    const std::filesystem::path& module_directory) noexcept {
+    try {
+        if (module_directory.empty()) {
+            return {};
+        }
+        const auto ini_path = module_directory / L"ofxr_bridge.ini";
+        std::wstring value(1024, L'\0');
+        const DWORD length = GetPrivateProfileStringW(
+            L"ofxr", L"cursor_templates", L"", value.data(),
+            static_cast<DWORD>(value.size()), ini_path.c_str());
+        value.resize(length);
+        return std::filesystem::path(value);
+    } catch (...) {
+        return {};
+    }
+}
