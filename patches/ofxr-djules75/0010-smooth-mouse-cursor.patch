+            queue->ExecuteCommandLists(1, lists);
+            cursor_tiles_x = tiles_x;
+            cursor_tiles_y = tiles_y;
+            cursor_template_count = static_cast<UINT>(options.templates.size());
+            cursor_active_milliseconds = options.active_milliseconds;
+            cursor_stats = {};
+            cursor_stats.templates = cursor_template_count;
+            cursor_stats.matchable_templates = matchable;
+            cursor_logged = cursor_stats;
+            cursor_enabled = matchable != 0U;
+            return cursor_enabled ? S_OK : S_FALSE;
+        } catch (...) {
+            return E_OUTOFMEMORY;
+        }
+    }
