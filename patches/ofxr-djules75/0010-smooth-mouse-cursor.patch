+}
+
+// The cursor where it is at this synthetic's instant: the current frame's own
+// pixels, moved by a whole number of pixels so they stay exactly as drawn.
+float4 cursor_draw(CursorComposite cursor, float2 pixel, float4 colour) {
+    float4 output = colour;
