+// DCS VR Control (0010): the smooth mouse cursor. A small arrow that moves
+// further than its own size between two real frames over a textured,
+// otherwise still image: in the generated frames it must appear exactly once,
+// at its position for that frame's instant, with neither real frame's copy
+// left behind; and wherever the detection cannot be sure (a look-alike next
+// to it, no cursor, an idle mouse) every generated pixel must come out exactly
+// as with the feature off.
+constexpr UINT kCursorWidth = 320;
+constexpr UINT kCursorHeight = 240;
+
+[[nodiscard]] RgbaBytes cursor_background_texel(UINT x, UINT y, UINT eye) noexcept {
+    // A panel-like texture: soft shading, grain and a few hard-edged blocks.
+    std::uint32_t hash = (x * 73856093U) ^ (y * 19349663U) ^ (eye * 83492791U);
+    hash ^= hash >> 13U;
+    hash *= 0x5bd1e995U;
+    hash ^= hash >> 15U;
+    const float grain = static_cast<float>(hash & 31U) - 16.0F;
+    const float xf = static_cast<float>(x);
+    const float yf = static_cast<float>(y);
+    float base = 70.0F + 30.0F * std::sin(xf * 0.05F) * std::cos(yf * 0.07F) + grain;
+    if (((x / 40U) + (y / 30U)) % 5U == 0U) {
+        base += 60.0F;
+    }
+    const auto channel = [](float value) noexcept {
+        return static_cast<std::uint8_t>(std::lround(std::clamp(value, 0.0F, 255.0F)));
+    };
+    return {channel(base + 6.0F), channel(base), channel(base * 0.8F + 10.0F), 255};
+}
+
+[[nodiscard]] StereoPattern cursor_background() {
+    StereoPattern pattern;
+    for (UINT eye = 0; eye < kEyeCount; ++eye) {
+        pattern[eye].resize(static_cast<std::size_t>(kCursorWidth) * kCursorHeight * kBytesPerPixel);
+        for (UINT y = 0; y < kCursorHeight; ++y) {
+            for (UINT x = 0; x < kCursorWidth; ++x) {
+                const RgbaBytes texel = cursor_background_texel(x, y, eye);
+                std::copy(texel.begin(), texel.end(), pattern[eye].begin() +
+                    static_cast<std::ptrdiff_t>((static_cast<std::size_t>(y) * kCursorWidth + x) * kBytesPerPixel));
+            }
+        }
+    }
+    return pattern;
+}
+
+using CursorPosition = std::array<int, 2>;
+
+// A control marker in the manner of DCS's: a plain green cross, one colour
+// and no outline, so it can only be matched by its shape.
+[[nodiscard]] xrfg::D3D12CursorTemplate marker_template() noexcept {
+    xrfg::D3D12CursorTemplate marker{};
+    for (UINT y = 4; y < 19; ++y) {
+        for (UINT x = 4; x < 19; ++x) {
+            const bool bar = (x >= 10 && x < 13) || (y >= 10 && y < 13);
+            marker.rgba[y * xrfg::kD3D12CursorTemplateSize + x] = bar ? 0xff28dc00U : 0U;
+        }
+    }
+    return marker;
+}
+
+// A cursor image as drawn: the template resized by nearest texel, the way
+// the detection and the composition map pixels to texels.
+struct Sprite {
+    int size{};
+    std::vector<std::uint32_t> rgba;
+};
+
+[[nodiscard]] Sprite make_sprite(const xrfg::D3D12CursorTemplate& source, float scale = 1.0F) {
+    Sprite sprite;
+    sprite.size = static_cast<int>(std::ceil(static_cast<float>(xrfg::kD3D12CursorTemplateSize) * scale));
+    sprite.rgba.assign(static_cast<std::size_t>(sprite.size) * static_cast<std::size_t>(sprite.size), 0U);
+    for (int y = 0; y < sprite.size; ++y) {
+        for (int x = 0; x < sprite.size; ++x) {
+            const int tx = static_cast<int>(std::floor((static_cast<float>(x) + 0.5F) / scale));
+            const int ty = static_cast<int>(std::floor((static_cast<float>(y) + 0.5F) / scale));
+            if (tx < static_cast<int>(xrfg::kD3D12CursorTemplateSize) &&
+                ty < static_cast<int>(xrfg::kD3D12CursorTemplateSize)) {
+                sprite.rgba[static_cast<std::size_t>(y * sprite.size + x)] =
+                    source.rgba[static_cast<std::size_t>(ty) * xrfg::kD3D12CursorTemplateSize +
+                        static_cast<std::size_t>(tx)];
+            }
+        }
+    }
+    return sprite;
+}
+
+void draw_cursor_sized(StereoPattern* pattern, UINT eye, UINT width, UINT height,
+    CursorPosition at, const Sprite& sprite) {
+    for (int ty = 0; ty < sprite.size; ++ty) {
+        for (int tx = 0; tx < sprite.size; ++tx) {
+            const std::uint32_t rgba = sprite.rgba[static_cast<std::size_t>(ty * sprite.size + tx)];
+            const std::uint32_t alpha = rgba >> 24U;
+            const int x = at[0] + tx;
+            const int y = at[1] + ty;
+            if (alpha == 0U || x < 0 || y < 0 || x >= static_cast<int>(width) ||
+                y >= static_cast<int>(height)) {
+                continue;
+            }
+            const std::size_t offset =
+                (static_cast<std::size_t>(y) * width + static_cast<std::size_t>(x)) * kBytesPerPixel;
+            for (UINT channel = 0; channel < 3U; ++channel) {
+                const std::uint32_t colour = (rgba >> (8U * channel)) & 0xffU;
+                const std::uint32_t under = (*pattern)[eye][offset + channel];
+                (*pattern)[eye][offset + channel] = static_cast<std::uint8_t>(
+                    (colour * alpha + under * (255U - alpha) + 127U) / 255U);
+            }
+        }
+    }
+}
+
+void draw_cursor(StereoPattern* pattern, UINT eye, CursorPosition at, const Sprite& sprite) {
+    draw_cursor_sized(pattern, eye, kCursorWidth, kCursorHeight, at, sprite);
+}
+
+void draw_cursor_into(StereoPattern* pattern, UINT width, UINT height, CursorPosition at,
+    const Sprite& sprite) {
+    for (UINT eye = 0; eye < kEyeCount; ++eye) {
+        draw_cursor_sized(pattern, eye, width, height, at, sprite);
+    }
+}
