+    float2 relative = coordinate - cursor.position;
+    float reach = float(kCursorTemplateSize) * cursor.scale;
+    float coverage = 0.0;
+    if (all(relative >= float2(-2.0, -2.0)) && all(relative <= float2(reach + 2.0, reach + 2.0))) {
