+            source.x < float(Width) && source.y < float(Height);
+        if (alpha > 0.0 && inside) {
+            output = saturate(lerp(
+                output,
+                CurrentFrame.Load(int4(int2(source), int(Slice), 0)),
+                alpha));
+        }
+    }
+    return output;
+}
