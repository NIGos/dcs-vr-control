+
+float4 CursorCompositePS(FullscreenVertex input) : SV_Target {
+    uint2 integer_pixel = uint2(input.position.xy);
+    float2 pixel = float2(integer_pixel);
+    CursorComposite cursor = load_cursor_composite(ViewIndex);
+    CameraSample current = sample_current_target(pixel, Slice, ViewIndex);
+    float4 output_color = saturate(current.color);
+    MappedCoordinate previous_coverage = map_target_to_source(
+        pixel, PreviousMappings[ViewIndex]);
