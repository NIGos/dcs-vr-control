+// The words the detection reads for the templates: their texels, up to 64
+// sample positions each (spread over the shape, the even ones first so the
+// first 32 are the coarse pass's) and each one's sample count. A template
+// with inner contrast samples its opaque texels and is matched on their
+// brightness; one of a single colour samples 40 of its opaque texels and 24
+// of the transparent ring around them, weighted 255 and 0 in bits 16-23, and
+// is matched on that shape (info bit 16). A template with fewer than eight
+// opaque texels has a count of 0: it is never matched, but lends its shape.
+[[nodiscard]] std::vector<std::uint32_t> cursor_template_words(
+    const std::vector<D3D12CursorTemplate>& templates,
+    std::uint32_t* matchable) {
+    std::vector<std::uint32_t> words(kCursorTemplateWords, 0U);
+    std::uint32_t usable = 0;
+    const std::size_t count = std::min<std::size_t>(
+        templates.size(), kD3D12MaxCursorTemplates);
+    for (std::size_t index = 0; index < count; ++index) {
+        const auto& texels = templates[index].rgba;
+        std::copy(texels.begin(), texels.end(),
+            words.begin() + static_cast<std::ptrdiff_t>(index * kCursorTemplateTexels));
+        constexpr std::uint32_t kSize = kD3D12CursorTemplateSize;
+        const auto alpha = [&](int x, int y) {
+            return x < 0 || y < 0 || x >= static_cast<int>(kSize) || y >= static_cast<int>(kSize)
+                ? 0U
+                : texels[static_cast<std::size_t>(y) * kSize + static_cast<std::size_t>(x)] >> 24U;
+        };
+        std::vector<std::uint32_t> opaque;
+        std::vector<std::uint32_t> ring;
+        for (std::uint32_t texel = 0; texel < kCursorTemplateTexels; ++texel) {
+            const int x = static_cast<int>(texel % kSize);
+            const int y = static_cast<int>(texel / kSize);
+            if (alpha(x, y) >= 192U) {
+                opaque.push_back(texel);
+            } else if (alpha(x, y) == 0U &&
+                       (alpha(x - 1, y) >= 192U || alpha(x + 1, y) >= 192U ||
+                        alpha(x, y - 1) >= 192U || alpha(x, y + 1) >= 192U)) {
+                ring.push_back(texel);
+            }
+        }
+        const auto spread_out = [](const std::vector<std::uint32_t>& from, std::size_t wanted) {
+            std::vector<std::uint32_t> chosen;
+            wanted = std::min(wanted, from.size());
+            for (std::size_t sample = 0; sample < wanted; ++sample) {
+                chosen.push_back(from[sample * from.size() / wanted]);
+            }
+            return chosen;
+        };
+        // Inner contrast: the opaque texels' brightness varies enough to
+        // match on alone.
+        float sum = 0.0F;
+        float sum_squares = 0.0F;
+        const std::vector<std::uint32_t> inner = spread_out(opaque, kCursorSamplesPerTemplate);
+        for (const std::uint32_t texel : inner) {
+            const float value = cursor_template_luma(texels[texel]);
+            sum += value;
+            sum_squares += value * value;
+        }
+        const float n = static_cast<float>(std::max<std::size_t>(inner.size(), 1U));
+        const float mean = sum / n;
+        const bool contrast = inner.size() >= 8U &&
+            sum_squares - n * mean * mean >= n * 4.0e-3F;
+        const bool shape = !contrast && opaque.size() >= 8U && ring.size() >= 8U;
+        // (texel, weight) pairs in raster order, then the even ones first.
+        std::vector<std::pair<std::uint32_t, std::uint32_t>> chosen;
+        if (contrast) {
+            for (const std::uint32_t texel : inner) {
+                chosen.emplace_back(texel, 255U);
+            }
+        } else if (shape) {
+            for (const std::uint32_t texel : spread_out(opaque, 40U)) {
+                chosen.emplace_back(texel, 255U);
+            }
+            for (const std::uint32_t texel :
+                 spread_out(ring, kCursorSamplesPerTemplate - chosen.size())) {
+                chosen.emplace_back(texel, 0U);
+            }
+            std::sort(chosen.begin(), chosen.end());
+        }
+        std::vector<std::pair<std::uint32_t, std::uint32_t>> ordered;
+        for (std::size_t sample = 0; sample < chosen.size(); sample += 2) {
+            ordered.push_back(chosen[sample]);
+        }
+        for (std::size_t sample = 1; sample < chosen.size(); sample += 2) {
+            ordered.push_back(chosen[sample]);
+        }
+        for (std::size_t sample = 0; sample < ordered.size(); ++sample) {
+            const std::uint32_t texel = ordered[sample].first;
+            words[kCursorSampleBase + index * kCursorSamplesPerTemplate + sample] =
+                (texel % kSize) | ((texel / kSize) << 8U) | (ordered[sample].second << 16U);
+        }
+        words[kCursorInfoBase + index] = static_cast<std::uint32_t>(ordered.size()) |
+            (shape ? 0x10000U : 0U);
+        usable += contrast || shape ? 1U : 0U;
+    }
+    if (matchable != nullptr) {
+        *matchable = usable;
+    }
+    return words;
+}
