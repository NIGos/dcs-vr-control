+void test_smooth_cursor(
+    D3D12WarpFixture& fixture,
+    xrfg::D3D12OpticalFlowBackend backend = xrfg::D3D12OpticalFlowBackend::fidelity_fx,
+    xrfg::D3D12NvidiaOpticalFlowOptions nvidia_options = {}) {
+    const char* label = backend == xrfg::D3D12OpticalFlowBackend::nvidia ? "NVIDIA" : "FidelityFX";
+    for (const int variant : {0, 1, 2, 3, 4, 5}) {
+        // 2X, 3X, 2X while the head turns, the green marker in 2X, and the
+        // arrow drawn a quarter larger and a fifth smaller than its image.
+        const bool triple = variant == 1;
+        CursorScenario on{};
+        on.triple = triple;
+        on.yaw = variant == 2 ? 0.03F : 0.0F;
+        on.marker = variant == 3;
+        on.scale = variant == 4 ? 1.26F : variant == 5 ? 0.794F : 1.0F;
+        const Sprite sprite = make_sprite(
+            on.marker ? marker_template() : xrfg::built_in_arrow_template(), on.scale);
+        CursorScenario off = on;
+        off.feature = false;
+        const CursorRun with = run_cursor_scenario(fixture, backend, nvidia_options, on);
+        const CursorRun without = run_cursor_scenario(fixture, backend, nvidia_options, off);
+        // Real frames are never touched.
+        require(with.current_output == with.current_frame && without.current_output == with.current_output,
+            "cursor: the real frame changed");
+        require(with.stats.pairs == 1 && with.stats.drawn == 1,
+            std::string("cursor: the gate did not accept a clean moving cursor (") + label +
+                ", pairs " + std::to_string(with.stats.pairs) + ", drawn " +
+                std::to_string(with.stats.drawn) + ", not found " +
+                std::to_string(with.stats.not_found) + ", score " +
+                std::to_string(with.stats.low_score) + ", margin " +
+                std::to_string(with.stats.ambiguous) + ", stereo " +
+                std::to_string(with.stats.stereo) + ", jump " + std::to_string(with.stats.jump) +
+                ", busy " + std::to_string(with.stats.busy) + ")");
+        for (UINT output = 0; output < (triple ? 2U : 1U); ++output) {
+            const float t = with.fractions[output];
+            for (UINT eye = 0; eye < kEyeCount; ++eye) {
+                const CursorPosition from = on.previous[eye];
+                const CursorPosition to{from[0] + on.motion[0], from[1] + on.motion[1]};
+                const CursorPosition expected{
+                    to[0] + static_cast<int>(std::lround((from[0] - to[0]) * (1.0F - t))),
+                    to[1] + static_cast<int>(std::lround((from[1] - to[1]) * (1.0F - t)))};
+                const CursorMeasure good = measure_cursor(
+                    with.synthetic[output], with.background, eye, from, to, expected, sprite);
+                const CursorMeasure bad = measure_cursor(
+                    without.synthetic[output], with.background, eye, from, to, expected, sprite);
+                std::cout << "smooth cursor " << label << (triple ? " 3X" : " 2X")
+                          << (on.yaw != 0.0F ? " turning" : "") << (on.marker ? " marker" : "")
+                          << (on.scale != 1.0F ? " scale=" + std::to_string(on.scale) : std::string())
+                          << " t=" << t
+                          << " eye=" << eye << ": on mismatches=" << good.cursor_mismatches
+                          << " best_offset=(" << good.best_offset[0] << "," << good.best_offset[1]
+                          << ") ghost_mean=" << good.ghost_mean << " ghost_share=" << good.ghost_share
+                          << " rest_mean=" << good.rest_mean
+                          << " | off mismatches=" << bad.cursor_mismatches
+                          << " ghost_mean=" << bad.ghost_mean << " ghost_share=" << bad.ghost_share << '\n';
+                require(good.cursor_mismatches == 0 && good.best_offset == CursorPosition{0, 0},
+                    "cursor: not drawn exactly at its position for the generated instant");
+                require(good.ghost_mean < good.rest_mean + 0.02 && good.ghost_share < 0.02,
+                    "cursor: a stale copy is left in the generated frame");
+                require(bad.ghost_share > 0.2 || bad.cursor_mismatches > 0,
+                    "cursor: the scene does not show the problem without the feature");
+            }
+        }
+    }
+
+    // A second identical arrow that stays still 34 px below: either could be
+    // the cursor, so the gate must leave the frame exactly as without.
+    {
+        CursorScenario on{};
+        on.distractor = CursorPosition{0, 34};
+        CursorScenario off = on;
+        off.feature = false;
+        const CursorRun with = run_cursor_scenario(fixture, backend, nvidia_options, on);
+        const CursorRun without = run_cursor_scenario(fixture, backend, nvidia_options, off);
+        require(with.stats.pairs == 1 && with.stats.drawn == 0 &&
+                    with.stats.ambiguous + with.stats.low_score + with.stats.jump > 0,
+            "cursor: a look-alike next to the cursor was not rejected");
+        require(with.synthetic[0] == without.synthetic[0],
+            "cursor: a rejected pair changed the generated frame");
+        std::cout << "smooth cursor " << label << ": look-alike rejected (ambiguous "
+                  << with.stats.ambiguous << ", score " << with.stats.low_score << ", jump "
+                  << with.stats.jump << "), output identical to off\n";
+    }
+
+    // No cursor in the frames, the mouse moving: nothing found, nothing
+    // changed. The cursor moving, the mouse idle: nothing runs at all.
+    {
+        CursorScenario absent{};
+        absent.draw = false;
+        CursorScenario absent_off = absent;
+        absent_off.feature = false;
+        const CursorRun with = run_cursor_scenario(fixture, backend, nvidia_options, absent);
+        const CursorRun without = run_cursor_scenario(fixture, backend, nvidia_options, absent_off);
+        require(with.stats.pairs == 1 && with.stats.drawn == 0 && with.stats.not_found == 1 &&
+                    with.synthetic[0] == without.synthetic[0],
+            "cursor: frames without a cursor changed");
+        CursorScenario idle{};
+        idle.mouse_moves = false;
+        CursorScenario idle_off = idle;
+        idle_off.feature = false;
+        const CursorRun idle_with = run_cursor_scenario(fixture, backend, nvidia_options, idle);
+        const CursorRun idle_without = run_cursor_scenario(fixture, backend, nvidia_options, idle_off);
+        require(idle_with.stats.idle_pairs == 1 && idle_with.stats.pairs == 0 &&
+                    idle_with.synthetic[0] == idle_without.synthetic[0] &&
+                    idle_with.current_output == idle_without.current_output,
+            "cursor: an idle mouse changed the generated frame");
+        std::cout << "smooth cursor " << label
+                  << ": no cursor and idle mouse leave the output identical to off\n";
+    }
+}
