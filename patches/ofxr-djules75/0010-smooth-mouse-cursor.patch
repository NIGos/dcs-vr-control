+CursorComposite load_cursor_composite(uint view) {
+    CursorComposite output = (CursorComposite)0;
+    uint record = (kCursorCompositeBase + min(view, 1u) * 16u) * 4u;
+    uint4 first = CursorState.Load4(record);
+    uint4 second = CursorState.Load4(record + 16u);
+    uint last = CursorState.Load(record + 32u);
+    output.valid = first.x;
+    output.previous.position = asfloat(first.yz);
+    output.current.position = float2(asfloat(first.w), asfloat(second.x));
+    output.previous.template_index = second.y;
+    output.current.template_index = second.z;
+    output.previous.scale = max(asfloat(second.w), 0.25);
+    output.current.scale = max(asfloat(last), 0.25);
