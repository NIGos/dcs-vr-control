+struct CursorMeasure {
+    // Opaque cursor texels at the expected position that differ from the
+    // cursor's colour by more than 2/255, and the offset (within 2 px) where
+    // the cursor matches best.
+    std::size_t cursor_mismatches{};
+    CursorPosition best_offset{};
+    // Pixels near either real frame's position (but away from the expected
+    // one): their mean distance from the true background, and the share of
+    // them more than 40/255 away - a ghost.
+    double ghost_mean{};
+    double ghost_share{};
+    // The same distance everywhere well away from the cursor: the
+    // synthesis's own error on this scene, which the ghost region shares.
+    double rest_mean{};
+};
+
+[[nodiscard]] CursorMeasure measure_cursor(
+    const StereoPattern& output, const StereoPattern& background, UINT eye,
+    CursorPosition from, CursorPosition to, CursorPosition expected, const Sprite& sprite) {
+    const int kSize = sprite.size;
+    const auto pixel = [&](const StereoPattern& pattern, int x, int y, UINT channel) {
+        return static_cast<int>(pattern[eye][(static_cast<std::size_t>(y) * kCursorWidth +
+            static_cast<std::size_t>(x)) * kBytesPerPixel + channel]);
+    };
+    const auto covered = [&](CursorPosition at, int x, int y, int grow) {
+        for (int dy = -grow; dy <= grow; ++dy) {
+            for (int dx = -grow; dx <= grow; ++dx) {
+                const int tx = x + dx - at[0];
+                const int ty = y + dy - at[1];
+                if (tx >= 0 && ty >= 0 && tx < kSize && ty < kSize &&
+                    (sprite.rgba[static_cast<std::size_t>(ty * kSize + tx)] >> 24U) != 0U) {
+                    return true;
+                }
+            }
+        }
+        return false;
+    };
+    CursorMeasure measure{};
+    std::size_t best = std::numeric_limits<std::size_t>::max();
+    for (int oy = -2; oy <= 2; ++oy) {
+        for (int ox = -2; ox <= 2; ++ox) {
+            std::size_t mismatches = 0;
+            for (int ty = 0; ty < kSize; ++ty) {
+                for (int tx = 0; tx < kSize; ++tx) {
+                    const std::uint32_t rgba = sprite.rgba[static_cast<std::size_t>(ty * kSize + tx)];
+                    if ((rgba >> 24U) != 255U) {
+                        continue;
+                    }
+                    const int x = expected[0] + ox + tx;
+                    const int y = expected[1] + oy + ty;
+                    for (UINT channel = 0; channel < 3U; ++channel) {
+                        if (std::abs(pixel(output, x, y, channel) -
+                                static_cast<int>((rgba >> (8U * channel)) & 0xffU)) > 2) {
+                            ++mismatches;
+                            break;
+                        }
+                    }
+                }
+            }
+            if (ox == 0 && oy == 0) {
+                measure.cursor_mismatches = mismatches;
+            }
+            if (mismatches < best) {
+                best = mismatches;
+                measure.best_offset = {ox, oy};
+            }
+        }
+    }
+    double total = 0.0;
+    std::size_t count = 0;
+    std::size_t ghosts = 0;
+    double rest_total = 0.0;
+    std::size_t rest_count = 0;
+    for (int y = 16; y + 16 < static_cast<int>(kCursorHeight); ++y) {
+        for (int x = 16; x + 16 < static_cast<int>(kCursorWidth); ++x) {
+            int distance = 0;
+            for (UINT channel = 0; channel < 3U; ++channel) {
+                distance = std::max(distance,
+                    std::abs(pixel(output, x, y, channel) - pixel(background, x, y, channel)));
+            }
+            if (!covered(from, x, y, 8) && !covered(to, x, y, 8) && !covered(expected, x, y, 8)) {
+                rest_total += distance;
+                ++rest_count;
+            }
+            if (!(covered(from, x, y, 1) || covered(to, x, y, 1)) || covered(expected, x, y, 2)) {
+                continue;
+            }
+            total += distance;
+            ghosts += distance > 40 ? 1U : 0U;
+            ++count;
+        }
+    }
+    require(count > 0 && rest_count > 0, "cursor: no ghost region");
+    measure.ghost_mean = total / static_cast<double>(count) / 255.0;
+    measure.ghost_share = static_cast<double>(ghosts) / static_cast<double>(count);
+    measure.rest_mean = rest_total / static_cast<double>(rest_count) / 255.0;
+    return measure;
+}
