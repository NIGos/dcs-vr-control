+    StereoPattern background;
+    StereoPattern previous_frame;
+    StereoPattern current_frame;
+    StereoPattern current_output;
+    std::array<StereoPattern, 2> synthetic;
+    std::array<float, 2> fractions{0.5F, 0.5F};
+    xrfg::D3D12SmoothCursorStats stats{};
+};
