+void test_cursor_template_decoding() {
+    // A 32-bit cursor resource as Windows stores it: hotspot, header,
+    // bottom-up BGRA rows, then the AND mask.
+    constexpr std::size_t kSize = xrfg::kD3D12CursorTemplateSize;
+    std::vector<std::uint8_t> bits(4U + 40U + kSize * kSize * 4U + kSize * 4U, 0U);
+    const auto put32 = [&](std::size_t at, std::uint32_t value) {
+        for (std::size_t i = 0; i < 4U; ++i) {
+            bits[at + i] = static_cast<std::uint8_t>(value >> (8U * i));
+        }
+    };
+    put32(4, 40);
+    put32(8, 32);
+    put32(12, 64);
+    bits[4 + 12] = 1;
+    bits[4 + 14] = 32;
+    // Texel (3, 5): opaque blue-ish; everything else transparent.
+    const std::size_t row = 4U + 40U + (kSize - 1U - 5U) * kSize * 4U;
+    bits[row + 3U * 4U + 0U] = 200; // B
+    bits[row + 3U * 4U + 1U] = 100; // G
+    bits[row + 3U * 4U + 2U] = 50;  // R
+    bits[row + 3U * 4U + 3U] = 255; // A
+    xrfg::D3D12CursorTemplate decoded{};
+    require(xrfg::decode_cursor_resource(bits, &decoded), "cursor template: 32-bit decode");
+    require(decoded.rgba[5 * kSize + 3] == (50U | (100U << 8U) | (200U << 16U) | (255U << 24U)) &&
+                decoded.rgba[0] == 0U,
+        "cursor template: 32-bit texels");
+    bits[4 + 14] = 16;
+    require(!xrfg::decode_cursor_resource(bits, &decoded), "cursor template: 16-bit refused");
+    const xrfg::D3D12CursorTemplate arrow = xrfg::built_in_arrow_template();
+    std::size_t opaque = 0;
+    for (const std::uint32_t rgba : arrow.rgba) {
+        opaque += (rgba >> 24U) == 255U ? 1U : 0U;
+    }
+    require(opaque > 100U && opaque < 400U, "cursor template: built-in arrow");
+    // With a directory that holds no Visualizer.dll (and none loaded in this
+    // process) the built-in arrow stands in.
+    const xrfg::CursorTemplateSet fallback =
+        xrfg::load_dcs_cursor_templates(std::filesystem::temp_directory_path());
+    require(fallback.source == xrfg::CursorTemplateSource::built_in && fallback.templates.size() == 1,
+        "cursor template: fallback");
+    // XRFG_TEST_DCS_BIN: a DCS bin directory, read for the game's cursors.
+    std::array<wchar_t, 512> dcs_bin{};
+    const DWORD length = GetEnvironmentVariableW(L"XRFG_TEST_DCS_BIN", dcs_bin.data(),
+        static_cast<DWORD>(dcs_bin.size()));
+    if (length > 0 && length < dcs_bin.size()) {
+        const xrfg::CursorTemplateSet dcs =
+            xrfg::load_dcs_cursor_templates(std::filesystem::path(dcs_bin.data()));
+        require(dcs.source == xrfg::CursorTemplateSource::dcs_file && !dcs.templates.empty(),
+            "cursor template: DCS's Visualizer.dll");
+        std::cout << "cursor templates from DCS: " << dcs.templates.size() << " (ids";
+        for (const auto& item : dcs.templates) {
+            std::cout << ' ' << item.source_id;
+        }
+        std::cout << ")\n";
+    }
+    std::cout << "cursor template decoding and fallback passed\n";
+}
