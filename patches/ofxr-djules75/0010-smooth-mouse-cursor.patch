+struct CursorScenario {
+    // The cursor's top-left corner in the previous frame, per eye, and how
+    // far it moves (the same in both eyes: it is view-locked).
+    std::array<CursorPosition, kEyeCount> previous{CursorPosition{60, 70}, CursorPosition{48, 70}};
+    CursorPosition motion{24, 10};
+    bool draw{true};
+    // A second, identical arrow that does not move, relative to the
+    // previous position.
+    std::optional<CursorPosition> distractor;
+    bool feature{true};
+    bool mouse_moves{true};
+    bool triple{false};
+    // The cursor is the green marker rather than the arrow (both are
+    // offered to the detection).
+    bool marker{false};
+    // How large DCS draws it against the 32x32 image.
+    float scale{1.0F};
+    // Head yaw between the two frames (radians): the scene turns past the
+    // view-locked cursor and the previous frame is warped into the current
+    // camera.
+    float yaw{0.0F};
