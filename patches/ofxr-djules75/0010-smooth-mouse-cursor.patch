+// XRFG_TEST_CURSOR_BENCH=1 on NVIDIA hardware: the detection's and the
+// composition's GPU time at a headset's resolution, the cursor moving every
+// frame (one acquisition, then tracking), against the feature off.
+void bench_smooth_cursor(D3D12WarpFixture& fixture, UINT width, UINT height) {
+    // Two identical pipelines, one with the feature and one without, driven
+    // alternately so both see the same clocks. Three frames cycle with the
+    // cursor 30 px apart in each (and the mouse moving with it), so after
+    // the first pair every detection tracks.
+    const xrfg::D3D12CursorTemplate arrow = xrfg::built_in_arrow_template();
+    const Sprite sprite = make_sprite(arrow);
+    constexpr UINT kFrames = 3;
+    constexpr int kPairs = 240;
+    const std::array<CursorPosition, kFrames> positions{
+        CursorPosition{static_cast<int>(width / 2), static_cast<int>(height / 2)},
+        CursorPosition{static_cast<int>(width / 2) + 30, static_cast<int>(height / 2)},
+        CursorPosition{static_cast<int>(width / 2) + 15, static_cast<int>(height / 2) + 26}};
+    struct Pipeline {
+        std::array<ComPtr<ID3D12Resource>, kFrames> sources{};
+        std::array<ComPtr<ID3D12Resource>, 2> currents{};
+        std::array<ComPtr<ID3D12Resource>, 2> synthetics{};
+        std::shared_ptr<xrfg::D3D12SwapchainHistory> history;
+        std::unique_ptr<xrfg::D3D12FrameSynthesizer> synthesizer;
+        std::vector<std::uint64_t> composition;
+        std::vector<std::uint64_t> total;
+        std::vector<std::uint64_t> detection;
+        std::uint64_t first_detection{};
+    };
+    std::array<Pipeline, 2> pipelines{};
+    StereoPattern background;
+    for (UINT eye = 0; eye < kEyeCount; ++eye) {
+        background[eye].resize(static_cast<std::size_t>(width) * height * kBytesPerPixel);
+        for (UINT y = 0; y < height; ++y) {
+            for (UINT x = 0; x < width; ++x) {
+                const RgbaBytes texel = cursor_background_texel(x % kCursorWidth, y % kCursorHeight, eye);
+                std::copy(texel.begin(), texel.end(), background[eye].begin() +
+                    static_cast<std::ptrdiff_t>((static_cast<std::size_t>(y) * width + x) * kBytesPerPixel));
+            }
+        }
+    }
+    for (UINT index = 0; index < pipelines.size(); ++index) {
+        Pipeline& pipeline = pipelines[index];
+        for (UINT frame = 0; frame < kFrames; ++frame) {
+            pipeline.sources[frame] = create_source_texture(fixture, width, height);
+            StereoPattern image = background;
+            draw_cursor_into(&image, width, height, positions[frame], sprite);
+            upload_pattern(fixture, pipeline.sources[frame].Get(), image);
+        }
+        for (auto& c : pipeline.currents) c = create_source_texture(fixture, width, height);
+        for (auto& s : pipeline.synthetics) s = create_source_texture(fixture, width, height);
+        std::array<ID3D12Resource*, kFrames> source_pointers{};
+        for (UINT i = 0; i < kFrames; ++i) source_pointers[i] = pipeline.sources[i].Get();
+        std::array<ID3D12Resource*, 2> current_pointers{pipeline.currents[0].Get(), pipeline.currents[1].Get()};
+        std::array<ID3D12Resource*, 2> synthetic_pointers{pipeline.synthetics[0].Get(), pipeline.synthetics[1].Get()};
+        pipeline.history = std::make_shared<xrfg::D3D12SwapchainHistory>();
+        require(operation_succeeded(pipeline.history->initialize(fixture.device(), fixture.queue(),
+                    std::span<ID3D12Resource* const>(source_pointers.data(), source_pointers.size()),
+                    D3D12_RESOURCE_STATE_RENDER_TARGET)), "bench: history");
+        pipeline.synthesizer = std::make_unique<xrfg::D3D12FrameSynthesizer>();
+        require(operation_succeeded(pipeline.synthesizer->initialize(fixture.device(), fixture.queue(),
+                    pipeline.history,
+                    std::span<ID3D12Resource* const>(current_pointers.data(), current_pointers.size()),
+                    std::span<ID3D12Resource* const>(synthetic_pointers.data(), synthetic_pointers.size()),
+                    kFormat, D3D12_RESOURCE_STATE_RENDER_TARGET,
+                    xrfg::D3D12OpticalFlowBackend::nvidia, {}, true)), "bench: synthesizer");
+        if (index == 1) {
+            xrfg::D3D12SmoothCursorOptions options{};
+            options.enabled = true;
+            // The full cockpit set's worth of templates: the built-in arrow
+            // and fifteen shifted copies, so the cost is the real one.
+            for (UINT i = 0; i < xrfg::kD3D12MaxCursorTemplates; ++i) {
+                xrfg::D3D12CursorTemplate copy{};
+                for (UINT t = 0; t < copy.rgba.size(); ++t) {
+                    const UINT x = t % 32U;
+                    const UINT y = t / 32U;
+                    copy.rgba[t] = x >= i % 4U && y >= i / 4U
+                        ? arrow.rgba[(y - i / 4U) * 32U + (x - i % 4U)] : 0U;
+                }
+                options.templates.push_back(copy);
+            }
+            require(pipeline.synthesizer->set_smooth_cursor(options) == S_OK, "bench: set_smooth_cursor");
+        }
+    }
+    const ReprojectionViews views = make_reprojection_views();
+    for (int frame = 0; frame <= kPairs; ++frame) {
+        const UINT slot = static_cast<UINT>(frame) % kFrames;
+        for (Pipeline& pipeline : pipelines) {
+            pipeline.synthesizer->note_cursor_position(positions[slot][0], positions[slot][1],
+                200'000U + static_cast<std::uint64_t>(frame) * 11U);
+            xrfg::D3D12HistoryCaptureTicket capture{};
+            xrfg::D3D12FrameSynthesisTicket ticket{};
+            require(operation_succeeded(pipeline.history->capture(slot, &capture)) &&
+                        operation_succeeded(pipeline.history->commit(capture)), "bench: capture");
+            const HRESULT submitted = frame == 0
+                ? pipeline.synthesizer->submit_prime(capture, views, 0, &ticket)
+                : pipeline.synthesizer->submit_pair(capture, views, views, 0,
+                      static_cast<std::uint32_t>(frame % 2), &ticket, std::nullopt, {}, false, 0.5F);
+            require(operation_succeeded(submitted), "bench: submission");
+            require_frame_start_gate(*pipeline.synthesizer, "bench: frame-start gate");
+            xrfg::D3D12NvidiaGpuTiming timing{};
+            while (pipeline.synthesizer->consume_nvidia_gpu_timing(&timing) == S_OK) {
+                if (timing.previous_serial == 0) {
+                    continue;
+                }
+                pipeline.composition.push_back(timing.composition_microseconds);
+                pipeline.total.push_back(timing.total_microseconds);
+                if (timing.cursor_microseconds != 0) {
+                    if (pipeline.first_detection == 0) {
+                        pipeline.first_detection = timing.cursor_microseconds;
+                    } else {
+                        pipeline.detection.push_back(timing.cursor_microseconds);
+                    }
+                }
+            }
+        }
+    }
+    const auto median = [](std::vector<std::uint64_t> values) -> std::uint64_t {
+        if (values.empty()) return 0;
+        std::sort(values.begin(), values.end());
+        return values[values.size() / 2];
+    };
+    xrfg::D3D12SmoothCursorStats stats{};
+    require(operation_succeeded(pipelines[1].synthesizer->wait_for_idle()) &&
+                operation_succeeded(pipelines[0].synthesizer->wait_for_idle()), "bench: idle");
+    static_cast<void>(pipelines[1].synthesizer->smooth_cursor_stats(&stats));
+    std::cout << "cursor bench " << width << "x" << height << " x2: composition median off "
+              << median(pipelines[0].composition) << " us, on " << median(pipelines[1].composition)
+              << " us (" << pipelines[1].composition.size() << " pairs); whole pair median off "
+              << median(pipelines[0].total) << " us, on " << median(pipelines[1].total)
+              << " us; detection: acquisition "
+              << pipelines[1].first_detection << " us, tracking median " << median(pipelines[1].detection)
+              << " us (" << pipelines[1].detection.size() << "); gate pairs " << stats.pairs << " drawn "
+              << stats.drawn << " acquired " << stats.acquired << " tracked " << stats.tracked
+              << " not_found " << stats.not_found << " margin " << stats.ambiguous << " jump "
+              << stats.jump << " busy " << stats.busy << '\n';
+}
