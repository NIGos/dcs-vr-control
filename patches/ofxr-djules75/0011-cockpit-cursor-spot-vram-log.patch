+// DCS VR Control (0011): one diagnostic capture's files (see
+// D3D12SmoothCursorOptions::capture_directory).
+void write_cursor_capture_files(
+    const std::vector<std::uint32_t>& capture,
+    const std::filesystem::path& directory,
+    std::uint32_t index) noexcept {
+    try {
+        const std::uint32_t* words = capture.data();
+        if (words[0] == 0x43535243U) {
+            const std::wstring stem = L"cursor-capture-" + std::to_wstring(GetCurrentProcessId()) +
+                L"-" + std::to_wstring(index);
+            const auto bmp = [&](const wchar_t* suffix, const std::uint32_t* pixels,
+                                 UINT width, UINT height, UINT stride) {
+                const UINT row = (width * 3U + 3U) & ~3U;
+                std::vector<std::uint8_t> file(54U + static_cast<std::size_t>(row) * height, 0U);
+                const auto put32 = [&](std::size_t at, std::uint32_t value) {
+                    for (int b = 0; b < 4; ++b) file[at + b] = static_cast<std::uint8_t>(value >> (8 * b));
+                };
+                file[0] = 'B'; file[1] = 'M';
+                put32(2, static_cast<std::uint32_t>(file.size())); put32(10, 54); put32(14, 40);
+                put32(18, width); put32(22, height);
+                file[26] = 1; file[28] = 24;
+                put32(34, row * height);
+                for (UINT y = 0; y < height; ++y) {
+                    std::uint8_t* out = file.data() + 54 + static_cast<std::size_t>(height - 1U - y) * row;
+                    for (UINT x = 0; x < width; ++x) {
+                        const std::uint32_t rgba = pixels[static_cast<std::size_t>(y) * stride + x];
+                        out[x * 3U] = static_cast<std::uint8_t>(rgba >> 16U);
+                        out[x * 3U + 1U] = static_cast<std::uint8_t>(rgba >> 8U);
+                        out[x * 3U + 2U] = static_cast<std::uint8_t>(rgba);
+                    }
+                }
+                HANDLE handle = CreateFileW((directory / (stem + suffix)).c_str(),
+                    GENERIC_WRITE, 0, nullptr, CREATE_ALWAYS, FILE_ATTRIBUTE_NORMAL, nullptr);
+                if (handle != INVALID_HANDLE_VALUE) {
+                    DWORD written = 0;
+                    WriteFile(handle, file.data(), static_cast<DWORD>(file.size()), &written, nullptr);
+                    CloseHandle(handle);
+                }
+            };
+            const std::uint32_t* crops = words + kCaptureHeaderWords;
+            bmp(L"-previous.bmp", crops, kCaptureCrop, kCaptureCrop, kCaptureCrop);
+            bmp(L"-current.bmp", crops + kCaptureCrop * kCaptureCrop, kCaptureCrop, kCaptureCrop, kCaptureCrop);
+            const UINT overview_width = std::min<UINT>(words[2] & 0xffffU, kCaptureOverviewMax);
+            const UINT overview_height = std::min<UINT>(words[2] >> 16U, kCaptureOverviewMax);
+            if (overview_width != 0U && overview_height != 0U) {
+                bmp(L"-overview.bmp", crops + 2U * kCaptureCrop * kCaptureCrop,
+                    overview_width, overview_height, kCaptureOverviewMax);
+            }
+            float values[8]{};
+            std::memcpy(values, words + 6, sizeof(values));
+            float rect[4]{};
+            std::memcpy(rect, words + 48, sizeof(rect));
+            std::string text;
+            char line[256]{};
+            std::snprintf(line, sizeof(line),
+                "image %ux%u flags %u view0 rect %.0f,%.0f %.0fx%.0f overview step %u\n"
+                "mouse delta %.1f,%.1f\nprevious crop centre %.1f,%.1f\ncurrent crop centre %.1f,%.1f\n",
+                words[4] & 0xffffU, words[4] >> 16U, words[5], rect[0], rect[1], rect[2], rect[3], words[3],
+                values[0], values[1], values[2], values[3], values[4], values[5]);
+            text += line;
+            for (int frame = 0; frame < 2; ++frame) {
+                const std::uint32_t* entry = words + (frame == 0 ? 16 : 32);
+                float score = 0.0F;
+                float second = 0.0F;
+                std::memcpy(&score, entry + 5, sizeof(score));
+                std::memcpy(&second, entry + 6, sizeof(second));
+                std::snprintf(line, sizeof(line),
+                    "%s: status %u at %d,%d template %u scale step %u score %.3f look-alike %.3f mode %u\n",
+                    frame == 0 ? "previous" : "current", entry[0], static_cast<std::int32_t>(entry[1]),
+                    static_cast<std::int32_t>(entry[2]), entry[3], entry[4], score, second, entry[9]);
+                text += line;
+            }
+            HANDLE handle = CreateFileW((directory / (stem + L"-info.txt")).c_str(),
+                GENERIC_WRITE, 0, nullptr, CREATE_ALWAYS, FILE_ATTRIBUTE_NORMAL, nullptr);
+            if (handle != INVALID_HANDLE_VALUE) {
+                DWORD written = 0;
+                WriteFile(handle, text.data(), static_cast<DWORD>(text.size()), &written, nullptr);
+                CloseHandle(handle);
+            }
+        }
+    } catch (...) {
+    }
+}
