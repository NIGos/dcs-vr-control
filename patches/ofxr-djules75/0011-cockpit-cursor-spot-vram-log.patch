+// DCS VR Control (0011): with `[ofxr] diag_vram` the memory the panel shows
+// also goes to the flight log once a second (vram_status), so a flight that
+// ran short of video memory can be told from one that did not afterwards.
+void log_vram_status(SessionState& state) noexcept {
+    if (!state.diag_vram || !xrfg::bridge_flight_logger().enabled()) {
+        return;
+    }
+    const std::uint64_t now = GetTickCount64();
+    if (now - state.vram_logged_ms < 1000U) {
+        return;
+    }
+    state.vram_logged_ms = now;
+    // Only once the session's device is known: ensure_gpu_stats tries once.
+    if (state.d3d12_device || state.d3d11_device) {
+        ensure_gpu_stats(state);
+    }
+    if (!state.gpu_stats) {
+        return;
+    }
+    const xrfg::VramStatus vram = state.gpu_stats->snapshot().vram;
+    if (!vram.known) {
+        return;
+    }
+    const auto mib = [](std::uint64_t bytes) { return std::min<std::uint64_t>(bytes >> 20U, 0xffffffffU); };
+    // Windows gives a process in the background a smaller budget.
+    DWORD foreground_process = 0;
+    if (HWND foreground = GetForegroundWindow(); foreground != nullptr) {
+        GetWindowThreadProcessId(foreground, &foreground_process);
+    }
+    xrfg::bridge_flight_logger().event(
+        xrfg::BridgeFlightOperation::vram_status,
+        1,
+        mib(vram.process_usage) | (mib(vram.budget) << 32U),
+        mib(vram.adapter_used) | (mib(vram.adapter_total) << 32U),
+        foreground_process == GetCurrentProcessId() ? 1U : 0U);
+}
