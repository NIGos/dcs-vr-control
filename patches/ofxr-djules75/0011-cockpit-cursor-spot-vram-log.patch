+// (0011) As DCS's cockpit draws it (enlight/rayCursor.fx): the image as a
+// spot, brighter at its centre (x0.5 at the rim to x1.5), lit by the scene so
+// its yellow arrives orange, added over the panel with 30 % of the panel
+// still showing under its opaque texels.
+void draw_ray_cursor(StereoPattern* pattern, UINT eye, CursorPosition at, const Sprite& sprite) {
+    const float half = static_cast<float>(sprite.size) * 0.5F;
+    for (int ty = 0; ty < sprite.size; ++ty) {
+        for (int tx = 0; tx < sprite.size; ++tx) {
+            const std::uint32_t rgba = sprite.rgba[static_cast<std::size_t>(ty * sprite.size + tx)];
+            const int x = at[0] + tx;
+            const int y = at[1] + ty;
+            if ((rgba >> 24U) == 0U || x < 0 || y < 0 || x >= static_cast<int>(kCursorWidth) ||
+                y >= static_cast<int>(kCursorHeight)) {
+                continue;
+            }
+            const float dx = (static_cast<float>(tx) + 0.5F - half) / half;
+            const float dy = (static_cast<float>(ty) + 0.5F - half) / half;
+            const float t = std::clamp(1.0F - (dx * dx + dy * dy), 0.0F, 1.0F);
+            const float gain = (t * t * (3.0F - 2.0F * t) + 0.5F) / 1.5F;
+            const std::array<float, 3> lit{235.0F, 150.0F, 20.0F};
+            const std::size_t offset =
+                (static_cast<std::size_t>(y) * kCursorWidth + static_cast<std::size_t>(x)) * kBytesPerPixel;
+            for (UINT channel = 0; channel < 3U; ++channel) {
+                const float under = static_cast<float>((*pattern)[eye][offset + channel]);
+                (*pattern)[eye][offset + channel] = static_cast<std::uint8_t>(
+                    std::lround(std::clamp(under * 0.3F + lit[channel] * gain, 0.0F, 255.0F)));
+            }
+        }
+    }
+}
