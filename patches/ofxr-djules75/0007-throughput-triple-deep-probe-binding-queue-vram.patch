+std::string format_vram_line(const VramStatus& vram, DiagnosticColor& color) {
+    if (!vram.known) { color = DiagnosticColor::grey; return "VRAM: not available"; }
+    constexpr double kGiB = 1024.0 * 1024.0 * 1024.0;
+    const auto gb = [](std::uint64_t bytes) { return fixed(static_cast<float>(static_cast<double>(bytes) / kGiB), 1); };
+    const bool adapter_wide = vram.adapter_used != 0 && vram.adapter_total != 0;
+    const std::uint64_t used = adapter_wide ? vram.adapter_used : vram.process_usage;
+    const std::uint64_t total = adapter_wide ? vram.adapter_total
+        : vram.budget != 0 ? vram.budget : vram.adapter_total;
+    std::string text = "VRAM " + gb(used) + " / " + gb(total) + " GB";
+    if (adapter_wide) {
+        text += " (app " + gb(vram.process_usage);
+        if (vram.budget != 0) text += ", budget " + gb(vram.budget);
+        text += ")";
+    } else if (vram.budget != 0) {
+        text += " (app / budget)";
+    }
+    color = DiagnosticColor::white;
+    if (vram.budget != 0 && vram.process_usage > vram.budget) color = DiagnosticColor::red;
+    else if ((total != 0 && used * 10 >= total * 9) ||
+             (vram.budget != 0 && vram.process_usage * 10 >= vram.budget * 9)) color = DiagnosticColor::amber;
+    return text;
+}
