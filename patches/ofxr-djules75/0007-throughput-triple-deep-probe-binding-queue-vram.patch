+        // Off by default: the 0004-0006 behaviour is unchanged without it.
+        AdaptiveFrameGenController controller;
+        controller.start(3, start);
+        Nanoseconds now = start;
+        const auto run = drive_probes(controller, now, 60 * kSecond, 27 * kMillisecond, 20 * kMillisecond, 0);
+        require(run.started.empty() && controller.mode() == 3, "no probe unless configured");
+    }
+    {
+        // The live case: 3X reads 27 ms a frame - its own cap, not the
+        // application's work - over the 18.9 ms the headroom rule needs, so
+        // the rules alone never leave 3X. The application really needs 20 ms
+        // and holds 2X (45 at 90 Hz) without a missed slot: the probe finds
+        // that and keeps 2X.
+        AdaptiveFrameGenController controller(config);
+        controller.start(3, start);
+        Nanoseconds now = start;
+        const auto run = drive_probes(controller, now, 90 * kSecond, 27 * kMillisecond, 20 * kMillisecond, 0);
+        require(run.started.size() == 1, "one probe: " + std::to_string(run.started.size()));
+        require(run.started[0] - start >= 20 * kSecond && run.started[0] - start < 20 * kSecond + 4 * kPeriod,
+            "after the probe interval in a stable 3X");
+        require(run.kept.size() == 1 && run.failed.empty(), "the window held");
+        require(run.kept[0] - run.started[0] >= 2500 * kMillisecond &&
+                run.kept[0] - run.started[0] < 2500 * kMillisecond + 3 * kPeriod,
+            "kept at the end of the window");
+        require(run.other_switch < 0 && controller.mode() == 2, "and 2X stays");
+        require(!controller.probing() && controller.probe_interval() == 20 * kSecond, "the interval is the base one");
