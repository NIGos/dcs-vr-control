+    }
+    if (open) {
+        total += open_end - open_start;
+    }
+    return total;
+}
+
+} // namespace
+
+BlockedSplit BlockedIntervalLog::blocked(
+    Nanoseconds from,
+    Nanoseconds to,
+    std::uint32_t frame_thread,
+    Nanoseconds other_until) const noexcept {
+    BlockedSplit split{};
+    if (to <= from) {
+        return split;
+    }
+    other_until = std::clamp(other_until, from, to);
+    std::array<std::pair<Nanoseconds, Nanoseconds>, kCapacity> own{};
+    std::array<std::pair<Nanoseconds, Nanoseconds>, kCapacity> all{};
+    std::size_t own_n = 0;
+    std::size_t all_n = 0;
+    for (std::size_t index = 0; index < filled_; ++index) {
+        const Entry& entry = entries_[index];
+        const bool mine = entry.thread == frame_thread;
+        const Nanoseconds limit = mine ? to : other_until;
+        const Nanoseconds start = std::max(entry.start, from);
+        const Nanoseconds end = std::min(entry.end, limit);
+        if (end <= start) {
+            continue;
+        }
+        all[all_n++] = {start, end};
+        if (mine) {
+            own[own_n++] = {start, end};
+        }
+    }
+    split.own = union_length(own, own_n);
+    split.total = union_length(all, all_n);
+    return split;
+}
+
+// ---------------------------------------------------------------------------
+// DCS VR Control (0007): GPU busy time.
+
+void GpuBusyMeter::observe(const GpuBusySample& sample) noexcept {
+    if (sample.span <= 0 || sample.process_busy_delta < 0 ||
+        sample.adapter_busy_delta < 0) {
+        // Counters that went backwards (an adapter reset): start over.
+        pending_ = {};
+        return;
+    }
+    pending_.at = sample.at;
+    pending_.process_busy_delta += sample.process_busy_delta;
+    pending_.adapter_busy_delta += sample.adapter_busy_delta;
+    pending_.frames_delta += sample.frames_delta;
+    pending_.span += sample.span;
+    if (pending_.span < kMinimumSpan) {
+        return;
+    }
+    GpuBusyReading reading{};
+    reading.valid = true;
+    reading.at = pending_.at;
+    const double span = static_cast<double>(pending_.span);
+    reading.process_load = static_cast<double>(pending_.process_busy_delta) / span;
+    reading.adapter_load = std::max(
+        reading.process_load,
+        static_cast<double>(pending_.adapter_busy_delta) / span);
+    reading.per_frame = pending_.frames_delta == 0
+        ? -1
+        : pending_.process_busy_delta /
+              static_cast<Nanoseconds>(pending_.frames_delta);
+    latest_ = reading;
+    pending_ = {};
+}
+
+GpuBusyReading GpuBusyMeter::fresh(
+    Nanoseconds now, Nanoseconds max_age) const noexcept {
+    if (!latest_.valid || now - latest_.at > max_age) {
+        return {};
+    }
+    return latest_;
+}
+
+double projected_gpu_load_at_double_rate(
+    double process_load, double adapter_load) noexcept {
+    process_load = std::max(0.0, process_load);
+    const double others = std::max(0.0, adapter_load - process_load);
+    return others + process_load * 1.5;
+}
+
 } // namespace xrfg::latency
