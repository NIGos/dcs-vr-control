+// ---------------------------------------------------------------------------
+// DCS VR Control (0007): holds attributed to frames.
+
+void blocked_interval_tests() {
+    constexpr std::uint32_t render = 1;
+    constexpr std::uint32_t wait = 2;
+    {
+        // DCS's shape: the render thread released at 0 and held 5 ms in its
+        // xrEndFrame at the end; the wait thread held 4 ms in xrWaitFrame
+        // before the render thread could begin (at 8 ms), and 10 ms later
+        // while the render thread drew. Only the first wait counts.
+        BlockedIntervalLog log;
+        log.add(render, 30 * kMillisecond, 35 * kMillisecond);
+        log.add(wait, 2 * kMillisecond, 6 * kMillisecond);
+        log.add(wait, 12 * kMillisecond, 22 * kMillisecond);
+        const auto split = log.blocked(0, 35 * kMillisecond, render, 8 * kMillisecond);
+        require(split.own == 5 * kMillisecond, "own holds: " + std::to_string(split.own));
+        require(split.total == 9 * kMillisecond, "plus the wait before the begin: " + std::to_string(split.total));
+    }
+    {
+        // Two threads held at once delay the frame once; a hold straddling
+        // the frame's start is clipped to it.
+        BlockedIntervalLog log;
+        log.add(render, -5 * kMillisecond, 3 * kMillisecond);
+        log.add(wait, 1 * kMillisecond, 4 * kMillisecond);
+        const auto split = log.blocked(0, 20 * kMillisecond, render, 20 * kMillisecond);
+        require(split.own == 3 * kMillisecond && split.total == 4 * kMillisecond, "union, clipped");
+    }
+    {
+        // Holds outside the frame do not count; an empty interval is zero.
+        BlockedIntervalLog log;
+        log.add(render, 50 * kMillisecond, 60 * kMillisecond);
+        log.add(render, 5, 5);
+        require(log.blocked(0, 40 * kMillisecond, render, 40 * kMillisecond).total == 0, "outside");
+        require(log.blocked(10, 10, render, 10).total == 0, "empty frame");
+        // The ring forgets the oldest.
+        for (std::size_t i = 0; i < BlockedIntervalLog::kCapacity; ++i) {
+            log.add(render, 100 * kMillisecond + static_cast<Nanoseconds>(i) * 10, 100 * kMillisecond + static_cast<Nanoseconds>(i) * 10 + 5);
+        }
+        require(log.blocked(0, 70 * kMillisecond, render, 0).total == 0, "overwritten");
+        log.reset();
+        require(log.blocked(0, 200 * kMillisecond, render, 0).total == 0, "reset");
+    }
+}
+
+// ---------------------------------------------------------------------------
+// DCS VR Control (0007): GPU busy per frame.
+
+void gpu_busy_tests() {
+    {
+        GpuBusyMeter meter;
+        require(!meter.latest().valid, "nothing yet");
+        // 250 ms: the process's busiest engine ran 100 ms, the adapter's
+        // 150 ms, over 8 application frames.
+        meter.observe({kSecond, 100 * kMillisecond, 150 * kMillisecond, 8, 250 * kMillisecond});
+        const auto reading = meter.latest();
+        require(reading.valid && reading.per_frame == 12'500'000, "busy per frame: " + std::to_string(reading.per_frame));
+        require(reading.process_load > 0.399 && reading.process_load < 0.401, "process load");
+        require(reading.adapter_load > 0.599 && reading.adapter_load < 0.601, "adapter load");
+        require(meter.fresh(kSecond + 500 * kMillisecond, kSecond).valid, "fresh");
+        require(!meter.fresh(3 * kSecond, kSecond).valid, "stale");
+    }
+    {
+        // Short samples are folded into the next.
+        GpuBusyMeter meter;
+        meter.observe({100 * kMillisecond, 20 * kMillisecond, 20 * kMillisecond, 2, 100 * kMillisecond});
+        require(!meter.latest().valid, "too short alone");
+        meter.observe({200 * kMillisecond, 30 * kMillisecond, 40 * kMillisecond, 3, 100 * kMillisecond});
+        require(meter.latest().valid && meter.latest().per_frame == 10 * kMillisecond, "folded: " +
+            std::to_string(meter.latest().per_frame));
+        // No frames: loads, but nothing per frame.
+        meter.observe({500 * kMillisecond, 30 * kMillisecond, 40 * kMillisecond, 0, 300 * kMillisecond});
+        require(meter.latest().valid && meter.latest().per_frame == -1, "no frames");
+        // Counters that went backwards start over.
+        meter.observe({600 * kMillisecond, -5, 10, 1, 100 * kMillisecond});
+        meter.observe({700 * kMillisecond, 10 * kMillisecond, 10 * kMillisecond, 1, 100 * kMillisecond});
+        require(meter.latest().at == 500 * kMillisecond, "the bad sample and its fold are dropped");
+        // The adapter is never less loaded than the process on it.
+        GpuBusyMeter other;
+        other.observe({kSecond, 200 * kMillisecond, 100 * kMillisecond, 4, 400 * kMillisecond});
+        require(other.latest().adapter_load >= other.latest().process_load, "adapter >= process");
+    }
+    {
+        // 2X projection: the process's 40% grows by half, the 20% that is
+        // everyone else's stays.
+        const double load = projected_gpu_load_at_double_rate(0.4, 0.6);
+        require(load > 0.799 && load < 0.801, "projected: " + std::to_string(load));
+        require(projected_gpu_load_at_double_rate(0.7, 0.7) > 1.0, "a busy GPU projects past 1");
+    }
+}
+
+// ---------------------------------------------------------------------------
+// DCS VR Control (0007): 3X's deeper pipeline.
+
+void triple_depth_tests() {
+    {
+        TripleDepth depth;
+        depth.arm(true, 2);
+        require(!depth.pending, "2X has its own deeper pipeline");
+        depth.arm(false, 3);
+        require(!depth.pending, "shallow 3X takes no shift");
+        depth.arm(true, 3);
+        require(depth.pending, "deep 3X arms");
+        require(!depth.take(false, true, true), "only at a slot after a real frame");
+        require(!depth.take(true, false, true), "not ahead of a frame's second synthetic");
+        require(!depth.take(true, true, false), "not without a frame to re-present");
+        require(depth.take(true, true, true) && depth.inserted == 1 && depth.slots == 1, "taken once");
+        require(!depth.take(true, true, true) && depth.inserted == 1, "and only once");
+        // On time: no more.
+        for (std::uint32_t i = 0; i < 10 * TripleDepth::kWindow; ++i) {
+            require(!depth.observe_leader(i % 15 == 0), "two late in thirty asks for nothing");
+        }
+        require(!depth.pending && depth.slots == 1, "one slot holds");
+        // One hitch - three late at once, then on time - asks for nothing.
+        for (std::uint32_t i = 0; i < 4 * TripleDepth::kWindow; ++i) {
+            require(!depth.observe_leader(i >= 40 && i < 43), "one hitch asks for nothing");
+        }
+        // Three late in a window, two windows running: one more slot, then
+        // no more past two.
+        bool asked = false;
+        std::uint32_t seen = 0;
+        for (std::uint32_t i = 0; i < 2 * TripleDepth::kWindow && !asked; ++i, ++seen) {
+            asked = depth.observe_leader(i % 10 == 0);
+        }
+        require(asked && depth.pending && seen == 2 * TripleDepth::kWindow,
+            "three late in thirty, twice, asks for a second slot");
+        require(!depth.observe_leader(true), "nothing counted while one is pending");
+        require(depth.take(true, true, true) && depth.slots == 2 && depth.inserted == 2, "second slot");
+        for (std::uint32_t i = 0; i < 3 * TripleDepth::kWindow; ++i) {
+            require(!depth.observe_leader(true), "two is the most");
+        }
+        depth.arm(true, 3);
+        require(depth.pending && depth.slots == 0, "a new shape starts over");
+        require(depth.take(true, true, true) && depth.inserted == 3 && depth.slots == 1, "re-armed by a new shape");
+        depth.arm(true, 2);
+        require(!depth.active && !depth.observe_leader(true), "inactive outside 3X");
+    }
+    {
+        // The release delay keeps the depth's period in hand.
+        require(triple_slack_for_tuner(14 * kMillisecond, kPeriod, true) == 14 * kMillisecond - kPeriod, "deep");
+        require(triple_slack_for_tuner(14 * kMillisecond, kPeriod, false) == 14 * kMillisecond, "shallow");
+        // A deep 3X with 13.1 ms of measured slack (a period plus 2 ms) sits
+        // in the tuner's band: no raise, no back-off.
+        TripleReleaseTuner tuner;
+        TripleReleaseWindow window{};
+        for (std::uint32_t i = 0; i < TripleReleaseTuner::kWindowFrames; ++i) {
+            window = observe_triple_slack(tuner, kPeriod,
+                triple_slack_for_tuner(kPeriod + 2 * kMillisecond + 100'000, kPeriod, true));
+        }
+        require(window.closed && tuner.delay <= kMillisecond, "a period kept: delay " + std::to_string(tuner.delay));
+        // And one that falls under a period backs off at once.
+        tuner.delay = 6 * kMillisecond;
+        for (std::uint32_t i = 0; i < TripleReleaseTuner::kWindowFrames; ++i) {
+            window = observe_triple_slack(tuner, kPeriod,
+                triple_slack_for_tuner(kPeriod - 3 * kMillisecond, kPeriod, true));
+        }
+        require(window.closed && tuner.delay < 6 * kMillisecond, "under a period backs off: " +
+            std::to_string(tuner.delay));
+    }
+}
