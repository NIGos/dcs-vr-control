+// ---------------------------------------------------------------------------
+// DCS VR Control (0007): the layer's holds on the application, attributed to
+// the frame they delayed.
+//
+// Adaptive control's CPU figure is a frame's interval less the time the
+// layer held the application. 0004 took only the thread that calls
+// xrEndFrame into account, which misses an application whose frame starts on
+// another thread: DCS World calls xrWaitFrame on its main thread once the
+// render thread's xrEndFrame has returned, and the render thread begins its
+// next frame only after that - a hold there delays the frame exactly as much
+// as one on the render thread does, and was counted as the application's own
+// work.
+//
+// Every hold is logged as an interval, with the thread it was on. A frame's
+// blocked time is the union, within its interval, of
+//   - every hold on the thread that ends the frame, wherever it falls, and
+//   - holds on any other thread that fall between the frame's start and the
+//     moment its own thread entered xrBeginFrame: the stretch in which the
+//     frame was waiting to start at all.
+// Holds on other threads after that overlap the frame's own work - a wait
+// thread that sits in xrWaitFrame while the render thread draws costs the
+// frame nothing - and are not counted. The union, not the sum: two threads
+// held at once delay a frame once.
+//
+// Limits: what the application does between a hold on another thread and
+// its own xrBeginFrame (its simulation step, say) is still counted as its
+// work, which it is; and a hold the layer cannot see - the application
+// waiting on its own threads, or on its GPU - is work too, as far as this
+// can tell.
+struct BlockedSplit {
+    // The union described above.
+    Nanoseconds total{};
+    // Of it, the frame thread's own holds alone (0004's figure).
+    Nanoseconds own{};
 };
 
+class BlockedIntervalLog {
+public:
+    static constexpr std::size_t kCapacity = 512;
+
+    void add(std::uint32_t thread, Nanoseconds start, Nanoseconds end) noexcept;
+    // Over (from, to]: the frame thread's holds, and other threads' up to
+    // other_until (clamped into the interval).
+    [[nodiscard]] BlockedSplit blocked(
+        Nanoseconds from,
+        Nanoseconds to,
+        std::uint32_t frame_thread,
+        Nanoseconds other_until) const noexcept;
+    void reset() noexcept;
+
+private:
+    struct Entry {
+        Nanoseconds start{};
+        Nanoseconds end{};
+        std::uint32_t thread{};
+    };
+    std::array<Entry, kCapacity> entries_{};
+    std::size_t next_{};
+    std::size_t filled_{};
+};
+
+// ---------------------------------------------------------------------------
+// DCS VR Control (0007): GPU busy time per application frame.
+//
+// 0004 timed the application's frame with two GPU timestamps on its own
+// context, opened at its release and closed at its next xrEndFrame. That is
+// a span, not busy time: on a title that submits as it records, the GPU
+// waits for the CPU inside it, so a CPU-bound frame reads as long on the GPU
+// as on the CPU, plus the tail of its last commands - on the live DCS flight
+// 24-33 ms of "GPU" a frame against a 16-28 ms CPU, with the headset's own
+// GPU readout at 50-67%. Timestamps alone cannot tell idle from busy inside
+// one stretch of commands.
+//
+// The operating system's GPU scheduler can: it keeps, per process and per
+// engine (node), the time that process's work actually ran (what Task
+// Manager shows). The layer samples it a few times a second off the render
+// path and feeds the deltas here with the count of application frames: busy
+// per frame is the busiest engine's running time over the frames in
+// between. It covers everything the process put on that engine - the
+// application's frame, the layer's synthesis and copies - and nothing it did
+// not run, so idle gaps never count. The adapter's own counters give the
+// whole GPU's load, the compositor's and every other process's included,
+// which projected_gpu_load_at_double_rate uses.
+//
+// Limits: a sample spans several frames, so a frame's figure is the average
+// over its sample (a single long frame is diluted); engines run concurrently
+// and only the busiest is taken, which is right for a GPU-bound title and an
+// underestimate for one that alternates engines heavily; and another
+// process's work on the same engine slows this one's without showing in its
+// figure (it shows in the adapter's load).
+struct GpuBusySample {
+    Nanoseconds at{};
+    // Deltas since the previous sample: the busiest of the process's engines
+    // and the busiest of the adapter's (each the max of per-engine deltas),
+    // the application frames ended, and the wall time between the samples.
+    Nanoseconds process_busy_delta{};
+    Nanoseconds adapter_busy_delta{};
+    std::uint64_t frames_delta{};
+    Nanoseconds span{};
+};
+
+struct GpuBusyReading {
+    bool valid{};
+    Nanoseconds at{};
+    // Busy per application frame, -1 without frames in the sample.
+    Nanoseconds per_frame{-1};
+    // Fractions of the sample's wall time.
+    double process_load{};
+    double adapter_load{};
+};
+
+class GpuBusyMeter {
+public:
+    // Samples shorter than this are folded into the next one.
+    static constexpr Nanoseconds kMinimumSpan = 150 * kMillisecond;
+    void observe(const GpuBusySample& sample) noexcept;
+    [[nodiscard]] GpuBusyReading latest() const noexcept { return latest_; }
+    // The latest reading if it is no older than `max_age` at `now`; an
+    // invalid one otherwise.
+    [[nodiscard]] GpuBusyReading fresh(
+        Nanoseconds now, Nanoseconds max_age) const noexcept;
+    void reset() noexcept { *this = GpuBusyMeter{}; }
+
+private:
+    GpuBusySample pending_{};
+    GpuBusyReading latest_{};
+};
+
+// The adapter's load if the application ran at one and a half times its 3X
+// rate (3X -> 2X): its own share grows by half, everyone else's stays.
+// Inputs as fractions of wall time; the result can exceed 1, which is the
+// point of it.
+[[nodiscard]] double projected_gpu_load_at_double_rate(
+    double process_load, double adapter_load) noexcept;
+
+// ---------------------------------------------------------------------------
+// DCS VR Control (0007): 3X with the deeper pipeline.
+//
+// In 3X the application is released on the presenter's count, once every
+// three slots, at the slot its previous frame's real one goes out in; its
+// next frame's first synthetic takes the slot after that, a single period
+// later. Under a pipelined application (DCS World's shape: the presenter
+// keeps no frame to repeat and waits for the next one instead) that phase
+// never moves, so a frame that needs more than a period to render and
+// synthesize sends every first synthetic out late - on the live flight, 16
+// to 28 ms of work against an 11.1 ms period, all of them, until the
+// late-frame skip stopped making them (the headset saw 60 distinct frames a
+// second).
+//
+// The deeper pipeline re-presents the previous real frame in one slot, once:
+// from then on every frame goes out a slot later than it would have - the
+// application keeps its rate (that slot advances the presenter's count like
+// any other) and its first synthetic has two periods instead of one, paid
+// for in a period of latency. If first synthetics still go out late -
+// kGrowLate or more of a window of kWindow of them, in kGrowWindows windows
+// in a row, so that one hitch (a frame of 90 ms late three first synthetics
+// at once) does not add a period of latency for good - one more slot is
+// taken the same way, up to kMaxSlots: with two, the first synthetic has the whole
+// three-period cycle, which is all an application that holds 3X at all can
+// need. Slack beyond what the frames use is not given back by removing a
+// slot but by the release delay, which keeps one period of it in hand
+// (triple_slack_for_tuner).
+//
+// It is not done by holding every first synthetic until it is a period old
+// (2X's deeper pipeline): under a pipelined application there is no frame to
+// hold with, and a hold for age would add a slot every time the application
+// ran a little late - a pipeline that only ever deepens.
+//
+// Armed whenever the session takes 3X with the deeper pipeline (its start,
+// a switch, a new presenter), which also forgets the slots taken before;
+// taken at the first slot after a real frame whose first synthetic (or the
+// late-frame skip's one synthetic) is waiting or not yet there, when there
+// is a frame to re-present.
+struct TripleDepth {
+    static constexpr std::uint32_t kMaxSlots = 2;
+    static constexpr std::uint32_t kWindow = 30;
+    static constexpr std::uint32_t kGrowLate = 3;
+    static constexpr std::uint32_t kGrowWindows = 2;
+
+    bool active{};               // 3X with the deeper pipeline in force
+    bool pending{};              // a slot is wanted
+    std::uint32_t slots{};       // taken in this shape
+    std::uint32_t inserted{};    // taken over the session, for the log
+    std::uint32_t window{};
+    std::uint32_t window_late{};
+    std::uint32_t late_windows{}; // in a row
+
+    void arm(bool deep_pipeline, std::uint32_t frames_per_application_frame) noexcept {
+        active = deep_pipeline && frames_per_application_frame > 2;
+        pending = active;
+        slots = 0;
+        window = 0;
+        window_late = 0;
+        late_windows = 0;
+    }
+    // One first synthetic's slot (not a re-presented one of this): whether
+    // it was late. Returns true when this asks for one more slot.
+    bool observe_leader(bool late) noexcept {
+        if (!active || pending || slots >= kMaxSlots) {
+            return false;
+        }
+        ++window;
+        window_late += late ? 1U : 0U;
+        if (window < kWindow) {
+            return false;
+        }
+        late_windows = window_late >= kGrowLate ? late_windows + 1 : 0;
+        window = 0;
+        window_late = 0;
+        const bool grow = late_windows >= kGrowWindows;
+        if (grow) {
+            late_windows = 0;
+        }
+        pending = grow;
+        return grow;
+    }
+    // At a slot after a real frame (gen1_slot): whether this slot is the one
+    // re-presented. `leader_or_empty`: the front of the queue is a first
+    // synthetic, or nothing is queued. `can_repeat`: a frame to re-present.
+    [[nodiscard]] bool take(
+        bool gen1_slot, bool leader_or_empty, bool can_repeat) noexcept {
+        if (!pending || !gen1_slot || !leader_or_empty || !can_repeat) {
+            return false;
+        }
+        pending = false;
+        ++slots;
+        ++inserted;
+        window = 0;
+        window_late = 0;
+        late_windows = 0;
+        return true;
+    }
+};
+
+// The release delay's slack sample in 3X with the deeper pipeline: a period
+// of the measured slack is the depth itself and is not given back as delay,
+// so the tuner keeps that period in hand (it raises only past a period plus
+// kSlackMargin, and backs off as soon as less than a period is left).
+[[nodiscard]] constexpr Nanoseconds triple_slack_for_tuner(
+    Nanoseconds slack, Nanoseconds period, bool deep_pipeline) noexcept {
+    return deep_pipeline && period > 0 ? slack - period : slack;
+}
