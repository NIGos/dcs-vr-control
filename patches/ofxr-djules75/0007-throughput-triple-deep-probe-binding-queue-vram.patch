index 0000000..54f2707
--- /dev/null
+++ b/src/layer/gpu_stats_sampler.cpp
@@ -0,0 +1,271 @@
+// DCS VR Control (0007): see gpu_stats_sampler.hpp.
+#include "xrfg/gpu_stats_sampler.hpp"
+
+#include <algorithm>
+#include <chrono>
+#include <condition_variable>
+#include <mutex>
+#include <thread>
+#include <vector>
+
+#include <winternl.h> // NTSTATUS, which d3dkmthk.h expects
+#include <d3dkmthk.h>
+#include <dxgi1_6.h>
+#include <wrl/client.h>
+
+namespace xrfg {
+namespace {
+
+using QueryStatistics = NTSTATUS(APIENTRY*)(const D3DKMT_QUERYSTATISTICS*);
+
+[[nodiscard]] latency::Nanoseconds steady_now() noexcept {
+    return std::chrono::duration_cast<std::chrono::nanoseconds>(
+        std::chrono::steady_clock::now().time_since_epoch()).count();
+}
+
+// The scheduler's running times are in 100 ns units (checked against a
+// known GPU load: 50% duty read 0.46 of wall time in them).
+constexpr latency::Nanoseconds kRunningTimeUnit = 100;
+constexpr ULONG kMaximumNodes = 64;
+constexpr ULONG kMaximumSegments = 32;
+
+} // namespace
+
+struct GpuStatsSampler::Impl {
+    LUID adapter{};
+    bool sample_busy{};
+    bool sample_vram{};
+    const std::atomic<std::uint64_t>* frames{};
+    QueryStatistics query{};
+    ULONG nodes{};
+    ULONG segments{};
+    std::vector<std::int64_t> process_previous;
+    std::vector<std::int64_t> adapter_previous;
+    std::uint64_t frames_previous{};
+    latency::Nanoseconds busy_previous_at{};
+    bool busy_primed{};
+    Microsoft::WRL::ComPtr<IDXGIAdapter3> dxgi_adapter;
+    std::uint64_t dedicated_total{};
+    bool dxgi_tried{};
+
+    mutable std::mutex mutex;
+    std::condition_variable condition;
+    bool stop{};
+    latency::GpuBusyMeter meter;   // mutex
+    VramStatus vram;               // mutex
+    std::thread thread;
+
+    [[nodiscard]] bool query_running_time(
+        D3DKMT_QUERYSTATISTICS_TYPE type, ULONG node, std::int64_t* value) const noexcept {
+        D3DKMT_QUERYSTATISTICS statistics{};
+        statistics.Type = type;
+        statistics.AdapterLuid = adapter;
+        if (type == D3DKMT_QUERYSTATISTICS_PROCESS_NODE) {
+            statistics.hProcess = GetCurrentProcess();
+            statistics.QueryProcessNode.NodeId = node;
+        } else {
+            statistics.QueryNode.NodeId = node;
+        }
+        if (query(&statistics) != 0) {
+            return false;
+        }
+        *value = type == D3DKMT_QUERYSTATISTICS_PROCESS_NODE
+            ? statistics.QueryResult.ProcessNodeInformation.RunningTime.QuadPart
+            : statistics.QueryResult.NodeInformation.GlobalInformation.RunningTime.QuadPart;
+        return true;
+    }
+
+    void initialize() noexcept {
+        HMODULE gdi = GetModuleHandleW(L"gdi32.dll");
+        if (gdi == nullptr) {
+            gdi = LoadLibraryW(L"gdi32.dll");
+        }
+        if (gdi != nullptr) {
+            query = reinterpret_cast<QueryStatistics>(
+                GetProcAddress(gdi, "D3DKMTQueryStatistics"));
+        }
+        if (query == nullptr) {
+            return;
+        }
+        D3DKMT_QUERYSTATISTICS statistics{};
+        statistics.Type = D3DKMT_QUERYSTATISTICS_ADAPTER;
+        statistics.AdapterLuid = adapter;
+        if (query(&statistics) == 0) {
+            nodes = std::min<ULONG>(
+                statistics.QueryResult.AdapterInformation.NodeCount, kMaximumNodes);
+            segments = std::min<ULONG>(
+                statistics.QueryResult.AdapterInformation.NbSegments, kMaximumSegments);
+        }
+        process_previous.assign(nodes, 0);
+        adapter_previous.assign(nodes, 0);
+    }
+
+    void sample_busy_once() noexcept {
+        if (query == nullptr || nodes == 0 || frames == nullptr) {
+            return;
+        }
+        const latency::Nanoseconds now = steady_now();
+        const std::uint64_t frame_count = frames->load(std::memory_order_relaxed);
+        std::int64_t process_max = 0;
+        std::int64_t adapter_max = 0;
+        bool ok = true;
+        for (ULONG node = 0; node < nodes; ++node) {
+            std::int64_t process = 0;
+            std::int64_t whole = 0;
+            if (!query_running_time(D3DKMT_QUERYSTATISTICS_PROCESS_NODE, node, &process) ||
+                !query_running_time(D3DKMT_QUERYSTATISTICS_NODE, node, &whole)) {
+                ok = false;
+                break;
+            }
+            if (busy_primed) {
+                process_max = std::max(process_max, process - process_previous[node]);
+                adapter_max = std::max(adapter_max, whole - adapter_previous[node]);
+            }
+            process_previous[node] = process;
+            adapter_previous[node] = whole;
+        }
+        if (!ok) {
+            busy_primed = false;
+            return;
+        }
+        if (busy_primed) {
+            latency::GpuBusySample sample{};
+            sample.at = now;
+            sample.process_busy_delta = process_max * kRunningTimeUnit;
+            sample.adapter_busy_delta = adapter_max * kRunningTimeUnit;
+            sample.frames_delta = frame_count >= frames_previous
+                ? frame_count - frames_previous
+                : 0;
+            sample.span = now - busy_previous_at;
+            std::scoped_lock lock(mutex);
+            meter.observe(sample);
+        }
+        busy_primed = true;
+        busy_previous_at = now;
+        frames_previous = frame_count;
+    }
+
+    void sample_vram_once() noexcept {
+        if (!dxgi_tried) {
+            dxgi_tried = true;
+            Microsoft::WRL::ComPtr<IDXGIFactory4> factory;
+            if (SUCCEEDED(CreateDXGIFactory1(IID_PPV_ARGS(factory.GetAddressOf())))) {
+                static_cast<void>(factory->EnumAdapterByLuid(
+                    adapter, IID_PPV_ARGS(dxgi_adapter.GetAddressOf())));
+            }
+            if (dxgi_adapter) {
+                DXGI_ADAPTER_DESC description{};
+                if (SUCCEEDED(dxgi_adapter->GetDesc(&description))) {
+                    dedicated_total = description.DedicatedVideoMemory;
+                }
+            }
+        }
+        VramStatus status{};
+        if (dxgi_adapter) {
+            DXGI_QUERY_VIDEO_MEMORY_INFO info{};
+            if (SUCCEEDED(dxgi_adapter->QueryVideoMemoryInfo(
+                    0, DXGI_MEMORY_SEGMENT_GROUP_LOCAL, &info))) {
+                status.known = true;
+                status.process_usage = info.CurrentUsage;
+                status.budget = info.Budget;
+            }
+        }
+        status.adapter_total = dedicated_total;
+        if (query != nullptr && segments != 0) {
+            std::uint64_t resident = 0;
+            bool any = false;
+            for (ULONG segment = 0; segment < segments; ++segment) {
+                D3DKMT_QUERYSTATISTICS statistics{};
+                statistics.Type = D3DKMT_QUERYSTATISTICS_SEGMENT;
+                statistics.AdapterLuid = adapter;
+                statistics.QuerySegment.SegmentId = segment;
+                if (query(&statistics) != 0) {
+                    continue;
+                }
+                const auto& information = statistics.QueryResult.SegmentInformation;
+                if (information.Aperture) {
+                    continue; // system memory seen through the aperture
+                }
+                resident += information.BytesResident;
+                any = true;
+            }
+            status.adapter_used = any ? resident : 0;
+        }
+        std::scoped_lock lock(mutex);
+        vram = status;
+    }
+
+    void run() noexcept {
+        try {
+            initialize();
+            auto next_busy = std::chrono::steady_clock::now();
+            auto next_vram = next_busy;
+            for (;;) {
+                const auto now = std::chrono::steady_clock::now();
+                if (sample_busy && now >= next_busy) {
+                    sample_busy_once();
+                    next_busy = now + std::chrono::milliseconds(kBusyIntervalMs);
+                }
+                if (sample_vram && now >= next_vram) {
+                    sample_vram_once();
+                    next_vram = now + std::chrono::milliseconds(kVramIntervalMs);
+                }
+                auto wake = sample_busy ? next_busy : next_vram;
+                if (sample_busy && sample_vram) {
+                    wake = std::min(next_busy, next_vram);
+                }
+                std::unique_lock lock(mutex);
+                if (condition.wait_until(lock, wake, [&] { return stop; })) {
+                    return;
+                }
+            }
+        } catch (...) {
+        }
+    }
+};
+
+GpuStatsSampler::GpuStatsSampler(
+    LUID adapter,
+    bool sample_busy,
+    bool sample_vram,
+    const std::atomic<std::uint64_t>* frames) noexcept {
+    try {
+        impl_ = std::make_unique<Impl>();
+        impl_->adapter = adapter;
+        impl_->sample_busy = sample_busy;
+        impl_->sample_vram = sample_vram;
+        impl_->frames = frames;
+        if (sample_busy || sample_vram) {
+            impl_->thread = std::thread([raw = impl_.get()] { raw->run(); });
+        }
+    } catch (...) {
+        impl_.reset();
+    }
+}
+
+GpuStatsSampler::~GpuStatsSampler() {
+    if (!impl_) {
+        return;
+    }
+    {
+        std::scoped_lock lock(impl_->mutex);
+        impl_->stop = true;
+    }
+    impl_->condition.notify_all();
+    if (impl_->thread.joinable()) {
+        impl_->thread.join();
+    }
+}
+
+GpuStatsSnapshot GpuStatsSampler::snapshot() const noexcept {
+    GpuStatsSnapshot snapshot{};
+    if (!impl_) {
+        return snapshot;
+    }
+    std::scoped_lock lock(impl_->mutex);
+    snapshot.busy = impl_->meter.latest();
+    snapshot.vram = impl_->vram;
+    return snapshot;
+}
+
+} // namespace xrfg
