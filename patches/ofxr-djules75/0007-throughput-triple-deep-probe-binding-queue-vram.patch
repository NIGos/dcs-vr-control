diff --git a/include/xrfg/gpu_stats_sampler.hpp b/include/xrfg/gpu_stats_sampler.hpp
new file mode 100644
index 0000000..7ed8a9b
--- /dev/null
+++ b/include/xrfg/gpu_stats_sampler.hpp
@@ -0,0 +1,60 @@
+#pragma once
+// DCS VR Control (0007): what the GPU is doing, sampled off the render path.
+//
+// A thread of its own reads, a few times a second:
+//  - busy time: the operating system's GPU scheduler counters
+//    (D3DKMTQueryStatistics) - per engine (node), how long this process's
+//    work ran on it, and how long anything ran on it at all - reduced to the
+//    busiest engine and handed with the application frames counted since the
+//    last sample to an xrfg::latency::GpuBusyMeter (see there for what the
+//    figure is and is not);
+//  - memory, when asked for: IDXGIAdapter3::QueryVideoMemoryInfo for the
+//    local segment group (this process's CurrentUsage and its Budget), the
+//    adapter's dedicated memory from its description, and what every process
+//    together has resident in the adapter's dedicated segments (the
+//    scheduler's segment statistics; 0 where they cannot be read).
+// Nothing here is on any frame call: the frame paths only read the last
+// snapshot. gdi32's D3DKMTQueryStatistics is looked up at run time and
+// nothing else is needed (no NVML, no vendor library); where it is missing
+// the busy reading simply never becomes valid.
+#include <atomic>
+#include <cstdint>
+#include <memory>
+
+#include <windows.h>
+
+#include "xrfg/diagnostic_overlay_model.hpp"
+#include "xrfg/latency_control.hpp"
+
+namespace xrfg {
+
+struct GpuStatsSnapshot {
+    latency::GpuBusyReading busy;
+    VramStatus vram;
+};
+
+class GpuStatsSampler {
+public:
+    // `frames`: the application frames ended so far, read at each busy
+    // sample; must outlive the sampler.
+    GpuStatsSampler(
+        LUID adapter,
+        bool sample_busy,
+        bool sample_vram,
+        const std::atomic<std::uint64_t>* frames) noexcept;
+    ~GpuStatsSampler();
+    GpuStatsSampler(const GpuStatsSampler&) = delete;
+    GpuStatsSampler& operator=(const GpuStatsSampler&) = delete;
+
+    [[nodiscard]] GpuStatsSnapshot snapshot() const noexcept;
+
+    static constexpr std::int64_t kBusyIntervalMs = 250;
+    // At most twice a second.
+    static constexpr std::int64_t kVramIntervalMs = 500;
+
+private:
+    struct Impl;
+    std::unique_ptr<Impl> impl_;
+};
+
+} // namespace xrfg
