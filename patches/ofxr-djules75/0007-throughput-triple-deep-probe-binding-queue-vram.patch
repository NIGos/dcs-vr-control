@@ -0,0 +1,135 @@
+// DCS VR Control (0007): the GPU statistics sampler against the machine's own
+// GPU - the OS scheduler's running-time counters and DXGI's memory figures,
+// which a fake cannot stand in for. A light load of this process's own (a
+// few clears a frame) must read as busy time per frame, the adapter must read
+// at least as loaded as the process on it, and the memory figures must be
+// there. Skipped, not failed, on a machine without a hardware D3D12 adapter.
+#include "xrfg/gpu_stats_sampler.hpp"
+
+#include <d3d12.h>
+#include <dxgi1_6.h>
+#include <wrl/client.h>
+
+#include <atomic>
+#include <chrono>
+#include <cstdint>
+#include <iostream>
+#include <stdexcept>
+#include <string>
+#include <thread>
+
+using Microsoft::WRL::ComPtr;
+
+namespace {
+
+void require(bool pass, const std::string& message) {
+    if (!pass) {
+        throw std::runtime_error(message);
+    }
+}
+
+} // namespace
+
+int main() {
+    try {
+        ComPtr<IDXGIFactory6> factory;
+        if (FAILED(CreateDXGIFactory1(IID_PPV_ARGS(factory.GetAddressOf())))) {
+            std::cout << "SKIP: no DXGI factory\n";
+            return 0;
+        }
+        ComPtr<IDXGIAdapter1> adapter;
+        if (FAILED(factory->EnumAdapterByGpuPreference(
+                0, DXGI_GPU_PREFERENCE_HIGH_PERFORMANCE,
+                IID_PPV_ARGS(adapter.GetAddressOf())))) {
+            std::cout << "SKIP: no adapter\n";
+            return 0;
+        }
+        DXGI_ADAPTER_DESC1 description{};
+        adapter->GetDesc1(&description);
+        ComPtr<ID3D12Device> device;
+        if ((description.Flags & DXGI_ADAPTER_FLAG_SOFTWARE) != 0 ||
+            FAILED(D3D12CreateDevice(adapter.Get(), D3D_FEATURE_LEVEL_11_0,
+                IID_PPV_ARGS(device.GetAddressOf())))) {
+            std::cout << "SKIP: no hardware D3D12 adapter\n";
+            return 0;
+        }
+        D3D12_COMMAND_QUEUE_DESC queue_description{};
+        queue_description.Type = D3D12_COMMAND_LIST_TYPE_DIRECT;
+        ComPtr<ID3D12CommandQueue> queue;
+        require(SUCCEEDED(device->CreateCommandQueue(&queue_description, IID_PPV_ARGS(queue.GetAddressOf()))), "queue");
+        D3D12_DESCRIPTOR_HEAP_DESC heap_description{};
+        heap_description.Type = D3D12_DESCRIPTOR_HEAP_TYPE_RTV;
+        heap_description.NumDescriptors = 1;
+        ComPtr<ID3D12DescriptorHeap> heap;
+        require(SUCCEEDED(device->CreateDescriptorHeap(&heap_description, IID_PPV_ARGS(heap.GetAddressOf()))), "heap");
+        D3D12_HEAP_PROPERTIES heap_properties{};
+        heap_properties.Type = D3D12_HEAP_TYPE_DEFAULT;
+        D3D12_RESOURCE_DESC texture{};
+        texture.Dimension = D3D12_RESOURCE_DIMENSION_TEXTURE2D;
+        texture.Width = 2048;
+        texture.Height = 2048;
+        texture.DepthOrArraySize = 1;
+        texture.MipLevels = 1;
+        texture.Format = DXGI_FORMAT_R16G16B16A16_FLOAT;
+        texture.SampleDesc.Count = 1;
+        texture.Flags = D3D12_RESOURCE_FLAG_ALLOW_RENDER_TARGET;
+        ComPtr<ID3D12Resource> target;
+        require(SUCCEEDED(device->CreateCommittedResource(&heap_properties, D3D12_HEAP_FLAG_NONE, &texture,
+            D3D12_RESOURCE_STATE_RENDER_TARGET, nullptr, IID_PPV_ARGS(target.GetAddressOf()))), "target");
+        device->CreateRenderTargetView(target.Get(), nullptr, heap->GetCPUDescriptorHandleForHeapStart());
+        ComPtr<ID3D12CommandAllocator> allocator;
+        require(SUCCEEDED(device->CreateCommandAllocator(D3D12_COMMAND_LIST_TYPE_DIRECT,
+            IID_PPV_ARGS(allocator.GetAddressOf()))), "allocator");
+        ComPtr<ID3D12GraphicsCommandList> list;
+        require(SUCCEEDED(device->CreateCommandList(0, D3D12_COMMAND_LIST_TYPE_DIRECT, allocator.Get(), nullptr,
+            IID_PPV_ARGS(list.GetAddressOf()))), "list");
+        for (int clear = 0; clear < 24; ++clear) {
+            const float colour[4]{0.1f * static_cast<float>(clear % 7), 0.2f, 0.3f, 1.0f};
+            list->ClearRenderTargetView(heap->GetCPUDescriptorHandleForHeapStart(), colour, 0, nullptr);
+        }
+        require(SUCCEEDED(list->Close()), "close");
+        ComPtr<ID3D12Fence> fence;
+        require(SUCCEEDED(device->CreateFence(0, D3D12_FENCE_FLAG_NONE, IID_PPV_ARGS(fence.GetAddressOf()))), "fence");
+        HANDLE event = CreateEventW(nullptr, FALSE, FALSE, nullptr);
+        require(event != nullptr, "event");
+
+        std::atomic<std::uint64_t> frames{0};
+        xrfg::GpuStatsSampler sampler(device->GetAdapterLuid(), true, true, &frames);
+        // About 1.5 s of 90 "frames" a second, each a small GPU job.
+        std::uint64_t value = 0;
+        const auto started = std::chrono::steady_clock::now();
+        while (std::chrono::steady_clock::now() - started < std::chrono::milliseconds(1500)) {
+            ID3D12CommandList* lists[] = {list.Get()};
+            queue->ExecuteCommandLists(1, lists);
+            require(SUCCEEDED(queue->Signal(fence.Get(), ++value)), "signal");
+            if (SUCCEEDED(fence->SetEventOnCompletion(value, event))) {
+                WaitForSingleObject(event, 1000);
+            }
+            frames.fetch_add(1);
+            std::this_thread::sleep_for(std::chrono::milliseconds(11));
+        }
+        const auto snapshot = sampler.snapshot();
+        CloseHandle(event);
+        require(snapshot.busy.valid, "no busy reading from the scheduler counters");
+        require(snapshot.busy.per_frame > 0, "no busy time per frame: " + std::to_string(snapshot.busy.per_frame));
+        require(snapshot.busy.process_load > 0.0 && snapshot.busy.process_load <= 1.0,
+            "process load out of range: " + std::to_string(snapshot.busy.process_load));
+        require(snapshot.busy.adapter_load >= snapshot.busy.process_load && snapshot.busy.adapter_load <= 1.5,
+            "adapter load: " + std::to_string(snapshot.busy.adapter_load));
+        require(snapshot.vram.known && snapshot.vram.budget > 0 && snapshot.vram.process_usage > 0,
+            "process VRAM figures");
+        require(snapshot.vram.adapter_total >= (1ULL << 30), "adapter dedicated memory");
+        require(snapshot.vram.adapter_used == 0 || snapshot.vram.adapter_used >= snapshot.vram.process_usage / 2,
+            "adapter-wide resident memory");
+        std::cout << "GPU statistics sampler passed: busy " << snapshot.busy.per_frame / 1000
+                  << " us/frame, process " << snapshot.busy.process_load * 100.0 << "%, adapter "
+                  << snapshot.busy.adapter_load * 100.0 << "%, VRAM app "
+                  << (snapshot.vram.process_usage >> 20) << " MB of budget " << (snapshot.vram.budget >> 20)
+                  << " MB, adapter " << (snapshot.vram.adapter_used >> 20) << " / "
+                  << (snapshot.vram.adapter_total >> 20) << " MB\n";
+        return 0;
+    } catch (const std::exception& error) {
+        std::cerr << error.what() << '\n';
+        return 1;
+    }
+}
