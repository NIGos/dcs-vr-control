diff --git a/tests/layer_triple_deep.cmake b/tests/layer_triple_deep.cmake
new file mode 100644
index 0000000..9339dcb
--- /dev/null
+++ b/tests/layer_triple_deep.cmake
@@ -0,0 +1,158 @@
+# DCS VR Control (0007): runs dcs-triple-deep (CASE steady) or
+# dcs-triple-deep-jitter (CASE jitter) with TRIPLE_DEEP_INI beside the layer
+# DLL - 3X with deep_pipeline=1 on a runtime that paces like a display - and
+# checks from the flight log that
+#   - the session took 3X with the deeper pipeline (700 with a=3 b=1) and set
+#     its depth with a re-presented slot (403, the first with a=1; a second
+#     one, a=2, only if first synthetics kept going out late);
+#   - over the steady stretch (the last STEADY_SECONDS whole seconds before
+#     the teardown's) every second's submissions were fresh: no first
+#     synthetic late, nothing re-presented, and at least MIN_FRESH a real
+#     frame or a synthetic (the fake runs about 90 slots a second);
+#   - the late-frame skip never turned on.
+#
+# A second in which the test application itself stalled - one of its frames
+# took more than STALL_MS from one xrEndFrame to the next, which no pipeline
+# depth absorbs, and which a loaded machine produces on WARP now and then -
+# is left out of the judgement; at least MIN_JUDGED seconds must remain.
+foreach(required_variable IN ITEMS LAYER_DLL CALL_CHAIN TRIPLE_DEEP_INI WORK_DIR CASE)
+    if(NOT DEFINED ${required_variable})
+        message(FATAL_ERROR "${required_variable} was not provided")
+    endif()
+endforeach()
+if(NOT DEFINED STEADY_SECONDS)
+    set(STEADY_SECONDS 8)
+endif()
+if(NOT DEFINED MIN_JUDGED)
+    set(MIN_JUDGED 5)
+endif()
+if(NOT DEFINED MIN_FRESH)
+    set(MIN_FRESH 80)
+endif()
+if(NOT DEFINED STALL_MS)
+    set(STALL_MS 50)
+endif()
+
+file(REMOVE_RECURSE "${WORK_DIR}")
+file(MAKE_DIRECTORY "${WORK_DIR}")
+file(COPY "${LAYER_DLL}" DESTINATION "${WORK_DIR}")
+file(COPY "${TRIPLE_DEEP_INI}" DESTINATION "${WORK_DIR}")
+get_filename_component(triple_deep_ini_name "${TRIPLE_DEEP_INI}" NAME)
+file(RENAME "${WORK_DIR}/${triple_deep_ini_name}" "${WORK_DIR}/ofxr_bridge.ini")
+
+if(CASE STREQUAL "jitter")
+    set(mode dcs-triple-deep-jitter)
+else()
+    set(mode dcs-triple-deep)
+endif()
+get_filename_component(layer_name "${LAYER_DLL}" NAME)
+execute_process(
+    COMMAND "${CALL_CHAIN}"
+        "${WORK_DIR}/${layer_name}"
+        "${WORK_DIR}/fake-runtime.log"
+        ${mode}
+    RESULT_VARIABLE call_chain_result
+    OUTPUT_VARIABLE call_chain_output
+    ERROR_VARIABLE call_chain_error)
+if(NOT call_chain_result EQUAL 0)
+    message(FATAL_ERROR
+        "Call chain '${mode}' failed (${call_chain_result}):\n"
+        "${call_chain_output}\n${call_chain_error}")
+endif()
+message(STATUS "${call_chain_output}")
+
+file(GLOB flight_logs "${WORK_DIR}/ofxr-bridge-flight-*.log")
+list(LENGTH flight_logs flight_log_count)
+if(NOT flight_log_count EQUAL 1)
+    message(FATAL_ERROR "Expected one OFXR flight log, found ${flight_log_count}")
+endif()
+list(GET flight_logs 0 flight_log)
+file(READ "${flight_log}" contents)
+
+string(FIND "${contents}" "op=presenter_transition result=700 dur_us=0 a=3 b=1 " shape)
+if(shape EQUAL -1)
+    message(FATAL_ERROR "The session did not take 3X with the deeper pipeline")
+endif()
+string(REGEX MATCHALL "op=presenter_transition result=403 dur_us=0 a=[0-9]+" depth_slots "${contents}")
+list(LENGTH depth_slots depth_slot_count)
+if(depth_slot_count LESS 1 OR depth_slot_count GREATER 2)
+    message(FATAL_ERROR "Expected one or two re-presented slots setting the depth, found ${depth_slot_count}")
+endif()
+list(GET depth_slots 0 first_depth_slot)
+if(NOT first_depth_slot MATCHES "a=1$")
+    message(FATAL_ERROR "The first depth slot is not the first: ${first_depth_slot}")
+endif()
+string(FIND "${contents}" "op=submission_timing result=3 dur_us=0 a=1 " skip_entered)
+if(NOT skip_entered EQUAL -1)
+    message(FATAL_ERROR "The late-frame skip turned on in 3X with the deeper pipeline")
+endif()
+
+# The application's own stalls: xrEndFrame to xrEndFrame over STALL_MS.
+string(REGEX MATCHALL "ms=[0-9]+\\.[0-9]+ tid=[0-9]+ phase=B op=app_end_frame" end_frames "${contents}")
+set(stalls "")
+set(previous_ms -1)
+foreach(record IN LISTS end_frames)
+    string(REGEX REPLACE "^ms=([0-9]+)\\.[0-9]+ .*" "\\1" at_ms "${record}")
+    if(previous_ms GREATER_EQUAL 0)
+        math(EXPR gap "${at_ms} - ${previous_ms}")
+        if(gap GREATER STALL_MS)
+            list(APPEND stalls "${at_ms}")
+        endif()
+    endif()
+    set(previous_ms "${at_ms}")
+endforeach()
+
+# Per second: a= submissions by kind (real, gen1, gen2, repeat; 16 bits
+# each), b= the late ones packed the same.
+string(REGEX MATCHALL "ms=[0-9]+\\.[0-9]+ tid=[0-9]+ phase=I op=submission_timing result=1 dur_us=0 a=[0-9]+ b=[0-9]+" tallies "${contents}")
+list(LENGTH tallies tally_count)
+math(EXPR needed "${STEADY_SECONDS} + 1")
+if(tally_count LESS needed)
+    message(FATAL_ERROR "Only ${tally_count} per-second submission records")
+endif()
+# The last record is cut short by the teardown.
+math(EXPR last "${tally_count} - 2")
+math(EXPR first "${tally_count} - 1 - ${STEADY_SECONDS}")
+set(summary "")
+set(judged 0)
+foreach(index RANGE ${first} ${last})
+    list(GET tallies ${index} record)
+    string(REGEX REPLACE "^ms=([0-9]+)\\.[0-9]+ .* a=([0-9]+) b=([0-9]+)$" "\\1;\\2;\\3" fields "${record}")
+    list(GET fields 0 at_ms)
+    list(GET fields 1 counts)
+    list(GET fields 2 lates)
+    math(EXPR real "${counts} & 65535")
+    math(EXPR gen1 "(${counts} >> 16) & 65535")
+    math(EXPR gen2 "(${counts} >> 32) & 65535")
+    math(EXPR repeat "(${counts} >> 48) & 65535")
+    math(EXPR late_gen1 "(${lates} >> 16) & 65535")
+    math(EXPR fresh "${real} + ${gen1} + ${gen2}")
+    # A stall in this second (or right at its edges) excuses it.
+    math(EXPR window_from "${at_ms} - 1100")
+    math(EXPR window_to "${at_ms} + 100")
+    set(stalled OFF)
+    foreach(stall IN LISTS stalls)
+        if(stall GREATER window_from AND stall LESS window_to)
+            set(stalled ON)
+        endif()
+    endforeach()
+    if(stalled)
+        string(APPEND summary " [stalled: real ${real} gen1 ${gen1} gen2 ${gen2} repeat ${repeat} late-gen1 ${late_gen1}]")
+        continue()
+    endif()
+    math(EXPR judged "${judged} + 1")
+    string(APPEND summary " [real ${real} gen1 ${gen1} gen2 ${gen2} repeat ${repeat} late-gen1 ${late_gen1}]")
+    if(late_gen1 GREATER 0)
+        message(FATAL_ERROR "A first synthetic went out late in the steady stretch:${summary}")
+    endif()
+    if(repeat GREATER 0)
+        message(FATAL_ERROR "A slot was re-presented in the steady stretch:${summary}")
+    endif()
+    if(fresh LESS MIN_FRESH)
+        message(FATAL_ERROR "Fewer than ${MIN_FRESH} fresh frames in a steady second:${summary}")
+    endif()
+endforeach()
+if(judged LESS MIN_JUDGED)
+    message(FATAL_ERROR "Only ${judged} seconds without a stall of the test application:${summary}")
+endif()
+message(STATUS "3X deep (${CASE}) over ${STEADY_SECONDS} s, ${judged} judged, ${depth_slot_count} depth slot(s):${summary}")
