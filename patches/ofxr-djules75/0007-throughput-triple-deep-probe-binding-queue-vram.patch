@@ -718,6 +736,341 @@ void adaptive_tests() {
 // DCS VR Control (0006): late submissions, the late-frame skip, and the
 // synthesis GPU split.
 
+// ---------------------------------------------------------------------------
+// DCS VR Control (0007): probing 2X from a stable 3X.
+
+struct ProbeRun {
+    std::vector<Nanoseconds> started;
+    std::vector<Nanoseconds> failed;
+    std::vector<Nanoseconds> kept;
+    std::vector<Nanoseconds> skipped;
+    std::vector<Nanoseconds> intervals; // the next interval at each failure
+    Nanoseconds other_switch{-1};
+};
+
+// An application whose work reads `work3` in 3X (inflated by the cap or not)
+// and `work2` in 2X, missing a 2X slot every `late_every_2x` frames (0:
+// never). Probe events are acted on as the layer acts on them.
+ProbeRun drive_probes(AdaptiveFrameGenController& controller, Nanoseconds& now,
+    Nanoseconds seconds, Nanoseconds work3, Nanoseconds work2,
+    std::uint32_t late_every_2x, double projected_load = -1.0) {
+    ProbeRun run{};
+    const Nanoseconds end = now + seconds;
+    std::uint32_t index = 0;
+    while (now < end) {
+        const Nanoseconds frame = kPeriod * controller.mode();
+        now += frame;
+        const Nanoseconds work = controller.mode() == 3 ? work3 : work2;
+        controller.add_frame(now, work, work);
+        if (controller.mode() == 2 && late_every_2x != 0 && ++index % late_every_2x == 0) {
+            controller.add_late(now);
+        }
+        if (projected_load >= 0.0) {
+            controller.set_projected_gpu_load(now, projected_load);
+        }
+        const auto decision = controller.evaluate(now, kPeriod);
+        switch (decision.probe) {
+        case AdaptiveProbeEvent::started: run.started.push_back(now); break;
+        case AdaptiveProbeEvent::failed:
+            run.failed.push_back(now);
+            run.intervals.push_back(decision.probe_interval);
+            break;
+        case AdaptiveProbeEvent::kept:
+            run.kept.push_back(now);
+            controller.probe_kept(now);
+            break;
+        case AdaptiveProbeEvent::skipped:
+            run.skipped.push_back(now);
+            controller.probe_skipped(now);
+            break;
+        default: break;
+        }
+        if (decision.target != 0) {
+            if (decision.reason != AdaptiveReason::probe &&
+                decision.reason != AdaptiveReason::probe_failed &&
+                run.other_switch < 0) {
+                run.other_switch = now;
+            }
+            controller.switched(decision.target, now, decision.reason);
+        }
+    }
+    return run;
