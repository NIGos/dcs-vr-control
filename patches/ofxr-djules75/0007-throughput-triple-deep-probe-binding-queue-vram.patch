+        // frame. Each probe goes back to 3X within a second (past the dwell),
+        // and the interval doubles to its ceiling: 20, 40, 80, 120, 120 s.
+        AdaptiveFrameGenController controller(config);
+        controller.start(3, start);
+        Nanoseconds now = start;
+        const auto run = drive_probes(controller, now, 500 * kSecond, 27 * kMillisecond, 20 * kMillisecond, 3);
+        require(run.started.size() >= 5 && run.failed.size() >= 5, "probes made and failed: " +
+            std::to_string(run.started.size()) + "/" + std::to_string(run.failed.size()));
+        require(run.kept.empty() && run.other_switch < 0, "never kept, never another switch");
+        for (std::size_t i = 0; i < run.failed.size(); ++i) {
+            require(run.failed[i] - run.started[i] < kSecond,
+                "back to 3X quickly: " + std::to_string(run.failed[i] - run.started[i]));
+            require(run.failed[i] - run.started[i] >= 500 * kMillisecond, "not before the probe's settle");
+        }
+        const Nanoseconds expected[] = {40 * kSecond, 80 * kSecond, 120 * kSecond, 120 * kSecond};
+        for (std::size_t i = 0; i < 4; ++i) {
+            require(run.intervals[i] == expected[i], "backoff " + std::to_string(i) + ": " +
+                std::to_string(run.intervals[i]));
+            const Nanoseconds gap = run.started[i + 1] - run.failed[i];
+            require(gap >= expected[i] && gap < expected[i] + 4 * kPeriod,
+                "next probe after the grown interval: " + std::to_string(gap));
+        }
+        require(controller.mode() == 3, "ends in 3X");
+    }
+    {
+        // A failure resets once one holds: back to the base interval.
+        AdaptiveFrameGenController controller(config);
+        controller.start(3, start);
+        Nanoseconds now = start;
+        auto first = drive_probes(controller, now, 25 * kSecond, 27 * kMillisecond, 20 * kMillisecond, 3);
+        require(first.failed.size() == 1 && controller.probe_interval() == 40 * kSecond, "one failure");
+        auto second = drive_probes(controller, now, 50 * kSecond, 27 * kMillisecond, 20 * kMillisecond, 0);
+        require(second.kept.size() == 1 && controller.probe_interval() == 20 * kSecond, "a kept probe resets");
+    }
+    {
+        // Clearly impossible: a median of 32 ms is more than 1.4 x two
+        // periods (31.1 ms). No probe, and no backoff for it either.
+        AdaptiveFrameGenController controller(config);
+        controller.start(3, start);
+        Nanoseconds now = start;
+        const auto run = drive_probes(controller, now, 70 * kSecond, 32 * kMillisecond, 20 * kMillisecond, 0);
+        require(run.started.empty() && run.skipped.size() == 3, "skipped at 20, 40, 60 s: " +
+            std::to_string(run.skipped.size()));
+        require(controller.probe_interval() == 20 * kSecond, "skips do not grow the interval");
+    }
+    {
+        // Or the GPU says so: at 2X it would need 115% of the adapter.
+        AdaptiveFrameGenController controller(config);
+        controller.start(3, start);
+        Nanoseconds now = start;
+        const auto run = drive_probes(controller, now, 30 * kSecond, 27 * kMillisecond, 20 * kMillisecond, 0, 1.15);
+        require(run.started.empty() && run.skipped.size() == 1, "GPU rules it out");
+        Nanoseconds later = now;
+        const auto fits = drive_probes(controller, later, 30 * kSecond, 27 * kMillisecond, 20 * kMillisecond, 0, 0.8);
+        require(fits.started.size() == 1, "and in once it fits");
+    }
+    {
+        // A probe that runs slow in 2X (p90 over two periods) without a
+        // missed slot fails as well.
+        AdaptiveFrameGenController controller(config);
+        controller.start(3, start);
+        Nanoseconds now = start;
+        const auto run = drive_probes(controller, now, 25 * kSecond, 27 * kMillisecond, 25 * kMillisecond, 0);
+        require(run.failed.size() == 1 && run.failed[0] - run.started[0] < 1500 * kMillisecond,
+            "slow fails the probe");
+    }
+    {
+        // The median is reported beside the p90.
+        AdaptiveFrameGenController controller;
+        controller.start(3, start);
+        for (int i = 0; i < 10; ++i) {
+            controller.add_frame(start + 2 * kSecond + i, (10 + i) * kMillisecond, 1 * kMillisecond);
+        }
+        const auto stats = controller.stats(start + 3 * kSecond, 3 * kSecond);
+        require(stats.p50 == 14 * kMillisecond && stats.p90 == 18 * kMillisecond, "p50 and p90: " +
+            std::to_string(stats.p50) + " " + std::to_string(stats.p90));
+    }
+}
