diff --git a/include/xrfg/diagnostic_overlay_model.hpp b/include/xrfg/diagnostic_overlay_model.hpp
new file mode 100644
index 0000000..f3c146a
--- /dev/null
+++ b/include/xrfg/diagnostic_overlay_model.hpp
@@ -0,0 +1,139 @@
+#pragma once
+// DCS VR Control: in-headset diagnostic panel (session-only toggle) drawn by the
+// FPS overlay. Pure model: no Windows or OpenXR calls, unit tested on its own.
+//
+// The panel shows the overall FPS, DLSS 5 (DLSS-NR) state read from the status
+// block the patched Cheeky runtime publishes in Local\DcsVrControlStatus-<pid>,
+// and this layer's own frame-generation state with application vs output rate.
+
+#include "xrfg/fps_overlay_model.hpp"
+#include <atomic>
+#include <cstddef>
+#include <cstdint>
+#include <string>
+#include <string_view>
+#include <vector>
+
+namespace xrfg {
+
+// ABI shared with patches/cheeky/dcs_status_block.hpp (DcsVrStatusV1). The
+// static_asserts below pin the same layout on both sides.
+inline constexpr std::uint32_t kDcsVrStatusMagic = 0x53525644U; // "DVRS"
+inline constexpr std::uint32_t kDcsVrStatusVersion = 1U;
+enum DcsVrStatusFlag : std::uint32_t {
+    dcsvr_nr_enabled = 1U,
+    dcsvr_quad_focus = 2U,
+    dcsvr_nr_hotkey = 4U,
+    dcsvr_graphics_ready = 8U,
+    dcsvr_sr_enabled = 16U,
+    dcsvr_nr_foveated = 32U,
+};
+struct DcsVrStatusV1 {
+    std::uint32_t magic;
+    std::uint32_t version;
+    std::uint32_t structure_size;
+    std::uint32_t sequence;
+    std::uint64_t publish_tick_ms;
+    std::uint32_t publisher_pid;
+    std::uint32_t flags;
+    std::uint32_t nr_state;
+    std::uint32_t nr_evaluations_per_second;
+    std::uint32_t nr_failures_per_second;
+    std::uint32_t focus_views_mapped;
+    std::uint32_t focus_accepts_per_second;
+    std::uint32_t focus_rejects_per_second;
+    std::uint32_t focus_last_reject;
+    std::uint32_t nr_hotkey;
+    float nr_gpu_ms;
+    float present_fps;
+    char reason[56];
+};
+static_assert(sizeof(DcsVrStatusV1) == 128U);
+static_assert(offsetof(DcsVrStatusV1, sequence) == 12U && offsetof(DcsVrStatusV1, publish_tick_ms) == 16U);
+static_assert(offsetof(DcsVrStatusV1, flags) == 28U && offsetof(DcsVrStatusV1, focus_views_mapped) == 44U);
+static_assert(offsetof(DcsVrStatusV1, nr_gpu_ms) == 64U && offsetof(DcsVrStatusV1, reason) == 72U);
+
+// Sequence-counter read of a block another thread may be writing. False when
+// no settled copy was obtained or the block is not a V1 status.
+[[nodiscard]] bool load_dcsvr_status(const DcsVrStatusV1& shared, DcsVrStatusV1& out) noexcept;
+// Older than this and the panel says the status is not updating.
+inline constexpr std::uint64_t kDcsVrStatusStaleMs = 2000U;
+
+// "virtual-key:modifiers" in decimal (Ctrl 1, Alt 2, Shift 4), as DCSVR_NR_HOTKEY.
+struct DiagnosticHotkey { unsigned virtual_key{}, modifiers{}; };
+[[nodiscard]] bool parse_diagnostic_hotkey(std::string_view text, DiagnosticHotkey& hotkey) noexcept;
+[[nodiscard]] std::string diagnostic_hotkey_label(const DiagnosticHotkey& hotkey);
+// The key plus exactly the chosen modifiers, so Alt+Shift+F12 does not fire on
+// Ctrl+Alt+Shift+F12. key_down(virtual_key) reports the physical state.
+template<class KeyDown>
+bool diagnostic_hotkey_down(const DiagnosticHotkey& hotkey, KeyDown key_down) {
+    if (!hotkey.virtual_key || !key_down(hotkey.virtual_key)) return false;
+    constexpr unsigned modifier_keys[3]{0x11U /*VK_CONTROL*/, 0x12U /*VK_MENU*/, 0x10U /*VK_SHIFT*/};
+    for (unsigned bit = 0; bit < 3; ++bit)
+        if (key_down(modifier_keys[bit]) != (((hotkey.modifiers >> bit) & 1U) != 0)) return false;
+    return true;
+}
+
+// Edge-triggered, session-only visibility. Never persisted.
+class DiagnosticToggle {
+public:
+    explicit DiagnosticToggle(bool visible = false) noexcept : visible_(visible) {}
+    // `foreground`: the game owns the foreground window. True when toggled.
+    bool poll(bool down, bool foreground) noexcept {
+        const bool pressed = down && !was_down_;
+        was_down_ = down;
+        if (!pressed || !foreground) return false;
+        visible_ = !visible_;
+        return true;
+    }
+    [[nodiscard]] bool visible() const noexcept { return visible_; }
+private:
+    bool visible_{};
+    bool was_down_{};
+};
+
+// What this layer knows about its own generation, sampled on the application's
+// xrEndFrame thread right after the live controls are applied.
+struct GenerationStatus {
+    bool known{};
+    bool enabled{};            // [ofxr] enabled and the last control revision applied
+    bool nvidia{};             // optical-flow backend in use
+    bool nvidia_unavailable{}; // NVIDIA failed to initialise; FidelityFX took over
+    bool budget_exhausted{};   // runtime refused private swapchains: pass-through
+    std::uint32_t multiplier{2};
+};
+
+enum class DiagnosticColor : std::uint8_t { white, green, amber, grey, red };
+struct DiagnosticLine {
+    std::string text;
+    DiagnosticColor color{DiagnosticColor::white};
+};
+
+struct DiagnosticInputs {
+    float output_fps{};        // what the overlay's counter shows
+    float app_fps{};           // distinct application frames
+    bool generating{};         // a synthetic frame reached the runtime in the last 0.5 s
+    GenerationStatus generation;
+    bool cheeky_present{};     // the status block exists
+    bool cheeky_fresh{};       // and was published within kDcsVrStatusStaleMs
+    DcsVrStatusV1 cheeky{};
+    DiagnosticHotkey hotkey;   // shown as the hide hint when valid
+};
+
+[[nodiscard]] std::string format_dlss_line(const DiagnosticInputs& inputs, DiagnosticColor& color);
+[[nodiscard]] std::string format_generation_line(const DiagnosticInputs& inputs, DiagnosticColor& color);
+[[nodiscard]] std::vector<DiagnosticLine> format_diagnostic_lines(const DiagnosticInputs& inputs);
+
+inline constexpr std::uint32_t kDiagnosticPanelWidth = 768;
+inline constexpr std::uint32_t kDiagnosticPanelHeight = 176;
+// Characters per line at the panel's fixed glyph scale; longer lines are cut.
+[[nodiscard]] std::size_t diagnostic_panel_columns(std::uint32_t width) noexcept;
+// Premultiplied RGBA (or BGRA) with a translucent dark background.
+[[nodiscard]] std::vector<std::uint32_t> rasterize_diagnostic_panel(
+    std::uint32_t width, std::uint32_t height, const std::vector<DiagnosticLine>& lines, bool bgra);
+// Beside the counter's corner (upper_right when the counter is off), towards
+// the centre, inside the same central 90 degrees.
+[[nodiscard]] OverlayPlacement diagnostic_panel_placement(
+    FpsOverlayPosition position, float left, float right, float down, float up) noexcept;
+
+} // namespace xrfg
