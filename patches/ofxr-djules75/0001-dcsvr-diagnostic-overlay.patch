+OverlayPlacement diagnostic_panel_placement(
+    FpsOverlayPosition position, float left, float right, float down, float up) noexcept {
+    if (position == FpsOverlayPosition::off) position = FpsOverlayPosition::upper_right;
+    const auto counter = overlay_placement(position, left, right, down, up);
+    left = std::clamp(left, -1.0f, -0.1f);
+    right = std::clamp(right, 0.1f, 1.0f);
+    down = std::clamp(down, -1.0f, -0.1f);
+    up = std::clamp(up, 0.1f, 1.0f);
+    const float span_x = right - left, span_y = up - down;
+    // Tangent units; the quad sits 2 m away, so poses and sizes are doubled.
+    const float width = span_x * 0.30f;
+    const float height = width * static_cast<float>(kDiagnosticPanelHeight) / static_cast<float>(kDiagnosticPanelWidth);
+    const float cx = counter.x * 0.5f, cy = counter.y * 0.5f;
+    const float cw = counter.width * 0.5f, ch = counter.height * 0.5f;
+    const bool on_left = position == FpsOverlayPosition::upper_left || position == FpsOverlayPosition::lower_left;
+    const bool on_top = position == FpsOverlayPosition::upper_left || position == FpsOverlayPosition::upper_right;
+    const float gap = ch * 0.25f;
+    float x = on_left ? cx - cw * 0.5f + width * 0.5f : cx + cw * 0.5f - width * 0.5f;
+    float y = on_top ? cy - ch * 0.5f - gap - height * 0.5f : cy + ch * 0.5f + gap + height * 0.5f;
+    const float margin_x = span_x * 0.02f, margin_y = span_y * 0.02f;
+    x = std::clamp(x, left + margin_x + width * 0.5f, std::max(left + margin_x + width * 0.5f, right - margin_x - width * 0.5f));
+    y = std::clamp(y, down + margin_y + height * 0.5f, std::max(down + margin_y + height * 0.5f, up - margin_y - height * 0.5f));
+    return {2.0f * x, 2.0f * y, -2.0f, 2.0f * width, 2.0f * height};
+}
