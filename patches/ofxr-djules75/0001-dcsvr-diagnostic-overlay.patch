+++ b/tests/openxr_diagnostic_panel_tests.cpp
@@ -0,0 +1,300 @@
+// DCS VR Control diagnostic panel through the real OpenXrFpsOverlay on WARP:
+// lazy second swapchain, layer budget, live Cheeky status block, GPU pixels.
+#include "xrfg/openxr_fps_overlay.hpp"
+#include <openxr/openxr_platform.h>
+#include <windows.h>
+#include <dxgi1_6.h>
+#include <wrl/client.h>
+#include <array>
+#include <chrono>
+#include <cstring>
+#include <filesystem>
+#include <fstream>
+#include <iostream>
+#include <map>
+#include <stdexcept>
+#include <string>
+#include <thread>
+#include <vector>
+
+using Microsoft::WRL::ComPtr;
+namespace {
+void check(bool pass, const char* message) { if (!pass) throw std::runtime_error(message); }
+template<class T> T handle(std::uintptr_t value) { return reinterpret_cast<T>(value); }
+const auto session = handle<XrSession>(2);
+const auto overlay_space = handle<XrSpace>(4);
+bool d3d11{};
+ComPtr<ID3D12Device> device;
+ComPtr<ID3D12CommandQueue> queue;
+ComPtr<ID3D11Device> device11;
+struct Chain {
+    std::uint32_t width{}, height{}, acquired{}, released{}, acquires{};
+    std::vector<ComPtr<ID3D12Resource>> textures;
+    std::vector<ComPtr<ID3D11Texture2D>> textures11;
+};
+std::map<std::uintptr_t, Chain> chains;
+std::uintptr_t next_chain{5};
+unsigned destroyed{}, max_layers{4}, observed_count{};
+std::vector<const XrCompositionLayerQuad*> observed_quads;
+
+XrResult XRAPI_CALL create_space(XrSession, const XrReferenceSpaceCreateInfo*, XrSpace* output) { *output = overlay_space; return XR_SUCCESS; }
+XrResult XRAPI_CALL destroy_space(XrSpace) { return XR_SUCCESS; }
+XrResult XRAPI_CALL formats(XrSession, std::uint32_t capacity, std::uint32_t* count, std::int64_t* output) {
+    *count = 1; if (capacity) output[0] = DXGI_FORMAT_R8G8B8A8_UNORM; return XR_SUCCESS;
+}
+XrResult XRAPI_CALL properties(XrInstance, XrSystemId, XrSystemProperties* output) {
+    output->graphicsProperties = {4096, 4096, max_layers}; return XR_SUCCESS;
+}
+XrResult XRAPI_CALL create_chain(XrSession, const XrSwapchainCreateInfo* info, XrSwapchain* output) {
+    check(info->arraySize == 1 && info->format == DXGI_FORMAT_R8G8B8A8_UNORM &&
+        (info->usageFlags & XR_SWAPCHAIN_USAGE_TRANSFER_DST_BIT), "overlay swapchain description");
+    auto& chain = chains[next_chain];
+    chain.width = info->width; chain.height = info->height;
+    if (d3d11) {
+        D3D11_TEXTURE2D_DESC desc{};
+        desc.Width = info->width; desc.Height = info->height; desc.MipLevels = desc.ArraySize = desc.SampleDesc.Count = 1;
+        desc.Format = DXGI_FORMAT_R8G8B8A8_UNORM; desc.BindFlags = D3D11_BIND_RENDER_TARGET | D3D11_BIND_SHADER_RESOURCE;
+        chain.textures11.resize(3);
+        for (auto& texture : chain.textures11) check(SUCCEEDED(device11->CreateTexture2D(&desc, nullptr, &texture)), "D3D11 texture");
+    } else {
+        D3D12_HEAP_PROPERTIES heap{}; heap.Type = D3D12_HEAP_TYPE_DEFAULT;
+        D3D12_RESOURCE_DESC desc{};
+        desc.Dimension = D3D12_RESOURCE_DIMENSION_TEXTURE2D;
+        desc.Width = info->width; desc.Height = info->height; desc.DepthOrArraySize = desc.MipLevels = desc.SampleDesc.Count = 1;
+        desc.Format = DXGI_FORMAT_R8G8B8A8_UNORM; desc.Flags = D3D12_RESOURCE_FLAG_ALLOW_RENDER_TARGET;
+        chain.textures.resize(3);
+        for (auto& texture : chain.textures) check(SUCCEEDED(device->CreateCommittedResource(&heap, D3D12_HEAP_FLAG_NONE,
+            &desc, D3D12_RESOURCE_STATE_RENDER_TARGET, nullptr, IID_PPV_ARGS(&texture))), "D3D12 texture");
+    }
+    *output = handle<XrSwapchain>(next_chain++);
+    return XR_SUCCESS;
+}
+XrResult XRAPI_CALL destroy_chain(XrSwapchain) { ++destroyed; return XR_SUCCESS; }
+XrResult XRAPI_CALL enumerate(XrSwapchain swapchain, std::uint32_t capacity, std::uint32_t* count, XrSwapchainImageBaseHeader* output) {
+    auto& chain = chains.at(reinterpret_cast<std::uintptr_t>(swapchain));
+    *count = 3;
+    if (capacity) for (unsigned i = 0; i < 3; ++i) {
+        if (d3d11) reinterpret_cast<XrSwapchainImageD3D11KHR*>(output)[i].texture = chain.textures11[i].Get();
+        else reinterpret_cast<XrSwapchainImageD3D12KHR*>(output)[i].texture = chain.textures[i].Get();
+    }
+    return XR_SUCCESS;
+}
+XrResult XRAPI_CALL acquire(XrSwapchain swapchain, const XrSwapchainImageAcquireInfo*, std::uint32_t* index) {
+    auto& chain = chains.at(reinterpret_cast<std::uintptr_t>(swapchain));
+    chain.acquired = chain.acquires++ % 3; *index = chain.acquired; return XR_SUCCESS;
+}
+XrResult XRAPI_CALL wait(XrSwapchain, const XrSwapchainImageWaitInfo* info) {
+    check(info->timeout == 0, "blocking image wait"); return XR_SUCCESS;
+}
+XrResult XRAPI_CALL release(XrSwapchain swapchain, const XrSwapchainImageReleaseInfo*) {
+    auto& chain = chains.at(reinterpret_cast<std::uintptr_t>(swapchain));
+    chain.released = chain.acquired; return XR_SUCCESS;
+}
+XrResult XRAPI_CALL end(XrSession, const XrFrameEndInfo* info) {
+    observed_count = info->layerCount;
+    check(info->layerCount <= max_layers, "exceeded maxLayerCount");
+    observed_quads.clear();
+    for (std::uint32_t i = 1; i < info->layerCount; ++i) {
+        const auto* quad = reinterpret_cast<const XrCompositionLayerQuad*>(info->layers[i]);
+        if (quad->type != XR_TYPE_COMPOSITION_LAYER_QUAD) continue;
+        check(quad->space == overlay_space && quad->layerFlags == XR_COMPOSITION_LAYER_BLEND_TEXTURE_SOURCE_ALPHA_BIT &&
+            chains.count(reinterpret_cast<std::uintptr_t>(quad->subImage.swapchain)), "invalid overlay quad");
+        observed_quads.push_back(quad);
+    }
+    return XR_SUCCESS;
+}
+XrResult XRAPI_CALL get(XrInstance, const char* name, PFN_xrVoidFunction* output) {
+#define FN(n, f) if (std::strcmp(name, n) == 0) { *output = reinterpret_cast<PFN_xrVoidFunction>(f); return XR_SUCCESS; }
+    FN("xrCreateReferenceSpace", create_space) FN("xrDestroySpace", destroy_space)
+    FN("xrCreateSwapchain", create_chain) FN("xrDestroySwapchain", destroy_chain)
+    FN("xrEnumerateSwapchainFormats", formats) FN("xrEnumerateSwapchainImages", enumerate)
+    FN("xrAcquireSwapchainImage", acquire) FN("xrWaitSwapchainImage", wait) FN("xrReleaseSwapchainImage", release)
+    FN("xrGetSystemProperties", properties)
+#undef FN
+    *output = nullptr; return XR_ERROR_FUNCTION_UNSUPPORTED;
+}
+
+// Test-only readback of the last released image of `chain`.
+std::size_t pixel_count(const Chain& chain, std::uint32_t wanted) {
+    std::size_t result{};
+    if (d3d11) {
+        D3D11_TEXTURE2D_DESC desc{}; chain.textures11[chain.released]->GetDesc(&desc);
+        desc.Usage = D3D11_USAGE_STAGING; desc.BindFlags = 0; desc.CPUAccessFlags = D3D11_CPU_ACCESS_READ;
+        ComPtr<ID3D11Texture2D> staging;
+        check(SUCCEEDED(device11->CreateTexture2D(&desc, nullptr, &staging)), "staging11");
+        ComPtr<ID3D11DeviceContext> context; device11->GetImmediateContext(&context);
+        context->CopyResource(staging.Get(), chain.textures11[chain.released].Get());
+        D3D11_MAPPED_SUBRESOURCE mapped{};
+        check(SUCCEEDED(context->Map(staging.Get(), 0, D3D11_MAP_READ, 0, &mapped)), "map11");
+        for (unsigned y = 0; y < chain.height; ++y) {
+            const auto* row = reinterpret_cast<const std::uint32_t*>(static_cast<const char*>(mapped.pData) + y * mapped.RowPitch);
+            for (unsigned x = 0; x < chain.width; ++x) result += row[x] == wanted;
+        }
+        context->Unmap(staging.Get(), 0);
+        return result;
+    }
+    auto* texture = chain.textures[chain.released].Get();
+    const auto desc = texture->GetDesc();
+    D3D12_PLACED_SUBRESOURCE_FOOTPRINT footprint{}; UINT64 bytes{};
+    device->GetCopyableFootprints(&desc, 0, 1, 0, &footprint, nullptr, nullptr, &bytes);
+    D3D12_HEAP_PROPERTIES heap{}; heap.Type = D3D12_HEAP_TYPE_READBACK;
+    D3D12_RESOURCE_DESC buffer{}; buffer.Dimension = D3D12_RESOURCE_DIMENSION_BUFFER;
+    buffer.Width = bytes; buffer.Height = buffer.DepthOrArraySize = buffer.MipLevels = buffer.SampleDesc.Count = 1;
+    buffer.Layout = D3D12_TEXTURE_LAYOUT_ROW_MAJOR;
+    ComPtr<ID3D12Resource> readback; ComPtr<ID3D12CommandAllocator> allocator;
+    ComPtr<ID3D12GraphicsCommandList> list; ComPtr<ID3D12Fence> fence;
+    check(SUCCEEDED(device->CreateCommittedResource(&heap, D3D12_HEAP_FLAG_NONE, &buffer,
+        D3D12_RESOURCE_STATE_COPY_DEST, nullptr, IID_PPV_ARGS(&readback))), "readback12");
+    check(SUCCEEDED(device->CreateCommandAllocator(D3D12_COMMAND_LIST_TYPE_DIRECT, IID_PPV_ARGS(&allocator))), "allocator12");
+    check(SUCCEEDED(device->CreateCommandList(0, D3D12_COMMAND_LIST_TYPE_DIRECT, allocator.Get(), nullptr, IID_PPV_ARGS(&list))), "list12");
+    D3D12_RESOURCE_BARRIER barrier{}; barrier.Type = D3D12_RESOURCE_BARRIER_TYPE_TRANSITION;
+    barrier.Transition.pResource = texture; barrier.Transition.Subresource = D3D12_RESOURCE_BARRIER_ALL_SUBRESOURCES;
+    barrier.Transition.StateBefore = D3D12_RESOURCE_STATE_RENDER_TARGET; barrier.Transition.StateAfter = D3D12_RESOURCE_STATE_COPY_SOURCE;
+    list->ResourceBarrier(1, &barrier);
+    D3D12_TEXTURE_COPY_LOCATION source{}, dest{};
+    source.pResource = texture; source.Type = D3D12_TEXTURE_COPY_TYPE_SUBRESOURCE_INDEX;
+    dest.pResource = readback.Get(); dest.Type = D3D12_TEXTURE_COPY_TYPE_PLACED_FOOTPRINT; dest.PlacedFootprint = footprint;
+    list->CopyTextureRegion(&dest, 0, 0, 0, &source, nullptr);
+    std::swap(barrier.Transition.StateBefore, barrier.Transition.StateAfter); list->ResourceBarrier(1, &barrier);
+    check(SUCCEEDED(list->Close()), "close12");
+    ID3D12CommandList* lists[]{list.Get()}; queue->ExecuteCommandLists(1, lists);
+    check(SUCCEEDED(device->CreateFence(0, D3D12_FENCE_FLAG_NONE, IID_PPV_ARGS(&fence))), "fence12");
+    check(SUCCEEDED(queue->Signal(fence.Get(), 1)), "signal12");
+    HANDLE event = CreateEventW(nullptr, FALSE, FALSE, nullptr);
+    check(event && SUCCEEDED(fence->SetEventOnCompletion(1, event)), "event12");
+    check(WaitForSingleObject(event, 5000) == WAIT_OBJECT_0, "GPU readback timed out"); CloseHandle(event);
+    void* mapped{}; const D3D12_RANGE range{0, static_cast<SIZE_T>(bytes)};
+    check(SUCCEEDED(readback->Map(0, &range, &mapped)), "map12");
+    for (unsigned y = 0; y < chain.height; ++y) {
+        const auto* row = reinterpret_cast<const std::uint32_t*>(static_cast<const char*>(mapped) + footprint.Offset + y * footprint.Footprint.RowPitch);
+        for (unsigned x = 0; x < chain.width; ++x) result += row[x] == wanted;
+    }
+    const D3D12_RANGE empty{}; readback->Unmap(0, &empty);
+    return result;
+}
+const Chain* panel_chain() {
+    for (const auto& [id, chain] : chains) if (chain.width == xrfg::kDiagnosticPanelWidth) return &chain;
+    return nullptr;
+}
+void write_position(const std::filesystem::path& ini, const char* position) {
+    std::ofstream(ini, std::ios::binary | std::ios::trunc) << "[overlay]\r\nposition=" << position << "\r\n";
+}
+}
+
+int main(int argc, char** argv) {
+    const auto ini = std::filesystem::temp_directory_path() /
+        (L"ofxr-diagnostic-panel-test-" + std::to_wstring(GetCurrentProcessId()) + L".ini");
+    HANDLE mapping{};
+    void* view{};
+    try {
+        d3d11 = argc > 1 && std::string(argv[1]) == "d3d11";
+        if (d3d11) {
+            check(SUCCEEDED(D3D11CreateDevice(nullptr, D3D_DRIVER_TYPE_WARP, nullptr, 0, nullptr, 0,
+                D3D11_SDK_VERSION, &device11, nullptr, nullptr)), "WARP D3D11");
+        } else {
+            ComPtr<IDXGIFactory4> factory; ComPtr<IDXGIAdapter> warp;
+            check(SUCCEEDED(CreateDXGIFactory1(IID_PPV_ARGS(&factory))) &&
+                SUCCEEDED(factory->EnumWarpAdapter(IID_PPV_ARGS(&warp))), "WARP adapter");
+            check(SUCCEEDED(D3D12CreateDevice(warp.Get(), D3D_FEATURE_LEVEL_11_0, IID_PPV_ARGS(&device))), "WARP D3D12");
+            D3D12_COMMAND_QUEUE_DESC desc{};
+            check(SUCCEEDED(device->CreateCommandQueue(&desc, IID_PPV_ARGS(&queue))), "queue12");
+        }
+        XrCompositionLayerProjectionView projection_view{XR_TYPE_COMPOSITION_LAYER_PROJECTION_VIEW};
+        projection_view.fov = {-0.8f, 0.8f, 0.8f, -0.8f};
+        projection_view.subImage.imageRect.extent = {2688, 2784};
+        XrCompositionLayerProjection projection{XR_TYPE_COMPOSITION_LAYER_PROJECTION};
+        projection.viewCount = 1; projection.views = &projection_view;
+        std::array<const XrCompositionLayerBaseHeader*, 4> layers{};
+        layers.fill(reinterpret_cast<const XrCompositionLayerBaseHeader*>(&projection));
+        XrFrameEndInfo info{XR_TYPE_FRAME_END_INFO}; info.layerCount = 1; info.layers = layers.data();
+        write_position(ini, "upper_right");
+
+        // Hidden by default: no second swapchain is ever made.
+        SetEnvironmentVariableW(L"DCSVR_DIAG_OVERLAY", nullptr);
+        SetEnvironmentVariableW(L"DCSVR_DIAG_HOTKEY", L"123:6");
+        {
+            xrfg::OpenXrFpsOverlay overlay(handle<XrInstance>(1), session, 1, get, end,
+                device.Get(), queue.Get(), device11.Get(), ini, nullptr);
+            overlay.application_frame(&info);
+            check(overlay.end_frame(&info, false) == XR_SUCCESS && observed_count == 2, "counter missing");
+            check(chains.size() == 1 && !overlay.diagnostic_visible(), "hidden panel created a swapchain");
+        }
+        chains.clear();
+        destroyed = 0;
+
+        // Cheeky's status block, published the way the runtime does.
+        const auto name = L"Local\\DcsVrControlStatus-" + std::to_wstring(GetCurrentProcessId());
+        mapping = CreateFileMappingW(INVALID_HANDLE_VALUE, nullptr, PAGE_READWRITE, 0, 4096, name.c_str());
+        check(mapping != nullptr, "status mapping");
+        view = MapViewOfFile(mapping, FILE_MAP_WRITE, 0, 0, sizeof(xrfg::DcsVrStatusV1));
+        check(view != nullptr, "status view");
+        auto& status = *static_cast<xrfg::DcsVrStatusV1*>(view);
+        status.magic = xrfg::kDcsVrStatusMagic; status.version = xrfg::kDcsVrStatusVersion;
+        status.structure_size = sizeof(status); status.sequence = 2;
+        status.flags = xrfg::dcsvr_nr_enabled | xrfg::dcsvr_quad_focus | xrfg::dcsvr_graphics_ready;
+        status.nr_evaluations_per_second = 90; status.focus_views_mapped = 2; status.nr_gpu_ms = 1.5f;
+        status.publish_tick_ms = GetTickCount64();
+
+        SetEnvironmentVariableW(L"DCSVR_DIAG_OVERLAY", L"1");
+        {
+            xrfg::OpenXrFpsOverlay overlay(handle<XrInstance>(1), session, 1, get, end,
+                device.Get(), queue.Get(), device11.Get(), ini, nullptr);
+            check(overlay.diagnostic_visible(), "DCSVR_DIAG_OVERLAY=1 did not start visible");
+            overlay.set_generation_status({true, true, true, false, false, 2});
+            overlay.application_frame(&info);
+            check(overlay.end_frame(&info, true) == XR_SUCCESS && observed_count == 3, "counter + panel not submitted");
+            const auto* panel = panel_chain();
+            check(chains.size() == 2 && panel && panel->height == xrfg::kDiagnosticPanelHeight, "panel swapchain");
+            check(observed_quads.size() == 2 && observed_quads[1]->size.width > observed_quads[0]->size.width,
+                "panel must follow the counter");
+            check(observed_quads[1]->pose.position.y < observed_quads[0]->pose.position.y, "panel not below the counter");
+            // Green "DLSS 5: ON (2 focus views, 1.5 ms)" and the translucent background reached the GPU image.
+            check(pixel_count(*panel, 0xff70eb40u) > 200, "panel DLSS line missing on GPU");
+            check(pixel_count(*panel, 0x99000000u) > static_cast<std::size_t>(panel->width) * panel->height / 2,
+                "panel background missing on GPU");
+
+            // NR off in Cheeky and framegen off here: no green line remains.
+            overlay.set_generation_status({true, false, true, false, false, 2});
+            status.sequence = 3; status.flags &= ~xrfg::dcsvr_nr_enabled; status.publish_tick_ms = GetTickCount64(); status.sequence = 4;
+            std::this_thread::sleep_for(std::chrono::milliseconds(260));
+            overlay.application_frame(&info);
+            check(overlay.end_frame(&info, false) == XR_SUCCESS && observed_count == 3, "panel lost on refresh");
+            check(pixel_count(*panel, 0xff70eb40u) == 0 && pixel_count(*panel, 0xffa5a5a5u) > 100,
+                "DLSS 5 OFF not redrawn");
+
+            // One free layer: the counter keeps its place, the panel waits for room.
+            info.layerCount = max_layers - 1;
+            check(overlay.end_frame(&info, false) == XR_SUCCESS && observed_count == max_layers &&
+                observed_quads.size() == 1 && observed_quads[0]->subImage.imageRect.extent.width !=
+                    static_cast<int>(xrfg::kDiagnosticPanelWidth), "layer budget");
+            info.layerCount = max_layers;
+            check(overlay.end_frame(&info, false) == XR_SUCCESS && observed_count == max_layers, "full frame changed");
+            info.layerCount = 1;
+
+            // Counter off: the panel stays.
+            write_position(ini, "off");
+            std::this_thread::sleep_for(std::chrono::milliseconds(260));
+            overlay.application_frame(&info);
+            check(overlay.end_frame(&info, false) == XR_SUCCESS && observed_count == 2 &&
+                observed_quads.size() == 1 && observed_quads[0]->subImage.imageRect.extent.width ==
+                    static_cast<int>(xrfg::kDiagnosticPanelWidth), "panel without counter");
+            check(!overlay.marker_placement(), "counter marker while counter is off");
+
+            // Manual stop removes everything at once.
+            overlay.suspend();
+            check(overlay.end_frame(&info, false) == XR_SUCCESS && observed_count == 1, "suspend kept the panel");
+        }
+        check(destroyed == 2, "panel swapchain leaked");
+        UnmapViewOfFile(view); CloseHandle(mapping);
+        std::filesystem::remove(ini);
+        std::cout << "Diagnostic panel " << (d3d11 ? "D3D11" : "D3D12")
+                  << " lazy swapchain, status block, layer budget, GPU text and lifetime passed\n";
+        return 0;
+    } catch (const std::exception& error) {
+        std::cerr << error.what() << '\n';
+        if (view) UnmapViewOfFile(view);
+        if (mapping) CloseHandle(mapping);
+        std::error_code ignored; std::filesystem::remove(ini, ignored);
+        return 1;
+    }
+}
