new file mode 100644
index 0000000..716b3e5
--- /dev/null
+++ b/tests/diagnostic_overlay_tests.cpp
@@ -0,0 +1,187 @@
+// DCS VR Control diagnostic panel: status ABI, hotkey, toggle, text and placement.
+#include "xrfg/diagnostic_overlay_model.hpp"
+#include <cmath>
+#include <cstring>
+#include <iostream>
+#include <set>
+#include <stdexcept>
+#include <string>
+
+namespace {
+void require(bool pass, const std::string& message) { if (!pass) throw std::runtime_error(message); }
+xrfg::DcsVrStatusV1 status(std::uint32_t flags) {
+    xrfg::DcsVrStatusV1 s{};
+    s.magic = xrfg::kDcsVrStatusMagic; s.version = xrfg::kDcsVrStatusVersion; s.structure_size = sizeof(s);
+    s.flags = flags | xrfg::dcsvr_graphics_ready;
+    return s;
+}
+xrfg::DiagnosticInputs inputs() {
+    xrfg::DiagnosticInputs in;
+    in.output_fps = 89.6f; in.app_fps = 44.8f; in.generating = true;
+    in.generation = {true, true, true, false, false, 2};
+    in.cheeky_present = in.cheeky_fresh = true;
+    in.cheeky = status(xrfg::dcsvr_nr_enabled | xrfg::dcsvr_quad_focus);
+    in.cheeky.nr_evaluations_per_second = 90; in.cheeky.focus_views_mapped = 2; in.cheeky.nr_gpu_ms = 1.84f;
+    return in;
+}
+std::string dlss(const xrfg::DiagnosticInputs& in, xrfg::DiagnosticColor expected) {
+    xrfg::DiagnosticColor color{};
+    auto text = xrfg::format_dlss_line(in, color);
+    require(color == expected, "DLSS line colour for: " + text);
+    return text;
+}
+std::string generation(const xrfg::DiagnosticInputs& in, xrfg::DiagnosticColor expected) {
+    xrfg::DiagnosticColor color{};
+    auto text = xrfg::format_generation_line(in, color);
+    require(color == expected, "Framegen line colour for: " + text);
+    return text;
+}
+}
+
+int main() {
+    try {
+        using namespace xrfg;
+        using C = DiagnosticColor;
+        // ABI pinned identically by patches/cheeky/dcs_status_block.hpp.
+        require(sizeof(DcsVrStatusV1) == 128 && offsetof(DcsVrStatusV1, reason) == 72 &&
+            kDcsVrStatusMagic == 0x53525644U, "status ABI");
+
+        // Sequence-counter read: settled copy only, V1 only.
+        DcsVrStatusV1 shared = status(dcsvr_nr_enabled), read{};
+        shared.sequence = 4; shared.nr_evaluations_per_second = 90;
+        std::memset(shared.reason, 'x', sizeof(shared.reason)); // unterminated on purpose
+        require(load_dcsvr_status(shared, read) && read.nr_evaluations_per_second == 90 &&
+            std::strlen(read.reason) == sizeof(read.reason) - 1, "settled status not read or not terminated");
+        shared.sequence = 5;
+        require(!load_dcsvr_status(shared, read), "torn status accepted");
+        shared.sequence = 6; shared.structure_size = 64;
+        require(!load_dcsvr_status(shared, read), "foreign status size accepted");
+
+        // Hotkey: same format as DCSVR_NR_HOTKEY.
+        DiagnosticHotkey key{};
+        require(parse_diagnostic_hotkey("123:6", key) && key.virtual_key == 123 && key.modifiers == 6, "Alt+Shift+F12 not parsed");
+        for (const char* bad : {"0:0", "", "123", ":6", "123:", "123:8", "255:1", "12a:1", "12345:1", "-1:2"})
+            require(!parse_diagnostic_hotkey(bad, key), std::string("invalid hotkey accepted: ") + bad);
+        require(diagnostic_hotkey_label({0x7B, 6}) == "Alt+Shift+F12", "label F12");
+        require(diagnostic_hotkey_label({0x24, 7}) == "Ctrl+Alt+Shift+Home", "label Home");
+        require(diagnostic_hotkey_label({0x79, 7}) == "Ctrl+Alt+Shift+F10", "label F10");
+        require(diagnostic_hotkey_label({0x2D, 5}) == "Ctrl+Shift+Insert", "label Insert");
+        require(diagnostic_hotkey_label({}).empty(), "label of no key");
+        const auto held = [](std::set<unsigned> keys) { return [keys](unsigned k) { return keys.count(k) != 0; }; };
+        const DiagnosticHotkey alt_shift_f12{0x7B, 6};
+        require(diagnostic_hotkey_down(alt_shift_f12, held({0x7B, 0x12, 0x10})), "Alt+Shift+F12 not detected");
+        require(!diagnostic_hotkey_down(alt_shift_f12, held({0x7B, 0x11, 0x10})), "Ctrl+Shift+F12 (DLSS 5 toggle) fired the panel");
+        require(!diagnostic_hotkey_down(alt_shift_f12, held({0x7B, 0x11, 0x12, 0x10})), "extra Ctrl accepted");
+        require(!diagnostic_hotkey_down(alt_shift_f12, held({0x12, 0x10})), "modifiers alone fired");
+        require(!diagnostic_hotkey_down({}, held({0x7B, 0x12, 0x10})), "disabled hotkey fired");
+
+        // Toggle: edge-triggered, foreground only, starts as configured.
+        DiagnosticToggle toggle;
+        require(!toggle.visible(), "starts hidden by default");
+        require(!toggle.poll(true, false) && !toggle.visible(), "background press toggled");
+        require(!toggle.poll(false, true), "release toggled");
+        require(toggle.poll(true, true) && toggle.visible(), "press did not show");
+        require(!toggle.poll(true, true) && toggle.visible(), "held key repeated");
+        toggle.poll(false, true);
+        require(toggle.poll(true, true) && !toggle.visible(), "second press did not hide");
+        require(DiagnosticToggle(true).visible(), "DCSVR_DIAG_OVERLAY=1 start");
+
+        // DLSS 5 line.
+        auto in = inputs();
+        require(dlss(in, C::green) == "DLSS 5: ON (2 focus views, 1.8 ms)", "quad ON line: " + dlss(in, C::green));
+        in.cheeky.nr_gpu_ms = 0;
+        require(dlss(in, C::green) == "DLSS 5: ON (2 focus views)", "ON without timing");
+        in.cheeky.flags &= ~dcsvr_quad_focus; in.cheeky.nr_gpu_ms = 2.0f;
+        require(dlss(in, C::green) == "DLSS 5: ON (90/s, 2.0 ms)", "stereo ON line: " + dlss(in, C::green));
+        in.cheeky.nr_failures_per_second = 3;
+        require(dlss(in, C::amber) == "DLSS 5: ON (90/s, 2.0 ms, 3 failed/s)", "failures");
+        in = inputs(); in.cheeky.nr_evaluations_per_second = 0;
+        { const char text[] = "focus views not identified"; std::memcpy(in.cheeky.reason, text, sizeof(text)); }
+        require(dlss(in, C::amber) == "DLSS 5: ON but not applied (focus views not identified)", "not applied");
+        in.cheeky.reason[0] = 0;
+        require(dlss(in, C::amber) == "DLSS 5: ON but not applied (no NR evaluations)", "not applied fallback");
+        in = inputs(); in.cheeky.flags &= ~dcsvr_nr_enabled;
+        require(dlss(in, C::grey) == "DLSS 5: OFF", "OFF");
+        in.cheeky_fresh = false;
+        require(dlss(in, C::amber) == "DLSS 5: status not updating", "stale");
+        in.cheeky_present = false;
+        require(dlss(in, C::grey) == "DLSS 5: not loaded", "absent");
+
+        // Framegen line.
+        in = inputs();
+        require(generation(in, C::green) == "Framegen: OFXR NVIDIA 2x", "NVIDIA 2x");
+        in.generation.multiplier = 3;
+        require(generation(in, C::green) == "Framegen: OFXR NVIDIA 3x", "3x");
+        in.generation.multiplier = 2; in.generation.nvidia = false;
+        require(generation(in, C::green) == "Framegen: OFXR FidelityFX 2x", "FidelityFX");
+        in.generation.nvidia_unavailable = true;
+        require(generation(in, C::amber) == "Framegen: OFXR FidelityFX 2x (NVIDIA failed)", "NVIDIA fallback");
+        in = inputs(); in.generating = false;
+        require(generation(in, C::amber) == "Framegen: OFXR NVIDIA 2x - not generating", "not generating");
+        in.generation.budget_exhausted = true;
+        require(generation(in, C::red) == "Framegen: fallback (swapchain limit)", "budget");
+        in.generation.enabled = false;
+        require(generation(in, C::grey) == "Framegen: off", "off");
+        in.generation.known = false;
+        require(generation(in, C::grey) == "Framegen: unknown", "unknown");
+
+        // Whole panel.
+        in = inputs(); in.hotkey = {0x7B, 6};
+        const auto lines = format_diagnostic_lines(in);
+        require(lines.size() == 5 && lines[0].text == "FPS 90" && lines[3].text == "App 45 fps -> out 90 fps" &&
+            lines[4].text == "Alt+Shift+F12: hide" && lines[4].color == C::grey, "panel lines");
+        in.hotkey = {};
+        require(format_diagnostic_lines(in).size() == 4, "hint without a key");
+        // Every line the formatter can produce fits the panel.
+        in = inputs(); in.cheeky.nr_evaluations_per_second = 0;
+        std::memset(in.cheeky.reason, 'w', sizeof(in.cheeky.reason) - 1); in.cheeky.reason[sizeof(in.cheeky.reason) - 1] = 0;
+        require(diagnostic_panel_columns(kDiagnosticPanelWidth) >= 50, "panel too narrow");
+        require(diagnostic_panel_columns(kDiagnosticPanelWidth) >=
+            std::string("Framegen: OFXR FidelityFX 3x (NVIDIA failed) - not generating").size(), "framegen line cut");
+
+        // Raster: translucent background, coloured ink, BGRA swap, long lines cut, bad sizes refused.
+        std::vector<DiagnosticLine> sample{{"DLSS 5: ON", C::green}, {"Framegen: off", C::grey},
+            {std::string(200, '#'), C::amber}};
+        const auto rgba = rasterize_diagnostic_panel(kDiagnosticPanelWidth, kDiagnosticPanelHeight, sample, false);
+        const auto bgra = rasterize_diagnostic_panel(kDiagnosticPanelWidth, kDiagnosticPanelHeight, sample, true);
+        require(rgba.size() == static_cast<std::size_t>(kDiagnosticPanelWidth) * kDiagnosticPanelHeight, "raster size");
+        std::size_t background = 0, green = 0, green_bgra = 0, grey = 0, amber = 0, amber_right_edge = 0;
+        for (std::size_t i = 0; i < rgba.size(); ++i) {
+            background += rgba[i] == 0x99000000u;
+            green += rgba[i] == 0xff70eb40u;
+            green_bgra += bgra[i] == 0xff40eb70u;
+            grey += rgba[i] == 0xffa5a5a5u;
+            amber += rgba[i] == 0xff3cbeffu;
+            if (rgba[i] == 0xff3cbeffu && i % kDiagnosticPanelWidth >= kDiagnosticPanelWidth - 4) ++amber_right_edge;
+        }
+        require(background > rgba.size() / 2, "background not translucent black");
+        require(green > 100 && green == green_bgra && grey > 100 && amber > 100, "line colours missing");
+        require(amber_right_edge == 0, "long line drawn past the margin");
+        require(rasterize_diagnostic_panel(8, 8, sample, false).empty(), "tiny raster accepted");
+
+        // Placement: inside the central 90 degrees, beside the counter, never on top of it.
+        for (auto position : {FpsOverlayPosition::upper_right, FpsOverlayPosition::upper_left,
+                 FpsOverlayPosition::lower_left, FpsOverlayPosition::lower_right, FpsOverlayPosition::off}) {
+            for (const float wide : {1.0f, 0.6f}) {
+                const auto panel = diagnostic_panel_placement(position, -wide, wide, -0.9f, 0.8f);
+                const auto counter = overlay_placement(
+                    position == FpsOverlayPosition::off ? FpsOverlayPosition::upper_right : position, -wide, wide, -0.9f, 0.8f);
+                const float l = panel.x - panel.width / 2, r = panel.x + panel.width / 2;
+                const float b = panel.y - panel.height / 2, t = panel.y + panel.height / 2;
+                require(panel.z == -2.0f && panel.width > counter.width && panel.height > 0, "panel size");
+                require(l >= -2.0f * wide && r <= 2.0f * wide && b >= -1.8f && t <= 1.6f, "panel outside the view");
+                const bool top = position == FpsOverlayPosition::upper_left || position == FpsOverlayPosition::upper_right ||
+                    position == FpsOverlayPosition::off;
+                require(top ? t <= counter.y - counter.height / 2 : b >= counter.y + counter.height / 2, "panel overlaps the counter");
+                require((panel.y > 0) == top, "panel left the counter's half");
+                require(std::abs(panel.width / panel.height -
+                    static_cast<float>(kDiagnosticPanelWidth) / kDiagnosticPanelHeight) < 0.01f, "panel aspect");
+            }
+        }
+        std::cout << "Diagnostic overlay status, hotkey, toggle, text, raster and placement passed\n";
+        return 0;
+    } catch (const std::exception& error) {
+        std::cerr << error.what() << '\n';
+        return 1;
+    }
+}
