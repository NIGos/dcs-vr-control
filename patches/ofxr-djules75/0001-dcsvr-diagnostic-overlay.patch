diff --git a/src/core/diagnostic_overlay_model.cpp b/src/core/diagnostic_overlay_model.cpp
new file mode 100644
index 0000000..31caa8f
--- /dev/null
+++ b/src/core/diagnostic_overlay_model.cpp
@@ -0,0 +1,271 @@
+#include "xrfg/diagnostic_overlay_model.hpp"
+
+#include <algorithm>
+#include <array>
+#include <cmath>
+#include <cstdio>
+#include <cstring>
+
+namespace xrfg {
+
+bool load_dcsvr_status(const DcsVrStatusV1& shared, DcsVrStatusV1& out) noexcept {
+    std::atomic_ref<std::uint32_t> sequence(const_cast<std::uint32_t&>(shared.sequence));
+    for (int attempt = 0; attempt < 8; ++attempt) {
+        const auto before = sequence.load(std::memory_order_acquire);
+        if (before & 1U) continue;
+        std::memcpy(&out, &shared, sizeof(out));
+        std::atomic_thread_fence(std::memory_order_acquire);
+        if (sequence.load(std::memory_order_relaxed) != before) continue;
+        out.reason[sizeof(out.reason) - 1] = 0;
+        return out.magic == kDcsVrStatusMagic && out.version == kDcsVrStatusVersion &&
+            out.structure_size == sizeof(out);
+    }
+    return false;
+}
+
+bool parse_diagnostic_hotkey(std::string_view text, DiagnosticHotkey& hotkey) noexcept {
+    const auto colon = text.find(':');
+    if (colon == std::string_view::npos || colon == 0 || colon + 1 >= text.size()) return false;
+    unsigned values[2]{};
+    const std::string_view parts[2]{text.substr(0, colon), text.substr(colon + 1)};
+    for (int i = 0; i < 2; ++i) {
+        if (parts[i].size() > 4) return false;
+        for (const char c : parts[i]) {
+            if (c < '0' || c > '9') return false;
+            values[i] = values[i] * 10U + static_cast<unsigned>(c - '0');
+        }
+    }
+    if (values[0] == 0 || values[0] > 0xFE || values[1] > 7) return false;
+    hotkey = {values[0], values[1]};
+    return true;
+}
+
+std::string diagnostic_hotkey_label(const DiagnosticHotkey& hotkey) {
+    if (!hotkey.virtual_key) return {};
+    std::string label;
+    if (hotkey.modifiers & 1U) label += "Ctrl+";
+    if (hotkey.modifiers & 2U) label += "Alt+";
+    if (hotkey.modifiers & 4U) label += "Shift+";
+    const unsigned key = hotkey.virtual_key;
+    char name[16]{};
+    if (key >= 0x70U && key <= 0x87U) std::snprintf(name, sizeof(name), "F%u", key - 0x6FU);
+    else if ((key >= '0' && key <= '9') || (key >= 'A' && key <= 'Z')) name[0] = static_cast<char>(key);
+    else switch (key) {
+        case 0x21U: std::snprintf(name, sizeof(name), "PageUp"); break;
+        case 0x22U: std::snprintf(name, sizeof(name), "PageDown"); break;
+        case 0x23U: std::snprintf(name, sizeof(name), "End"); break;
+        case 0x24U: std::snprintf(name, sizeof(name), "Home"); break;
+        case 0x2DU: std::snprintf(name, sizeof(name), "Insert"); break;
+        case 0x2EU: std::snprintf(name, sizeof(name), "Delete"); break;
+        default: std::snprintf(name, sizeof(name), "Key%u", key); break;
+    }
+    return label + name;
+}
+
+namespace {
+std::string fixed(float value, int decimals) {
+    char text[32]{};
+    std::snprintf(text, sizeof(text), "%.*f", decimals,
+        std::isfinite(value) ? static_cast<double>(std::clamp(value, 0.0f, 9999.0f)) : 0.0);
+    return text;
+}
+std::string whole(float value) { return fixed(value, 0); }
+}
+
+std::string format_dlss_line(const DiagnosticInputs& in, DiagnosticColor& color) {
+    const auto& s = in.cheeky;
+    if (!in.cheeky_present) { color = DiagnosticColor::grey; return "DLSS 5: not loaded"; }
+    if (!in.cheeky_fresh) { color = DiagnosticColor::amber; return "DLSS 5: status not updating"; }
+    if (!(s.flags & dcsvr_nr_enabled)) { color = DiagnosticColor::grey; return "DLSS 5: OFF"; }
+    if (s.nr_evaluations_per_second == 0U) {
+        color = DiagnosticColor::amber;
+        const std::string reason = s.reason[0] ? std::string(s.reason, strnlen(s.reason, sizeof(s.reason)))
+                                               : std::string("no NR evaluations");
+        return "DLSS 5: ON but not applied (" + reason + ")";
+    }
+    color = DiagnosticColor::green;
+    std::string detail;
+    if (s.flags & dcsvr_quad_focus) {
+        detail = std::to_string(s.focus_views_mapped) +
+            (s.focus_views_mapped == 1U ? " focus view" : " focus views");
+    } else {
+        detail = std::to_string(s.nr_evaluations_per_second) + "/s";
+    }
+    if (s.nr_gpu_ms > 0.0f && std::isfinite(s.nr_gpu_ms)) detail += ", " + fixed(s.nr_gpu_ms, 1) + " ms";
+    if (s.nr_failures_per_second) {
+        detail += ", " + std::to_string(s.nr_failures_per_second) + " failed/s";
+        color = DiagnosticColor::amber;
+    }
+    return "DLSS 5: ON (" + detail + ")";
+}
+
+std::string format_generation_line(const DiagnosticInputs& in, DiagnosticColor& color) {
+    const auto& g = in.generation;
+    if (!g.known) { color = DiagnosticColor::grey; return "Framegen: unknown"; }
+    if (!g.enabled) { color = DiagnosticColor::grey; return "Framegen: off"; }
+    if (g.budget_exhausted) { color = DiagnosticColor::red; return "Framegen: fallback (swapchain limit)"; }
+    std::string text = std::string("Framegen: OFXR ") + (g.nvidia && !g.nvidia_unavailable ? "NVIDIA" : "FidelityFX") +
+        " " + std::to_string(std::clamp<std::uint32_t>(g.multiplier, 2U, 3U)) + "x";
+    if (g.nvidia_unavailable) text += " (NVIDIA failed)";
+    if (!in.generating) {
+        color = DiagnosticColor::amber;
+        return text + " - not generating";
+    }
+    color = g.nvidia_unavailable ? DiagnosticColor::amber : DiagnosticColor::green;
+    return text;
+}
+
+std::vector<DiagnosticLine> format_diagnostic_lines(const DiagnosticInputs& in) {
+    std::vector<DiagnosticLine> lines;
+    lines.push_back({"FPS " + whole(in.output_fps), DiagnosticColor::white});
+    DiagnosticLine dlss, generation;
+    dlss.text = format_dlss_line(in, dlss.color);
+    generation.text = format_generation_line(in, generation.color);
+    lines.push_back(std::move(dlss));
+    lines.push_back(std::move(generation));
+    lines.push_back({"App " + whole(in.app_fps) + " fps -> out " + whole(in.output_fps) + " fps",
+        DiagnosticColor::white});
+    if (in.hotkey.virtual_key)
+        lines.push_back({diagnostic_hotkey_label(in.hotkey) + ": hide", DiagnosticColor::grey});
+    return lines;
+}
+
+namespace {
+// Original 5x7 bitmap glyphs, rows top to bottom, bit 4 leftmost. Lowercase
+// letters are drawn as capitals; anything unknown as '?'.
+std::array<unsigned char, 7> text_glyph(char c) noexcept {
+    if (c >= 'a' && c <= 'z') c = static_cast<char>(c - 'a' + 'A');
+    switch (c) {
+    case ' ': return {0,0,0,0,0,0,0};
+    case '0': return {14,17,19,21,25,17,14};
+    case '1': return {4,12,4,4,4,4,14};
+    case '2': return {14,17,1,2,4,8,31};
+    case '3': return {30,1,1,14,1,1,30};
+    case '4': return {2,6,10,18,31,2,2};
+    case '5': return {31,16,16,30,1,1,30};
+    case '6': return {14,16,16,30,17,17,14};
+    case '7': return {31,1,2,4,8,8,8};
+    case '8': return {14,17,17,14,17,17,14};
+    case '9': return {14,17,17,15,1,1,14};
+    case 'A': return {14,17,17,31,17,17,17};
+    case 'B': return {30,17,17,30,17,17,30};
+    case 'C': return {14,17,16,16,16,17,14};
+    case 'D': return {28,18,17,17,17,18,28};
+    case 'E': return {31,16,16,30,16,16,31};
+    case 'F': return {31,16,16,30,16,16,16};
+    case 'G': return {14,17,16,23,17,17,15};
+    case 'H': return {17,17,17,31,17,17,17};
+    case 'I': return {14,4,4,4,4,4,14};
+    case 'J': return {7,2,2,2,2,18,12};
+    case 'K': return {17,18,20,24,20,18,17};
+    case 'L': return {16,16,16,16,16,16,31};
+    case 'M': return {17,27,21,21,17,17,17};
+    case 'N': return {17,17,25,21,19,17,17};
+    case 'O': return {14,17,17,17,17,17,14};
+    case 'P': return {30,17,17,30,16,16,16};
+    case 'Q': return {14,17,17,17,21,18,13};
+    case 'R': return {30,17,17,30,20,18,17};
+    case 'S': return {15,16,16,14,1,1,30};
+    case 'T': return {31,4,4,4,4,4,4};
+    case 'U': return {17,17,17,17,17,17,14};
+    case 'V': return {17,17,17,17,17,10,4};
+    case 'W': return {17,17,17,21,21,21,10};
+    case 'X': return {17,17,10,4,10,17,17};
+    case 'Y': return {17,17,17,10,4,4,4};
+    case 'Z': return {31,1,2,4,8,16,31};
+    case '.': return {0,0,0,0,0,12,12};
+    case ',': return {0,0,0,0,12,4,8};
+    case ':': return {0,12,12,0,12,12,0};
+    case ';': return {0,12,12,0,12,4,8};
+    case '(': return {2,4,8,8,8,4,2};
+    case ')': return {8,4,2,2,2,4,8};
+    case '[': return {14,8,8,8,8,8,14};
+    case ']': return {14,2,2,2,2,2,14};
+    case '-': return {0,0,0,31,0,0,0};
+    case '+': return {0,4,4,31,4,4,0};
+    case '=': return {0,0,31,0,31,0,0};
+    case '/': return {0,1,2,4,8,16,0};
+    case '>': return {8,4,2,1,2,4,8};
+    case '<': return {2,4,8,16,8,4,2};
+    case '_': return {0,0,0,0,0,0,31};
+    case '\'': return {12,4,8,0,0,0,0};
+    case '!': return {4,4,4,4,4,0,4};
+    case '%': return {24,25,2,4,8,19,3};
+    case '#': return {10,10,31,10,31,10,10};
+    case '*': return {0,4,21,14,21,4,0};
+    default: return {14,17,1,2,4,0,4}; // '?'
+    }
+}
+constexpr unsigned kGlyphScale = 2;
+constexpr unsigned kCellWidth = 6 * kGlyphScale;
+constexpr unsigned kLineHeight = 10 * kGlyphScale;
+constexpr unsigned kMargin = 4 * kGlyphScale;
+}
+
+std::size_t diagnostic_panel_columns(std::uint32_t width) noexcept {
+    return width > 2 * kMargin ? (width - 2 * kMargin + kGlyphScale) / kCellWidth : 0;
+}
+
+std::vector<std::uint32_t> rasterize_diagnostic_panel(
+    std::uint32_t width, std::uint32_t height, const std::vector<DiagnosticLine>& lines, bool bgra) {
+    if (width < 64 || width > 4096 || height < 32 || height > 2048) return {};
+    const auto color = [bgra](unsigned r, unsigned g, unsigned b) {
+        return 0xff000000u | (bgra ? b | (g << 8) | (r << 16) : r | (g << 8) | (b << 16));
+    };
+    // Premultiplied: black at 60% coverage keeps the text readable over the cockpit.
+    std::vector<std::uint32_t> pixels(static_cast<std::size_t>(width) * height, 0x99000000u);
+    const auto columns = diagnostic_panel_columns(width);
+    unsigned top = kMargin;
+    for (const auto& line : lines) {
+        if (top + 7 * kGlyphScale > height - kMargin / 2) break;
+        std::uint32_t ink{};
+        switch (line.color) {
+        case DiagnosticColor::green: ink = color(64, 235, 112); break;
+        case DiagnosticColor::amber: ink = color(255, 190, 60); break;
+        case DiagnosticColor::grey: ink = color(165, 165, 165); break;
+        case DiagnosticColor::red: ink = color(255, 80, 80); break;
+        default: ink = color(240, 240, 240); break;
+        }
+        unsigned x = kMargin;
+        for (std::size_t i = 0; i < line.text.size() && i < columns; ++i, x += kCellWidth) {
+            const auto rows = text_glyph(line.text[i]);
+            for (unsigned y = 0; y < 7; ++y) for (unsigned column = 0; column < 5; ++column) {
+                if ((rows[y] & (1u << (4 - column))) == 0) continue;
+                for (unsigned sy = 0; sy < kGlyphScale; ++sy) for (unsigned sx = 0; sx < kGlyphScale; ++sx) {
+                    const unsigned px = x + column * kGlyphScale + sx;
+                    const unsigned py = top + y * kGlyphScale + sy;
+                    if (px < width && py < height) pixels[static_cast<std::size_t>(py) * width + px] = ink;
+                }
+            }
+        }
+        top += kLineHeight;
+    }
+    return pixels;
+}
