+# DCS VR Control (0009): runs dcs-triple-scenes (CASE triple) or
+# dcs-adaptive-scenes (CASE adaptive) with SCENES_INI beside the layer DLL
+# and checks from the flight log that
+#   - the late-frame skip, off by default, never turned on;
+#   - the 1.5 s stall was recorded as a scene change (scene_change, result
+#     >= 1000 ms) in the shape the session was in;
+#   - triple: the heavy phase took a third depth slot (403 with a=3, which
+#     0008's two-slot cap could not) before the scene change, which gave
+#     its slots back (b) and was followed by a first slot again (403 a=1);
+#     and the last STEADY_SECONDS whole seconds before the teardown's had no
+#     first synthetic late, nothing re-presented and at least MIN_FRESH fresh
+#     submissions (the fake runs about 100 slots a second);
+#   - adaptive: no adaptive switch within the scene's two-second settle,
+#     whatever the new scene's first frames did.
+foreach(required_variable IN ITEMS LAYER_DLL CALL_CHAIN SCENES_INI WORK_DIR CASE)
+    if(NOT DEFINED ${required_variable})
+        message(FATAL_ERROR "${required_variable} was not provided")
+    endif()
+endforeach()
+if(NOT DEFINED STEADY_SECONDS)
+    set(STEADY_SECONDS 3)
+endif()
+if(NOT DEFINED MIN_FRESH)
+    set(MIN_FRESH 80)
+endif()
+
+file(REMOVE_RECURSE "${WORK_DIR}")
+file(MAKE_DIRECTORY "${WORK_DIR}")
+file(COPY "${LAYER_DLL}" DESTINATION "${WORK_DIR}")
+file(COPY "${SCENES_INI}" DESTINATION "${WORK_DIR}")
+get_filename_component(scenes_ini_name "${SCENES_INI}" NAME)
+file(RENAME "${WORK_DIR}/${scenes_ini_name}" "${WORK_DIR}/ofxr_bridge.ini")
+
+if(CASE STREQUAL "adaptive")
+    set(mode dcs-adaptive-scenes)
+else()
+    set(mode dcs-triple-scenes)
+endif()
+get_filename_component(layer_name "${LAYER_DLL}" NAME)
+execute_process(
+    COMMAND "${CALL_CHAIN}"
+        "${WORK_DIR}/${layer_name}"
+        "${WORK_DIR}/fake-runtime.log"
+        ${mode}
+    RESULT_VARIABLE call_chain_result
+    OUTPUT_VARIABLE call_chain_output
+    ERROR_VARIABLE call_chain_error)
+if(NOT call_chain_result EQUAL 0)
+    message(FATAL_ERROR
+        "Call chain '${mode}' failed (${call_chain_result}):\n"
+        "${call_chain_output}\n${call_chain_error}")
+endif()
+message(STATUS "${call_chain_output}")
+
+file(GLOB flight_logs "${WORK_DIR}/ofxr-bridge-flight-*.log")
+list(LENGTH flight_logs flight_log_count)
+if(NOT flight_log_count EQUAL 1)
+    message(FATAL_ERROR "Expected one OFXR flight log, found ${flight_log_count}")
+endif()
+list(GET flight_logs 0 flight_log)
+file(READ "${flight_log}" contents)
+
+string(FIND "${contents}" "op=submission_timing result=3 dur_us=0 a=1 " skip_entered)
+if(NOT skip_entered EQUAL -1)
+    message(FATAL_ERROR "The late-frame skip turned on with late_frame_skip at its default")
+endif()
+
+# The stall itself, from the application's own xrEndFrame calls: where the
+# behaviour is judged, whether or not the layer saw a scene change.
+string(REGEX MATCHALL "ms=[0-9]+\\.[0-9]+ tid=[0-9]+ phase=B op=app_end_frame" end_frames "${contents}")
+set(stall_ms -1)
+set(previous_ms -1)
+foreach(record IN LISTS end_frames)
+    string(REGEX REPLACE "^ms=([0-9]+)\\.[0-9]+ .*" "\\1" at_ms "${record}")
+    if(previous_ms GREATER_EQUAL 0)
+        math(EXPR gap "${at_ms} - ${previous_ms}")
+        if(gap GREATER 1000)
+            set(stall_ms ${at_ms})
+        endif()
+    endif()
+    set(previous_ms "${at_ms}")
+endforeach()
+if(stall_ms LESS 0)
+    message(FATAL_ERROR "The scenario's stall is not in the log")
+endif()
+
+if(CASE STREQUAL "adaptive")
+    # 0008 switched to 3X on the new scene's first frames (p90 ~126 ms).
+    math(EXPR settle_end "${stall_ms} + 2000")
+    string(REGEX MATCHALL "ms=[0-9]+\\.[0-9]+ tid=[0-9]+ phase=I op=adaptive_switch result=[0-9]+ dur_us=0 a=[0-9]+ b=[0-9]+ c=[0-9]+" switches "${contents}")
+    foreach(record IN LISTS switches)
+        string(REGEX REPLACE "^ms=([0-9]+)\\..*" "\\1" at_ms "${record}")
+        if(at_ms GREATER_EQUAL stall_ms AND at_ms LESS settle_end)
+            message(FATAL_ERROR "An adaptive switch within the scene's settle: ${record} (stall ended at ${stall_ms} ms)")
+        endif()
+    endforeach()
+else()
+    # 0008 judged first synthetics by their hand-over only and kept one or
+    # two slots: the heavy phase's, handed over on time but written after,
+    # never asked for more.
+    string(REGEX MATCH "ms=[0-9]+\\.[0-9]+ tid=[0-9]+ phase=I op=presenter_transition result=403 dur_us=0 a=3 " third_slot "${contents}")
+    if(third_slot STREQUAL "")
+        message(FATAL_ERROR "The heavy phase never took a third depth slot")
+    endif()
+    string(REGEX REPLACE "^ms=([0-9]+)\\..*" "\\1" third_slot_ms "${third_slot}")
+    if(third_slot_ms GREATER stall_ms)
+        message(FATAL_ERROR "The third depth slot came after the heavy phase: ${third_slot}")
+    endif()
+endif()
+
+string(REGEX MATCHALL "ms=[0-9]+\\.[0-9]+ tid=[0-9]+ phase=I op=scene_change result=[0-9]+ dur_us=0 a=[0-9]+ b=[0-9]+ c=[0-9]+" scenes "${contents}")
+list(LENGTH scenes scene_count)
+if(NOT scene_count EQUAL 1)
+    message(FATAL_ERROR "Expected one scene change, found ${scene_count}: ${scenes}")
+endif()
+list(GET scenes 0 scene)
+string(REGEX REPLACE "^ms=([0-9]+)\\.[0-9]+ .* result=([0-9]+) dur_us=0 a=([0-9]+) b=([0-9]+) c=([0-9]+)$" "\\1;\\2;\\3;\\4;\\5" fields "${scene}")
+list(GET fields 0 scene_ms)
+list(GET fields 1 gap_ms)
+list(GET fields 2 scene_multiplier)
+list(GET fields 3 scene_flags)
+if(gap_ms LESS 1000 OR gap_ms GREATER 3000)
+    message(FATAL_ERROR "The scene change's gap is not the stall's: ${scene}")
+endif()
+string(FIND "${contents}" "${scene}" scene_at)
+
+if(CASE STREQUAL "adaptive")
+    if(NOT scene_multiplier EQUAL 2)
+        message(FATAL_ERROR "The scene change was not in 2X: ${scene}")
+    endif()
+    message(STATUS "Scene change (adaptive): ${scene}; no switch in its settle")
+    return()
+endif()
+
+if(NOT scene_multiplier EQUAL 3)
+    message(FATAL_ERROR "The scene change was not in 3X: ${scene}")
+endif()
+math(EXPR slots_given_back "${scene_flags} & 65535")
+if(slots_given_back LESS 3)
+    message(FATAL_ERROR "The heavy phase's depth (${slots_given_back} slots) was not given back at the scene change: ${scene}")
+endif()
+string(SUBSTRING "${contents}" ${scene_at} -1 after_scene)
+string(FIND "${after_scene}" "op=presenter_transition result=403 dur_us=0 a=1 " rearmed_at)
+if(rearmed_at EQUAL -1)
+    message(FATAL_ERROR "No depth slot was taken again after the scene change")
+endif()
+
+# The last STEADY_SECONDS whole seconds before the teardown's.
+string(REGEX MATCHALL "ms=[0-9]+\\.[0-9]+ tid=[0-9]+ phase=I op=submission_timing result=1 dur_us=0 a=[0-9]+ b=[0-9]+" tallies "${contents}")
+list(LENGTH tallies tally_count)
+math(EXPR needed "${STEADY_SECONDS} + 1")
+if(tally_count LESS needed)
+    message(FATAL_ERROR "Only ${tally_count} per-second submission records")
+endif()
+math(EXPR last "${tally_count} - 2")
+math(EXPR first "${tally_count} - 1 - ${STEADY_SECONDS}")
+set(summary "")
+foreach(index RANGE ${first} ${last})
+    list(GET tallies ${index} record)
+    string(REGEX REPLACE "^ms=([0-9]+)\\.[0-9]+ .* a=([0-9]+) b=([0-9]+)$" "\\1;\\2;\\3" tally_fields "${record}")
+    list(GET tally_fields 1 counts)
+    list(GET tally_fields 2 lates)
+    math(EXPR real "${counts} & 65535")
+    math(EXPR gen1 "(${counts} >> 16) & 65535")
+    math(EXPR gen2 "(${counts} >> 32) & 65535")
+    math(EXPR repeat "(${counts} >> 48) & 65535")
+    math(EXPR late_gen1 "(${lates} >> 16) & 65535")
+    math(EXPR fresh "${real} + ${gen1} + ${gen2}")
+    string(APPEND summary " [real ${real} gen1 ${gen1} gen2 ${gen2} repeat ${repeat} late-gen1 ${late_gen1}]")
+    if(late_gen1 GREATER 0 OR repeat GREATER 0 OR fresh LESS MIN_FRESH)
+        message(FATAL_ERROR "Not every slot fresh in the light scene after the load:${summary}")
+    endif()
+endforeach()
+message(STATUS "Scene change (3X deep): ${scene}; third slot in the heavy phase, depth re-armed after the load;${summary}")
