+        }
+        require(window.late == 30 && tuner.delay <= room - kSlackMargin && tuner.hold > 0,
+            "one failed window backs off by the whole shortfall: " + std::to_string(tuner.delay));
+        require(tuner.last_failure == before, "failure remembered");
+        for (std::uint32_t i = 0; i < 40 * TripleReleaseTuner::kWindowFrames; ++i) {
