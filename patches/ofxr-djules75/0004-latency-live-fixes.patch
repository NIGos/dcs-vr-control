@@ -0,0 +1,303 @@
+#include "xrfg/frame_gpu_timer.hpp"
+
+#include <algorithm>
+
+namespace xrfg {
+
+namespace {
+
+[[nodiscard]] std::int64_t ticks_to_nanoseconds(
+    std::uint64_t begin, std::uint64_t end, std::uint64_t frequency) noexcept {
+    if (frequency == 0 || end < begin) {
+        return -1;
+    }
+    const long double ns = static_cast<long double>(end - begin) *
+        1'000'000'000.0L / static_cast<long double>(frequency);
+    return static_cast<std::int64_t>(ns + 0.5L);
+}
+
+} // namespace
+
+// ---------------------------------------------------------------------------
+// D3D11
+
+HRESULT D3D11FrameGpuTimer::initialize(
+    ID3D11Device* device, ID3D11DeviceContext* context) noexcept {
+    if (device == nullptr || context == nullptr) {
+        return E_INVALIDARG;
+    }
+    for (Slot& slot : slots_) {
+        D3D11_QUERY_DESC description{};
+        description.Query = D3D11_QUERY_TIMESTAMP_DISJOINT;
+        HRESULT result = device->CreateQuery(&description, slot.disjoint.GetAddressOf());
+        if (FAILED(result)) {
+            return result;
+        }
+        description.Query = D3D11_QUERY_TIMESTAMP;
+        result = device->CreateQuery(&description, slot.begin.GetAddressOf());
+        if (FAILED(result)) {
+            return result;
+        }
+        result = device->CreateQuery(&description, slot.end.GetAddressOf());
+        if (FAILED(result)) {
+            return result;
+        }
+    }
+    context_ = context;
+    return S_OK;
+}
+
+void D3D11FrameGpuTimer::open() noexcept {
+    if (!context_) {
+        return;
+    }
+    if (open_) {
+        // Released again without the frame coming back: keep the bracket
+        // going rather than leave a disjoint query begun.
+        return;
+    }
+    if (pending_ >= kSlots) {
+        return; // The GPU is far behind; this frame goes unmeasured.
+    }
+    Slot& slot = slots_[next_];
+    context_->Begin(slot.disjoint.Get());
+    context_->End(slot.begin.Get());
+    // Submitted now, so the mark is taken when the GPU gets here rather
+    // than when the application's next commands happen to flush it.
+    context_->Flush();
+    open_ = true;
+}
+
+void D3D11FrameGpuTimer::close() noexcept {
+    if (!context_ || !open_) {
+        return;
+    }
+    Slot& slot = slots_[next_];
+    context_->End(slot.end.Get());
+    context_->End(slot.disjoint.Get());
+    // Same: an unflushed end mark would be taken late, when the next frame's
+    // commands flush, and the bracket would grow by the gap.
+    context_->Flush();
+    slot.pending = true;
+    next_ = (next_ + 1) % kSlots;
+    ++pending_;
+    open_ = false;
+}
+
+std::size_t D3D11FrameGpuTimer::collect(std::span<std::int64_t> output) noexcept {
+    std::size_t written = 0;
+    while (context_ && pending_ > 0 && written < output.size()) {
+        Slot& slot = slots_[oldest_];
+        D3D11_QUERY_DATA_TIMESTAMP_DISJOINT disjoint{};
+        UINT64 begin = 0;
+        UINT64 end = 0;
+        constexpr UINT kNoFlush = D3D11_ASYNC_GETDATA_DONOTFLUSH;
+        if (context_->GetData(slot.disjoint.Get(), &disjoint, sizeof(disjoint), kNoFlush) != S_OK ||
+            context_->GetData(slot.begin.Get(), &begin, sizeof(begin), kNoFlush) != S_OK ||
+            context_->GetData(slot.end.Get(), &end, sizeof(end), kNoFlush) != S_OK) {
+            break; // Not there yet; the queries complete in order.
+        }
+        slot.pending = false;
+        oldest_ = (oldest_ + 1) % kSlots;
+        --pending_;
+        if (!disjoint.Disjoint) {
+            const std::int64_t ns = ticks_to_nanoseconds(begin, end, disjoint.Frequency);
+            if (ns >= 0) {
+                output[written++] = ns;
+            }
+        }
+    }
+    return written;
+}
+
+// ---------------------------------------------------------------------------
+// D3D12
+
+HRESULT D3D12QueueFrameGpuTimer::initialize(
+    ID3D12Device* device, ID3D12CommandQueue* queue) noexcept {
+    if (device == nullptr || queue == nullptr) {
+        return E_INVALIDARG;
+    }
+    const D3D12_COMMAND_LIST_TYPE type = queue->GetDesc().Type;
+    if (type != D3D12_COMMAND_LIST_TYPE_DIRECT &&
+        type != D3D12_COMMAND_LIST_TYPE_COMPUTE) {
+        return E_NOTIMPL;
+    }
+    UINT64 frequency = 0;
+    HRESULT result = queue->GetTimestampFrequency(&frequency);
+    if (FAILED(result) || frequency == 0) {
+        return FAILED(result) ? result : E_FAIL;
+    }
+    D3D12_QUERY_HEAP_DESC heap_description{};
+    heap_description.Type = D3D12_QUERY_HEAP_TYPE_TIMESTAMP;
+    heap_description.Count = static_cast<UINT>(2 * kSlots);
+    heap_description.NodeMask = queue->GetDesc().NodeMask;
+    result = device->CreateQueryHeap(&heap_description, IID_PPV_ARGS(heap_.GetAddressOf()));
+    if (FAILED(result)) {
+        return result;
+    }
+    D3D12_HEAP_PROPERTIES heap{};
+    heap.Type = D3D12_HEAP_TYPE_READBACK;
+    D3D12_RESOURCE_DESC buffer{};
+    buffer.Dimension = D3D12_RESOURCE_DIMENSION_BUFFER;
+    buffer.Width = 2 * kSlots * sizeof(std::uint64_t);
+    buffer.Height = 1;
+    buffer.DepthOrArraySize = 1;
+    buffer.MipLevels = 1;
+    buffer.SampleDesc.Count = 1;
+    buffer.Layout = D3D12_TEXTURE_LAYOUT_ROW_MAJOR;
+    result = device->CreateCommittedResource(
+        &heap, D3D12_HEAP_FLAG_NONE, &buffer, D3D12_RESOURCE_STATE_COPY_DEST,
+        nullptr, IID_PPV_ARGS(readback_.GetAddressOf()));
+    if (FAILED(result)) {
+        return result;
+    }
+    result = device->CreateFence(0, D3D12_FENCE_FLAG_NONE, IID_PPV_ARGS(fence_.GetAddressOf()));
+    if (FAILED(result)) {
+        return result;
+    }
+    for (Slot& slot : slots_) {
+        result = device->CreateCommandAllocator(type, IID_PPV_ARGS(slot.allocator.GetAddressOf()));
+        if (FAILED(result)) {
+            return result;
+        }
+        Microsoft::WRL::ComPtr<ID3D12GraphicsCommandList>* lists[] = {
+            &slot.open_list, &slot.close_list};
+        for (auto* list : lists) {
+            result = device->CreateCommandList(
+                0, type, slot.allocator.Get(), nullptr,
+                IID_PPV_ARGS(list->ReleaseAndGetAddressOf()));
+            if (FAILED(result)) {
+                return result;
+            }
+            result = (*list)->Close();
+            if (FAILED(result)) {
+                return result;
+            }
+        }
+    }
+    LARGE_INTEGER qpc_frequency{};
+    if (QueryPerformanceFrequency(&qpc_frequency) && qpc_frequency.QuadPart > 0) {
+        qpc_frequency_ = static_cast<std::uint64_t>(qpc_frequency.QuadPart);
+    }
+    frequency_ = frequency;
+    queue_ = queue;
+    return S_OK;
+}
+
+std::int64_t D3D12QueueFrameGpuTimer::to_qpc(std::uint64_t ticks) const noexcept {
+    const long double delta =
+        (static_cast<long double>(ticks) - static_cast<long double>(calibration_ticks_)) *
+        static_cast<long double>(qpc_frequency_) / static_cast<long double>(frequency_);
+    return static_cast<std::int64_t>(static_cast<long double>(calibration_qpc_) + delta);
+}
+
+bool D3D12QueueFrameGpuTimer::record(Slot& slot, std::size_t index) noexcept {
+    const UINT first = static_cast<UINT>(2 * index);
+    if (FAILED(slot.allocator->Reset()) ||
+        FAILED(slot.open_list->Reset(slot.allocator.Get(), nullptr))) {
+        return false;
+    }
+    slot.open_list->EndQuery(heap_.Get(), D3D12_QUERY_TYPE_TIMESTAMP, first);
+    if (FAILED(slot.open_list->Close()) ||
+        FAILED(slot.close_list->Reset(slot.allocator.Get(), nullptr))) {
+        return false;
+    }
+    slot.close_list->EndQuery(heap_.Get(), D3D12_QUERY_TYPE_TIMESTAMP, first + 1);
+    slot.close_list->ResolveQueryData(
+        heap_.Get(), D3D12_QUERY_TYPE_TIMESTAMP, first, 2, readback_.Get(),
+        static_cast<UINT64>(first) * sizeof(std::uint64_t));
+    return SUCCEEDED(slot.close_list->Close());
+}
+
+void D3D12QueueFrameGpuTimer::open() noexcept {
+    if (!queue_ || open_ || pending_ >= kSlots) {
+        return;
+    }
+    Slot& slot = slots_[next_];
+    if (!record(slot, next_)) {
+        return;
+    }
+    LARGE_INTEGER now{};
+    QueryPerformanceCounter(&now);
+    slot.open_submitted_qpc = now.QuadPart;
+    ID3D12CommandList* lists[] = {slot.open_list.Get()};
+    queue_->ExecuteCommandLists(1, lists);
+    open_ = true;
+}
+
+void D3D12QueueFrameGpuTimer::close() noexcept {
+    if (!queue_ || !open_) {
+        return;
+    }
+    Slot& slot = slots_[next_];
+    ID3D12CommandList* lists[] = {slot.close_list.Get()};
+    queue_->ExecuteCommandLists(1, lists);
+    slot.fence_value = next_fence_value_++;
+    if (FAILED(queue_->Signal(fence_.Get(), slot.fence_value))) {
+        // Nothing will tell this slot completed; the timer stops.
+        queue_.Reset();
+        return;
+    }
+    slot.pending = true;
+    next_ = (next_ + 1) % kSlots;
+    ++pending_;
+    open_ = false;
+}
+
+std::size_t D3D12QueueFrameGpuTimer::collect(std::span<std::int64_t> output) noexcept {
+    std::size_t written = 0;
+    if (!fence_) {
+        return 0;
+    }
+    const std::uint64_t completed = fence_->GetCompletedValue();
+    // Taken again on every collection, so the gap test below never runs on a
+    // calibration that has drifted.
+    const bool calibrated = qpc_frequency_ != 0 && pending_ > 0 &&
+        SUCCEEDED(queue_ ? queue_->GetClockCalibration(&calibration_ticks_, &calibration_qpc_)
+                         : E_FAIL);
+    while (pending_ > 0 && written < output.size()) {
+        Slot& slot = slots_[oldest_];
+        if (completed == UINT64_MAX || completed < slot.fence_value) {
+            break;
+        }
+        const SIZE_T first = 2 * oldest_ * sizeof(std::uint64_t);
+        const D3D12_RANGE range{first, first + 2 * sizeof(std::uint64_t)};
+        void* mapped = nullptr;
+        std::uint64_t ticks[2]{};
+        if (SUCCEEDED(readback_->Map(0, &range, &mapped)) && mapped != nullptr) {
