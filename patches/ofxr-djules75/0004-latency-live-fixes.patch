+                static_cast<const std::uint8_t*>(mapped) + first);
+            ticks[0] = values[0];
+            ticks[1] = values[1];
+            const D3D12_RANGE none{0, 0};
+            readback_->Unmap(0, &none);
+            std::int64_t ns = ticks_to_nanoseconds(ticks[0], ticks[1], frequency_);
+            if (calibrated) {
+                // Work that ran between the previous close and this open.
+                const std::int64_t open_qpc = to_qpc(ticks[0]);
+                const std::int64_t busy_from =
+                    std::max(previous_close_qpc_, slot.open_submitted_qpc);
+                if (ns >= 0 && previous_close_qpc_ >= 0 && open_qpc > busy_from) {
+                    const long double gap =
+                        static_cast<long double>(open_qpc - busy_from) * 1'000'000'000.0L /
+                        static_cast<long double>(qpc_frequency_);
+                    // A gap of more than a second is a stall, not a frame.
+                    if (gap < 1'000'000'000.0L) {
+                        ns += static_cast<std::int64_t>(gap);
+                    }
+                }
+                previous_close_qpc_ = to_qpc(ticks[1]);
+            }
+            if (ns >= 0) {
+                output[written++] = ns;
+            }
+        }
+        slot.pending = false;
+        oldest_ = (oldest_ + 1) % kSlots;
+        --pending_;
+    }
+    return written;
+}
