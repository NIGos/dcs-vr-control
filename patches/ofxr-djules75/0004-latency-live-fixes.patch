+// DCS VR Control (0004): the dcs-throughput scenarios' wait thread, made
+// once. Run behaves as a std::thread running the job (join() included): on
+// this thread when one is given, on a thread of its own otherwise.
+class PersistentWaitThread {
+public:
+    PersistentWaitThread() : thread_([this] { loop(); }) {}
+    PersistentWaitThread(const PersistentWaitThread&) = delete;
+    PersistentWaitThread& operator=(const PersistentWaitThread&) = delete;
+    ~PersistentWaitThread() {
+        {
+            std::scoped_lock lock(mutex_);
+            stop_ = true;
+        }
+        condition_.notify_all();
+        thread_.join();
+    }
+    class Run {
+    public:
+        Run(PersistentWaitThread* owner, std::function<void()> job) : owner_(owner) {
+            if (owner_ != nullptr) {
+                std::scoped_lock lock(owner_->mutex_);
+                owner_->job_ = std::move(job);
+                owner_->done_ = false;
+                owner_->condition_.notify_all();
+            } else {
+                thread_ = std::thread(std::move(job));
+            }
+        }
+        Run(const Run&) = delete;
+        Run& operator=(const Run&) = delete;
+        void join() {
+            if (owner_ != nullptr) {
+                std::unique_lock lock(owner_->mutex_);
+                owner_->condition_.wait(lock, [&] { return owner_->done_; });
+            } else if (thread_.joinable()) {
+                thread_.join();
+            }
