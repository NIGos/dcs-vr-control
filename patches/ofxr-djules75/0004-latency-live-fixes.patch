+// frame; one older than a quarter second is not used, and the frame then has
+// no GPU figure. Under adaptive control only; otherwise the bookkeeping is
+// just reset.
+void sample_application_throughput(
+    SessionState& state, std::chrono::steady_clock::time_point entered) noexcept {
