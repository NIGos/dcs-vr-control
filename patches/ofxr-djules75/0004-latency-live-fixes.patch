+#         the test's and the layer's overhead, ~10-13 and ~11-15 ms judged),
+#         under 85% of two periods: 3X -> 2X on headroom.
+#   gpu   CPU 5 ms and GPU 23 ms per frame, GPU over two periods: no downshift.
+# Both: the CPU and GPU components are logged (adaptive_throughput), the GPU
+# one from the D3D12 queue bracket; synthesis GPU time carries its total in
+# dur_us; and 3X off SteamVR steers its release delay on slack (802).
+foreach(required_variable IN ITEMS LAYER_DLL CALL_CHAIN ADAPTIVE_INI WORK_DIR CASE)
+    if(NOT DEFINED ${required_variable})
+        message(FATAL_ERROR "${required_variable} was not provided")
+    endif()
+endforeach()
