+TripleReleaseWindow observe_triple_slack(
+    TripleReleaseTuner& tuner, Nanoseconds period, Nanoseconds slack) noexcept {
+    TripleReleaseWindow report{};
+    if (period <= 0) {
+        return report;
+    }
+    if (slack < 0) {
+        ++tuner.window_late;
+    }
+    tuner.slack[tuner.window_frames % TripleReleaseTuner::kWindowFrames] = slack;
+    if (++tuner.window_frames < TripleReleaseTuner::kWindowFrames) {
+        return report;
+    }
+    const std::uint32_t late_count = tuner.window_late;
+    const std::uint32_t unwritten = tuner.window_unwritten;
+    tuner.window_frames = 0;
+    tuner.window_late = 0;
+    tuner.window_unwritten = 0;
+    auto sorted = tuner.slack;
+    std::sort(sorted.begin(), sorted.end());
+    const Nanoseconds low = sorted[1];
+    auto& delay = tuner.delay;
+    auto& ceiling = tuner.ceiling;
+    if (ceiling < 0) {
+        ceiling = period * 2;
+    }
+    if (low < 0) {
+        // Two or more frames written after their hand-over. Only a delay
+        // can be given back; with none, the lateness is the title's own.
+        if (delay > 0) {
+            tuner.last_failure = delay;
+            const Nanoseconds back = std::max(
+                TripleReleaseTuner::kBackoffStep, kSlackMargin - low);
+            ceiling = std::max<Nanoseconds>(0, delay - back);
+            delay = ceiling;
+            tuner.hold = tuner.backoff;
+            tuner.backoff = std::min(
+                tuner.backoff * 2, TripleReleaseTuner::kMaxHoldWindows);
+        }
+    } else if (low >= kSlackMargin) {
+        if (tuner.last_failure >= 0 && delay >= tuner.last_failure) {
+            tuner.backoff = TripleReleaseTuner::kBaseHoldWindows;
+            tuner.last_failure = -1;
+        }
+        // Delaying the release moves the frame's readiness later by at most
+        // the same amount, so what is left above the margin is what can be
+        // taken - a step at a time.
+        const Nanoseconds raise = std::min(kMaxSlackRaise, low - kSlackMargin);
+        if (raise > 0) {
+            if (delay < ceiling) {
+                delay = std::min(ceiling, delay + raise);
+            } else if (tuner.hold > 0) {
+                --tuner.hold;
+            } else {
+                ceiling = std::min(period * 2, ceiling + raise);
+                delay = ceiling;
+            }
+        }
+    }
+    report.closed = true;
+    report.delay = delay;
+    report.ceiling = ceiling;
+    report.late = late_count;
+    report.unwritten = unwritten;
+    report.hold = tuner.hold;
+    report.slack_valid = true;
+    report.slack_low = low;
+    report.slack_median = sorted[sorted.size() / 2];
+    return report;
+}
