diff --git a/include/xrfg/frame_gpu_timer.hpp b/include/xrfg/frame_gpu_timer.hpp
new file mode 100644
index 0000000..e3a2495
--- /dev/null
+++ b/include/xrfg/frame_gpu_timer.hpp
@@ -0,0 +1,130 @@
+#pragma once
+// DCS VR Control (0004): the GPU time of an application frame, for adaptive
+// 2X/3X (xrfg::latency::AdaptiveFrameGenController).
+//
+// A bracket of two GPU timestamps on the application's own submission path:
+// opened when the layer releases the application to render a frame (its
+// xrEndFrame returns) and closed when that frame comes back (its next
+// xrEndFrame is entered), both from the thread that calls xrEndFrame. Read
+// back asynchronously - a bracket is collected once the GPU has passed it,
+// never waited for - so a frame's figure arrives a frame or two after it.
+//
+// What a bracket covers, and what it does not:
+//  - It is elapsed GPU time between the two marks on that one context or
+//    queue, not exclusive busy time. Whatever else the GPU runs in the same
+//    stretch - the layer's synthesis, the runtime's compositor, another
+//    process - counts, and so does the GPU waiting for the application's
+//    CPU to submit. An application that submits as it records (the D3D11
+//    immediate context flushes as its command buffer fills; DCS World) keeps
+//    that wait small; one that submits its whole frame at the end has a
+//    bracket nearer CPU plus GPU. Every error is an overestimate: adaptive
+//    control can only be kept in 3X by it, never moved to 2X.
+//  - GPU work the application submits on other contexts or queues is
+//    covered only where the bracketed one waits for it. D3D11 has one
+//    immediate context per device, and every deferred context's work is
+//    executed through it, so a D3D11 application's whole frame is inside.
+//    A D3D12 application's work on other queues (async compute, copy) is
+//    inside only as far as the queue it hands the layer waits on it.
+//  - Work queued between a close and the next open - another thread
+//    submitting while the layer holds the render thread inside xrEndFrame -
+//    would fall between brackets. D3D11 cannot do that (the immediate context
+//    is single-threaded). On D3D12 the open mark's own GPU time is compared,
+//    through the queue's clock calibration, with the moment it was submitted
+//    and with the previous close: if the queue was still busy when it was
+//    submitted, the stretch from the later of the two to the open mark is
+//    added to the bracket.
+//  - The marks are queued on the context from the xrEndFrame thread. A
+//    D3D11 immediate context is single-threaded; the bridge already uses it
+//    from that thread at every swapchain release, and this adds two queries
+//    and a flush per frame there.
+#include <cstddef>
+#include <cstdint>
+#include <span>
+
+#include <d3d11.h>
+#include <d3d12.h>
+#include <wrl/client.h>
+
+namespace xrfg {
+
+class FrameGpuTimer {
+public:
+    virtual ~FrameGpuTimer() = default;
+    // The application was released to render a frame.
+    virtual void open() noexcept = 0;
+    // Its frame came back. A close with no open bracket does nothing.
+    virtual void close() noexcept = 0;
+    // Brackets the GPU has completed since the last call, oldest first, in
+    // nanoseconds; never waits. Returns how many were written. A bracket the
+    // GPU reported unreliable (D3D11 disjoint) is dropped.
+    virtual std::size_t collect(std::span<std::int64_t> output) noexcept = 0;
+};
+
+// On a D3D11 application's immediate context: TIMESTAMP_DISJOINT around two
+// TIMESTAMP queries.
+class D3D11FrameGpuTimer final : public FrameGpuTimer {
+public:
+    [[nodiscard]] HRESULT initialize(
+        ID3D11Device* device, ID3D11DeviceContext* context) noexcept;
+    void open() noexcept override;
+    void close() noexcept override;
+    std::size_t collect(std::span<std::int64_t> output) noexcept override;
+
+private:
+    static constexpr std::size_t kSlots = 8;
+    struct Slot {
+        Microsoft::WRL::ComPtr<ID3D11Query> disjoint;
+        Microsoft::WRL::ComPtr<ID3D11Query> begin;
+        Microsoft::WRL::ComPtr<ID3D11Query> end;
+        bool pending{};
+    };
+    Microsoft::WRL::ComPtr<ID3D11DeviceContext> context_;
+    Slot slots_[kSlots];
+    std::size_t next_{};     // the slot the next open uses
+    std::size_t oldest_{};   // the oldest pending slot
+    std::size_t pending_{};
+    bool open_{};
+};
+
+// On a D3D12 application's queue: two one-query command lists per bracket,
+// resolved into a readback buffer, completion told by a fence of its own.
+class D3D12QueueFrameGpuTimer final : public FrameGpuTimer {
+public:
+    [[nodiscard]] HRESULT initialize(
+        ID3D12Device* device, ID3D12CommandQueue* queue) noexcept;
+    void open() noexcept override;
+    void close() noexcept override;
+    std::size_t collect(std::span<std::int64_t> output) noexcept override;
+
+private:
+    static constexpr std::size_t kSlots = 8;
+    struct Slot {
+        Microsoft::WRL::ComPtr<ID3D12CommandAllocator> allocator;
+        Microsoft::WRL::ComPtr<ID3D12GraphicsCommandList> open_list;
+        Microsoft::WRL::ComPtr<ID3D12GraphicsCommandList> close_list;
+        std::uint64_t fence_value{};
+        // QueryPerformanceCounter when the open mark was submitted.
+        std::int64_t open_submitted_qpc{};
+        bool pending{};
+    };
+    [[nodiscard]] std::int64_t to_qpc(std::uint64_t ticks) const noexcept;
+    [[nodiscard]] bool record(Slot& slot, std::size_t index) noexcept;
+    Microsoft::WRL::ComPtr<ID3D12CommandQueue> queue_;
+    Microsoft::WRL::ComPtr<ID3D12QueryHeap> heap_;
+    Microsoft::WRL::ComPtr<ID3D12Resource> readback_;
+    Microsoft::WRL::ComPtr<ID3D12Fence> fence_;
+    std::uint64_t frequency_{};
+    std::uint64_t qpc_frequency_{};
+    std::uint64_t calibration_ticks_{};
+    std::uint64_t calibration_qpc_{};
+    // The previous bracket's close mark, on the QPC timeline; -1 for none.
+    std::int64_t previous_close_qpc_{-1};
+    std::uint64_t next_fence_value_{1};
+    Slot slots_[kSlots];
+    std::size_t next_{};
+    std::size_t oldest_{};
+    std::size_t pending_{};
+    bool open_{};
+};
+
+} // namespace xrfg
