+        message(FATAL_ERROR "A correction after the depth slot keyed as 3X's own shape: ${record}")
+    endif()
+endforeach()
+string(REGEX MATCH "op=display_time_correction result=0 dur_us=0 a=[0-9]+ b=[0-9]+ c=3" depth_rebase "${contents}")
+if(NOT depth_rebase)
+    message(FATAL_ERROR "The display time correction was not rebased when the depth slot was taken")
+endif()
 if(depth_slot_count LESS 1 OR depth_slot_count GREATER 2)
     message(FATAL_ERROR "Expected one or two re-presented slots setting the depth, found ${depth_slot_count}")
 endif()
