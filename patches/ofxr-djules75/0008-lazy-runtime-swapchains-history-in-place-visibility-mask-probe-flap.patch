+# DCS VR Control (0008): display time corrections, c= the mode they are
+# keyed by (2: 3X's own shape, 3/4: the deeper pipeline with one/two slots).
+string(REGEX MATCHALL "op=display_time_correction result=-?[0-9]+ dur_us=0 a=[0-9]+ b=[0-9]+ c=[0-9]+" corrections "${contents}")
+if(CASE STREQUAL "quad")
+    # Every real frame carries a quad layer: nothing can be re-presented, so
+    # no slot is ever taken, and nothing may be keyed as the deeper pipeline.
+    if(NOT depth_slot_count EQUAL 0)
+        message(FATAL_ERROR "A depth slot was taken with nothing safe to re-present: ${depth_slots}")
+    endif()
+    foreach(record IN LISTS corrections)
+        if(NOT record MATCHES "c=2$")
+            message(FATAL_ERROR "A display time correction keyed as the deeper pipeline without a slot: ${record}")
