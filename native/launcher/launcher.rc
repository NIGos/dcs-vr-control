// Icon and version information of the DCS Control launcher.
#include <winver.h>
#include "version.h"  // written by scripts/build-launcher.ps1 from Directory.Build.props

1 ICON "..\\..\\src\\DcsVr.App\\Assets\\app-icon.ico"

VS_VERSION_INFO VERSIONINFO
FILEVERSION DCSC_VERSION
PRODUCTVERSION DCSC_VERSION
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904b0"
    BEGIN
      VALUE "CompanyName", "DCS Control contributors"
      VALUE "FileDescription", "DCS Control"
      VALUE "ProductName", "DCS Control"
      VALUE "OriginalFilename", "DcsControl.exe"
      VALUE "FileVersion", DCSC_VERSION_TEXT
      VALUE "ProductVersion", DCSC_VERSION_TEXT
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
