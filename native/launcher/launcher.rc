// Icon and version information of the DCS Control launcher.
#include <winver.h>

1 ICON "..\\..\\src\\DcsVr.App\\Assets\\app-icon.ico"

VS_VERSION_INFO VERSIONINFO
FILEVERSION 0,5,0,0
PRODUCTVERSION 0,5,0,0
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904b0"
    BEGIN
      VALUE "CompanyName", "DCS Control contributors"
      VALUE "FileDescription", "DCS Control"
      VALUE "ProductName", "DCS Control"
      VALUE "OriginalFilename", "DcsControl.exe"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
